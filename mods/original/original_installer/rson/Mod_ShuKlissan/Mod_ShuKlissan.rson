                        "  ShipSpecialBonuses(CurShip,bonDroid,0);",
                        "  ChangeState(10);",
                        "  exit;",
                        "}",
                        "if(MachpellaJump) {",
                        "  MakeShipEnterStar(CurShip,GalaxyStar(71),ShipStar(CurShip),0);",
                        "  RelationToRanger(CurShip,Player(),0);",
                        "  MachpellaJump=0;",
                        "  ChangeState(10);",
                        "  exit;",
                        "}",
                        "if(machpella_state == 1 && (!KlissanState || ruchnik_mashka)) {",
                        "  OrderLock(CurShip, 0);",
                        "  ShipSpecialBonuses(CurShip, bonDroid, 20);",
                        "  ruchnik_mashka = 0;",
                        "  ChangeState(22);",
                        "  exit;",
                        "}",
                        "if(KlissanState==2) {",
                        "  RelationToRanger(CurShip,Player(),0);",
                        "  ChangeState(10);",
                        "  exit;",
                        "}"
