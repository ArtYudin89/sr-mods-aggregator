                },
                {
                    "Name": "",
                    "Code.Type": "Turn",
                    "Code": [
                        "OrderLanding(CurShip,PlanetPirateClan());",
                        "OrderLock(CurShip,1);",
                        "if(EndState2<4 && GroupCount(Handler))",
                        "{",
                        "    EndState2=4;",
                        "    if(ShipInNormalSpace(Player())) Dialog(WB1,WarriorsWB);",
                        "}",
                        "if(ShipStar(Player())==ShipStar(CurShip)) {",
                        "    if(!GroupCount(Handler) && !kill_handler) { //Хандлер либо убит, либо улетел в Нифигац",
                        "        kill_handler=1; //Флаг разговора о ликвидации Хандлера",
                        "        if(!HandlerDead) {",
                        "            if(GroupCount(Machpella)) Dialog(WB2b,WarriorsWB); //Хандлер не убит, убей Махпеллу",
                        "        }",
                        "        else {",
                        "            if(!kill_machpella && GroupCount(Machpella)) Dialog(WB2a,WarriorsWB); //Хандлер убит, убей Махпеллу",
                        "            else Dialog(WB3b,WarriorsWB); //Все убиты, поздравляем",
                        "        }",
                        "    }",
