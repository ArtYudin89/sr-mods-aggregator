            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 620,
                    "Parent": -1,
                    "#": 13,
                    "Code.Type": "Global",
                    "Code": [
                        "if(CurTurn()>=script_date) {",
                        "  if(GRunFrom==3) {",
                        "    GRun();",
                        "    script_date=CurTurn()+1500;",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 620,
                    "Parent": -1,
                    "#": 14,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(GroupCount(domike) && GroupCount(flote)) {",
                        "  if(ShipStar(GroupToShip(domike))==ShipStar(Player())) {",
                        "    if(dicky==0) {",
                        "      for (i=0; i<GroupCount(domike); i=i+1)",
                        "      {",
                        "      a=GroupShip(domike,i);",
                        "      OrderTeleport(a,ShipStar(a),228,228);",
                        "      }",
                        "      dicky=1;",
                        "    }",
                        "  }",
                        "}",
                        "if(!GroupCount(flote)) {",
                        "  for (i=0; i<GroupCount(domike); i=i+1)",
                        "  {",
                        "  a=GroupShip(domike,i);",
                        "  ShipOut(a);",
                        "  }",
                        "}",
                        "if(!GroupCount(domike)) {",
                        "  for (i=0; i<GroupCount(flote); i=i+1)",
                        "  {",
                        "  a=GroupShip(flote,i);",
                        "  ShipOut(a);",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 70,
                    "Pos.y": 250,
                    "Parent": -1,
                    "#": 33,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(ShipStar(GroupToShip(flote))==ShipStar(Player())) {",
                        "  if(ShipInNormalSpace(Player())) {",
                        "    if(ShipInNormalSpace(GroupToShip(flote))) {",
                        "      if(dlg==0) {",
                        "        Dialog(flot,flote);",
                        "        //SFT('Диалог стартовал - sas mod');",
                        "      }",
                        "    }",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 410,
                    "Parent": -1,
                    "#": 34,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(dlg==0) {",
                        "  DChange(0);",
                        "  exit;",
                        "}",
                        "if(dlg==2) {",
                        "  DChange(1);",
                        "  exit;",
                        "}",
                        "if(dlg==1) {",
                        "  DChange(4);",
                        "  exit;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 480,
                    "Parent": -1,
                    "#": 35,
                    "Code.Type": "Turn",
                    "Code": [
                        "DAdd(1);",
                        "DAdd(2);",
                        "DAdd(5);"
                    ]
                },
