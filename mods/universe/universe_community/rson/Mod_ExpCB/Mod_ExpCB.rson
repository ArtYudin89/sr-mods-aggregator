                    "Code": [
                        "//Игрок приобрёл ММ за \"наличные\" ноды (трюм + склад) + за ноды со счёта",
                        "i = GAnswerData;",
                        "GetNodesFromShip(Player(), GetNodesFromShip(Player()));",
