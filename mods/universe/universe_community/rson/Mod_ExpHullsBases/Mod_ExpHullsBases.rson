                        "            tstr1 = '</color>' + Format(CT('Script.Mod_ExpHullsBases.Dialogs' + ruin_str_type + '.GreetingImprove'), '<HullReport' + '>', HullReport, '');",
                        "            exit;",
                        "        }",
                        "    }",
                        "    else ShipMoney(Player(), ShipMoney(Player()) - armor_upgrade_cost);",
                        "",
                        "    SetEquipmentStats(ShipItems(cur_ruin, 0), GetEquipmentStats(ShipItems(cur_ruin, 0)) + armor_augment);",
                        "    ItemCost(ShipItems(cur_ruin, 0), cur_ruin_cost + cur_ruin_cost * 4 / 10);",
                        "",
                        "    if(ruin_str_type == 'WB') tstr1 = '</color>' + CT(\"Script.Mod_ExpHullsBases.472\");",
                        "    else if(ruin_str_type == 'PlayerMercHQ')",
                        "    {",
                        "        tstr1 = '</color>' + CT('Script.Mod_ExpHullsBases.DialogsPlayerMercHQ.HullArmorIncreased');",
                        "    }",
                        "    else tstr1 = '</color>' + CT(\"Script.Mod_ExpHullsBases.487\");",
                        "    tstr2 = '</color>' + CT(\"Script.Mod_ExpHullsBases.179\");",
                        "",
                        "    Sound('Sound.Repair');",
                        "}",
                        "//Повышение ТУ корпуса",
                        "else if(GAnswerData == 3)",
                        "{",
                        "    if(ruin_str_type == 'PlayerMercHQ')",
                        "    {",
                        "        check = PlayerHQPayCheck(level_upgrade_cost);",
                        "        if(!check)",
                        "        {",
                        "            //В реплике собеседника подставлена именно эта переменная, поэтому возвращаем в неё исходное значение",
                        "            tstr1 = '</color>' + Format(CT('Script.Mod_ExpHullsBases.Dialogs' + ruin_str_type + '.GreetingImprove'), '<HullReport' + '>', HullReport, '');",
                        "            exit;",
                        "        }",
                        "    }",
                        "    else ShipMoney(Player(), ShipMoney(Player()) - level_upgrade_cost);",
                        "",
                        "    ItemLevel(ShipItems(cur_ruin, 0), ItemLevel(ShipItems(cur_ruin, 0)) + 1);",
                        "    ItemCost(ShipItems(cur_ruin, 0), cur_ruin_cost + cur_ruin_cost / 3);",
                        "",
                        "    if(ruin_str_type == 'WB') tstr1 = '</color>' + CT(\"Script.Mod_ExpHullsBases.475\");",
                        "    else if(ruin_str_type == 'PlayerMercHQ')",
                        "    {",
                        "        tstr1 = '</color>' + CT('Script.Mod_ExpHullsBases.DialogsPlayerMercHQ.HullLevelIncreased');",
                        "    }",
                        "    else tstr1 = '</color>' + CT(\"Script.Mod_ExpHullsBases.484\");",
                        "    tstr2 = '</color>' + CT(\"Script.Mod_ExpHullsBases.179\");",
                        "",
                        "    Sound('Sound.Repair');",
                        "}",
                        "//Установка ГСОМ",
                        "else if(GAnswerData == 4)",
                        "{",
                        "    if(ruin_str_type == 'PlayerMercHQ')",
                        "    {",
                        "        check = PlayerHQPayCheck(upgrade_cost_gsom);",
                        "        if(!check)",
                        "        {",
                        "            exit;",
                        "        }",
                        "    }",
                        "    else ShipMoney(Player(), ShipMoney(Player()) - upgrade_cost_gsom);",
                        "",
                        "    cur_item = ShipItems(cur_ruin, 0);",
                        "    SpecialToEquipment(FindBonusByNameInCfg('ExpHullsBases_GSOM'), cur_item);",
                        "    HullType(cur_item, 8); //Возвращаем станционный тип корпуса, т.к. SpecialToEquipment превратила его в акриновый",
                        "",
                        "    //Удаляем лишние выводы строчек бонусов из EvoArmada, если она подключена",
                        "    if(CurrentMods('Evolution\\\\EvoArmada'))",
                        "    {",
                        "        for(i = ItemExtraSpecials(cur_item) - 1; i >= 0; i = i - 1)",
                        "        {",
                        "            int bonus_num = ItemExtraSpecials(cur_item, i);",
                        "            tstr1 = BonusNumInCfg(bonus_num);",
                        "            if(tstr1 == 'EvoArmada_bonWEnergy' || tstr1 == 'EvoArmada_bonWSplinter' || tstr1 == 'EvoArmada_bonDef'/* || tstr1 == 'EvoArmada_bonSlotArt' || tstr1 == 'EvoArmada_bonSlotForsage' || tstr1 == 'EvoArmada_bonSlotRadar'*/)",
                        "            {",
                        "                tint1 = ItemExtraSpecialsCountByType(cur_item, bonus_num);",
                        "                ItemExtraSpecialsDeleteByType(cur_item, bonus_num, tint1);",
                        "                ItemExtraSpecialsAddByType(cur_item, FindBonusByNameInCfg(tstr1 + 'Hidden'), tint1);",
                        "            }",
                        "            else if(tstr1 == 'EvoArmada_ExtraSpecialsLineBreak')",
                        "            {",
                        "                ItemExtraSpecialsDeleteByType(cur_item, bonus_num);",
                        "            }",
                        "        }",
                        "    }",
                        "",
                        "    if(ruin_str_type == 'WB') tstr1 = '</color>' + CT(\"Script.Mod_ExpHullsBases.493\");",
                        "    else if(ruin_str_type == 'PlayerMercHQ')",
                        "    {",
                        "        tstr1 = '</color>' + CT('Script.Mod_ExpHullsBases.DialogsPlayerMercHQ.GSOMInstalled');",
                        "    }",
                        "    else tstr1 = '</color>' + CT(\"Script.Mod_ExpHullsBases.492\");",
                        "    tstr2 = '</color>' + CT(\"Script.Mod_ExpHullsBases.179\");",
                        "",
                        "    Sound('Sound.Repair');",
                        "}",
                        "//Установка \"Урагана\"",
                        "else if(GAnswerData == 5)",
                        "{",
                        "    if(ruin_str_type == 'PlayerMercHQ')",
                        "    {",
                        "        check = PlayerHQPayCheck(upgrade_cost_hurricane);",
                        "        if(!check)",
                        "        {",
                        "            exit;",
                        "        }",
                        "    }",
                        "    else ShipMoney(Player(), ShipMoney(Player()) - upgrade_cost_hurricane);",
                        "",
                        "    cur_item = ShipItems(cur_ruin, 0);",
                        "    SpecialToEquipment(FindBonusByNameInCfg('ExpHullsBases_Hurricane'), cur_item);",
                        "    HullType(cur_item, 8); //Возвращаем станционный тип корпуса, т.к. SpecialToEquipment превратила его в акриновый",
                        "",
                        "    //Удаляем лишние выводы строчек бонусов из EvoArmada, если она подключена",
                        "    if(CurrentMods('Evolution\\\\EvoArmada'))",
                        "    {",
                        "        for(i = ItemExtraSpecials(cur_item) - 1; i >= 0; i = i - 1)",
                        "        {",
                        "            bonus_num = ItemExtraSpecials(cur_item, i);",
                        "            tstr1 = BonusNumInCfg(bonus_num);",
                        "            if(tstr1 == 'EvoArmada_bonSkill1' || tstr1 == 'EvoArmada_bonWRadius')",
                        "            {",
                        "                tint1 = ItemExtraSpecialsCountByType(cur_item, bonus_num);",
                        "                ItemExtraSpecialsDeleteByType(cur_item, bonus_num, tint1);",
                        "                ItemExtraSpecialsAddByType(cur_item, FindBonusByNameInCfg(tstr1 + 'Hidden'), tint1);",
                        "            }",
                        "            else if(tstr1 == 'EvoArmada_ExtraSpecialsLineBreak')",
                        "            {",
                        "                ItemExtraSpecialsDeleteByType(cur_item, bonus_num);",
                        "            }",
                        "        }",
                        "    }",
                        "",
                        "    if(ruin_str_type == 'WB') tstr1 = '</color>' + CT(\"Script.Mod_ExpHullsBases.463\");",
                        "    else if(ruin_str_type == 'PlayerMercHQ')",
                        "    {",
                        "        tstr1 = '</color>' + CT('Script.Mod_ExpHullsBases.DialogsPlayerMercHQ.HurricaneInstalled');",
                        "    }",
                        "    else tstr1 = '</color>' + CT(\"Script.Mod_ExpHullsBases.491\");",
                        "    tstr2 = '</color>' + CT(\"Script.Mod_ExpHullsBases.179\");",
                        "",
                        "    Sound('Sound.Repair');",
                        "}",
                        "//Установка поликсенатной брони",
                        "else if(GAnswerData == 6)",
                        "{",
                        "    if(ruin_str_type == 'PlayerMercHQ')",
                        "    {",
                        "        check = PlayerHQPayCheck(upgrade_cost_polyxen);",
                        "        if(!check)",
                        "        {",
                        "            exit;",
                        "        }",
                        "    }",
                        "    else ShipMoney(Player(), ShipMoney(Player()) - upgrade_cost_polyxen);",
                        "",
                        "    cur_item = ShipItems(cur_ruin, 0);",
                        "    SpecialToEquipment(FindBonusByNameInCfg('ExpHullsBases_Polyxen'), cur_item);",
                        "    HullType(cur_item, 8); //Возвращаем станционный тип корпуса, т.к. SpecialToEquipment превратила его в акриновый",
                        "",
                        "    //Удаляем лишние выводы строчек бонусов из EvoArmada, если она подключена",
                        "    if(CurrentMods('Evolution\\\\EvoArmada'))",
                        "    {",
                        "        for(i = ItemExtraSpecials(cur_item) - 1; i >= 0; i = i - 1)",
                        "        {",
                        "            bonus_num = ItemExtraSpecials(cur_item, i);",
                        "            tstr1 = BonusNumInCfg(bonus_num);",
                        "            if(tstr1 == 'EvoArmada_bonDroid'/* || tstr1 == 'EvoArmada_bonSlotForsage'*/)",
                        "            {",
                        "                tint1 = ItemExtraSpecialsCountByType(cur_item, bonus_num);",
                        "                ItemExtraSpecialsDeleteByType(cur_item, bonus_num, tint1);",
                        "                ItemExtraSpecialsAddByType(cur_item, FindBonusByNameInCfg(tstr1 + 'Hidden'), tint1);",
