                        "  if(ShipType(cur_ruin) == 'MC') TextCorr = '</color>' + Format(CT(\"Script.Mod_ExpHullsBases.1010\"),\"<0>\",TextCorr2);",
                        "  else TextCorr = '</color>' + Format(CT(\"Script.Mod_ExpHullsBases.964\"),\"<0>\",TextCorr2);",
