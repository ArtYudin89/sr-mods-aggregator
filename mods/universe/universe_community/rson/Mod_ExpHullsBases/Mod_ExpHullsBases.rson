                    "Type": "Top",
                    "Parent": -1,
                    "Pos.x": 220,
                    "Pos.y": 865
                },
                {
                    "Name": "",
                    "Code.Type": "Turn",
                    "Code": [
                        "if(ShipJump(cur_ruin) <= 5) {",
                        "  DChange(65);",
                        "  exit;",
                        "}",
                        "if(ShipJump(cur_ruin) > 5) {",
                        "  if(PlayerBridge()) {",
                        "    if(!StarBattle(cur_star)) {",
                        "      DChange(13);",
                        "      exit;",
                        "    }",
                        "    if(StarBattle(cur_star)) {",
                        "      DChange(16);",
                        "      exit;",
                        "    }",
                        "  }",
                        "  if(!PlayerBridge()) {",
                        "    if(!StarBattle(cur_star)) {",
                        "      DChange(22);",
                        "      exit;",
                        "    }",
                        "    if(StarBattle(cur_star)) {",
                        "      DChange(16);",
                        "      exit;",
                        "    }",
                        "  }",
                        "}"
                    ],
