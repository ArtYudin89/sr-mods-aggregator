                        "if(ruin_str_type == 'PlayerMercHQ') tstr1 = '</color>' + CT('Script.Mod_ExpHullsBases.DialogsPlayerMercHQ.PlayerGSOMYes');",
                        "else tstr1 = '</color>' + CT(\"Script.Mod_ExpHullsBases.476\");",
                        "",
                        "if(player_money < upgrade_cost_gsom)",
                        "{",
                        "    tstr1 = DeleteTags(tstr1);",
