                    ],
                    "#": 253,
                    "Type": "Top",
                    "Parent": -1,
                    "Pos.x": 250,
                    "Pos.y": 550
                },
                {
                    "Name": "",
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!PlayerBridge()) cur_ruin = GetShipRuins(Player());",
                        "k = ShipFindCustomShipInfoByType(cur_ruin, 'Teleport_Generator');",
                        "if(!ShipCustomShipInfoData(cur_ruin, k, 3)) {",
                        "  DChange(33);",
                        "  exit;",
                        "}",
                        "if(ShipCustomShipInfoData(cur_ruin, k, 3)) {",
                        "  DChange(34);",
                        "  exit;",
                        "}"
                    ],
                    "#": 254,
                    "Type": "Top",
                    "Parent": -1,
                    "Pos.x": 400,
                    "Pos.y": 550
                },
                {
                    "Name": "",
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!PlayerBridge()) TextCorr = '</color>' + CT(\"Script.Mod_ExpHullsBases.945\");",
                        "else TextCorr = '</color>' + CT(\"Script.Mod_ExpHullsBases.1000\");",
                        "DChange(51);",
                        "exit;"
                    ],
                    "#": 255,
                    "Type": "Top",
                    "Parent": -1,
                    "Pos.x": 580,
                    "Pos.y": 550
                },
                {
                    "Name": "",
                    "Code.Type": "Turn",
                    "Code": [
                        "if(ShipType(cur_ruin) == 'MC') {",
                        "  if(StarBattle(cur_star)) {",
                        "    DChange(45);",
                        "    exit;",
                        "  }",
                        "  if(!StarBattle(cur_star)) {",
                        "    if(ShipType(cur_ruin) == 'SB') TextCorr2 = '</color>' + CT(\"Script.Mod_ExpHullsBases.855\");",
                        "    else if(ShipType(cur_ruin) == 'RC') TextCorr2 = '</color>' + CT(\"Script.Mod_ExpHullsBases.854\");",
                        "    else if(ShipType(cur_ruin) == 'MC') TextCorr2 = '</color>' + CT(\"Script.Mod_ExpHullsBases.859\");",
                        "    else if(ShipType(cur_ruin) == 'BK') TextCorr2 = '</color>' + CT(\"Script.Mod_ExpHullsBases.852\");",
                        "    else if(ShipType(cur_ruin) == 'TC') TextCorr2 = '</color>' + CT(\"Script.Mod_ExpHullsBases.851\");",
                        "    if(ShipType(cur_ruin) == 'MC') TextCorr = '</color>' + Format(CT(\"Script.Mod_ExpHullsBases.1010\"),\"<0>\",TextCorr2);",
                        "    else TextCorr = '</color>' + Format(CT(\"Script.Mod_ExpHullsBases.964\"),\"<0>\",TextCorr2);",
                        "    //Формируем список доступных для скачка систем",
                        "    ArrayClear(tempArr);",
                        "    ArrayClear(tempArr2);",
                        "    tempInt3 = 0;",
                        "    j = 1;",
