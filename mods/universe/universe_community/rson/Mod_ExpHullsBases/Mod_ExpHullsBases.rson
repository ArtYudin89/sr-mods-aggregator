                },
                {
                    "Name": "",
                    "Code.Type": "Turn",
                    "Code": [
                        "//Добавляем опции для установки акриновых улучшений и портального генератора",
                        "if(ruin_str_type == 'WB' || ruin_str_type == 'PlayerMercHQ')",
                        "{",
                        "    TextCorr2 = '</color>' + CT(\"Script.Mod_ExpHullsBases.451\");",
                        "    TextCorr3 = '</color>' + CT(\"Script.Mod_ExpHullsBases.470\");",
                        "}",
                        "else",
                        "{",
                        "    TextCorr2 = '</color>' + CT(\"Script.Mod_ExpHullsBases.416\");",
                        "    TextCorr3 = '</color>' + CT(\"Script.Mod_ExpHullsBases.464\");",
                        "}",
                        "",
                        "if(int(GetGameOptions('FontDialog')) > 1) TextCorr = '</color>' + CT(\"Script.Mod_ExpHullsBases.444\");",
                        "else TextCorr = '</color>' + CT(\"Script.Mod_ExpHullsBases.443\");",
                        "",
                        "if(GetGameOptions('FontDialog') == '0') DefSplt = '</color>----------------------------------------------------';",
                        "else if(GetGameOptions('FontDialog') == '1') DefSplt = '</color>------------------------------------------';",
                        "else if(GetGameOptions('FontDialog') == '2') DefSplt = '</color>-----------------------------------------';",
                        "else DefSplt = '</color>-------------------------------------';",
                        "",
                        "//Запоминаем наличие инфошек портального генератора и доп. энергоядер на станции",
                        "i = ShipFindCustomShipInfoByType(cur_ruin, 'Teleport_Generator');",
                        "k = ShipFindCustomShipInfoByType(cur_ruin, 'Extra_Powercores');",
                        "if(~k) tempInt3 = ShipCustomShipInfoData(cur_ruin, k, 1);",
                        "else tempInt3 = 1;",
                        "",
                        "//Убеждаемся, что для установки ядра на станции имеется хотя бы один свободный слот (оружия или артефакта)",
                        "tempInt1 = 0;",
                        "tempInt2 = 0;",
                        "if(~i)",
                        "{",
                        "    if((GetEquipmentStats(ShipItems(cur_ruin, 0), 1) + ShipSpecialBonuses(cur_ruin, bonSlotWeapon)) > 1) tempInt1 = 1;",
                        "    if((GetEquipmentStats(ShipItems(cur_ruin, 0), 2) + ShipSpecialBonuses(cur_ruin, bonSlotArt)) > 0) tempInt2 = 1;",
                        "}",
                        "",
                        "//Добавляем опции для улучшения статов станции",
                        "//Увеличение размера",
                        "if(cur_ruin_size < max_ruin_size)",
                        "{",
                        "    if(ruin_str_type != 'PlayerMercHQ') tstr1 = '</color>' + Format(CT(\"Script.Mod_ExpHullsBases.164\"),\"<0>\",size_augment_str,\"<1>\",size_upgrade_cost_str);",
                        "    else tstr1 = '</color>' + Format(CT('Script.Mod_ExpHullsBases.DialogsPlayerMercHQ.PlayerAskHullStructureIncrease'), '<Count'+'>', size_augment_str, '<Cost'+'>', size_upgrade_cost_str);",
                        "",
                        "    if(player_money < size_upgrade_cost)",
                        "    {",
                        "        tstr1 = DeleteTags(tstr1);",
                        "        AddDialogBlock(tstr1, 1);",
                        "    }",
                        "    InjectAnswer('RuinImproveDone', tstr1, 1);",
                        "}",
                        "",
                        "//Усиление брони",
                        "if(cur_ruin_armor < max_ruin_armor)",
                        "{",
                        "    if(ruin_str_type != 'PlayerMercHQ') tstr1 = '</color>' + Format(CT(\"Script.Mod_ExpHullsBases.166\"),\"<0>\",armor_augment_str,\"<1>\",armor_upgrade_cost_str);",
                        "    else tstr1 = '</color>' + Format(CT('Script.Mod_ExpHullsBases.DialogsPlayerMercHQ.PlayerAskHullArmorIncrease'), '<Count'+'>', armor_augment_str, '<Cost'+'>', armor_upgrade_cost_str);",
                        "",
                        "    if(player_money < armor_upgrade_cost)",
                        "    {",
                        "        tstr1 = DeleteTags(tstr1);",
                        "        AddDialogBlock(tstr1, 1);",
                        "    }",
                        "",
                        "    InjectAnswer('RuinImproveDone', tstr1, 2);",
                        "}",
                        "",
                        "//Повышение ТУ корпуса",
                        "if(cur_ruin_techlevel < 8)",
                        "{",
                        "    //НБ и ТЦ могут поднимать ТУ своей базы раньше всех прочих станций",
                        "    tint1 = 0;",
                        "    if(ruin_str_type == 'SB' || ruin_str_type == 'TC')",
                        "    {",
                        "        if(cur_ruin_techlevel <= GalaxyTechLevel()) tint1 = 1;",
                        "    }",
                        "    else",
                        "    {",
                        "        if(cur_ruin_techlevel < GalaxyTechLevel()) tint1 = 1;",
                        "    }",
                        "",
                        "    if(tint1)",
                        "    {",
                        "        if(ruin_str_type != 'PlayerMercHQ') tstr1 = '</color>' + Format(CT(\"Script.Mod_ExpHullsBases.473\"),\"<0>\",level_upgrade_cost_str);",
                        "        else tstr1 = '</color>' + Format(CT('Script.Mod_ExpHullsBases.DialogsPlayerMercHQ.PlayerAskHullLevelIncrease'), '<Cost'+'>', level_upgrade_cost_str);",
                        "",
                        "        if(player_money < level_upgrade_cost)",
                        "        {",
                        "            tstr1 = DeleteTags(tstr1);",
                        "            AddDialogBlock(tstr1, 1);",
                        "        }",
                        "",
                        "        InjectAnswer('RuinImproveDone', tstr1, 3);",
                        "    }",
                        "}",
                        "if(ruin_str_type != 'WB' &&",
                        "ruin_str_type != 'MB' &&",
                        "ruin_str_type != 'Manaan') {",
                        "  if(i == -1) {",
                        "    if(cur_ruin_techlevel > 3 && ruin_str_type != 'PlayerMercHQ') {",
                        "      DAdd(42);",
                        "    }",
                        "  }",
                        "  if((tempInt1 || tempInt2) && tempInt3 < 4) {",
                        "    if(tempInt3 < 2) {",
                        "      if(k <= -1) tempStr1 = '</color>' + CT(\"Script.Mod_ExpHullsBases.744\");",
                        "      else tempStr1 = '</color>' + CT(\"Script.Mod_ExpHullsBases.794\");",
                        "      DAdd(44);",
                        "    }",
                        "    if(tempInt3 > 1) {",
                        "      if(cur_ruin_techlevel > 4) {",
                        "        if(k <= -1) tempStr1 = '</color>' + CT(\"Script.Mod_ExpHullsBases.744\");",
                        "        else tempStr1 = '</color>' + CT(\"Script.Mod_ExpHullsBases.794\");",
                        "        DAdd(44);",
                        "      }",
                        "    }",
                        "  }",
                        "}",
                        "if(HullSpecial(cur_ruin) == -1) {",
                        "  if(ruin_str_type != 'PlayerMercHQ')",
                        "  {",
                        "      tempStr1 = '</color>' + CT(\"Script.Mod_ExpHullsBases.1033\");",
                        "      tempStr2 = '</color>' + CT(\"Script.Mod_ExpHullsBases.1032\");",
                        "      tempStr3 = '</color>' + CT(\"Script.Mod_ExpHullsBases.1031\");",
                        "  }",
                        "  else",
                        "  {",
                        "      tempStr1 = '</color>' + CT('Script.Mod_ExpHullsBases.DialogsPlayerMercHQ.PlayerAskGSOM');",
                        "      tempStr2 = '</color>' + CT('Script.Mod_ExpHullsBases.DialogsPlayerMercHQ.PlayerAskHurricane');",
                        "      tempStr3 = '</color>' + CT('Script.Mod_ExpHullsBases.DialogsPlayerMercHQ.PlayerAskPolyxen');",
                        "  }",
                        "  if(cur_ruin_techlevel > 5) {",
                        "    DAdd(2);",
                        "  }",
                        "  if(cur_ruin_techlevel > 4) {",
                        "    DAdd(1);",
                        "  }",
                        "  if(cur_ruin_techlevel > 3) {",
                        "    DAdd(3);",
                        "  }",
                        "}",
                        "if(ruin_str_type == 'PlayerMercHQ') {",
                        "  //Добавляем отдельный диалог по улучшению уровня штаба игрока в моде ShuMercsHQ",
                        "  if(PlayerHQMainArray['Main', 'HQLevel'] < PlayerHQMainArray['Main', 'HQLevelMax'])",
                        "  {",
                        "      cost = min(max(PortionInDiapason(PlayerHQMainArray['Main', 'HQLevel'], 1, 4, 1000000, 10000000), PortionInDiapason(PlayerHQMainArray['Main', 'HQLevel'], 1, 4, 30.0 * GalaxyMoney(4, 4), 300.0 * GalaxyMoney(4, 4))), 1000000000);",
                        "      tstr1 = '</color>' + Format(CT('Script.Mod_ShuMercs.PlayerHQImproveDialog.PlayerAskHQLevelUp'), '<Cost'+'>', cost);",
                        "      if(player_money < cost)",
                        "      {",
                        "          tstr1 = DeleteTags(tstr1);",
                        "          AddDialogBlock(tstr1, 1);",
                        "      }",
                        "",
                        "      InjectAnswer('RuinImproveDone', tstr1, 10);",
                        "  }",
                        "}",
                        "DAdd(29);"
                    ],
                    "#": 296,
                    "Type": "Top",
                    "Parent": -1,
                    "Pos.x": 280,
                    "Pos.y": 695
                },
                {
                    "Name": "",
                    "Code.Type": "Turn",
