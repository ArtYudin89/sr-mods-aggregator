                {
                    "Name": "",
                    "Code.Type": "Turn",
                    "Code": [
                        "upgrade_cost_portalGen = round(1.0 * (50000 + 50000 * (GalaxyDiffLevels(4) - 100) / 400) * (0.5 + (0.25 * (GalaxyTechLevel() - 1))), 100);",
                        "if(CurrentMods('Evolution\\\\EvoNoInflation')) upgrade_cost_portalGen = round(0.33 * upgrade_cost_portalGen, 100);",
                        "",
                        "if(GetGameOptions('FontDialog') < 1) TextCorr4 = '</color>' + CT(\"Script.Mod_ExpHullsBases.726\");",
                        "else TextCorr4 = '</color>' + CT(\"Script.Mod_ExpHullsBases.725\");",
                        "DChange(32);",
