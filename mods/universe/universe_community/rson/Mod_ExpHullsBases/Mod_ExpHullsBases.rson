                    "Parent": -1,
                    "Pos.x": 340,
                    "Pos.y": 865
                },
                {
                    "Name": "",
                    "Code.Type": "Turn",
                    "Code": [
                        "destination_star = ConStar(cur_con, 0);",
                        "if(StarOwner(destination_star) != 0) {",
                        "  DChange(15);",
                        "  exit;",
                        "}",
                        "if(StarOwner(destination_star) == 0) {",
                        "  if(StarRuins(destination_star, 'WB') > 0) {",
                        "    DChange(18);",
                        "    exit;",
                        "  }",
