                        "          if(!SectorVisible(StarToCon(tempInt3)))",
                        "          {",
                        "              tempInt3 = 0;",
                        "              continue;",
                        "          }",
                        "          if(StarBattle(tempInt3) && ShipType(cur_ruin) != 'MC')",
                        "          {",
                        "              tempInt3 = 0;",
                        "              continue;",
                        "          }",
                        "          if(StarRuins(tempInt3, ShipType(cur_ruin)))",
                        "          {",
                        "              tempInt3 = 0;",
                        "              continue;",
                        "          }",
                        "          if(StarRuins(tempInt3) >= 5)",
                        "          {",
                        "              tempInt3 = 0;",
                        "              continue;",
                        "          }",
                        "          //Отдельно заносим в массив систему и её номер по удалённости от местонахождения станции",
                        "          ArrayAdd(tempArr, tempInt3);",
                        "          ArrayAdd(tempArr2, j - 1);",
                        "          tempInt3 = 0;",
                        "      }",
                        "      else tempInt3 = 1;",
                        "  }",
                        "  if(ArrayDim(tempArr) > 1) {",
                        "    DChange(42);",
                        "    exit;",
                        "  }",
                        "  if(ArrayDim(tempArr) < 2) {",
                        "    DChange(49);",
                        "    exit;",
                        "  }",
                        "}"
