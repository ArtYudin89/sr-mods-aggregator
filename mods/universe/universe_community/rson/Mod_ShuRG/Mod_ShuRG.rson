            "Items": [],
            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 775,
                    "Parent": -1,
                    "#": 73,
                    "Code.Type": "Global",
                    "Code": [
                        "GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 775,
                    "Parent": -1,
                    "#": 74,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!GroupCount(Fleet))",
                        "{",
                        "    busy = 0;",
                        "}",
                        "",
                        "if(!Rnd(0, 8)) //if(!RndObject(0, 8, PlanetPirateClan()))",
                        "{",
                        "    PlanetBoostInventions(PlanetPirateClan(), 1);",
                        "}",
                        "",
                        "if(GetShipPlanet(Player())>0)",
                        "{",
                        "    if(GetShipPirateRank(Player()) == PirateClan)",
                        "    {",
                        "        if(GetShipPlanet(Player()) == PlanetPirateClan())",
                        "        {",
                        "            if(PlanetOwner(PlanetPirateClan()) == PirateClan) GotoGov(1);",
                        "        }",
                        "    }",
                        "}",
                        "",
                        "starz=StarShips(PlanetToStar(PlanetPirateClan()));",
                        "for(i=0; i<starz; i=i+1)",
                        "{",
                        "    sh=StarShips(PlanetToStar(PlanetPirateClan()),i);",
                        "    if(Id(sh)>=ship_id && !IsPlayer(sh) && GetShipPlanet(sh)>0 && ShipOnSidePirateClan(sh) && ShipFindCustomShipInfoByType(sh,'kostyl')==-1 && GetShipHomePlanet(sh)==PlanetPirateClan())",
                        "    {",
                        "        ShipAddCustomShipInfo(sh,'kostyl','NoShow');",
                        "        rand=Rnd(1,2);",
                        "        for(rand=rand;rand>0;rand=rand-1)",
                        "        {",
                        "            if (GetShipPirateRank(sh)>=4) break;",
                        "            RaisePirateRank(sh);",
                        "            if (GetShipPirateRank(sh)==3 && !Rnd(0,2)) break;",
                        "            if (GetShipPirateRank(sh)>=4) break;",
                        "        }",
                        "",
                        "        if (GalaxyDiffLevels(0)<=150)",
                        "        {",
                        "            ShipSkill(sh,0,Rnd(2,6));",
                        "            ShipSkill(sh,1,Rnd(2,6));",
                        "        }",
                        "        else if (GalaxyDiffLevels(0)<=350)",
                        "        {",
                        "            ShipSkill(sh,0,Rnd(3,6));",
                        "            ShipSkill(sh,1,Rnd(3,6));",
                        "        }",
                        "        else",
                        "        {",
                        "            ShipSkill(sh,0,Rnd(4,6));",
                        "            ShipSkill(sh,1,Rnd(4,6));",
                        "        }",
                        "",
                        "        if (GalaxyDiffLevels(0)==50) ShipMoney(sh,ShipMoney(sh)*1.15);",
                        "        else if (GalaxyDiffLevels(0)==100) ShipMoney(sh,ShipMoney(sh)*1.45);",
                        "        else if (GalaxyDiffLevels(0)==150) ShipMoney(sh,ShipMoney(sh)*1.80);",
                        "        else if (GalaxyDiffLevels(0)==200) ShipMoney(sh,ShipMoney(sh)*2.20);",
                        "        else if (GalaxyDiffLevels(0)<=300) ShipMoney(sh,ShipMoney(sh)*2.50);",
                        "        else if (GalaxyDiffLevels(0)<=400) ShipMoney(sh,ShipMoney(sh)*2.80);",
                        "        else if (GalaxyDiffLevels(0)<=500) ShipMoney(sh,ShipMoney(sh)*3.15);",
                        "        ShipRefit(sh);",
                        "",
                        "        if (GalaxyDiffLevels(0)==50) ShipImproveItems(sh,Rnd(1,2));",
                        "        else if (GalaxyDiffLevels(0)==100) ShipImproveItems(sh,Rnd(1,4));",
                        "        else if (GalaxyDiffLevels(0)==150) ShipImproveItems(sh,Rnd(2,6));",
                        "        else if (GalaxyDiffLevels(0)==200) ShipImproveItems(sh,Rnd(3,8));",
                        "        else if (GalaxyDiffLevels(0)==250) ShipImproveItems(sh,Rnd(3,9));",
                        "        else if (GalaxyDiffLevels(0)==300) ShipImproveItems(sh,Rnd(3,10));",
                        "        else if (GalaxyDiffLevels(0)==350) ShipImproveItems(sh,Rnd(4,10));",
                        "        else if (GalaxyDiffLevels(0)==400) ShipImproveItems(sh,Rnd(5,10));",
                        "        else if (GalaxyDiffLevels(0)==450) ShipImproveItems(sh,Rnd(5,11));",
                        "        else if (GalaxyDiffLevels(0)==500) ShipImproveItems(sh,Rnd(6,11));",
                        "    }",
                        "}",
                        "",
                        "ship_id=GalaxyShipId();",
                        "if(busy && GroupCount(Fleet))",
                        "{",
                        "    for(i=0;i<GroupCount(Fleet);i=i+1)",
                        "    {",
                        "        sh=GroupShip(Fleet,i);",
                        "        ShipSpecialBonuses(sh,bonHull,GalaxyTechLevel());",
                        "        ShipSpecialBonuses(sh,bonWEnergy,2+GalaxyTechLevel()*3);",
                        "        ShipSpecialBonuses(sh,bonWSplinter,2+GalaxyTechLevel()*3);",
                        "        ShipSpecialBonuses(sh,bonWMissile,2+GalaxyTechLevel()*3);",
                        "    }",
                        "}",
                        "",
                        "if(!busy && GroupCount(Fleet))",
                        "{",
                        "    for(i=0;i<GroupCount(Fleet);i=i+1)",
