                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 1420,
                    "Pos.y": 680,
                    "Parent": -1,
                    "#": 178,
                    "Code.Type": "Turn",
                    "Code": [
                        "items_to_repair=newarray(1);",
                        "repair_type=2;",
                        "if (cur_ruin_id!=0) ",
                        "{",
                        "ShipDestroy(IdToShip(cur_ruin_id));",
                        "}",
                        "cur_ruin=BuildRuins(GalaxyStar(71),t_PB);",
                        "TransferShip(cur_ruin,StarPlanets(GalaxyStar(71),1));",
                        "//Пришлось заюзать костыль с невидимой, чтобы в следующей операции подхватился ее тип,",
                        "//ибо копаться в коде Уханыча и выправлять условия я желанием не горел. Можно ведь и сломать что-нибудь.",
                        "//И, да, она прячется на незаселенке в Тортугаце, чтобы игрок ее не мог обнаружить ни на карте, ни через поиск.;",
                        "ArrayClear(items_to_repair);",
                        "domik_wpn_cost=0;",
                        "art_cost=0;",
                        "total_nod=0;",
                        "item_cost=0;",
                        "total_cost=0;",
                        "for(count=0;count<ShipItems(Player());count=count+1){",
                        "cur_item=ShipItems(Player(),count);",
                        "if(count==0){",
                        "    if(HullDamage(Player())>0) {",
                        "        item_cost=((ItemCost(cur_item)*HullDamage(Player())*1000)/40)/100+10;",
                        "        item_cost=item_cost/10000;",
                        "        item_cost=item_cost*10; ",
                        "        max_duration=HullDamage(Player());",
                        "        ArrayAdd(items_to_repair,cur_item);",
                        "        }",
                        "    continue;",
                        "    }",
                        "if(ItemType(cur_item)>=t_Weapon13 && ItemType(cur_item)<=t_Weapon15 && ShipType(cur_ruin)=='WB') continue;",
                        "if((!ItemIsInSet(cur_item) || !ItemIsInUse(cur_item)) && repair_type==0) continue;",
                        "if(!ItemIsInUse(cur_item) && repair_type==2) continue;",
                        "    if(ItemType(cur_item)>t_Hull && ItemType(cur_item)<t_Protoplasm){",
                        "        if(ItemDurability(cur_item)<=90){",
                        "            temp_int=(ItemCost(cur_item)*1000/20)+(((ItemCost(cur_item)*1000)/7)/100)*(100-ItemDurability(cur_item))+10000;",
                        "            if(ItemDurability(cur_item)<1) temp_int=(temp_int*13)/10;",
                        "            temp_int=temp_int/10000;",
                        "            temp_int=temp_int*10;",
                        "            item_cost=item_cost+temp_int;",
                        "            ArrayAdd(items_to_repair,cur_item);",
                        "                if(ItemType(cur_item)>=t_Weapon13 && ItemType(cur_item)<=t_Weapon15){",
                        "                domik_wpn_cost=domik_wpn_cost+temp_int;",
                        "                total_nod=total_nod+temp_int;}",
                        "        }",
                        "    }",
                        "    if(max_duration<100-ItemDurability(cur_item)) max_duration=100-ItemDurability(cur_item);",
                        "}",
                        "if(ShipType(cur_ruin)!='WB'){",
                        "    for(count=0;count<ShipArts(Player());count=count+1){",
                        "    cur_item=ShipArts(Player(),count);",
                        "    if(!ItemCanBeBroken(cur_item)) continue;",
                        "    if((!ItemIsInSet(cur_item) || !ItemIsInUse(cur_item)) && repair_type==0) continue;",
                        "    if(!ItemIsInUse(cur_item) && repair_type==2) continue;",
                        "    if(max_duration<100-ItemDurability(cur_item)) max_duration=100-ItemDurability(cur_item);",
                        "        if(ItemDurability(cur_item)<=90){",
                        "                    temp_int=(ItemCost(cur_item)*1000/10)+(((ItemCost(cur_item)*1000)/5)/100)*(100-ItemDurability(cur_item))+10000;",
                        "                    if(ItemDurability(cur_item)<1) temp_int=(temp_int*13)/10;",
                        "                    temp_int=temp_int/10000;",
                        "                    temp_int=temp_int*10;",
                        "                    temp_int=temp_int*2;",
                        "                    art_cost=art_cost+temp_int;",
                        "                    ArrayAdd(items_to_repair,cur_item);",
                        "                }",
                        "        if(max_duration<100-ItemDurability(cur_item)) max_duration=100-ItemDurability(cur_item);",
                        "    }",
                        "}",
                        "if(repair_type==1){",
                        "    for(art_count=0;art_count<ShipArts(Player());art_count=art_count+1){",
                        "        if(ItemType(ShipArts(Player(),art_count))==t_ArtefactTranclucator){",
                        "            cur_trank=ArtTranclucatorToShip(ShipArts(Player(),art_count));",
                        "                for(count=0;count<ShipItems(cur_trank);count=count+1){",
                        "                cur_item=ShipItems(cur_trank,count);",
                        "                if(count==0){",
                        "                    if(HullDamage(cur_trank)>0){",
                        "                        temp_int=((ItemCost(cur_item)*HullDamage(cur_trank)*1000)/40)/100+10;",
                        "                        temp_int=temp_int/10000;",
                        "                        temp_int=temp_int*10;",
                        "                        item_cost=item_cost+temp_int;",
                        "                        ArrayAdd(items_to_repair,cur_item);",
                        "                        if(max_duration<HullDamage(cur_trank)) max_duration=HullDamage(cur_trank);",
                        "                        }",
                        "                    continue;",
                        "                    }",
                        "                if(ItemType(cur_item)>=t_Weapon13 && ItemType(cur_item)<=t_Weapon15 && ShipType(cur_ruin)=='WB') continue;",
                        "                    if(ItemType(cur_item)>t_Hull && ItemType(cur_item)<t_Protoplasm){",
                        "                        if(ItemDurability(cur_item)<=90){",
                        "                            temp_int=(ItemCost(cur_item)*1000/20)+(((ItemCost(cur_item)*1000)/7)/100)*(100-ItemDurability(cur_item))+10000;",
                        "                            if(ItemDurability(cur_item)<1) temp_int=(temp_int*13)/10;",
                        "                            temp_int=temp_int/10000;",
                        "                            temp_int=temp_int*10;",
                        "                            item_cost=item_cost+temp_int;",
                        "                            ArrayAdd(items_to_repair,cur_item);",
                        "                            if(ItemType(cur_item)>=t_Weapon13 && ItemType(cur_item)<=t_Weapon15){",
                        "                            domik_wpn_cost=domik_wpn_cost+temp_int;",
                        "                            total_nod=total_nod+temp_int;",
                        "                            }",
                        "                        }",
                        "                    }",
                        "                    if(max_duration<100-ItemDurability(cur_item)) max_duration=100-ItemDurability(cur_item);",
                        "                }",
                        "            if(ShipType(cur_ruin)!='WB'){",
                        "                for(count=0;count<ShipArts(cur_trank);count=count+1){",
                        "                cur_item=ShipArts(cur_trank,count);",
                        "                if(!ItemCanBeBroken(cur_item)) continue;",
                        "                if((!ItemIsInSet(cur_item) || !ItemIsInUse(cur_item)) && repair_type==0) continue;",
                        "                if(!ItemIsInUse(cur_item) && repair_type==2) continue;",
                        "                if(max_duration<100-ItemDurability(cur_item)) max_duration=100-ItemDurability(cur_item);",
                        "                    if(ItemDurability(cur_item)<=90){",
                        "                                temp_int=(ItemCost(cur_item)*1000/10)+(((ItemCost(cur_item)*1000)/5)/100)*(100-ItemDurability(cur_item))+10000;",
                        "                                if(ItemDurability(cur_item)<1) temp_int=(temp_int*13)/10;",
                        "                                temp_int=temp_int/10000;",
                        "                                temp_int=temp_int*10;",
                        "                                temp_int=temp_int*2;",
                        "                                art_cost=art_cost+temp_int;",
                        "                                ArrayAdd(items_to_repair,cur_item);",
                        "                            }",
                        "                    if(max_duration<100-ItemDurability(cur_item)) max_duration=100-ItemDurability(cur_item);",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "}",
                        "ShipDestroy(cur_ruin);",
                        "total_cost=item_cost+art_cost;",
                        "total_nod=total_nod/400;",
                        "no_nod=1;",
                        "if(max_duration<=10) {",
                        "  DChange(0);",
                        "  exit;",
                        "}",
                        "if(max_duration>10) {",
                        "  total_cost=(total_cost*95)/100;",
                        "  total_nod=(total_nod*95)/100;",
                        "  domik_wpn_cost=(domik_wpn_cost*84)/100;",
                        "  discount=85;",
                        "  temp_int=total_cost;",
                        "  total_cost=total_cost-total_cost*discount/100;",
                        "  total_nod=total_nod-total_nod*discount/100;",
                        "  domik_wpn_cost=domik_wpn_cost-domik_wpn_cost*discount/100;",
                        "  if(!total_cost) {",
                        "    DChange(0);",
                        "    exit;",
                        "  }",
                        "  if(total_cost) {",
                        "    DChange(1);",
                        "    exit;",
                        "  }",
                        "}"
                    ]
                },
