                    "Parent": -1,
                    "#": 181,
                    "Code.Type": "Turn",
                    "Code": [
                        "sbor=0;",
                        "send_date=CurTurn();",
                        "if (StarOwner(GalaxyStar(star_num_in_galaxy))==2) nabeg_type=2;",
                        "else nabeg_type=1;",
                        "WasChangeTarget=0;",
                        "WasReinforcement=0;",
                        "enemy=0;",
                        "enemy_for_all=0;",
                        "busy=1;",
                        "pir_order=-1;",
                        "dState=0;",
                        "TimeToRun=0;",
                        "timer_rg=0;",
                        "ShipMoney(Player(),ShipMoney(Player())-pir_cost*squad_num);",
                        "Sound('Sound.Buy');",
                        "if (GroupCount(Fleet))",
                        "{",
                        "while (GroupCount(Fleet))",
                        "{",
                        "i=GroupShip(Fleet,0);",
                        "ShipOut(i);",
                        "}",
                        "}",
                        "",
                        "for (pir_left=StarShips(one_id);GroupCount(Fleet)<squad_num;pir_left=pir_left-1)",
                        "{",
                        "if (pir_left==0 && GroupCount(Fleet)<squad_num)",
                        "{",
                        "dState=1;",
                        "break;",
                        "}",
                        "pir_order=pir_order+1;",
                        "i=StarShips(one_id,pir_order);",
                        "if (ShipTypeN(i)!=t_Transport && ShipOnSidePirateClan(i) && i!=Player() && !ShipIsPartner(i) && ShipOrder(i)!=3 && !ShipInScript(i)) ShipJoin(Fleet,StarShips(one_id,pir_order));",
                        "}",
                        "if (dState==1)",
                        "{",
                        "pir_order=-1;",
                        "for (pir_left=StarShips(two_id);GroupCount(Fleet)<squad_num;pir_left=pir_left-1)",
                        "{",
                        "pir_order=pir_order+1;",
                        "i=StarShips(two_id,pir_order);",
                        "if (ShipTypeN(i)!=t_Transport && ShipOnSidePirateClan(i) && i!=Player() && !ShipIsPartner(i) && !ShipInScript(i) && ShipOrder(i)!=3) ShipJoin(Fleet,StarShips(two_id,pir_order));",
                        "}",
                        "}",
                        "DChange(9);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 220,
                    "Pos.y": 705,
                    "Parent": -1,
                    "#": 182,
                    "Code.Type": "Turn",
                    "Code": [
                        "for (i=0;i<GroupCount(Fleet);i=i+1)",
                        "{",
                        "sh=GroupShip(Fleet,i);",
                        "if (ShipInStar(sh,GalaxyStar(star_num_in_galaxy)) && ShipInNormalSpace(sh))",
                        "{",
                        "ShipSetBad(sh,IdToShip(enemy));",
                        "OrderFollowShip(sh,IdToShip(enemy),1,10);",
                        "}",
                        "if (ShipFindCustomShipInfoByType(sh,'ShuTarget')==-1) ShipAddCustomShipInfo(sh,'ShuTarget','NoShow',enemy);",
                        "else ShipCustomShipInfoData(sh,ShipFindCustomShipInfoByType(sh,'ShuTarget'),1,enemy);",
                        "enemy_for_all=1;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 580,
                    "Pos.y": 705,
                    "Parent": -1,
                    "#": 183,
                    "Code.Type": "Turn",
                    "Code": [
                        "if (Dist2Star(ShipStar(Player()),ShipOrderObj(Player()))>2550) i=2;",
                        "else",
                        "{",
                        "i=1;",
                        "ChangeTarget=1;",
                        "WasChangeTarget=1;",
                        "star_num_in_galaxy=Id(ShipOrderObj(Player()))-1;",
                        "}",
                        "if(i==1) {",
                        "  DChange(21);",
                        "  exit;",
                        "}",
                        "if(i==2) {",
                        "  DChange(22);",
                        "  exit;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 700,
                    "Pos.y": 705,
                    "Parent": -1,
                    "#": 184,
                    "Code.Type": "Turn",
                    "Code": [
                        "if (Dist2Star(PlanetToStar(PlanetPirateClan()),ShipStar(Player()))>2550) dState=2;",
                        "else    ",
                        "{",
                        "dState=1;",
                        "one_id=PlanetToStar(PlanetPirateClan());",
                        "two_id=GalaxyStar(71);",
                        "for (cur_zvezda=0;cur_zvezda<StarShips(one_id);cur_zvezda=cur_zvezda+1)",
                        "{",
                        "i=StarShips(one_id,cur_zvezda);",
                        "if (ShipTypeN(i)!=t_Transport && ShipOnSidePirateClan(i) && i!=Player() && !ShipIsPartner(i) && !ShipInScript(i) && ShipOrder(i)!=3) pirate_num=pirate_num+1;",
                        "}",
                        "for (cur_zvezda=0;cur_zvezda<StarShips(two_id);cur_zvezda=cur_zvezda+1)",
                        "{",
                        "i=StarShips(two_id,cur_zvezda);",
                        "if (ShipTypeN(i)!=t_Transport && ShipOnSidePirateClan(i) && i!=Player() && !ShipIsPartner(i) && !ShipInScript(i) && ShipOrder(i)!=3) pirate_num=pirate_num+1;",
                        "}",
                        "pir_cost=GalaxyMoney(2,2)*pirate_num*1.5;",
                        "}",
                        "if(dState==1) {",
                        "  DChange(24);",
                        "  exit;",
                        "}",
                        "if(dState==2) {",
                        "  DChange(23);",
                        "  exit;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 820,
                    "Pos.y": 705,
                    "Parent": -1,
                    "#": 185,
                    "Code.Type": "Turn",
                    "Code": [
                        "Sound('Sound.Buy');",
                        "ShipMoney(Player(),ShipMoney(Player())-pir_cost);",
                        "for(cur_zvezda=0; cur_zvezda<StarShips(one_id); cur_zvezda=cur_zvezda+1)",
                        "{",
                        "    i=StarShips(one_id,cur_zvezda);",
                        "    if(ShipTypeN(i)!=t_Transport && ShipOnSidePirateClan(i) && i!=Player() && !ShipIsPartner(i) && !ShipInScript(i) && ShipOrder(i)!=3)",
                        "    {",
                        "        ShipJoin(Fleet,i);",
                        "    }",
                        "}",
                        "for (cur_zvezda=0; cur_zvezda<StarShips(two_id); cur_zvezda=cur_zvezda+1)",
                        "{",
                        "    i=StarShips(two_id,cur_zvezda);",
                        "    if(ShipTypeN(i)!=t_Transport && ShipOnSidePirateClan(i) && i!=Player() && !ShipIsPartner(i) && !ShipInScript(i) && ShipOrder(i)!=3)",
                        "    {",
                        "        ShipJoin(Fleet,i);",
                        "    }",
                        "}"
                    ]
                }
            ],
