                        "ShipSpecialBonuses(CurShip,bonWMissile,3+GalaxyTechLevel()*2);",
                        "ShipSpecialBonuses(CurShip,bonHull,GalaxyTechLevel());",
                        "ShipSpecialBonuses(CurShip,bonSkill1,1);",
                        "ShipSpecialBonuses(CurShip,bonSkill2,1);",
                        "if(ShipInHyperSpace(CurShip) && CurTurn()>send_date+15) {",
                        "  TransferShip(CurShip,PlanetPirateClan());",
                        "  ShipOut(CurShip);",
                        "}",
                        "if(StarOwner(GalaxyStar(star_num_in_galaxy))==2 && nabeg_type==1 || !StarBattle(GalaxyStar(star_num_in_galaxy)) && nabeg_type==2) {",
                        "  if (!StarBattle(GalaxyStar(star_num_in_galaxy)) && nabeg_type==2 && StarOwner(GalaxyStar(star_num_in_galaxy))!=2) nabeg_type=1;",
                        "  else",
                        "  {",
                        "  korsar=CurShip;",
                        "  ShipOut(korsar);",
                        "  ShipJoin(Beg,korsar);",
                        "  if (ShipFindCustomShipInfoByType(korsar,'ShuTarget')>-1) ShipDeleteCustomShipInfo(sh,'ShuTarget');",
                        "  busy=0;",
                        "  }",
                        "}",
                        "if(ShipInStar(CurShip,GalaxyStar(star_num_in_galaxy)) && ShipInNormalSpace(CurShip)) {",
                        "  ChangeTarget=0;",
                        "  OrderLock(CurShip,0);",
                        "  ChangeState(2);",
                        "  exit;",
                        "}",
                        "if(!ShipInStar(CurShip,GalaxyStar(star_num_in_galaxy)) && !sbor && ShipInNormalSpace(CurShip)) {",
                        "  OrderLock(CurShip,0);",
                        "  OrderJump(CurShip,GalaxyStar(star_num_in_galaxy));",
                        "  OrderLock(CurShip,1);",
                        "}",
                        "if(ShipGetBad(CurShip)) {",
                        "  if(ShipOnSidePirateClan(ShipGetBad(CurShip))) {",
                        "    TruceBetweenShips(CurShip,ShipGetBad(CurShip));",
                        "  }",
                        "}",
                        "if(GetShipPlanet(CurShip)>0 && !sbor || sbor && GetShipPlanet(CurShip)!=PlanetPirateClan()) {",
                        "  OrderTakeOff(CurShip);",
                        "}",
                        "if(sbor && !ShipInStar(CurShip,PlanetToStar(PlanetPirateClan())) && ShipInNormalSpace(CurShip)) {",
                        "  OrderJump(CurShip,PlanetToStar(PlanetPirateClan()));",
                        "}",
