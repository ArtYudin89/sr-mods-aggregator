                        "for (cur_zvezda=0;cur_zvezda<StarShips(one_id);cur_zvezda=cur_zvezda+1)",
                        "{",
                        "i=StarShips(one_id,cur_zvezda);",
                        "if (ShipTypeN(i)!=t_Transport && ShipOnSidePirateClan(i) && i!=Player() && !ShipIsPartner(i) && !ShipInScript(i) && ShipOrder(i)!=3) pirate_num=pirate_num+1;",
                        "}",
                        "for (cur_zvezda=0;cur_zvezda<StarShips(two_id);cur_zvezda=cur_zvezda+1)",
                        "{",
                        "i=StarShips(two_id,cur_zvezda);",
                        "if (ShipTypeN(i)!=t_Transport && ShipOnSidePirateClan(i) && i!=Player() && !ShipIsPartner(i) && !ShipInScript(i) && ShipOrder(i)!=3) pirate_num=pirate_num+1;",
                        "}",
                        "parsek=0;",
                        "dState=0;",
                        "if(stars_add==0) {",
                        "  stars_add=1;",
                        "  stars=newarray(1);",
                        "}",
                        "if(busy) {",
                        "  DChange(6);",
                        "  exit;",
