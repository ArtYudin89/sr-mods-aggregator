            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 775,
                    "Parent": -1,
                    "#": 31,
                    "Code.Type": "Global",
                    "Code": [
                        "if(CurTurn() > 1342)",
                        "{",
                        "    //Скрипт запускается один раз за партию во время выполнения игроком прыжка",
                        "    if(GRunFrom == 3)",
                        "    {",
                        "        if(!GLastTurnRun(GScriptName)) GRun();",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 775,
                    "Parent": -1,
                    "#": 32,
                    "Code.Type": "Init",
                    "Code": [
                        "vNameShip = Name(GroupToShip(BigShip));",
                        "vshipname = Name(GroupToShip(PelengSpy));",
                        "//Запрет NPC грабить дипломата",
                        "NoTargetToShip(GroupToShip(PelengSpy), 2);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 775,
                    "Parent": -1,
                    "#": 33,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!vStartScript) {",
                        "  vStartScript = 1;",
                        "  //спавн штипов нужной подрасы",
                        "  for(i = 12; i > 0; i = i - 1) ShipJoin(SmallShip, BuyDomikExtremal(PlanetDom, 5));",
                        "  ShipDestroy(GroupToShip(SmallShip), 1);",
                        "  //спавним эквентора нужной подрасы",
                        "  ShipJoin(BigShip, BuyDomikExtremal(PlanetDom, 1));",
                        "  ShipDestroy(GroupToShip(BigShip), 1);",
                        "}",
                        "if(MyProbe==1) {",
                        "  if(vHitK1==0) {",
                        "    if(CountIn(BigShip)) {",
                        "      if(ItemExist(iOP)) {",
                        "        if(ShipInStar(Player(),StarDom)) {",
                        "          if(Dist(POP,GroupToShip(BigShip))<300) {",
                        "            if(!ItemIn(iOP,Player())) {",
                        "              vHour=Rnd(0,23);",
                        "              vMin=Rnd(0,59);",
                        "              vSec=Rnd(0,59);",
                        "              if(vZondMemory>=96) {",
                        "                Ether(2,'008DB316-DEE1-4BE1-A6BF-875942EC3671',Format(CT(\"Script.Mod_RevDominatorSpy.27\"),\"<0>\",GameDateTxtByTurn(CurTurn()),\"<1>\",vHour,\"<2>\",vMin,\"<3>\",vSec));",
                        "              }",
                        "              if(vZondMemory<96) {",
                        "                Ether(2,'008DB316-DEE1-4BE1-A6BF-875942EC3671',Format(CT(\"Script.Mod_RevDominatorSpy.42\"),\"<0>\",GameDateTxtByTurn(CurTurn()),\"<1>\",vHour,\"<2>\",vMin,\"<3>\",vSec,\"<4>\",vZondMemory,\"<5>\",(100-vZondMemory)));",
                        "                vZondDaysPl=vZondDaysPl+1;",
                        "                if(vStateDom<4)vZondMemory=vZondMemory+3;",
                        "              }",
                        "            }",
                        "          }",
                        "        }",
                        "      }",
                        "    }",
                        "  }",
                        "}",
                        "if(vZondDaysPl>=30) {",
                        "  vStateDom=3;",
                        "}",
                        "if(vStateDom==4) {",
                        "  vZondDaysPl=vZondDaysPl+1;",
                        "  if(vStateDom<4)vZondMemory=vZondMemory+3;",
                        "  if(vZondDaysPl>=5) {",
                        "    vStateDom=5;",
                        "    ItemDestroy(iOP,2);",
                        "  }",
                        "}",
                        "if(!ItemExist(iOP)) {",
                        "  if(vStateDom<4) {",
                        "    if(GroupToShip(BigShip))ShipOut(GroupToShip(BigShip));",
                        "    if(GroupToShip(SmallShip))",
                        "    \t{",
                        "    \tfor(i=GroupCount(SmallShip)-1;i>=0;i=i-1)ShipOut(GroupShip(SmallShip,i));",
                        "    \t}",
                        "    if(GroupToShip(BSB))ShipOut(GroupToShip(BSB));",
                        "    if(GroupToShip(PelengSpy))",
                        "    \t{",
                        "    \tNoTargetToShip(GroupToShip(PelengSpy),0);",
                        "    \tShipOut(GroupToShip(PelengSpy));",
                        "    \t}",
                        "    if(vStateDom==1) {",
                        "      vStateDom=128;",
                        "      Ether(5,'41DD73A2-7A71-4130-80C8-423E2CC022D0',Format(CT(\"Script.Mod_RevDominatorSpy.34\"),\"<0>\",Name(StarDom),\"<1>\",vNameShip,\"<2>\",90));",
                        "    }",
                        "  }",
                        "}",
                        "if(!CountIn(BigShip)) {",
                        "  NoTargetToShip(GroupToShip(SmallShip),0);",
                        "  ShipOut(GroupToShip(SmallShip));",
                        "  if(vStateDom<6) {",
                        "    if(GroupToShip(BigShip))ShipOut(GroupToShip(BigShip));",
                        "    if(GroupToShip(SmallShip))",
                        "    \t{",
                        "    \tfor(i=GroupCount(SmallShip)-1;i>=0;i=i-1)ShipOut(GroupShip(SmallShip,i));",
                        "    \t}",
                        "    if(GroupToShip(BSB))ShipOut(GroupToShip(BSB));",
                        "    if(GroupToShip(PelengSpy))",
                        "    \t{",
                        "    \tNoTargetToShip(GroupToShip(PelengSpy),0);",
                        "    \tShipOut(GroupToShip(PelengSpy));",
                        "    \t}",
                        "    if(vStateDom==1) {",
                        "      vStateDom=128;",
                        "      Ether(5,'41DD73A2-7A71-4130-80C8-423E2CC022D0',Format(CT(\"Script.Mod_RevDominatorSpy.34\"),\"<0>\",Name(StarDom),\"<1>\",vNameShip,\"<2>\",90));",
                        "    }",
                        "  }",
                        "}",
                        "if(!CountIn(BSB)) {",
                        "  if(vStateDom<6) {",
                        "    if(GroupToShip(BigShip))ShipOut(GroupToShip(BigShip));",
                        "    if(GroupToShip(SmallShip))",
                        "    \t{",
                        "    \tfor(i=GroupCount(SmallShip)-1;i>=0;i=i-1)ShipOut(GroupShip(SmallShip,i));",
                        "    \t}",
                        "    if(GroupToShip(BSB))ShipOut(GroupToShip(BSB));",
                        "    if(GroupToShip(PelengSpy))",
                        "    \t{",
                        "    \tNoTargetToShip(GroupToShip(PelengSpy),0);",
                        "    \tShipOut(GroupToShip(PelengSpy));",
                        "    \t}",
                        "    if(vStateDom==1) {",
                        "      vStateDom=128;",
                        "      Ether(5,'41DD73A2-7A71-4130-80C8-423E2CC022D0',Format(CT(\"Script.Mod_RevDominatorSpy.34\"),\"<0>\",Name(StarDom),\"<1>\",vNameShip,\"<2>\",90));",
                        "    }",
                        "  }",
                        "}",
                        "if(ItemExist(iOP)) {",
                        "  if(!ItemIn(iOP,PelengSpy)) {",
                        "    vZondDaysPe=vZondDaysPe+1;",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 320,
                    "Parent": -1,
                    "#": 61,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(Hitpoints(CurShip)<200 && Dist(PlaceSB,CurShip)<3000) {",
                        "  Dialog(dDiplomat,PelengSpy);",
                        "}",
                        "if(ShipInStar(CurShip,Star1)) {",
                        "  ChangeState(2);",
                        "  exit;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 440,
                    "Parent": -1,
                    "#": 62,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(Hitpoints(CurShip)<200 && Dist(PlaceSB,CurShip)<3000) {",
                        "  Dialog(dDiplomat,PelengSpy);",
                        "}",
                        "if(ItemIn(iOP,Player())) {",
                        "  ShipSetBad(GroupToShip(PelengSpy),Player());",
                        "  ShipOut(GroupToShip(PelengSpy));",
                        "}",
                        "if(vZondDaysPe>=30) {",
                        "  ChangeState(5);",
                        "  exit;",
                        "}",
                        "if(!ItemExist(iOP)) {",
                        "  ShipSetBad(GroupToShip(PelengSpy),Player());",
                        "  if(GroupToShip(BigShip))ShipOut(GroupToShip(BigShip));",
                        "  if(GroupToShip(SmallShip))",
                        "  \t{",
                        "  \tfor(i=GroupCount(SmallShip)-1;i>=0;i=i-1)ShipOut(GroupShip(SmallShip,i));",
                        "  \t}",
                        "  if(GroupToShip(BSB))ShipOut(GroupToShip(BSB));",
                        "  if(GroupToShip(PelengSpy))",
                        "  \t{",
                        "  \tNoTargetToShip(GroupToShip(PelengSpy),0);",
                        "  \tShipOut(GroupToShip(PelengSpy));",
                        "  \t}",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 220,
                    "Pos.y": 320,
                    "Parent": -1,
                    "#": 63,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(Hit(CurShip)) {",
                        "  ShipOut();",
                        "  vHitK1=1;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 380,
                    "Parent": -1,
                    "#": 64,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(vStateDom==3) {",
                        "  if(ShipInStar(Player(),Star1)) {",
                        "    ChangeState(6);",
                        "    exit;",
                        "  }",
                        "}",
                        "if(Hit(GroupToShip(BigShip))) {",
                        "  ShipOut();",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 100,
                    "Pos.y": 440,
                    "Parent": -1,
                    "#": 65,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(ItemIn(iOP,PelengSpy)) {",
                        "  ChangeState(7);",
                        "  exit;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 465,
                    "Parent": -1,
                    "#": 66,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(ShipInStar(CurShip,Star1)) {",
                        "  NoTargetToShip(CurShip,0);",
                        "  ShipOut();",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 190,
                    "Pos.y": 465,
                    "Parent": -1,
                    "#": 67,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(ShipInStar(CurShip,Star2)) {",
                        "  if(GroupToShip(BigShip))ShipOut(GroupToShip(BigShip));",
                        "  if(GroupToShip(SmallShip))",
                        "  \t{",
                        "  \tfor(i=GroupCount(SmallShip)-1;i>=0;i=i-1)ShipOut(GroupShip(SmallShip,i));",
                        "  \t}",
                        "  if(GroupToShip(BSB))ShipOut(GroupToShip(BSB));",
                        "  if(GroupToShip(PelengSpy))",
                        "  \t{",
                        "  \tNoTargetToShip(GroupToShip(PelengSpy),0);",
                        "  \tShipOut(GroupToShip(PelengSpy));",
                        "  \t}",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 565,
                    "Parent": -1,
                    "#": 68,
                    "Code.Type": "Turn",
                    "Code": [
                        "SkipGreeting();",
                        "if(vStateDom==5) {",
                        "  Ether(4,'41DD73A2-7A71-4130-80C8-423E2CC022D0',Format(CT(\"Script.Mod_RevDominatorSpy.34\"),\"<0>\",Name(StarDom),\"<1>\",Name(GroupToShip(BigShip)),\"<2>\",90));",
                        "  DChange(7);",
                        "  exit;",
                        "}",
                        "if(vStateDom==0) {",
                        "  DChange(0);",
                        "  exit;",
                        "}",
                        "if(ItemIn(iOP,Player()) && vStateDom!=0) {",
                        "  if(vStateDom==3) {",
                        "    DChange(6);",
                        "    exit;",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 100,
                    "Pos.y": 565,
                    "Parent": -1,
                    "#": 69,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(vStateDom==1) {",
                        "  if(Hitpoints(CurShip)>=200) {",
                        "    DChange(1);",
                        "    exit;",
                        "  }",
                        "  if(Hitpoints(CurShip)<200) {",
                        "    DChange(2);",
                        "    exit;",
                        "  }",
                        "}"
                    ]
