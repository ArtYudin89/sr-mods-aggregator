            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 665,
                    "Parent": -1,
                    "#": 19,
                    "Code.Type": "Global",
                    "Code": [
                        "if(vDoctorGState==0) {",
                        "  if((CurTurn()+1)>900) {",
                        "    GRun();",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 665,
                    "Parent": -1,
                    "#": 20,
                    "Code.Type": "Init",
                    "Code": [
                        "vLastSBName=Name(GroupToShip(SBgro));",
                        "AddPlanetNews(Format(CT(\"Script.Mod_RevScientist.37\"),\"<0>\",vLastSBName,\"<1>\",Name(Star),\"<2>\",vNewSBName,\"<3>\",GalaxyMoney(2)));",
                        "SetName(GroupToShip(SBgro),CT(\"Script.Mod_RevScientist.36\"));"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 665,
                    "Parent": -1,
                    "#": 21,
                    "Code.Type": "Turn",
                    "Code": [
                        "vTimer=vTimer+1;",
                        "if(ShipInStar(Player(),Star)) {",
                        "  if(vState==0) {",
                        "    if(!ItemIn(iCapsuleP,SBgro)) {",
                        "      Ether(1,'8E4B1F72-8A0A-441E-9C5F-49AF80B98E36',Format(CT(\"Script.Mod_RevScientist.25\"),\"<0>\",vNewSBName));",
                        "    }",
                        "  }",
                        "}",
                        "if(vNews==0) {",
                        "  if(!CountIn(SBgro)) {",
                        "    AddPlanetNews(Format(CT(\"Script.Mod_RevScientist.38\"),\"<0>\",Name(Star),\"<1>\",vNewSBName));",
                        "    vNews=1;",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 295,
                    "Parent": -1,
                    "#": 37,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(vState==0) {",
                        "  if(vTimer>=10) {",
                        "    if(Dist(Player(),PlaceSB)>200) {",
                        "      DropScriptItem(CurShip,iCapsuleP);",
                        "      ShipDestroy(GroupToShip(SBgro));",
                        "    }",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 70,
                    "Pos.y": 295,
                    "Parent": -1,
                    "#": 38,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!ItemIn(iCapsuleP,GroupToShip(SBgro))) {",
                        "  ChangeState(2);",
                        "  exit;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 355,
                    "Parent": -1,
                    "#": 39,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!ItemExist(iCapsuleP)) {",
                        "  ShipOut();",
                        "  vDoctorGState=1;",
                        "  vState=1;",
                        "}",
                        "if(ItemIn(iCapsuleP,Player())) {",
                        "  ShipOut();",
                        "  vDoctorGState=1;",
                        "  vState=1;",
                        "}",
                        "if(ItemIn(iCapsuleP,War)) {",
                        "  vState=1;",
                        "  AllShipOut();",
                        "  vDoctorGState=1;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 160,
                    "Pos.y": 295,
                    "Parent": -1,
                    "#": 40,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(vState==2) {",
                        "  if(vTimer>=5) {",
                        "    Dialog(dDoctor,PBgr);",
                        "  }",
                        "}",
                        "if(vState==3) {",
                        "  i=CreateEquipment(t_Weapon6,1,GalaxyTechLevel(),PirateClan);",
                        "  ModuleToEquipment(FindBonusByName(CT(\"Script.Mod_RevScientist.40\")),i);",
                        "  SpecialToEquipment(FindBonusByCustomTag('DishotEnergy'),i);",
                        "  ItemSize(i,10);",
                        "  SetName(i,'<color=255,167,84>'+CT(\"Script.Mod_RevScientist.41\")+'</color>');",
                        "  AddItemToShip(GroupToShip(PBgr),i);",
                        "  LinkItemToScript(i,iFazer);",
                        "  DropScriptItem(CurShip,iFazer);",
                        "  ReleaseItemFromScript(iFazer);",
                        "  ReleaseItemFromScript(iCapsuleP);",
                        "  AllShipOut();",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 455,
                    "Parent": -1,
                    "#": 41,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(vTimer>=5) {",
                        "  if(vState==2) {",
                        "    DChange(4);",
                        "    exit;",
                        "  }",
                        "}",
                        "if(vState==1) {",
                        "  if(ItemIn(iCapsuleP,Player())) {",
                        "    SkipGreeting();",
                        "    DChange(0);",
                        "    exit;",
                        "  }",
                        "}"
                    ]
                },
