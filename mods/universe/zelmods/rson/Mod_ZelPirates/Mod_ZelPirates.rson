                    "Parent": -1,
                    "#": 12,
                    "Code.Type": "Init",
                    "Code": [
                        "level=GalaxyDiffLevels(0)/50;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 310,
                    "Parent": -1,
                    "#": 13,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(PirateWin()!=4&&PirateWin()!=3) {",
                        "  days=days+1;",
                        "  reload=exp((0.5-0.03*level)*ControlledSystems(2))/level;",
                        "  while(days>=reload){",
                        "    pirate=BuyWarrior(PlanetPirateClan(),100+40*level);",
                        "    random = Rnd(Maloc, Gaal);",
                        "    ShipPilotRace(pirate, random);",
                        "    ShipOwner(pirate, 7);",
                        "    ItemOwner(ShipItems(pirate, 0), random);",
                        "    hullSize=300+(20+3*level)*GalaxyTechLevel();",
                        "    hullSize=Rnd(0.9*hullSize,1.1*hullSize);",
                        "    for(i=0;i<10;i=i+1)",
                        "      ShipRefit(pirate,hullSize);",
                        "    Chameleon(pirate);",
                        "    ShipImproveItems(pirate,level);",
                        "    days=days-reload;",
                        "  }",
                        "}"
                    ]
                }
            ],
