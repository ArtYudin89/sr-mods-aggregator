                    "Code": [
                        "int threat = ThreatCalc(0, cur_ruin, ShipOwner(cur_ruin));",
                        "//Если попытка запугивания успешна",
                        "if(Rnd(1, 100, sqr(Id(cur_ruin) + 666)) <= threat)",
