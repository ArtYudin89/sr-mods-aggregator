                    "Code.Type": "Turn",
                    "Code": [
                        "if(PlayerHQMainArray['Mercs', 'PlanetsCount'] <= 1) tstr5 = '</color>' + CT('Script.Mod_ShuMercs.PlayerHQMercsDialog.DevelopedPlanet');",
                        "else tstr5 = '</color>' + CT('Script.Mod_ShuMercs.PlayerHQMercsDialog.DevelopedPlanets');",
