                        "    InjectAnswer('PlayerHQStrikeFire', Format(CT('Script.Mod_ShuMercs.PlayerHQStrikeDialog.PlayerToFire'), '<Name'+'>', tstr1), i);//Format(ShipName(cur_ship), PlayerHQMainArray['Main', 'OrganisationName'] + ' ', '', '')), i);",
