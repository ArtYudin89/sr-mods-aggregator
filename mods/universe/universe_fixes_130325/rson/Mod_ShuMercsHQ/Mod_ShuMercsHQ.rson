                        "        //Приоритеты:",
                        "        //1 - военные и флагманы",
                        "        //2 - прочие корабли",
                        "        //3 - станции",
                        "        //4 - любые корабли на планетах и нейтральных станциях",
                        "        if(ShipInNormalSpace(ship) && ShipTypeN(ship) == t_Warrior && obj_type != 5)",
                        "        {",
                        "            closest_dist = dist;",
                        "            target = ship;",
                        "        }",
                        "        else if(!target)",
                        "        {",
                        "            if(ShipInNormalSpace(ship) && obj_type != 5)",
                        "            {",
                        "                closest_dist = dist;",
                        "                target = ship;",
                        "            }",
                        "            else if(!target)",
                        "            {",
                        "                if(obj_type == 5)",
                        "                {",
                        "                    closest_dist = dist;",
                        "                    target = ship;",
                        "                }",
                        "                else if(!target)",
                        "                {",
                        "                    closest_dist = dist;",
                        "                    target = ship;",
                        "                }",
                        "            }",
                        "        }",
