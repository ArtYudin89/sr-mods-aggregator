                        "                else if(QuestTargetDialogCall == -1)",
                        "                {",
                        "                    tstr1 = '</color>' + Format(CT(ActiveQuestsHQArray[1, 3] + '.TargetTakeOffStart'), '<Ship'+'>', ShortName(cur_ship), '<TargetPlanet'+'>', Name(IdToPlanet(ActiveQuestsHQArray[1, 10])), '<TargetStar'+'>', Name(GalaxyStar(ActiveQuestsHQArray[1, 8] - 1)));",
                        "                    QuestTargetDialogCall = 0;",
                        "                }",
