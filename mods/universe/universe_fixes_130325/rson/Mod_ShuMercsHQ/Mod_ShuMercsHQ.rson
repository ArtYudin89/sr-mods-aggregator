                        "        InjectAnswer('PlayerHQMedicineTreat', Format(CT('Script.Mod_ShuMercs.PlayerHQMedicineDialog.TreatDisease'), '<Disease' + '>', CT('Illness.Illness.' + (i - 1) + '.Name')), i);",
                        "        check = check + 1;",
