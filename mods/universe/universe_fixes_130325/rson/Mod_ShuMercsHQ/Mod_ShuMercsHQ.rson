                        "        else InjectAnswer('PlayerMercsAttack', Format(CT('Script.Mod_ShuMercs.PlayerMercsTalks.PlayerCallForHelpWith'), '<TargetShip'+'>', Name(tarr1[i]) + '<Object=' + tarr1[i] + ',23,17,0>'), tarr1[i]);",
                        "    }",
                        "  }",
                        "  if((tint1 & 1)) {",
