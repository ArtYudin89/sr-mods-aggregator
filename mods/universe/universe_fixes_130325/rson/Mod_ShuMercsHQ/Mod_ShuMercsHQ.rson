                        "    //Сразу пропускаем все про-клановые и нейтральные корабли и станции",
                        "    int stand = ShipStanding(ship);",
                        "    if(stand != 0 && stand != 2 && stand != 3 && stand != 9) continue;",
                        "",
                        "    int obj_type = ObjectType(ship);",
