                    "Code": [
                        "dword cur_star = ShipStar(CurShip);",
                        "dword HQ = GroupToShip(PlayerHQ);",
                        "//Если штаб был уничтожен, делаем наёмника игрока фрилансером",
                        "if(!HQ || Hit(CurShip, 0))",
                        "{",
                        "    //Наёмник уходит из организации, поскольку на него совершил нападение игрок",
