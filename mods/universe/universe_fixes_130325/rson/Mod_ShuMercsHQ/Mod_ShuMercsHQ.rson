                        "    PlayerHQMainArray['Quests', 'GluonGunsQuestDialogStateSet'] = PlayerHQMainArray['Quests', 'GluonGunsQuestDialogStateSet'] + 2;",
                        "}",
                        "DChange(73);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 460,
                    "Pos.y": 2545,
