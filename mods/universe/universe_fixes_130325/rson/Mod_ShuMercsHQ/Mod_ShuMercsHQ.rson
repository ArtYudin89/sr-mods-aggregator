                        "                tstr1 = tstr1 + CT(\"Script.Mod_ShuMercsHQ.193\") + '<clr><clrEnd>' + CT(\"Script.Mod_ShuMercsHQ.193\") + Format(CT(ActiveQuestsHQArray[ActiveQuestHQ, 3] + '.QuestNoteSuccess'), '<TargetStar' + '>', Name(cur_star), '<Cost' + '>', ActiveQuestsHQArray[ActiveQuestHQ, 5], '255,240,100');",
