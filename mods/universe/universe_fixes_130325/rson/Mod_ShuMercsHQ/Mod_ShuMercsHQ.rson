                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 280,
                    "Pos.y": 2250,
                    "Parent": -1,
                    "#": 755,
                    "Code.Type": "Turn",
                    "Code": [
                        "for(int i = 0; i < GroupCount(PlayerMercsStrike); i = i + 1)",
                        "{",
                        "    dword merc = GroupShip(PlayerMercsStrike, i);",
                        "    tstr2 = CT('ShipType.TypeName.PlayerMerc') + ' <color=0,50,200>' + Format(Name(merc), PlayerHQMainArray['Main', 'OrganisationName'] + ' ', '', '') + '</color>';",
                        "    if(!StateIs(merc, 'SittingBaseState'))",
                        "    {",
                        "        tstr2 = DeleteTags(tstr2 + ' ' + CT('Script.Mod_ShuMercs.PlayerHQScienceDialog.ReliabilityImproveChooseShipNotHere'));",
                        "        AddDialogBlock(tstr2, 1);",
                        "    }",
                        "    else AddDialogBlock(tstr2, 0);",
                        "",
                        "    InjectAnswer('PlayerHQScienceRelImpChooseShip', tstr2, merc);",
                        "}",
                        "merc = GroupToShip(CruisersDefenders);",
                        "if(merc)",
                        "{",
                        "    tstr2 = CT('ShipType.TypeName.PlayerMercCruiser') + ' <color=0,50,200>' + Format(Name(merc), PlayerHQMainArray['Main', 'OrganisationName'] + ' ', '', '') + '</color>';",
                        "    if(!StateIs(merc, 'CruiserWaitState'))",
                        "    {",
                        "        tstr2 = DeleteTags(tstr2 + ' ' + CT('Script.Mod_ShuMercs.PlayerHQScienceDialog.ReliabilityImproveChooseShipNotHere'));",
                        "        AddDialogBlock(tstr2, 1);",
                        "    }",
                        "    else AddDialogBlock(tstr2, 0);",
                        "",
                        "    InjectAnswer('PlayerHQScienceRelImpChooseShip', tstr2, merc);",
                        "}",
                        "",
                        "tstr2 = '</color>' + CT('Script.Mod_ShuMercs.PlayerHQScienceDialog.ReliabilityImproveChooseShipOut');",
                        "DAdd(107);"
                    ]
                },
