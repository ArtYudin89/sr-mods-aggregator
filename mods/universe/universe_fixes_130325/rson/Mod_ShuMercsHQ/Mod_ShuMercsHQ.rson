                        "if(PlayerHQMainArray['Main', 'HQLevel'] < PlayerHQMainArray['Main', 'HQLevelMax']) tstr1 = tstr1 + CT(\"Script.Mod_ShuMercsHQ.193\") + CT('Script.Mod_ShuMercs.PlayerHQMercsDialog.RecruitmentInfo2');",
