                        "    cur_planet = IdToPlanet(GetData(1));",
                        "    if(ShipInNormalSpace(CurShip))",
                        "    {",
                        "        tdwd3 = PlanetToStar(cur_planet);",
                        "        if(cur_star == tdwd3)",
                        "        {",
                        "            //Если целевая система не захвачена",
                        "            if(StarOwner(tdwd3) != 1 && StarCustomFaction(tdwd3) == '')",
