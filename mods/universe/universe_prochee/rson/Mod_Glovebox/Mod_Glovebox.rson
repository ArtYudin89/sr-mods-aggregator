            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 5,
                    "Code.Type": "Global",
                    "Code": [
                        "if(!Player()) GRun(); else { if(ShipFindCustomShipInfoByType(Player(), 'GB_Off') < 0) GRun(); }"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 6,
                    "Code.Type": "Init",
                    "Code": [
                        "",
                        "// the look of the strip: _D (dark grey) under a DenUIRecolor colour theme, else the classic",
                        "// colours of the game; the themes are the mods DenUIRecolor<Colour>, not DenUIRecolor_<addon>",
                        "function GB_Theme()",
                        "{",
                        "result = '';",
                        "str gb_ml = CurrentMods(-1);",
                        "int gb_p = findsubstr(gb_ml, 'DenUIRecolor');",
                        "for(int gb_n = 0; gb_n < 40; gb_n = gb_n + 1)",
                        "{",
                        "    if(gb_p >= 0)",
                        "    {",
                        "        if(substr(gb_ml, gb_p + 12, 1) != '_') result = '_D';",
                        "        gb_p = findsubstr(gb_ml, 'DenUIRecolor', gb_p + 12);",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function GB_Key(str gb_c, int gb_i)",
                        "{",
                        "result = 'GB_' + gb_c + '_' + gb_i;",
                        "}",
                        "",
                        "function GB_Peek(str gb_c, int gb_i)",
                        "{",
                        "result = GetItemFromVault(GB_Key(gb_c, gb_i), 0);",
                        "}",
                        "",
                        "function GB_Weight(str gb_c, int gb_n)",
                        "{",
                        "result = 0;",
                        "for(int gb_i = 0; gb_i < gb_n; gb_i = gb_i + 1)",
                        "{",
                        "    dword gb_it = GB_Peek(gb_c, gb_i);",
                        "    if(gb_it) result = result + ItemSize(gb_it);",
                        "}",
                        "}",
                        "",
                        "function GB_Used(str gb_c, int gb_n)",
                        "{",
                        "result = 0;",
                        "for(int gb_i = 0; gb_i < gb_n; gb_i = gb_i + 1)",
                        "{",
                        "    if(GB_Peek(gb_c, gb_i)) result = result + 1;",
                        "}",
                        "}",
                        "",
                        "function GB_FreeSlot(str gb_c, int gb_n)",
                        "{",
                        "result = gb_n;",
                        "for(int gb_i = gb_n - 1; gb_i >= 0; gb_i = gb_i - 1)",
                        "{",
                        "    if(!GB_Peek(gb_c, gb_i)) result = gb_i;",
                        "}",
                        "}",
                        "",
                        "function GB_Lines(str gb_c, int gb_n)",
                        "{",
                        "result = '';",
                        "for(int gb_i = 0; gb_i < gb_n; gb_i = gb_i + 1)",
                        "{",
                        "    dword gb_it = GB_Peek(gb_c, gb_i);",
                        "    if(gb_it) result = result + Format(CT('Script.Mod_Glovebox.Line'), '<0'+'>', ItemFullName(gb_it), '<1'+'>', '' + ItemSize(gb_it), '');",
                        "}",
                        "}",
                        "",
                        "function GB_Box()",
                        "{",
                        "result = 0;",
                        "dword gb_me = Player();",
                        "for(int gb_i = ShipItems(gb_me) - 1; gb_i >= 0; gb_i = gb_i - 1)",
                        "{",
                        "    dword gb_it = ShipItems(gb_me, gb_i);",
                        "    if(gb_it)",
                        "    {",
                        "        if(UselessItemData(gb_it, 3) == 7071)",
                        "        {",
                        "            if(result)",
                        "            {",
                        "                GetItemFromShip(gb_me, gb_it);",
                        "                FreeItem(gb_it);",
                        "            }",
                        "            if(!result) result = gb_it;",
                        "        }",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function g_Sync(int gb_x)",
                        "{",
                        "result = 0;",
                        "dword gb_me = Player();",
                        "int gb_w = GB_Weight('GB', 18) + GB_Weight('FE', 3);",
                        "dword gb_b = GB_Box();",
                        "if(gb_w > 0)",
                        "{",
                        "    if(!gb_b)",
                        "    {",
                        "        gb_b = CreateQuestItem('GB_Box');",
                        "        NoDropItem(gb_b, 1);",
                        "        ItemCost(gb_b, 0);",
                        "        UselessItemData(gb_b, 3, 7071);",
                        "        AddItemToShip(gb_me, gb_b);",
                        "        result = 1;",
                        "    }",
                        "    if(ItemSize(gb_b) != gb_w) result = 1;",
                        "    ItemSize(gb_b, gb_w);",
                        "    UselessItemData(gb_b, 1, gb_w);",
                        "    str gb_t = CT('Script.Mod_Glovebox.BoxText') + GB_Lines('GB', 6);",
                        "    str gb_f = GB_Lines('FE', 3);",
                        "    if(gb_f != '') gb_t = gb_t + CT('Script.Mod_Glovebox.BoxFE') + gb_f;",
                        "    UselessItemText(gb_b, gb_t);",
                        "}",
                        "if(gb_w <= 0)",
                        "{",
                        "    if(gb_b)",
                        "    {",
                        "        GetItemFromShip(gb_me, gb_b);",
                        "        FreeItem(gb_b);",
                        "        result = 1;",
                        "    }",
                        "}",
                        "ShipCalcParam(gb_me);",
                        "}",
                        "",
                        "function GB_Check(dword gb_it)",
                        "{",
                        "result = '';",
                        "if(UselessItemData(gb_it, 3) == 7071) result = 'NoSelf';",
                        "if(result == '' && ItemType(gb_it) == 42) result = 'NoHull';",
                        "if(result == '' && ItemInScript(gb_it) == 1) result = 'NoQuest';",
                        "}",
                        "",
                        "function g_Slot(int gb_i)",
                        "{",
                        "result = 0;",
                        "dword gb_me = Player();",
                        "if(FormCurShip() == gb_me)",
                        "{",
                        "    int gb_k = FormShipCurItem('MoveType');",
                        "    if(gb_k == 1) MessageBox(CT('Script.Mod_Glovebox.NoGoods'));",
                        "    if(gb_k >= 2)",
                        "    {",
                        "        dword gb_it = FormShipCurItem();",
                        "        str gb_m = GB_Check(gb_it);",
                        "        dword gb_old = GB_Peek('GB', gb_i);",
                        "        ShipCalcParam(gb_me);",
                        "        int gb_need = ItemSize(gb_it);",
                        "        if(gb_old) gb_need = gb_need - ItemSize(gb_old);",
                        "        if(gb_m == '' && gb_need > 0 && ShipFreeSpace(gb_me) < gb_need) gb_m = 'NoSpace';",
                        "        if(gb_m == '' && gb_old)",
                        "        {",
                        "            gb_old = GetItemFromVault(GB_Key('GB', gb_i));",
                        "            dword gb_c = FormShipCurItem('Replace', gb_old);",
                        "            PutItemInVault(GB_Key('GB', gb_i), gb_c);",
                        "            g_Sync(0);",
                        "            result = 1;",
                        "        }",
                        "        if(gb_m == '' && !gb_old)",
                        "        {",
                        "            dword gb_d = FormShipCurItem('Detach');",
                        "            if(gb_d)",
                        "            {",
                        "                PutItemInVault(GB_Key('GB', gb_i), gb_d);",
                        "                g_Sync(0);",
                        "                result = 1;",
                        "            }",
                        "        }",
                        "        if(gb_m != '') MessageBox(CT('Script.Mod_Glovebox.' + gb_m));",
                        "    }",
                        "    if(gb_k == 0)",
                        "    {",
                        "        dword gb_o = GetItemFromVault(GB_Key('GB', gb_i));",
                        "        if(gb_o)",
                        "        {",
                        "            AddItemToShip(gb_me, gb_o);",
                        "            g_Sync(0);",
                        "            result = 1;",
                        "        }",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function g_Paint(int gb_x)",
                        "{",
                        "for(int gb_i = 0; gb_i < 6; gb_i = gb_i + 1)",
                        "{",
                        "    dword gb_it = GB_Peek('GB', gb_i);",
                        "    if(gb_it)",
                        "    {",
                        "        InterfaceImage('Ship', 'GB_I' + gb_i, 'GI,' + EquipmentImageName('GetImagePath', gb_it) + 's');",
                        "        InterfaceState('Ship', 'GB_I' + gb_i, 1);",
                        "    }",
                        "    if(!gb_it) InterfaceState('Ship', 'GB_I' + gb_i, 0);",
                        "}",
                        "}",
                        "",
                        "function GB_Legacy()",
                        "{",
                        "dword gb_me = Player();",
                        "for(int gb_i = 6; gb_i < 18; gb_i = gb_i + 1)",
                        "{",
                        "    dword gb_it = GB_Peek('GB', gb_i);",
                        "    if(gb_it)",
                        "    {",
                        "        gb_it = GetItemFromVault(GB_Key('GB', gb_i));",
                        "        int gb_s = GB_FreeSlot('GB', 6);",
                        "        if(gb_s < 6) PutItemInVault(GB_Key('GB', gb_s), gb_it);",
                        "        if(gb_s >= 6) AddItemToShip(gb_me, gb_it);",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function GB_PGet(str gb_t, int gb_k)",
                        "{",
                        "result = 0;",
                        "if(ShipFindCustomShipInfoByType(Player(), gb_t) != -1) result = ShipCustomShipInfoData(Player(), gb_t, gb_k);",
                        "}",
                        "",
                        "function GB_PSet(str gb_t, int gb_k, int gb_v)",
                        "{",
                        "if(ShipFindCustomShipInfoByType(Player(), gb_t) == -1) ShipAddCustomShipInfo(Player(), gb_t);",
                        "ShipCustomShipInfoData(Player(), gb_t, gb_k, gb_v);",
                        "}",
                        "",
                        "function GB_PC(int gb_j)",
                        "{",
                        "result = 'GB';",
                        "if(gb_j >= 6) result = 'FE';",
                        "}",
                        "",
                        "function GB_PI(int gb_j)",
                        "{",
                        "result = gb_j;",
                        "if(gb_j >= 6) result = gb_j - 6;",
                        "}",
                        "",
                        "function GB_RGet(int gb_j)",
                        "{",
                        "result = GB_PGet('GB_Rem' + (1 + int(gb_j / 3)), 1 + gb_j - int(gb_j / 3) * 3);",
                        "}",
                        "",
                        "function GB_RSet(int gb_j, int gb_v)",
                        "{",
                        "GB_PSet('GB_Rem' + (1 + int(gb_j / 3)), 1 + gb_j - int(gb_j / 3) * 3, gb_v);",
                        "}",
                        "",
                        "function GB_Find(int gb_id)",
                        "{",
                        "result = 0;",
                        "dword gb_me = Player();",
                        "for(int gb_i = 0; gb_i < ShipItems(gb_me); gb_i = gb_i + 1)",
                        "{",
                        "    dword gb_it = ShipItems(gb_me, gb_i);",
                        "    if(gb_it)",
                        "    {",
                        "        if(Id(gb_it) == gb_id) result = gb_it;",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function g_Sets(int gb_x)",
                        "{",
                        "result = 0;",
                        "dword gb_me = Player();",
                        "int gb_s = PlayerEqSet();",
                        "int gb_last = GB_PGet('GB_Sets', 1);",
                        "if(gb_s != gb_last)",
                        "{",
                        "    GB_PSet('GB_Sets', 1, gb_s);",
                        "    int gb_on = 1;",
                        "    if(gb_last <= 0) gb_on = 0;",
                        "    if(gb_on)",
                        "    {",
                        "        for(int gb_i = 0; gb_i < ShipItems(gb_me); gb_i = gb_i + 1)",
                        "        {",
                        "            dword gb_x2 = ShipItems(gb_me, gb_i);",
                        "            if(gb_x2)",
                        "            {",
                        "                if(ItemIsInUse(gb_x2) && ItemIsInSet(gb_x2, gb_last) == 1 && ItemIsInSet(gb_x2, gb_s) == 0) gb_on = 0;",
                        "            }",
                        "        }",
                        "    }",
                        "    for(int gb_j = 0; gb_j < 9; gb_j = gb_j + 1)",
                        "    {",
                        "        int gb_id = GB_RGet(gb_j);",
                        "        if(gb_id)",
                        "        {",
                        "            dword gb_r = GB_Find(gb_id);",
                        "            if(!gb_r) GB_RSet(gb_j, 0);",
                        "            if(gb_r)",
                        "            {",
                        "                if(!ItemIsInUse(gb_r) && !GB_Peek(GB_PC(gb_j), GB_PI(gb_j)))",
                        "                {",
                        "                    GetItemFromShip(gb_me, gb_r);",
                        "                    PutItemInVault(GB_Key(GB_PC(gb_j), GB_PI(gb_j)), gb_r);",
                        "                    GB_RSet(gb_j, 0);",
                        "                    result = 1;",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "    if(gb_on)",
                        "    {",
                        "        int gb_pull = 0;",
                        "        for(int gb_j2 = 0; gb_j2 < 9; gb_j2 = gb_j2 + 1)",
                        "        {",
                        "            dword gb_p = GB_Peek(GB_PC(gb_j2), GB_PI(gb_j2));",
                        "            if(gb_p)",
                        "            {",
                        "                if(ItemIsInSet(gb_p, gb_s) == 1)",
                        "                {",
                        "                    gb_p = GetItemFromVault(GB_Key(GB_PC(gb_j2), GB_PI(gb_j2)));",
                        "                    AddItemToShip(gb_me, gb_p);",
                        "                    GB_RSet(gb_j2, Id(gb_p));",
                        "                    gb_pull = 1;",
                        "                }",
                        "            }",
                        "        }",
                        "        if(gb_pull)",
                        "        {",
                        "            PlayerEqSet(gb_s, 2);",
                        "            result = 1;",
                        "        }",
                        "    }",
                        "    if(result)",
                        "    {",
                        "        g_Sync(0);",
                        "        g_Paint(0);",
                        "        RunFunctionFromScript('Mod_ForsageBay', 'Paint', 0);",
                        "        if(CurrentForm() == 'Ship') UpdateFormShip();",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function g_Form(int gb_x)",
                        "{",
                        "dword gb_me = Player();",
                        "if(CurrentForm() == 'Ship')",
                        "{",
                        "    int gb_own = 0;",
                        "    if(FormCurShip() == gb_me) gb_own = 1;",
                        "    InterfaceState('Ship', 'GB_Strip', gb_own);",
                        "    if(gb_own) InterfaceImage('Ship', 'GB_StripImg', 'GI,Bm.GB.Strip' + GB_Theme());",
                        "    if(gb_own)",
                        "    {",
                        "        GB_Legacy();",
                        "        g_Sync(0);",
                        "        g_Paint(0);",
                        "    }",
                        "    if(gb_own) g_Sets(0);",
                        "}",
                        "}",
                        "",
                        "// NANITOIDS (the user, 2026-10-08): the game repairs one ship item a day per active nanitoid",
                        "// artefact (TShip.ApplyNanoArtefactRepair: an item of a repairable type at 60 percent or less",
                        "// the ranger can repair, fitted first, then the hold; + kArtefactNano, + kArtefactNanoEx when",
                        "// boosted, divided by the maker race EquipmentDurabilityFactor).  The vault is not on the ship,",
                        "// so the game never picks it: here the glovebox places and the afterburner bay of ForsageBay",
                        "// get the repair on the days the ship has nothing for it.  That repair of the day is over",
                        "// before phase 11, so it is judged by the count at the end of the previous day: GB_Nano Data 1",
                        "// = 1 + that count, 0 not counted yet.",
                        "",
                        "// a type the nanitoids repair (RepairableTypes: 0..79 without the goods 0..7, 9, 23..25,",
                        "// 35..38, the hull 42, 69..72, 74..79)",
                        "function GB_NanoType(int gb_t)",
                        "{",
                        "result = 0;",
                        "if(gb_t >= 8 && gb_t <= 79) result = 1;",
                        "if(gb_t == 9 || gb_t == 42) result = 0;",
                        "if(gb_t >= 23 && gb_t <= 25) result = 0;",
                        "if(gb_t >= 35 && gb_t <= 38) result = 0;",
                        "if(gb_t >= 69 && gb_t <= 72) result = 0;",
                        "if(gb_t >= 74) result = 0;",
                        "}",
                        "",
                        "function GB_NanoWants(dword gb_me, dword gb_it)",
                        "{",
                        "result = 0;",
                        "if(gb_it)",
                        "{",
                        "    if(GB_NanoType(ItemType(gb_it)))",
                        "    {",
                        "        if(ItemDurability(gb_it) <= 60 && ShipCanRepairEq(gb_me, gb_it) == 1) result = 1;",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function GB_NanoCount()",
                        "{",
                        "result = 0;",
                        "dword gb_me = Player();",
                        "for(int gb_i = 0; gb_i < ShipItems(gb_me); gb_i = gb_i + 1)",
                        "{",
                        "    result = result + GB_NanoWants(gb_me, ShipItems(gb_me, gb_i));",
                        "}",
                        "for(int gb_j = 0; gb_j < ShipArts(gb_me); gb_j = gb_j + 1)",
                        "{",
                        "    result = result + GB_NanoWants(gb_me, ShipArts(gb_me, gb_j));",
                        "}",
                        "}",
                        "",
                        "// the more worn of two candidates (either may be 0)",
                        "function GB_NanoWorse(dword gb_me, dword gb_w, dword gb_e)",
                        "{",
                        "result = gb_w;",
                        "if(GB_NanoWants(gb_me, gb_e))",
                        "{",
                        "    if(!gb_w) result = gb_e;",
                        "    if(gb_w)",
                        "    {",
                        "        if(ItemDurability(gb_e) < ItemDurability(gb_w)) result = gb_e;",
                        "    }",
                        "}",
                        "}",
                        "",
                        "// one repair by one nanitoid: the most worn item of the vault at 60 percent or less",
                        "function GB_NanoFix()",
                        "{",
                        "result = 0;",
                        "dword gb_me = Player();",
                        "dword gb_w = 0;",
                        "for(int gb_i = 0; gb_i < 6; gb_i = gb_i + 1)",
                        "{",
                        "    gb_w = GB_NanoWorse(gb_me, gb_w, GB_Peek('GB', gb_i));",
                        "}",
                        "for(int gb_f = 0; gb_f < 3; gb_f = gb_f + 1)",
                        "{",
                        "    gb_w = GB_NanoWorse(gb_me, gb_w, GB_Peek('FE', gb_f));",
                        "}",
                        "if(gb_w)",
                        "{",
                        "    float gb_k = 1.0;",
                        "    int gb_o = ItemOwner(gb_w);",
                        "    if(gb_o == 0) gb_k = 0.7;",
                        "    if(gb_o == 1) gb_k = 0.9;",
                        "    if(gb_o == 3) gb_k = 1.15;",
                        "    if(gb_o == 4) gb_k = 1.3;",
                        "    str gb_a = CT('Artefacts.NumericValues.kArtefactNano');",
                        "    int gb_add = 0;",
                        "    if(gb_a != '') gb_add = 0 + gb_a;",
                        "    if(ArtefactTypeBoosted(gb_me, 17))",
                        "    {",
                        "        str gb_b = CT('Artefacts.NumericValues.kArtefactNanoEx');",
                        "        int gb_bx = 0;",
                        "        if(gb_b != '') gb_bx = 0 + gb_b;",
                        "        gb_add = gb_add + gb_bx;",
                        "    }",
                        "    int gb_was = ItemDurability(gb_w);",
                        "    int gb_now = gb_was + round(1.0 * gb_add / gb_k);",
                        "    if(gb_now > 100) gb_now = 100;",
                        "    ItemDurability(gb_w, gb_now);",
                        "    if(gb_was <= 0 && gb_now > 0)",
                        "    {",
                        "        Ether(2, '', Format(CT('Artefacts.ArtNano.RepairItem'), '<Name>', '<color=255,240,100>' + ItemName(gb_w) + '</color>', ''), gb_me);",
                        "    }",
                        "    result = 1;",
                        "}",
                        "}",
                        "",
                        "// from GB_Nano at phase 11 of the day (and for the tests)",
                        "function g_Nano(int gb_x)",
                        "{",
                        "result = 0;",
                        "dword gb_me = Player();",
                        "if(ShipFindCustomShipInfoByType(gb_me, 'GB_Nano') < 0) ShipAddCustomShipInfo(gb_me, 'GB_Nano');",
                        "int gb_prev = ShipCustomShipInfoData(gb_me, 'GB_Nano', 1);",
                        "int gb_n = ArtefactTypeInUse(gb_me, 17);",
                        "if(gb_prev == 1 && gb_n > 0)",
                        "{",
                        "    for(int gb_i = 0; gb_i < gb_n; gb_i = gb_i + 1)",
                        "    {",
                        "        result = result + GB_NanoFix();",
                        "    }",
                        "}",
                        "ShipCustomShipInfoData(gb_me, 'GB_Nano', 1, 1 + GB_NanoCount());",
                        "}",
                        "",
                        "function g_NanoCount(int gb_x)",
                        "{",
                        "result = GB_NanoCount();",
                        "}",
                        "",
                        "function g_Off(int gb_x)",
                        "{",
                        "result = 0;",
                        "dword gb_me = Player();",
                        "for(int gb_i = 0; gb_i < 18; gb_i = gb_i + 1)",
                        "{",
                        "    dword gb_e = GetItemFromVault('GB_GB_' + gb_i);",
                        "    if(gb_e)",
                        "    {",
                        "        AddItemToShip(gb_me, gb_e);",
                        "        result = result + 1;",
                        "    }",
                        "}",
                        "int gb_fe = IsScriptActive('Mod_ForsageBay');",
                        "if(ShipFindCustomShipInfoByType(gb_me, 'FE_Off') >= 0) gb_fe = 0;",
                        "for(int gb_j = 0; gb_j < 3 && !gb_fe; gb_j = gb_j + 1)",
                        "{",
                        "    dword gb_f = GetItemFromVault('GB_FE_' + gb_j);",
                        "    if(gb_f)",
                        "    {",
                        "        AddItemToShip(gb_me, gb_f);",
                        "        result = result + 1;",
                        "    }",
                        "}",
                        "for(int gb_k = ShipItems(gb_me) - 1; gb_k >= 0; gb_k = gb_k - 1)",
                        "{",
                        "    dword gb_b = ShipItems(gb_me, gb_k);",
                        "    if(gb_b)",
                        "    {",
                        "        if(UselessItemData(gb_b, 3) == 7071)",
                        "        {",
                        "            dword gb_g = GetItemFromShip(gb_me, gb_b);",
                        "            if(gb_g) FreeItem(gb_g);",
                        "        }",
                        "    }",
                        "}",
                        "ShipCalcParam(gb_me);",
                        "if(ShipFindCustomShipInfoByType(gb_me, 'GB_Hook') >= 0) ShipDeleteCustomShipInfo(gb_me, 'GB_Hook');",
                        "if(ShipFindCustomShipInfoByType(gb_me, 'GB_Sets') >= 0) ShipDeleteCustomShipInfo(gb_me, 'GB_Sets');",
                        "if(ShipFindCustomShipInfoByType(gb_me, 'GB_Nano') >= 0) ShipDeleteCustomShipInfo(gb_me, 'GB_Nano');",
                        "if(ShipFindCustomShipInfoByType(gb_me, 'GB_Off') < 0) ShipAddCustomShipInfo(gb_me, 'GB_Off');",
                        "AllShipOut();",
                        "}",
                        "",
                        "function GB_NotMe()",
                        "{",
                        "if(GB_Me == 0) GB_Me = Rnd(1, 1000000000);",
                        "result = 0;",
                        "if(GetValueFromScript('Mod_Glovebox', 'GB_Me') != GB_Me) result = 1;",
                        "}",
                        "",
                        "function GB_Dedup()",
                        "{",
                        "result = GB_NotMe();",
                        "if(result) AllShipOut();",
                        "}"
                    ]
                },
