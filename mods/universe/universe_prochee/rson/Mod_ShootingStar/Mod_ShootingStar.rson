                    "Code.Type": "Init",
                    "Code": [
                        "function PlayerActCode() //t_OnPlayerChangeHull",
                        "{",
                        "    dword new_hull = ScriptItemActObject1();",
                        "    dword old_hull = ScriptItemActObject2();",
                        "    int to_add_shots = FindBonusByNameInCfg('ShootingStar_ExtraShot');",
                        "    to_add_shots = ItemExtraSpecialsCountByType(new_hull, to_add_shots) - ItemExtraSpecialsCountByType(old_hull, to_add_shots);",
                        "    if(to_add_shots) ShipSpecialBonuses(FormCurShip(), bonAttacks, ShipSpecialBonuses(FormCurShip(), bonAttacks) + to_add_shots);",
                        "}"
                    ]
                }
