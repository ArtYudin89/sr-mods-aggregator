                        "  }",
                        "  ",
                        "  daysAtt = daysAtt + ((10.0 + 1.0 * GroupCount(domiks) - 1.0 * GroupCount(domiks) * (bonusGlobal == 3) * 0.33) * 0.2) / ((1.0 + 0.3 * ControlledSystems(0)) * (1.0 + 1.0 * GalaxyDiffLevels() / 1000));",
                        "  if (ShipFindCustomShipInfoByType(Player(), 'Beacon1') != -1) {",
                        "    daysAtt = 0;",
                        "    targetStar = GalaxyStar(ShipCustomShipInfoData(Player(), 'Beacon1', 1));",
                        "    ShipDeleteCustomShipInfo(Player(), 'Beacon1');",
                        "    StartAttackSystem(targetStar);",
                        "  } else if (daysAtt >= 120 + 30 * (bonusGlobal == 1)) {",
                        "    daysAtt = 0;",
                        "    targetStar = GiveAttackStar();",
                        "    if (targetStar != -1)",
                        "      StartAttackSystem(targetStar);",
                        "    else",
                        "      daysAtt = 0 - GroupCount(domiks) * 10;",
                        "  }",
                        "  ",
                        "  bossShip = IdToShip(bossId);",
                        "  if (!bossShip) {",
                        "    daysBuildBoss = daysBuildBoss - 1;",
                        "    if (daysBuildBoss <= 0) {",
                        "      daysBuildBoss = 100 + GalaxyDiffLevels() / 2;",
                        "      if (bonusBoss == 0)",
                        "        SpawnBoss();",
                        "      else if (bonusBoss == 1){",
                        "        SpawnBossBlazer();",
                        "        daysBuildBoss=daysBuildBoss/2;",
                        "      }",
                        "      else if (bonusBoss == 2)",
                        "        SpawnBossKeller();",
                        "      else if (bonusBoss == 3)",
                        "        SpawnBossTerron();",
                        "    }",
                        "  }",
                        "  ",
                        "  if (domLevel < 10) {",
                        "    if (itemsForResearch < 300)",
                        "      ourItemsForResearch = itemsForResearch;",
                        "    else",
                        "      ourItemsForResearch = 300;",
                        "    speedResearch = (75.0 + ourItemsForResearch) / 375 * (0.18 - 0.014 * difficultOfResearch) * (1.0 + 0.2 * (bonusGlobal == 2));",
                        "    int destroyItemsForResearch = Rnd(0.4 * difficultOfResearch + 1, 1.2 * difficultOfResearch + 2);",
                        "    if (domLevel < 10)",
                        "      daysForResearch = (1.0 * Research[domLevel] - researched) / speedResearch;",
                        "    else",
                        "      daysForResearch = 0;",
                        "    if (daysForResearch > 0) {",
                        "      if (itemsForResearch > destroyItemsForResearch)",
                        "        itemsForResearch = itemsForResearch - destroyItemsForResearch;",
                        "      else if (itemsForResearch <= destroyItemsForResearch)",
                        "        itemsForResearch = 0;",
                        "      researched = researched + speedResearch;",
                        "    } else if (completeEther == 0) {",
                        "      CustomEther('BlazerEther', 7, '', 'Ученые Коалиции закончили свои исследования в области доминаторов Блазера. Для получения более подробной информации обратитесь к Блазеру.');",
                        "      completeEther = 1;",
                        "    }",
                        "  }",
                        "  ",
                        "  playerShip = Player();",
                        "  if (ShipInNormalSpace(playerShip) && Id(ShipItems(playerShip, 0)) == bertorHullId) {",
                        "    star = ShipStar(playerShip);",
                        "    cShips = StarShips(star);",
                        "    ourPlanet = IdToPlanet(planetId);",
                        "    power = (1.0 + 0.03 * (bonusAdd == 3) * curDomLevel) * HullSizeMax[5];",
                        "    for (i = 0; i <= cShips; i = i + 1) {",
                        "      thisShip = StarShips(star, i);",
                        "      if (ShipInNormalSpace(thisShip)) {",
                        "        if (thisShip != playerShip && HullHP(thisShip) <= power && Dist(playerShip, thisShip) <= 500 && GetRelationPlanet(ourPlanet, thisShip) > 30) {",
                        "          if (bonusAdd == 1)",
                        "            ShipAddCustomShipInfo(thisShip, 'DrKles_DomInfo', 'NoShow');",
                        "          else if (bonusAdd == 2)",
                        "            ShipAddCustomShipInfo(thisShip, 'DrKles_DomInfo', 'NoShow');",
                        "          else if (bonusAdd == 3)",
                        "            ShipAddCustomShipInfo(thisShip, 'DrKles_DomInfo', 'NoShow');",
                        "          else",
                        "            ShipAddCustomShipInfo(thisShip, 'DrKles_DomInfo', 'NoShow');",
                        "        }",
                        "      }",
                        "    }",
                        "    ShipCustomShipInfoData(playerShip, 'DrKles_BertorsAura', 1, 0);",
                        "    int numOfKligs = ShipCustomShipInfoData(playerShip, 'DrKles_BertorsAura', 2);",
                        "    if (Rnd(1, 10 + 2 * ((bonusDomiks == 3) + (bonusGlobal == 3))) > (5 - numOfKligs + (bonusDomiks == 3) + (bonusGlobal == 3))) {",
                        "      while (numOfKligs < 5 + (bonusDomiks == 3) + (bonusGlobal == 3)) {",
                        "        SpawnKlig(Id(playerShip));",
                        "        numOfKligs = numOfKligs + 1;",
                        "      }",
                        "      ShipCustomShipInfoData(playerShip, 'DrKles_BertorsAura', 2, 5 + (bonusDomiks == 3) + (bonusGlobal == 3));",
                        "    }",
                        "  }",
                        "  ",
                        "  if (!IdToShip(DBId)) {",
                        "    bossShip = IdToShip(bossId);",
                        "    if (bossShip)",
                        "      ShipDestroy(bossShip, 1);",
                        "    for (i = 0; i < GroupCount(bertors); i = i + 1)",
                        "      ShipDestroy(GroupShip(bertors, i), 1);",
                        "    for (i = 0; i < GroupCount(kligs); i = i + 1)",
                        "      ShipDestroy(GroupShip(kligs, i), 1);",
                        "    for (i = 0; i < GroupCount(domiks); i = i + 1)",
                        "      ShipDestroy(GroupShip(domiks, i), 1);",
                        "    for (i = 0; i < GroupCount(domiksBes); i = i + 1)",
                        "      ShipDestroy(GroupShip(domiksBes, i), 1);",
                        "    for (i = 0; i < GroupCount(freeGroup); i = i + 1)",
                        "      ShipDestroy(GroupShip(freeGroup, i), 1);",
                        "    isStartedDomiks = 0;",
                        "  /*  bonusGlobal=-1;",
                        "    bonusBoss=Rnd(1,3);",
                        "    bonusDomiks=-1;",
                        "    bonusAdd=0;*/",
                        "    CustomEther('BlazerEther', 7, '', 'База Доминаторов уничтожена. Все корабли доминаторов Коалиции, включая Блазера, получили приказ немедленного самоуничтожения для предотвращения сбоя в программе.');",
                        "  }",
                        "}",
                        "if(DomiksDefeated(0) == 3 && Blazer_msg == 0) {",
                        "  NamePlayer=Name(Player());",
                        "  CustomEther('BlazerEther', 7, '', Format('Уважаемый <0>! Научный отдел, который занимался разработкой антидоминаторской программы Противодействие, благодарит вас за то, что вы смогли сохранить в целости мозговой центр блазероидов и даже посадить его на планету. Благодаря вам у нас теперь есть возможность приблизиться к пониманию того, как устроены наши враги, что поможет Коалиции победить в этой кровопролитной войне. По возможности просим вас явиться на любую научную базу для обсуждения важной темы, касаемо будущей судьбы Блазера.',\"<0>\",NamePlayer));",
                        "  Blazer_msg=1;",
                        "}",
                        "if(robotsReady==1) {",
                        "  if(GRobotStatus==2)",
                        "    robotsReady=3;",
                        "  else",
                        "    robotsReady=2;",
                        "}",
                        "if (timer_nachalo == 1)",
                        "{",
                        "    timer_sovet=timer_sovet+1;",
                        "}",
                        "if (ShipRank(Player()) == 2)",
                        "{",
                        "    MyDOPmoney=8000;",
                        "}",
                        "if (ShipRank(Player()) == 3)",
                        "{",
                        "    MyDOPmoney=16000;",
                        "}",
                        "if (ShipRank(Player()) == 4)",
                        "{",
                        "    MyDOPmoney=32000;",
                        "}",
                        "if (ShipRank(Player()) == 5)",
                        "{",
                        "    MyDOPmoney=64000;",
                        "}",
                        "if (ShipRank(Player()) == 6)",
                        "{",
                        "    MyDOPmoney=128000;",
                        "}",
                        "if (ShipRank(Player()) == 7)",
                        "{",
                        "    MyDOPmoney=256000;",
                        "}",
                        "if(timer_sovet>30 && timer_nachalo == 1) {",
                        "  bankPlayer=bankPlayer+MyDOPmoney;",
                        "  timer_sovet=0;",
                        "}",
                        "if(domLevel==8&&completeTask==2&&doneMissions[4]==2) {",
                        "  m8GaalDays=m8GaalDays-1;",
                        "  if(m8GaalDays==0){",
                        "    doneMissions[4]=3;",
                        "    missionsStrings[4]=Format('ждет вас на планете <0>.',\"<0>\",PlanetName(IdToPlanet(idPlanetsMissions[4])));",
                        "  }",
                        "}",
                        "if(domLevel==8&&completeTask==2&&doneMissions[0]==2) {",
                        "  m8MalDays=m8MalDays-1;",
                        "  if(m8MalDays==0){",
                        "    doneMissions[0]=3;",
                        "    missionsStrings[0]=Format('ждет вас на планете <0>.',\"<0>\",PlanetName(IdToPlanet(idPlanetsMissions[0])));",
                        "  }",
                        "  else if(StarOwner(PlanetToStar(IdToPlanet(idPlanetsMissions[0]))) != 0){",
                        "    completeTask=0;",
                        "    Ether(5,'DrKlesQuest','Вы не выполнили условие Борфорса и он отказывается идти с вами на сделку. Задание провалено.');",
                        "  }",
                        "}",
                        "if(domLevel==8&&completeTask==2&&doneMissions[3]==2) {",
                        "  if(!IdToItem(idFean)){",
                        "    completeTask=0;",
                        "    Ether(5,'DrKlesQuest','Кто-то уничтожил капсулу с Абером. Задание провалено.');",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 1795,
                    "Parent": -1,
                    "#": 139,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "dword playerShip = Player();",
                        "dword planet = GetShipPlanet(Player());",
                        "dword shipRuins=GetShipRuins(playerShip);",
                        "if (isStartedDomiks==1) {",
                        "  if (shipRuins) {",
                        "    if (ShipType(shipRuins) == 'DBB') {",
                        "      AddDialogInject('dBank', CT(\"Script.DrKles_Blazer.462\"), 'Пополнить баланс станции', 1, 1);",
                        "      AddDialogInject('dMsgRank', CT(\"Script.DrKles_Blazer.408\"), 'Скажите, а какое количество средств вам выделяет Совет Коалиции в зависимости от моего военного звания? ', 1, 1);",
                        "      AddDialogInject('dBlazzer', CT(\"Script.DrKles_Blazer.408\"), 'Так что там по поводу сувенира с Блазером?', 1, 1);",
                        "      if (domLevel < 10) {",
                        "        if (daysForResearch > 0)",
                        "          AddDialogInject('dUpgrade', '', 'Помочь исследованиям', 2);",
                        "        else",
                        "          AddDialogInject('dGetMission', '', 'Так что там с исследованиями?', 2);",
                        "        if (domLevel == 2 && completeTask == 2) {",
                        "          bool = 0;",
                        "          for (i = ShipItems(playerShip) - 1; !bool && i > 0; i = i - 1) {",
                        "            if (Id(ShipItems(playerShip, i)) == idUselessItem[0]) {",
                        "              AddDialogInject('d2MissionComplete', '', 'Сдать ошметки Бертора', 3);",
                        "              bool = 1;",
                        "              j = i;",
                        "            }",
                        "          }",
                        "        } else if (domLevel == 5 && completeTask == 2 && bonusAdd == 2) {",
                        "          bool = 0;",
                        "          for (i = ShipItems(playerShip) - 1; !bool && i > 0; i = i - 1) {",
                        "            for (j = 0; !bool && j < numItems; j = j + 1) {",
                        "              if (Id(ShipItems(playerShip, i)) == idUselessItem[j]) {",
                        "                bool = 1;",
                        "                AddDialogInject('d5MissionComplete', '', 'Сдать экземпляры пиратского устройства', 3);",
                        "              }",
                        "            }",
                        "          }",
                        "        } else if (domLevel == 8 && completeTask == 2 && doneMissions[3] == 2) {",
                        "          bool = 0;",
                        "          for (i = ShipItems(playerShip) - 1; !bool && i > 0; i = i - 1) {",
                        "            if (Id(ShipItems(playerShip, i)) == idFean) {",
                        "              AddDialogInject('d8MissionFeanCom', '', 'Отдать капсулу с Абером', 3);",
                        "              bool = 1;",
                        "              j = i;",
                        "            }",
                        "          }",
                        "        } else if (domLevel == 7 && completeTask == 2) {",
                        "          if (!robotsReady)",
                        "            AddDialogInject('dRobots', '', 'Участвовать в боевом состязании с Блазером', 3);",
                        "          else if (robotsReady == 2)",
                        "            AddDialogInject('dRobotsL', '', 'Я проиграл в состязании с Блазером', 3);",
                        "          else if (robotsReady == 3)",
                        "            AddDialogInject('dRobotsW', '', 'Я выиграл в состязании с Блазером', 3);",
                        "        } else if (domLevel == 9 && completeTask == 2 && bonusAdd == 1) {",
                        "          if (!robotsReady)",
                        "            AddDialogOverride('dRobotsF', 100);",
                        "          else if (robotsReady == 2)",
                        "            AddDialogOverride('dRobotsFL', 100);",
                        "          else if (robotsReady == 3)",
                        "            AddDialogOverride('dRobotsFW', 100);",
                        "        }",
                        "      }",
                        "    }",
                        "  }",
                        "  if (GetTalkShip() && !TalkByAI()) {",
                        "    dword bossShip = IdToShip(bossId);",
                        "    dword talkShip = GetTalkShip();",
                        "    int relations = GetRelationPlanet(IdToPlanet(planetId), playerShip);",
                        "    if (bossShip == talkShip) {",
                        "      if (!bossDialog) {",
                        "        AddDialogOverride('dDialogBossStart', 1);",
                        "      } else {",
                        "        if (relations > 30 && ShipGetBad(talkShip) != playerShip)",
                        "          AddDialogOverride('dDialogBoss', 1);",
                        "        else",
                        "          AddDialogOverride('dDialogBossA', 1);",
                        "      }",
                        "    } else if (ShipCustomFaction(talkShip) == 'SubFaction1.Blazer' && (ShipTypeN(talkShip) == 5||ShipTypeN(talkShip) == 2)) {",
                        "      if (relations > 30 && ShipGetBad(talkShip) != playerShip)",
                        "        AddDialogOverride('dDialogDom', 1);",
                        "      else",
                        "        AddDialogOverride('dDialogDomA', 1);",
                        "    }",
                        "  }",
                        "  if (domLevel == 8 && completeTask == 2 && planet) {",
                        "    for (i = 0; i < 5; i = i + 1) {",
                        "      if (planet == IdToPlanet(idPlanetsMissions[i])) {",
                        "        if (i == 0) {",
                        "          if (doneMissions[i] == 0)",
                        "            AddDialogInject('d8MissionMal', '', 'Это вы Борфорс?', 1);",
                        "          else if (doneMissions[i] == 3)",
                        "            AddDialogOverride('d8MissionMalW', 1);",
                        "        } else if (i == 1) {",
                        "          if (doneMissions[i] == 0)",
                        "            AddDialogInject('d8MissionPel', '', 'Это вы Кувард?', 1);",
                        "        } else if (i == 2) {",
                        "          if (doneMissions[i] == 0) {",
                        "            if (doneMissions[0] == 1 && doneMissions[1] == 1 && doneMissions[3] == 1 && doneMissions[4] == 1) {",
                        "              if (m8HumIs)",
                        "                AddDialogInject('d8MissionHumY', '', 'Ну так что, вы согласны с предложением Совета Коалиции?', 1);",
                        "              else",
                        "                AddDialogInject('d8MissionHum', '', 'Это вы Леонард?', 1);",
                        "            } else {",
                        "              if (m8HumIs)",
                        "                AddDialogInject('d8MissionHumNo', '', 'Ну так что, вы согласны с предложением Совета Коалиции?', 1);",
                        "              else",
                        "                AddDialogInject('d8MissionHumN', '', 'Это вы Леонард?', 1);",
                        "            }",
                        "          }",
                        "        } else if (i == 3) {",
                        "          if (doneMissions[i] == 0)",
                        "            AddDialogInject('d8MissionFean', '', 'Это вы Абер?', 1);",
                        "        } else {",
                        "          if (doneMissions[i] == 0)",
                        "            AddDialogInject('d8MissionGaal', '', 'Это вы Арту?', 1);",
                        "          else if (doneMissions[i] == 3)",
                        "            AddDialogOverride('d8MissionGaalW', 1);",
                        "        }",
                        "      }",
                        "    }",
                        "  }",
                        "}",
                        "else if (bonusGlobal == -1 && DomiksDefeated(0) == 3) {",
                        "  if (shipRuins) {",
                        "    if (ShipType(shipRuins) == 'SB') {",
                        "      if(SBDialog)",
                        "        AddDialogInject('dSB', '', 'Я хочу сдать вам ошметки доминаторов для работы над проектом, связанного с Блазером', 0);",
                        "      else",
                        "        AddDialogInject('dSBStart', '', 'После победы над Блазером меня попросили прилететь на любую научную базу, чтобы обсудить дальнейшую судьбу этого доминаторского мозгового центра', 100);",
                        "    }",
                        "  }",
                        "}",
                        "else if(bonusDomiks==-1){",
                        "  if (shipRuins) {",
                        "    if (ShipType(shipRuins) == 'DBB') {",
                        "      GotoGov(2);",
                        "      if(robotsReady==0)",
                        "        AddDialogOverride('dDBStart',100);",
                        "      else if(robotsReady==2)",
                        "        AddDialogOverride('dDBLose',100);",
                        "      else if(robotsReady==3)",
                        "        AddDialogOverride('dDBWin',100);",
                        "    }",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 660,
                    "Parent": -1,
                    "#": 572,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(ShipInNormalSpace(CurShip)) {",
                        "  potentialEnemy = 0;",
                        "  distance = 100000;",
                        "  star = ShipStar(CurShip);",
                        "  cShips=StarShips(star);",
                        "  ourPlanet=IdToPlanet(planetId);",
                        "  nearPlanet=NearCivilPlanet(CurShip);",
                        "  ",
                        "  for (i = 0; i <= cShips; i = i + 1) {",
                        "    thisShip = StarShips(star, i);",
                        "    if (ShipInNormalSpace(thisShip)) {",
                        "      bool=GetRelationPlanet(ourPlanet, thisShip) <= 30;",
                        "      if (bool && distance > Dist(CurShip, thisShip) && ShipTypeN(thisShip)!=2) {",
                        "        potentialEnemy = thisShip;",
                        "        distance = Dist(CurShip, thisShip);",
                        "      }",
                        "    }",
                        "  }",
                        "  if (potentialEnemy != 0)",
                        "    ShipSetBad(CurShip, potentialEnemy);",
                        "  OrderLock(CurShip,1);",
                        "  if(ShipGetBad(CurShip)==0&&GetData(1,CurShip)==10000) {",
                        "    int turnsForComplete=GetData(0, CurShip);",
                        "    if(ItemSize(ShipItems(CurShip,0))-HullHP(CurShip)>ShipDroidRepair(CurShip)*5)",
                        "      turnsForComplete=OrderLanding(CurShip,NearCivilPlanet(CurShip));",
                        "    else if (turnsForComplete < 1) {",
                        "      ugol = 0.01 * Rnd(0, 200);",
                        "      radius = PlanetOrbitRadius(StarPlanets(ShipStar(CurShip), 0)) + Rnd(-50, 100);",
                        "      x = round(sin(ugol * pi) * radius);",
                        "      y = round(cos(ugol * pi) * radius);",
                        "      OrderMove(CurShip, x, y);",
                        "      distance=round(sqrt(sqr(abs(CoordX(CurShip)-x))+sqr(abs(CoordY(CurShip)-y))));",
                        "      int ourShipSpeed=ShipSpeed(CurShip);",
                        "      turnsForComplete=distance/ourShipSpeed+(distance%ourShipSpeed!=0);",
                        "    }",
                        "    SetData(turnsForComplete - 1, 0, CurShip);",
                        "    if(bonusAdd==3&&!HullDamage(CurShip)){",
                        "      domType=ShipCustomShipInfoData(CurShip,'DrKles_DomInfo',1);",
                        "      int minHPShip=HullSizeMin[domType];",
                        "      int maxHPShip=HullSizeMax[domType];",
                        "      int HPForOurShip=Rnd((minHPShip/200*(7+curDomLevel))/15,(maxHPShip/150*(7+curDomLevel))/10);",
                        "      int hitpointsOfTheShip=HullHP(CurShip);",
                        "      if(hitpointsOfTheShip+HPForOurShip<minHPShip*2){",
                        "        ItemSize(ShipItems(CurShip, 0),hitpointsOfTheShip+HPForOurShip);",
                        "        HullHP(CurShip, hitpointsOfTheShip+HPForOurShip);",
                        "      }",
                        "      else{",
                        "        int sizeOfTheShip=max(GiveNeedSizeShip(CurShip),minHPShip);",
                        "        ItemSize(ShipItems(CurShip, 0),sizeOfTheShip);",
                        "        HullHP(CurShip, sizeOfTheShip);",
                        "        dom = SpawnDom(domType,0);",
                        "        sizeOfTheShip=max(GiveNeedSizeShip(dom),minHPShip);",
                        "        ItemSize(ShipItems(dom, 0),sizeOfTheShip);",
                        "        HullHP(dom, sizeOfTheShip);",
                        "        TransferShip(dom, ShipStar(CurShip));",
                        "        ShipSetCoords(dom, CoordX(CurShip), CoordY(CurShip));",
                        "        ShipAngle(dom,ShipAngle(CurShip));",
                        "        ugol = 0.01 * Rnd(0, 200);",
                        "        radius = Rnd(150, 250);",
                        "        x = round(cos(ugol * pi) * radius + CoordX(CurShip));",
                        "        y = round(sin(ugol * pi) * radius + CoordY(CurShip));",
                        "        OrderMove(dom, x, y);",
                        "        ugol = 0.01 * Rnd(0, 200);",
                        "        x = round(cos(ugol * pi) * radius + CoordX(CurShip));",
                        "        y = round(sin(ugol * pi) * radius + CoordY(CurShip));",
                        "        OrderMove(CurShip, x, y);",
                        "        SetData(0, 0, CurShip);",
                        "      }",
                        "    }",
                        "  }",
                        "  if(ShipGetBad(CurShip)>0) {",
                        "    ChangeState(3);",
                        "    exit;",
                        "  }",
                        "  if(GetData(1,CurShip)!=10000&&ShipGetBad(CurShip)==0) {",
                        "    if(GalaxyStar(GetData(1,CurShip))==star) {",
                        "      SetData(10000,1,CurShip);",
                        "      ChangeState(0);",
                        "      exit;",
                        "    }",
                        "    if(GalaxyStar(GetData(1,CurShip))!=star) {",
                        "      OrderJump(CurShip,GalaxyStar(GetData(1,CurShip)));",
                        "      SetData(0,0,CurShip);",
                        "    }",
                        "  }",
                        "}",
                        "if(GetShipPlanet(CurShip)) {",
                        "  HullHP(CurShip,ItemSize(ShipItems(CurShip,0)));",
                        "  ShipRefuel(CurShip);",
                        "  ShipRepairEq(CurShip);",
                        "  OrderTakeOff(CurShip);",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 70,
                    "Pos.y": 480,
