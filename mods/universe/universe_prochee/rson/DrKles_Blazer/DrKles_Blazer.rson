                        "          ShipAddCustomShipInfo(thisShip,'DrKles_DomInfo','NoShow');",
                        "      }",
                        "    }",
                        "  }",
                        "  ShipCustomShipInfoData(CurShip,'DrKles_BertorsAura',1,0);",
                        "  ",
                        "  dword numOfKligs=ShipCustomShipInfoData(CurShip,'DrKles_BertorsAura',2);",
                        "  if(Rnd(1,10+2*((bonusDomiks==3)+(bonusGlobal==3)))>(5-numOfKligs+(bonusDomiks==3)+(bonusGlobal==3))){",
                        "    while(numOfKligs<5+(bonusDomiks==3)+(bonusGlobal==3)){",
                        "      SpawnKlig(Id(CurShip));",
                        "      numOfKligs=numOfKligs+1;",
                        "      OrderNone(CurShip);",
                        "      SetData(0, 0, CurShip);",
                        "    }",
                        "    ShipCustomShipInfoData(CurShip,'DrKles_BertorsAura',2,5+(bonusDomiks==3)+(bonusGlobal==3));",
                        "  }",
                        "}",
                        "if(GetData(2,CurShip)) {",
                        "  if(HullDamage(CurShip)>=60) {",
                        "    random = Rnd(1, 100);",
                        "    if (random < (20.0+(2.0*curDomLevel)*(1.0+0.6*6))/10) {",
                        "      powerDomiks = exp(0.55 * 6 -1.0) * (0.65 + 0.1*curDomLevel) * (1.0+0.033*(bonusGlobal==3)*curDomLevel);",
                        "      while (powerDomiks > 1) {",
                        "        if (powerDomiks >= 13 && Rnd(1, 10) > 8) {",
                        "          power = 5;",
                        "          powerDomiks = powerDomiks - 13;",
                        "        } else if (powerDomiks >= 8 && Rnd(1, 10) > 7) {",
                        "          power = 4;",
                        "          powerDomiks = powerDomiks - 8;",
                        "        } else if (powerDomiks >= 5 && Rnd(1, 10) > 6) {",
                        "          power = 3;",
                        "          powerDomiks = powerDomiks - 5;",
                        "        } else if (powerDomiks >= 3 && Rnd(1, 10) > 5) {",
                        "          power = 2;",
                        "          powerDomiks = powerDomiks - 3;",
                        "        } else if (powerDomiks >= 2) {",
                        "          power = 1;",
                        "          powerDomiks = powerDomiks - 2;",
                        "        }",
                        "        dom = SpawnDom(power,1);",
                        "        TransferShip(dom, NearCivilPlanet(CurShip));",
                        "        OrderTakeOff(dom);",
                        "        ShipSetCoords(dom, CoordX(CurShip), CoordY(CurShip));",
                        "        ugol = 0.01 * Rnd(0, 200);",
                        "        ShipAngle(dom, Rnd(1, 360));",
                        "        radius = Rnd(150, 400);",
                        "        x = round(cos(ugol * pi) * radius + CoordX(CurShip));",
                        "        y = round(sin(ugol * pi) * radius + CoordY(CurShip));",
                        "        OrderMove(dom, x, y);",
                        "        ShipOrder(dom, 5);",
                        "      }",
                        "    }",
                        "    SetData(0,2,CurShip);",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 160,
                    "Pos.y": 540,
                    "Parent": -1,
                    "#": 592,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!ShipInNormalSpace(CurShip)) {",
                        "  NoTargetToShip(CurShip,2);",
                        "  ShipRefuel(CurShip);",
                        "  ShipRepairEq(CurShip);",
                        "  OrderLock(CurShip,1);",
                        "  NoDropToShip(CurShip,1);",
                        "}",
                        "if(ShipInNormalSpace(CurShip)) {",
                        "  ChangeState(22);",
                        "  exit;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 70,
                    "Pos.y": 735,
                    "Parent": -1,
                    "#": 593,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(ShipInNormalSpace(CurShip)) {",
                        "  potentialEnemy = 0;",
                        "  distance = 100000;",
                        "  star = ShipStar(CurShip);",
                        "  cShips=StarShips(star);",
                        "  ourPlanet=IdToPlanet(planetId);",
                        "  nearPlanet=NearCivilPlanet(CurShip);",
                        "  myFather=IdToShip(GetData(1,CurShip));",
                        "  OrderForsage(CurShip,0);",
                        "  for (i = 0; i <= cShips; i = i + 1) {",
                        "    thisShip = StarShips(star, i);",
                        "    if (ShipInNormalSpace(thisShip)) {",
                        "      bool=GetRelationPlanet(ourPlanet, thisShip) <= 30;",
                        "      if (bool && distance > Dist(CurShip, thisShip) && ShipTypeN(thisShip)!=2) {",
                        "        potentialEnemy = thisShip;",
                        "        distance = Dist(CurShip, thisShip);",
                        "      }",
                        "    }",
                        "  }",
                        "  if (potentialEnemy != 0)",
                        "    ShipSetBad(CurShip, potentialEnemy);",
                        "  OrderLock(CurShip,1);",
                        "  if(myFather) {",
                        "    if(ShipStar(myFather)!=star) {",
                        "      OrderJump(CurShip,ShipStar(myFather));",
                        "    }",
                        "    if(ShipStar(myFather)==star) {",
                        "      if(ShipGetBad(CurShip)==0) {",
                        "        if(Dist(myFather,star)<PlanetOrbitRadius(StarPlanets(ShipStar(CurShip),0))+150) {",
                        "          int turnsForComplete=GetData(0, CurShip);",
                        "          if (turnsForComplete < 1) {",
                        "            ugol = 0.01 * Rnd(0, 200);",
                        "            radius = PlanetOrbitRadius(StarPlanets(ShipStar(CurShip), 0)) + Rnd(-50, 100);",
                        "            x = round(sin(ugol * pi) * radius);",
                        "            y = round(cos(ugol * pi) * radius);",
                        "            OrderMove(CurShip, x, y);",
                        "            distance=round(sqrt(sqr(abs(CoordX(CurShip)-x))+sqr(abs(CoordY(CurShip)-y))));",
                        "            int ourShipSpeed=ShipSpeed(CurShip);",
                        "            turnsForComplete=distance/ourShipSpeed+(distance%ourShipSpeed!=0);",
                        "          }",
                        "          SetData(turnsForComplete - 1, 0, CurShip);",
                        "        }",
                        "        if(Dist(myFather,star)>=PlanetOrbitRadius(StarPlanets(ShipStar(CurShip),0))+150) {",
                        "          OrderFollowShip(CurShip,myFather,1);",
                        "        }",
                        "      }",
                        "      if(ShipGetBad(CurShip)>0) {",
                        "        ChangeState(23);",
                        "        exit;",
                        "      }",
                        "    }",
                        "  }",
                        "  if(!myFather) {",
                        "    ShipDeleteCustomShipInfo(CurShip,'DrKles_KligsDeath');",
                        "    ShipDeleteCustomShipInfo(CurShip,'DrKles_KligsSuicide');",
                        "    ShipJoin(domiks,CurShip);",
                        "  }",
                        "}"
                    ]
                },
