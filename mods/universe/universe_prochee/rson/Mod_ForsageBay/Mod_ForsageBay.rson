            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 5,
                    "Code.Type": "Global",
                    "Code": [
                        "if(!Player()) GRun(); else { if(ShipFindCustomShipInfoByType(Player(), 'FE_Off') < 0) GRun(); }"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 6,
                    "Code.Type": "Init",
                    "Code": [
                        "",
                        "// the look of the pictures: _D (dark grey) under a DenUIRecolor colour theme, else the classic",
                        "// colours of the game; the themes are the mods DenUIRecolor<Colour>, not DenUIRecolor_<addon>",
                        "function FE_Theme()",
                        "{",
                        "result = '';",
                        "str fe_ml = CurrentMods(-1);",
                        "int fe_p = findsubstr(fe_ml, 'DenUIRecolor');",
                        "for(int fe_n = 0; fe_n < 40; fe_n = fe_n + 1)",
                        "{",
                        "    if(fe_p >= 0)",
                        "    {",
                        "        if(substr(fe_ml, fe_p + 12, 1) != '_') result = '_D';",
                        "        fe_p = findsubstr(fe_ml, 'DenUIRecolor', fe_p + 12);",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function FE_Key(int fe_i)",
                        "{",
                        "result = 'GB_FE_' + fe_i;",
                        "}",
                        "",
                        "function FE_Peek(int fe_i)",
                        "{",
                        "result = GetItemFromVault(FE_Key(fe_i), 0);",
                        "}",
                        "",
                        "function FE_Live(dword fe_e)",
                        "{",
                        "result = 0;",
                        "if(fe_e)",
                        "{",
                        "    if(ItemIsBroken(fe_e) == 0 && ItemDurability(fe_e) > 0) result = 1;",
                        "}",
                        "}",
                        "",
                        "function FE_LiveCount()",
                        "{",
                        "result = 0;",
                        "for(int fe_i = 0; fe_i < 3; fe_i = fe_i + 1)",
                        "{",
                        "    result = result + FE_Live(FE_Peek(fe_i));",
                        "}",
                        "}",
                        "",
                        "function FE_Count()",
                        "{",
                        "result = 0;",
                        "for(int fe_i = 0; fe_i < 3; fe_i = fe_i + 1)",
                        "{",
                        "    if(FE_Peek(fe_i)) result = result + 1;",
                        "}",
                        "}",
                        "",
                        "function FE_Best()",
                        "{",
                        "result = 0;",
                        "int fe_bc = 0;",
                        "for(int fe_i = 0; fe_i < 3; fe_i = fe_i + 1)",
                        "{",
                        "    dword fe_e = FE_Peek(fe_i);",
                        "    if(FE_Live(fe_e))",
                        "    {",
                        "        if(ItemDurability(fe_e) > fe_bc)",
                        "        {",
                        "            fe_bc = ItemDurability(fe_e);",
                        "            result = fe_e;",
                        "        }",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function FE_FreeSlot()",
                        "{",
                        "result = 3;",
                        "for(int fe_i = 3 - 1; fe_i >= 0; fe_i = fe_i - 1)",
                        "{",
                        "    if(!FE_Peek(fe_i)) result = fe_i;",
                        "}",
                        "}",
                        "",
                        "function FE_Broke()",
                        "{",
                        "result = 0;",
                        "dword fe_bm = Player();",
                        "int fe_has = 0;",
                        "for(int fe_bi = 0; fe_bi < 3; fe_bi = fe_bi + 1)",
                        "{",
                        "    if(FE_Peek(fe_bi)) fe_has = 1;",
                        "}",
                        "if(fe_has && ShipCustomShipInfoData(fe_bm, 'FE_Hook', 3) != 1)",
                        "{",
                        "    Ether(8, '', CT('Script.Mod_ForsageBay.Broken' + Rnd(0, 4)), fe_bm);",
                        "    ShipCustomShipInfoData(fe_bm, 'FE_Hook', 3, 1);",
                        "    result = 1;",
                        "}",
                        "}",
                        "",
                        "// the no-start sound unless muted (FE_Keep Data 2 = 1).  fe_film: from the calculation of the",
                        "// day (g_Wear, stage 21 -- the film object of the ship for the day does not exist yet, a FilmSound",
                        "// on it breaks the film with Error in TEFilm.ObjToNom), so only marked (FE_Keep Data 3) and put",
                        "// into the film at phase 11 by FE_SndFlush; otherwise (the interface) played at once.",
                        "// NO QUOTES IN THESE COMMENTS: the tokenizer runs before the comments are removed, and a lone",
                        "// apostrophe opens a string that swallows the code after it (FE_Mark and all after it were lost).",
                        "function FE_Snd(int fe_film)",
                        "{",
                        "result = 0;",
                        "dword fe_me = Player();",
                        "if(fe_me)",
                        "{",
                        "    if(ShipCustomShipInfoData(fe_me, 'FE_Keep', 2) != 1)",
                        "    {",
                        "        if(fe_film) ShipCustomShipInfoData(fe_me, 'FE_Keep', 3, 1);",
                        "        if(!fe_film) Sound('Sound.FE_NoStart');",
                        "        result = 1;",
                        "    }",
                        "}",
                        "}",
                        "",
                        "// a bay engine broke during the calculation of the day: FE_Keep Data 3 = 2 (stop the long flight)",
                        "// + 1 (the sound, unless muted); both done at phase 11 by FE_SndFlush",
                        "function FE_Mark()",
                        "{",
                        "result = 2;",
                        "dword fe_me = Player();",
                        "if(ShipCustomShipInfoData(fe_me, 'FE_Keep', 2) != 1) result = 3;",
                        "ShipCustomShipInfoData(fe_me, 'FE_Keep', 3, result);",
                        "}",
                        "",
                        "function FE_SndFlush()",
                        "{",
                        "result = 0;",
                        "dword fe_me = Player();",
                        "int fe_v = ShipCustomShipInfoData(fe_me, 'FE_Keep', 3);",
                        "if(fe_v > 0)",
                        "{",
                        "    ShipCustomShipInfoData(fe_me, 'FE_Keep', 3, 0);",
                        "    int fe_snd = 0;",
                        "    if(fe_v == 1 || fe_v == 3) fe_snd = 1;",
                        "    if(fe_snd == 1 && ShipInNormalSpace(fe_me) && !GetShipPlanet(fe_me))",
                        "    {",
                        "        FilmSound('Sound.FE_NoStart', fe_me);",
                        "        result = 1;",
                        "    }",
                        "    if(fe_v >= 2) FilmFlags(2, 1);",
                        "}",
                        "}",
                        "",
                        "function g_Mute(int fe_on)",
                        "{",
                        "result = 1;",
                        "int fe_v = 0;",
                        "if(!fe_on) fe_v = 1;",
                        "ShipCustomShipInfoData(Player(), 'FE_Keep', 2, fe_v);",
                        "g_Paint(0);",
                        "}",
                        "",
                        "function FE_NoFsText()",
                        "{",
                        "result = CT('Script.Mod_ForsageBay.Empty');",
                        "if(FE_Count() > 0) result = CT('Script.Mod_ForsageBay.Dead');",
                        "}",
                        "",
                        "// THE AFTERBURNER SPEED (the user, 2026-10-08): main engine + the working bay engine (FE_Best).",
                        "// The game gives (engine speed + speed bonuses) x ForsageCoef (2.0) on the afterburner, so the",
                        "// ship gets the bonus D = (bay - main - other bonuses) / 2 while the afterburner is on: then",
                        "// (main + other + D) x 2 = main + other + bay, slowed by the mass as the main engine is.  D goes",
                        "// into the own bonus of the ship (ShipSpecialBonuses, kind 2 = bonSpeed) on top of what quests",
                        "// gave, and is kept in FE_Spd Data 1 to be taken back.",
                        "// the speed bonus of a bay engine from its modules, as TEquipment.GetStatBonus(bonSpeed): the",
                        "// special module (EqSpecial) and the extra ones (ItemExtraSpecials), made stronger by the acrin",
                        "// of the item (EqModule: bonExtraAkrinEff 29 for a gain, bonExtraAkrinPenalty 30 for a loss, in",
                        "// hundredths of a percent).  The improvements of science bases change the engine speed itself.",
                        "// a module that does not work for the player (TShip.IsMicroModuleRaciallyRestricted for the",
                        "// player ship): RacialRestriction set in its config (Lang MicroModuls.<name>) and neither the",
                        "// race of the pilot (Maloc Peleng People Fei Gaal) nor, for a pirate (owner 7), PirateClan in",
                        "// its Owner list (Any or none: everyone)",
                        "function FE_ModBanned(int fe_mi)",
                        "{",
                        "result = 0;",
                        "str fe_cn = BonusNumInCfg(fe_mi);",
                        "str fe_rr = CT('MicroModuls.' + fe_cn + '.RacialRestriction');",
                        "if(fe_rr != '' && fe_rr != '0')",
                        "{",
                        "    str fe_ow = CT('MicroModuls.' + fe_cn + '.Owner');",
                        "    if(fe_ow != '' && fe_ow != 'Any')",
                        "    {",
                        "        dword fe_me = Player();",
                        "        int fe_pr = ShipPilotRace(fe_me);",
                        "        str fe_rn = '';",
                        "        if(fe_pr == 0) fe_rn = 'Maloc';",
                        "        if(fe_pr == 1) fe_rn = 'Peleng';",
                        "        if(fe_pr == 2) fe_rn = 'People';",
                        "        if(fe_pr == 3) fe_rn = 'Fei';",
                        "        if(fe_pr == 4) fe_rn = 'Gaal';",
                        "        int fe_ok = 0;",
                        "        if(fe_rn != '')",
                        "        {",
                        "            if(findsubstr(fe_ow, fe_rn) >= 0) fe_ok = 1;",
                        "        }",
                        "        if(ShipOwner(fe_me) == 7)",
                        "        {",
                        "            if(findsubstr(fe_ow, 'PirateClan') >= 0) fe_ok = 1;",
                        "        }",
                        "        if(!fe_ok) result = 1;",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function FE_ModSpeed(dword fe_e)",
                        "{",
                        "result = 0;",
                        "int fe_sb = 0;",
                        "int fe_s = EqSpecial(fe_e);",
                        "if(fe_s >= 0) fe_sb = BonusValue(fe_s, 2);",
                        "// as TShip.GetEquipmentStatBonus: a special module the pilot cannot use voids all the bonus",
                        "int fe_ban = 0;",
                        "if(fe_s >= 0) fe_ban = FE_ModBanned(fe_s);",
                        "int fe_xn = ItemExtraSpecials(fe_e);",
                        "for(int fe_i = 0; fe_i < fe_xn; fe_i = fe_i + 1)",
                        "{",
                        "    int fe_xm = ItemExtraSpecials(fe_e, fe_i);",
                        "    if(fe_xm >= 0) fe_sb = fe_sb + BonusValue(fe_xm, 2) * ItemExtraSpecialsCountByType(fe_e, fe_xm);",
                        "}",
                        "int fe_mm = EqModule(fe_e);",
                        "if(fe_sb != 0 && fe_mm >= 0)",
                        "{",
                        "    int fe_ak = BonusValue(fe_mm, 29);",
                        "    if(fe_sb < 0) fe_ak = BonusValue(fe_mm, 30);",
                        "    fe_sb = fe_sb + round(0.0001 * fe_ak * fe_sb);",
                        "}",
                        "if(fe_ban) fe_sb = 0;",
                        "result = fe_sb;",
                        "}",
                        "",
                        "function FE_Speed()",
                        "{",
                        "result = 0;",
                        "dword fe_me = Player();",
                        "if(fe_me)",
                        "{",
                        "    if(ShipFindCustomShipInfoByType(fe_me, 'FE_Spd') < 0) ShipAddCustomShipInfo(fe_me, 'FE_Spd');",
                        "    int fe_old = ShipCustomShipInfoData(fe_me, 'FE_Spd', 1);",
                        "    int fe_d = 0;",
                        "    dword fe_m = ShipEqInSlot(fe_me, 44);",
                        "    dword fe_b = FE_Best();",
                        "    if(fe_m && fe_b)",
                        "    {",
                        "        if(OrderForsage(fe_me) == 1)",
                        "        {",
                        "            int fe_other = ShipSpecialBonuses(fe_me, 2, 'Total') - fe_old;",
                        "            int fe_gap = GetEquipmentStats(fe_b, 0) + FE_ModSpeed(fe_b) - GetEquipmentStats(fe_m, 0) - fe_other;",
                        "            fe_d = round(0.5 * fe_gap);",
                        "        }",
                        "    }",
                        "    if(fe_d != fe_old)",
                        "    {",
                        "        int fe_own = ShipSpecialBonuses(fe_me, 2);",
                        "        ShipSpecialBonuses(fe_me, 2, fe_own - fe_old + fe_d);",
                        "        ShipCustomShipInfoData(fe_me, 'FE_Spd', 1, fe_d);",
                        "        ShipCalcParam(fe_me);",
                        "        // the path of the star map is laid out again (OrderForsage with a value does it",
                        "        // in the order mode)",
                        "        OrderForsage(fe_me, OrderForsage(fe_me));",
                        "        result = 1;",
                        "    }",
                        "}",
                        "}",
                        "",
                        "// the afterburner button of the ship screen (FE_FsBtn over the game one, which has no hook):",
                        "// as the game (TfShip2.ToggleAfterburner: its sounds, the note on switching on), then the speed",
                        "function g_Fs(int fe_x)",
                        "{",
                        "result = 1;",
                        "dword fe_me = Player();",
                        "if(OrderForsage(fe_me) == 1)",
                        "{",
                        "    OrderForsage(fe_me, 0);",
                        "    Sound('Sound.ForsageOff');",
                        "}",
                        "else",
                        "{",
                        "    if(ShipInNormalSpace(fe_me) && FE_LiveCount() > 0)",
                        "    {",
                        "        OrderForsage(fe_me, 1);",
                        "        if(OrderForsage(fe_me) == 1)",
                        "        {",
                        "            Sound('Sound.ForsageOn');",
                        "            FE_Speed();",
                        "            MessageBox(CT('FormShip.ForsageActivate'));",
                        "        }",
                        "    }",
                        "}",
                        "FE_Speed();",
                        "}",
                        "",
                        "// for the tests: the speed worked out now; the module speed of a bay engine",
                        "function g_Spd(int fe_x)",
                        "{",
                        "result = FE_Speed();",
                        "}",
                        "",
                        "function g_ModSpd(dword fe_e)",
                        "{",
                        "result = FE_ModSpeed(fe_e);",
                        "}",
                        "",
                        "function g_ModBan(int fe_mi)",
                        "{",
                        "result = FE_ModBanned(fe_mi);",
                        "}",
                        "",
                        "function FE_Guard()",
                        "{",
                        "result = 0;",
                        "dword fe_me = Player();",
                        "if(fe_me)",
                        "{",
                        "    if(OrderForsage(fe_me) == 1 && ShipSlots(fe_me, 8) > 0 && FE_LiveCount() == 0)",
                        "    {",
                        "        OrderForsage(fe_me, 0);",
                        "        FE_Snd(0);",
                        "        Ether(8, '', FE_NoFsText(), fe_me);",
                        "        result = 1;",
                        "    }",
                        "    FE_Speed();",
                        "}",
                        "}",
                        "",
                        "function g_NoFs(int fe_x)",
                        "{",
                        "result = 0;",
                        "FE_Snd(0);",
                        "MessageBox(FE_NoFsText());",
                        "}",
                        "",
                        "// for the tests: the state code (FE_Guard) run as the game runs it after F on the star map",
                        "function g_State(int fe_x)",
                        "{",
                        "result = 0;",
                        "ChangeState(0, Player());",
                        "}",
                        "",
                        "// NANITOIDS: the Glovebox repairs the bay engines with its own places (Mod_Glovebox g_Nano).",
                        "",
                        "function g_Wear(dword fe_it, int fe_dmg)",
                        "{",
                        "result = fe_dmg;",
                        "dword fe_me = Player();",
                        "ShipCustomShipInfoData(fe_me, 'FE_Wear', 1, 1);",
                        "if(fe_it)",
                        "{",
                        "    if(ItemType(fe_it) == 44)",
                        "    {",
                        "        result = 0;",
                        "        dword fe_e = FE_Best();",
                        "        if(!fe_e)",
                        "        {",
                        "            OrderForsage(fe_me, 0);",
                        "            FE_Broke();",
                        "        }",
                        "        if(fe_e)",
                        "        {",
                        "            int fe_mk = ShipCustomShipInfoData(fe_me, 'FE_Hook', 3);",
                        "            if(fe_mk == 1) ShipCustomShipInfoData(fe_me, 'FE_Hook', 3, 0);",
                        "            if(fe_mk == 2 && ItemDurability(fe_e) > FE_StopAt()) ShipCustomShipInfoData(fe_me, 'FE_Hook', 3, 0);",
                        "        }",
                        "        if(fe_e && fe_dmg > 0)",
                        "        {",
                        "            float fe_fm = ItemFragility(fe_it);",
                        "            float fe_fb = ItemFragility(fe_e);",
                        "            float fe_k = 1.0;",
                        "            if(fe_fm > 0.01) fe_k = fe_fb / fe_fm;",
                        "            int fe_tot = ShipCustomShipInfoData(fe_me, 'FE_Hook', 2) + round(fe_k * fe_dmg);",
                        "            int fe_whole = int(fe_tot / 1000);",
                        "            ShipCustomShipInfoData(fe_me, 'FE_Hook', 2, fe_tot - fe_whole * 1000);",
                        "            if(fe_whole > 0)",
                        "            {",
                        "                int fe_left = ItemDurability(fe_e) - fe_whole;",
                        "                if(fe_left < 0) fe_left = 0;",
                        "                if(fe_left == 0 && ItemDurability(fe_e) > 0) FE_Mark();",
                        "                ItemDurability(fe_e, fe_left);",
                        "                if(!FE_Best())",
                        "                {",
                        "                    OrderForsage(fe_me, 0);",
                        "                    FE_Broke();",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function FE_Show()",
                        "{",
                        "result = ShipCustomShipInfoData(Player(), 'FE_Hook', 1);",
                        "}",
                        "",
                        "function FE_FanRoll(dword fe_e)",
                        "{",
                        "result = 0;",
                        "dword fe_me = Player();",
                        "if(fe_e && ShipCustomShipInfoData(fe_me, 'FE_Wear', 3) == 0)",
                        "{",
                        "    str fe_seen = ShipCustomShipInfoTextData(fe_me, 'FE_Hook', 1);",
                        "    str fe_k = '|' + Id(fe_e) + '|';",
                        "    if(ItemOwner(fe_e) == 1 && findsubstr(fe_seen, fe_k) < 0)",
                        "    {",
                        "        ShipCustomShipInfoTextData(fe_me, 'FE_Hook', 1, fe_seen + fe_k);",
                        "        if(Rnd(0, 99) < 10)",
                        "        {",
                        "            dword fe_f = CreateCustomArt('FE_Fan', 1, 333, 1);",
                        "            AddItemToShip(fe_me, fe_f);",
                        "            ShipCalcParam(fe_me);",
                        "            ShipCustomShipInfoData(fe_me, 'FE_Wear', 3, 1);",
                        "            MsgAdd(CT('Script.Mod_ForsageBay.FanFound'), 0);",
                        "            result = 1;",
                        "        }",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function g_FanRoll(dword fe_e)",
                        "{",
                        "result = FE_FanRoll(fe_e);",
                        "}",
                        "",
                        "function FE_FanDay()",
                        "{",
                        "result = 0;",
                        "dword fe_me = Player();",
                        "int fe_has = 0;",
                        "for(int fe_k = 0; fe_k < ShipArts(fe_me); fe_k = fe_k + 1)",
                        "{",
                        "    if(EquipmentImageName(ShipArts(fe_me, fe_k)) == 'FE_Fan') fe_has = 1;",
                        "}",
                        "if(!fe_has) ShipCustomShipInfoData(fe_me, 'FE_Wear', 2, 0);",
                        "if(fe_has && !GetShipPlanet(fe_me))",
                        "{",
                        "    int fe_n = ShipCustomShipInfoData(fe_me, 'FE_Wear', 2) + 1;",
                        "    if(fe_n >= 2)",
                        "    {",
                        "        if(ShipHealthFactor(fe_me, 8) <= 0)",
                        "        {",
                        "            ShipHealthFactor(fe_me, 8, 5);",
                        "            Ether(8, '', CT('Script.Mod_ForsageBay.FanStrain' + Rnd(0, 1)), fe_me);",
                        "            result = 1;",
                        "        }",
                        "        fe_n = 0;",
                        "    }",
                        "    ShipCustomShipInfoData(fe_me, 'FE_Wear', 2, fe_n);",
                        "}",
                        "}",
                        "",
                        "function FE_PutAt(dword fe_it, int fe_i)",
                        "{",
                        "result = 0;",
                        "dword fe_me = Player();",
                        "str fe_m = '';",
                        "if(ItemType(fe_it) != 44) fe_m = 'OnlyEngines';",
                        "if(fe_m == '' && ItemInScript(fe_it) == 1) fe_m = 'NoQuest';",
                        "int fe_s = fe_i;",
                        "dword fe_old = 0;",
                        "if(fe_s < 3) fe_old = FE_Peek(fe_s);",
                        "if(fe_s >= 3) fe_s = FE_FreeSlot();",
                        "if(fe_m == '' && fe_s >= 3) fe_m = 'NoRoom';",
                        "ShipCalcParam(fe_me);",
                        "int fe_need = ItemSize(fe_it);",
                        "if(fe_old) fe_need = fe_need - ItemSize(fe_old);",
                        "if(fe_m == '' && fe_need > 0 && ShipFreeSpace(fe_me) < fe_need) fe_m = 'NoSpace';",
                        "if(fe_m == '' && fe_old)",
                        "{",
                        "    fe_old = GetItemFromVault(FE_Key(fe_s));",
                        "    dword fe_c = FormShipCurItem('Replace', fe_old);",
                        "    PutItemInVault(FE_Key(fe_s), fe_c);",
                        "    RunFunctionFromScript('Mod_Glovebox', 'Sync', 0);",
                        "    FE_FanRoll(fe_c);",
                        "    result = 1;",
                        "}",
                        "if(fe_m == '' && !fe_old)",
                        "{",
                        "    dword fe_d = FormShipCurItem('Detach');",
                        "    if(fe_d)",
                        "    {",
                        "        PutItemInVault(FE_Key(fe_s), fe_d);",
                        "        RunFunctionFromScript('Mod_Glovebox', 'Sync', 0);",
                        "        ShipCustomShipInfoData(fe_me, 'FE_Hook', 1, 1);",
                        "        FE_FanRoll(fe_d);",
                        "        result = 1;",
                        "    }",
                        "}",
                        "if(fe_m != '') MessageBox(CT('Script.Mod_ForsageBay.' + fe_m));",
                        "}",
                        "",
                        "function FE_Colour(int fe_n, int fe_sum, int fe_bad)",
                        "{",
                        "result = '';",
                        "if(fe_n > 0)",
                        "{",
                        "    result = 'O';",
                        "    if(fe_sum >= 50 * fe_n) result = 'Y';",
                        "    if(fe_sum >= 100 * fe_n) result = 'G';",
                        "    if(fe_bad) result = 'R';",
                        "}",
                        "}",
                        "",
                        "function FE_Lamp()",
                        "{",
                        "int fe_n = 0;",
                        "int fe_sum = 0;",
                        "int fe_bad = 0;",
                        "for(int fe_i = 0; fe_i < 3; fe_i = fe_i + 1)",
                        "{",
                        "    dword fe_e = FE_Peek(fe_i);",
                        "    if(fe_e)",
                        "    {",
                        "        fe_n = fe_n + 1;",
                        "        fe_sum = fe_sum + ItemDurability(fe_e);",
                        "        if(!FE_Live(fe_e)) fe_bad = 1;",
                        "    }",
                        "}",
                        "result = FE_Colour(fe_n, fe_sum, fe_bad);",
                        "}",
                        "",
                        "function g_Paint(int fe_x)",
                        "{",
                        "dword fe_me = Player();",
                        "int fe_on = 0;",
                        "if(FormCurShip() == fe_me && ShipSlots(fe_me, 8) > 0) fe_on = 1;",
                        "InterfaceState('Ship', 'FE_Housing', fe_on);",
                        "int fe_bay = 0;",
                        "if(fe_on && FE_Show() == 1) fe_bay = 1;",
                        "InterfaceState('Ship', 'FE_Bay', fe_bay);",
                        "int fe_mu = 0;",
                        "if(ShipCustomShipInfoData(fe_me, 'FE_Keep', 2) == 1) fe_mu = 1;",
                        "InterfaceState('Ship', 'FE_SndOn', fe_bay && !fe_mu);",
                        "InterfaceState('Ship', 'FE_SndOff', fe_bay && fe_mu);",
                        "str fe_sl = CT('Script.Mod_ForsageBay.SndOn');",
                        "if(fe_mu) fe_sl = CT('Script.Mod_ForsageBay.SndOff');",
                        "str fe_si = 'GI,Bm.FE.SndOn';",
                        "if(fe_mu) fe_si = 'GI,Bm.FE.SndOff';",
                        "InterfaceImage('Ship', 'FE_SndImg', fe_si + FE_Theme());",
                        "InterfaceState('Ship', 'FE_SndImg', fe_bay);",
                        "InterfaceText('Ship', 'FE_SndL', fe_sl);",
                        "FE_Speed();",
                        "InterfaceState('Ship', 'FE_Lock', fe_on);",
                        "int fe_lv = FE_LiveCount();",
                        "int fe_lk = 0;",
                        "if(fe_on && fe_lv == 0) fe_lk = 1;",
                        "InterfaceState('Ship', 'FE_LockBtn', fe_lk);",
                        "// our afterburner button: 3 shown and enabled, 2 shown disabled (out of normal space), 0 none",
                        "int fe_fs = 0;",
                        "if(fe_on && fe_lv > 0)",
                        "{",
                        "    fe_fs = 3;",
                        "    if(!ShipInNormalSpace(fe_me)) fe_fs = 2;",
                        "}",
                        "InterfaceState('Ship', 'FE_FsBtn', fe_fs);",
                        "str fe_kn = FE_Lamp();",
                        "int fe_lit = 0;",
                        "if(fe_kn != '') fe_lit = 1;",
                        "str fe_th = FE_Theme();",
                        "InterfaceImage('Ship', 'FE_BtnImg', 'GI,Bm.FE.Ball' + fe_th);",
                        "InterfaceImage('Ship', 'FE_ColImg', 'GI,Bm.FE.Col' + fe_th);",
                        "if(fe_lit) InterfaceImage('Ship', 'FE_FLight', 'GI,Bm.FE.FLight' + fe_kn + fe_th);",
                        "InterfaceState('Ship', 'FE_FLight', fe_lit);",
                        "for(int fe_i = 0; fe_i < 3; fe_i = fe_i + 1)",
                        "{",
                        "    dword fe_e = FE_Peek(fe_i);",
                        "    str fe_t = '';",
                        "    if(fe_e)",
                        "    {",
                        "        InterfaceImage('Ship', 'FE_I' + fe_i, 'GI,' + EquipmentImageName('GetImagePath', fe_e) + 's');",
                        "        InterfaceState('Ship', 'FE_I' + fe_i, 1);",
                        "        fe_t = Format(CT('Script.Mod_ForsageBay.Cond'), '<0'+'>', '' + ItemDurability(fe_e), '');",
                        "        if(!FE_Live(fe_e)) fe_t = CT('Script.Mod_ForsageBay.Broken');",
                        "    }",
                        "    if(!fe_e) InterfaceState('Ship', 'FE_I' + fe_i, 0);",
                        "    if(fe_t == '') fe_t = ' ';",
                        "    InterfaceText('Ship', 'FE_L' + fe_i, fe_t);",
                        "}",
                        "}",
                        "",
                        "function g_Toggle(int fe_x)",
                        "{",
                        "result = 0;",
                        "dword fe_me = Player();",
                        "if(FormCurShip() == fe_me)",
                        "{",
                        "    int fe_k = FormShipCurItem('MoveType');",
                        "    if(fe_k == 1) MessageBox(CT('Script.Mod_ForsageBay.OnlyEngines'));",
                        "    if(fe_k >= 2) result = FE_PutAt(FormShipCurItem(), 3);",
                        "    if(fe_k == 0)",
                        "    {",
                        "        ShipCustomShipInfoData(fe_me, 'FE_Hook', 1, 1 - FE_Show());",
                        "        g_Paint(0);",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function g_Slot(int fe_i)",
                        "{",
                        "result = 0;",
                        "dword fe_me = Player();",
                        "if(FormCurShip() == fe_me)",
                        "{",
                        "    int fe_k = FormShipCurItem('MoveType');",
                        "    if(fe_k == 1) MessageBox(CT('Script.Mod_ForsageBay.OnlyEngines'));",
                        "    if(fe_k >= 2) result = FE_PutAt(FormShipCurItem(), fe_i);",
                        "    if(fe_k == 0)",
                        "    {",
                        "        dword fe_e = GetItemFromVault(FE_Key(fe_i));",
                        "        if(fe_e)",
                        "        {",
                        "            AddItemToShip(fe_me, fe_e);",
                        "            RunFunctionFromScript('Mod_Glovebox', 'Sync', 0);",
                        "            result = 1;",
                        "        }",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function FE_Cost(dword fe_e)",
                        "{",
                        "result = 0;",
                        "int fe_c = ItemDurability(fe_e);",
                        "int fe_b = ItemIsBroken(fe_e);",
                        "if(fe_c < 100 || fe_b == 1)",
                        "{",
                        "    int fe_p = ItemCost(fe_e);",
                        "    float fe_v = 0.01 * int(fe_p / 7) * (100 - fe_c) + int(fe_p / 20) + 10;",
                        "    result = int(round(fe_v) / 10) * 10;",
                        "    if(fe_b == 1) result = round(1.3 * result);",
                        "}",
                        "}",
                        "",
                        "function g_Cost(dword fe_e)",
                        "{",
                        "result = FE_Cost(fe_e);",
                        "}",
                        "",
                        "function FE_RepCost()",
                        "{",
                        "result = 0;",
                        "dword fe_me = Player();",
                        "for(int fe_i = 0; fe_i < 3; fe_i = fe_i + 1)",
                        "{",
                        "    dword fe_e = FE_Peek(fe_i);",
                        "    if(fe_e)",
                        "    {",
                        "        if(ShipCanRepairEq(fe_me, fe_e) == 1) result = result + FE_Cost(fe_e);",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function FE_ArtPlace()",
                        "{",
                        "result = 0;",
                        "dword fe_r = GetShipRuins(Player());",
                        "if(fe_r)",
                        "{",
                        "    str fe_t = ShipType(fe_r);",
                        "    int fe_lic = 0;",
                        "    if(findsubstr(fe_t, '_licensed') >= 0) fe_lic = 1;",
                        "    fe_t = Format(fe_t, '_licensed', '', '');",
                        "    if(fe_t == 'SB' || fe_t == 'PB' || fe_t == 'TC') result = 1;",
                        "    if(fe_t == 'WB' && fe_lic) result = 1;",
                        "    dword fe_me = Player();",
                        "    if(ShipFindCustomShipInfoByType(fe_me, 'OS_Data') >= 0 && ShipFindCustomShipInfoByType(fe_me, 'MP_RepLic') >= 0)",
                        "    {",
                        "        if(ShipCustomShipInfoData(fe_me, 'OS_Data', 1) == 3 && ShipCustomShipInfoData(fe_me, 'OS_Data', 2) == Id(fe_r)) result = 1;",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function g_ArtTest(int fe_x)",
                        "{",
                        "result = FE_ArtPlace() * 1000000 + FE_ArtRepCost();",
                        "}",
                        "",
                        "function FE_Art(dword fe_a)",
                        "{",
                        "result = 0;",
                        "if(fe_a)",
                        "{",
                        "    if(ItemIsInUse(fe_a) && ItemCanBeBroken(fe_a) == 1) result = 1;",
                        "}",
                        "}",
                        "",
                        "function FE_ArtCost(dword fe_a)",
                        "{",
                        "result = 0;",
                        "int fe_c = ItemDurability(fe_a);",
                        "int fe_b = ItemIsBroken(fe_a);",
                        "if(fe_c < 100 || fe_b == 1)",
                        "{",
                        "    int fe_p = ItemCost(fe_a);",
                        "    float fe_v = 0.01 * int(fe_p / 5) * (100 - fe_c) + int(fe_p / 10) + 10;",
                        "    result = int(round(fe_v) / 10) * 10;",
                        "    if(fe_b == 1) result = round(1.3 * result);",
                        "}",
                        "}",
                        "",
                        "function FE_ArtRepCost()",
                        "{",
                        "result = 0;",
                        "dword fe_me = Player();",
                        "int fe_ok = FE_ArtPlace();",
                        "for(int fe_i = 0; fe_i < ShipArts(fe_me); fe_i = fe_i + 1)",
                        "{",
                        "    dword fe_a = ShipArts(fe_me, fe_i);",
                        "    if(fe_ok && FE_Art(fe_a))",
                        "    {",
                        "        if(ShipCanRepairEq(fe_me, fe_a) == 1) result = result + FE_ArtCost(fe_a);",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function FE_Move(str fe_c, int fe_dy)",
                        "{",
                        "InterfacePos('Hangar', fe_c, 0, fe_dy, 0);",
                        "}",
                        "",
                        "function FE_ArtLine(int fe_dy)",
                        "{",
                        "dword fe_me = Player();",
                        "int fe_n = 0;",
                        "int fe_sum = 0;",
                        "int fe_bad = 0;",
                        "for(int fe_i = 0; fe_i < ShipArts(fe_me); fe_i = fe_i + 1)",
                        "{",
                        "    dword fe_a = ShipArts(fe_me, fe_i);",
                        "    if(FE_Art(fe_a))",
                        "    {",
                        "        fe_n = fe_n + 1;",
                        "        fe_sum = fe_sum + ItemDurability(fe_a);",
                        "        if(ItemIsBroken(fe_a) == 1 || ItemDurability(fe_a) <= 0) fe_bad = 1;",
                        "    }",
                        "}",
                        "int fe_cost = FE_ArtRepCost();",
                        "str fe_t = CT('Script.Mod_ForsageBay.ArtNone');",
                        "if(fe_n > 0) fe_t = Format(CT('Script.Mod_ForsageBay.ArtOk'), '<0'+'>', '' + fe_n, '');",
                        "if(fe_cost > 0) fe_t = Format(CT('Script.Mod_ForsageBay.ArtRep'), '<0'+'>', '' + fe_n, '<1'+'>', '' + fe_cost, '');",
                        "InterfaceText('Hangar', 'FE_AText', fe_t);",
                        "str fe_l = FE_Colour(fe_n, fe_sum, fe_bad);",
                        "if(fe_l == '') fe_l = 'Off';",
                        "InterfaceImage('Hangar', 'FE_ALight', 'GI,Bm.FE.Lamp' + fe_l + FE_Theme());",
                        "InterfaceState('Hangar', 'FE_ALight', 1);",
                        "InterfaceState('Hangar', 'FE_AText', 1);",
                        "int fe_btn = 0;",
                        "if(fe_cost > 0) fe_btn = 1;",
                        "InterfaceState('Hangar', 'FE_ARBtn', fe_btn);",
                        "FE_Move('FE_ALight', fe_dy);",
                        "FE_Move('FE_AText', fe_dy);",
                        "FE_Move('FE_ARBtn', fe_dy);",
                        "}",
                        "",
                        "function g_ArtRepair(int fe_x)",
                        "{",
                        "dword fe_me = Player();",
                        "int fe_cost = FE_ArtRepCost();",
                        "if(fe_cost > 0)",
                        "{",
                        "    if(ShipMoney(fe_me) < fe_cost) MessageBox(Format(CT('Script.Mod_ForsageBay.ArtNoMoney'), '<0'+'>', '' + fe_cost, ''));",
                        "    if(ShipMoney(fe_me) >= fe_cost)",
                        "    {",
                        "        if(MessageBoxYesNo(Format(CT('Script.Mod_ForsageBay.ArtRepAsk'), '<0'+'>', '' + fe_cost, '')) == 1)",
                        "        {",
                        "            ShipMoney(fe_me, ShipMoney(fe_me) - fe_cost);",
                        "            for(int fe_i = 0; fe_i < ShipArts(fe_me); fe_i = fe_i + 1)",
                        "            {",
                        "                dword fe_a = ShipArts(fe_me, fe_i);",
                        "                if(FE_Art(fe_a))",
                        "                {",
                        "                    if(ShipCanRepairEq(fe_me, fe_a) == 1) ItemDurability(fe_a, 100);",
                        "                }",
                        "            }",
                        "            ShipCalcParam(fe_me);",
                        "            Sound('Sound.Repair');",
                        "        }",
                        "    }",
                        "}",
                        "FE_Hangar();",
                        "}",
                        "",
                        "function FE_Hangar()",
                        "{",
                        "dword fe_me = Player();",
                        "InterfaceImage('Hangar', 'FE_BoardImg', 'GI,Bm.FE.Board' + FE_Theme());",
                        "int fe_bay = 0;",
                        "if(ShipSlots(fe_me, 8) > 0) fe_bay = 1;",
                        "int fe_art = FE_ArtPlace();",
                        "if(fe_bay)",
                        "{",
                        "    int fe_n = FE_Count();",
                        "    int fe_live = FE_LiveCount();",
                        "    int fe_cost = FE_RepCost();",
                        "    str fe_t = CT('Script.Mod_ForsageBay.HgNone');",
                        "    if(fe_n > 0) fe_t = Format(CT('Script.Mod_ForsageBay.HgOk'), '<0'+'>', '' + fe_live, '<1'+'>', '' + fe_n, '');",
                        "    if(fe_cost > 0) fe_t = Format(CT('Script.Mod_ForsageBay.HgRep'), '<0'+'>', '' + fe_live, '<1'+'>', '' + fe_n, '<2'+'>', '' + fe_cost, '');",
                        "    InterfaceText('Hangar', 'FE_Text', fe_t);",
                        "    str fe_l = FE_Lamp();",
                        "    if(fe_l == '') fe_l = 'Off';",
                        "    InterfaceImage('Hangar', 'FE_Light', 'GI,Bm.FE.Lamp' + fe_l + FE_Theme());",
                        "    InterfaceState('Hangar', 'FE_Light', 1);",
                        "    InterfaceState('Hangar', 'FE_Text', 1);",
                        "    int fe_btn = 0;",
                        "    if(fe_cost > 0) fe_btn = 1;",
                        "    InterfaceState('Hangar', 'FE_RBtn', fe_btn);",
                        "}",
                        "if(!fe_bay)",
                        "{",
                        "    InterfaceState('Hangar', 'FE_Light', 0);",
                        "    InterfaceState('Hangar', 'FE_Text', 0);",
                        "    InterfaceState('Hangar', 'FE_RBtn', 0);",
                        "}",
                        "if(fe_art)",
                        "{",
                        "    int fe_dy = 0;",
                        "    if(!fe_bay) fe_dy = 0 - 15;",
                        "    FE_ArtLine(fe_dy);",
                        "}",
                        "if(!fe_art)",
                        "{",
                        "    InterfaceState('Hangar', 'FE_ALight', 0);",
                        "    InterfaceState('Hangar', 'FE_AText', 0);",
                        "    InterfaceState('Hangar', 'FE_ARBtn', 0);",
                        "}",
                        "int fe_sy = 0;",
                        "if(fe_bay + fe_art == 1) fe_sy = 0 - 7;",
                        "if(fe_bay + fe_art == 0) fe_sy = 0 - 15;",
                        "FE_Move('Text4', fe_sy);",
                        "FE_Move('Light4', fe_sy);",
                        "FE_HgButtons();",
                        "}",
                        "",
                        "function FE_HullCost()",
                        "{",
                        "result = 0;",
                        "dword fe_h = ShipEqInSlot(Player(), 42);",
                        "if(fe_h)",
                        "{",
                        "    int fe_w = ItemSize(fe_h);",
                        "    int fe_hp = HullHP(Player());",
                        "    if(fe_w > fe_hp && fe_w > 0)",
                        "    {",
                        "        float fe_d = 100.0 / fe_w * (fe_w - fe_hp);",
                        "        float fe_v = 1.0 * int(ItemCost(fe_h) / 40) / 100 * fe_d + 10;",
                        "        result = int(round(fe_v) / 10) * 10;",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function FE_FuelCost()",
                        "{",
                        "result = 0;",
                        "dword fe_me = Player();",
                        "dword fe_t = ShipEqInSlot(fe_me, 43);",
                        "if(fe_t)",
                        "{",
                        "    int fe_a = GetEquipmentStats(fe_t, 0) - ShipFuel(fe_me);",
                        "    if(fe_a > 0)",
                        "    {",
                        "        float fe_v = 1.0 * fe_a;",
                        "        float fe_r = 1.0 * (CurTurn() - 1000) / 14000;",
                        "        if(fe_r < 0) fe_r = 0.0;",
                        "        if(fe_r > 1) fe_r = 1.0;",
                        "        fe_v = fe_v * (1.0 + 9.0 * fe_r);",
                        "        int fe_o = 6;",
                        "        dword fe_pl = GetShipPlanet(fe_me);",
                        "        if(fe_pl) fe_o = PlanetOwner(fe_pl);",
                        "        if(fe_o == 0) fe_v = fe_v * 0.7;",
                        "        if(fe_o == 1) fe_v = fe_v * 0.9;",
                        "        if(fe_o == 3) fe_v = fe_v * 1.15;",
                        "        if(fe_o == 4) fe_v = fe_v * 1.3;",
                        "        if(fe_o == 7) fe_v = fe_v * 0.8;",
                        "        int fe_dl = int(GalaxyDiffLevels(7) / 50) - 1;",
                        "        if(fe_dl == 0) fe_v = fe_v * 0.7;",
                        "        if(fe_dl == 2) fe_v = fe_v * 1.2;",
                        "        if(fe_dl == 3) fe_v = fe_v * 1.5;",
                        "        result = round(fe_v);",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function FE_TankText()",
                        "{",
                        "dword fe_me = Player();",
                        "dword fe_t = ShipEqInSlot(fe_me, 43);",
                        "result = 'Ok';",
                        "if(!fe_t) result = 'Non';",
                        "if(fe_t)",
                        "{",
                        "    int fe_c = ItemDurability(fe_t);",
                        "    if(fe_c < 50) result = 'AverageDuration';",
                        "    if(fe_c < 20) result = 'SmallDuration';",
                        "    if(ItemIsBroken(fe_t) == 1) result = 'NeedRepair';",
                        "    if(result == 'Ok' && ShipFuel(fe_me) < GetEquipmentStats(fe_t, 0)) result = 'NeedFuel';",
                        "    if(ShipFuel(fe_me) == 0) result = 'Empty';",
                        "    if(ShipCanUseEq(fe_me, fe_t) == 0) result = 'CanNotUse';",
                        "}",
                        "}",
                        "",
                        "function FE_Total()",
                        "{",
                        "dword fe_me = Player();",
                        "result = 'Good';",
                        "int fe_bad = 0;",
                        "str fe_tk = FE_TankText();",
                        "if(fe_tk == 'Non' || fe_tk == 'CanNotUse' || fe_tk == 'Empty') fe_bad = 1;",
                        "if(fe_tk == 'NeedRepair' || fe_tk == 'SmallDuration' || fe_tk == 'AverageDuration') result = 'Nearly';",
                        "dword fe_e = ShipEqInSlot(fe_me, 44);",
                        "if(!fe_e) fe_bad = 2;",
                        "if(fe_e)",
                        "{",
                        "    if(ShipCanUseEq(fe_me, fe_e) == 0 || ShipSpeed(fe_me) <= 0) fe_bad = 2;",
                        "    if(!fe_bad)",
                        "    {",
                        "        if(ItemIsBroken(fe_e) == 1 || ItemDurability(fe_e) < 50) result = 'Nearly';",
                        "    }",
                        "    if(fe_bad != 2)",
                        "    {",
                        "        dword fe_r = GetShipRuins(fe_me);",
                        "        if(fe_r)",
                        "        {",
                        "            if(ShipInHyperSpace(fe_r)) result = 'RuinInHyperSpace';",
                        "        }",
                        "        ShipCalcParam(fe_me);",
                        "        if(ShipFreeSpace(fe_me) < 0) result = 'ShipOvercharging';",
                        "    }",
                        "}",
                        "if(fe_bad) result = 'Bad';",
                        "}",
                        "",
                        "function FE_Board()",
                        "{",
                        "int fe_hc = FE_HullCost();",
                        "str fe_t1 = CT('FormHangar.HullStatus.Ok');",
                        "if(fe_hc > 0) fe_t1 = CT('FormHangar.HullStatus.NeedRepair');",
                        "InterfaceText('Hangar', 'Text1', fe_t1);",
                        "int fe_w1 = 0;",
                        "if(fe_hc > 0) fe_w1 = 1;",
                        "InterfaceState('Hangar', 'Light1', fe_w1);",
                        "str fe_tk = FE_TankText();",
                        "InterfaceText('Hangar', 'Text2', CT('FormHangar.FuelTankStatus.' + fe_tk));",
                        "int fe_w2 = 1;",
                        "if(fe_tk == 'Ok' || fe_tk == 'NeedFuel') fe_w2 = 0;",
                        "InterfaceState('Hangar', 'Light2', fe_w2);",
                        "str fe_tt = FE_Total();",
                        "InterfaceText('Hangar', 'Text4', CT('FormHangar.TotalStatus.' + fe_tt));",
                        "int fe_w4 = 0;",
                        "if(fe_tt == 'Bad' || fe_tt == 'RuinInHyperSpace' || fe_tt == 'ShipOvercharging') fe_w4 = 1;",
                        "InterfaceState('Hangar', 'Light4', fe_w4);",
                        "int fe_rb = 3;",
                        "if(fe_hc <= 0) fe_rb = 2;",
                        "InterfaceState('Hangar', 'ButRepair', fe_rb);",
                        "int fe_fb = 3;",
                        "if(FE_FuelCost() <= 0) fe_fb = 2;",
                        "InterfaceState('Hangar', 'ButRefuel', fe_fb);",
                        "int fe_tb = 3;",
                        "if(fe_w4) fe_tb = 2;",
                        "InterfaceState('Hangar', 'ButTakeOff', fe_tb);",
                        "}",
                        "",
                        "function FE_HgButtons()",
                        "{",
                        "int fe_h = 0;",
                        "if(FE_HullCost() > 0) fe_h = 1;",
                        "InterfaceState('Hangar', 'FE_HBtn', fe_h);",
                        "int fe_f = 0;",
                        "if(FE_FuelCost() > 0) fe_f = 1;",
                        "InterfaceState('Hangar', 'FE_TBtn', fe_f);",
                        "}",
                        "",
                        "function g_HullRepair(int fe_x)",
                        "{",
                        "dword fe_me = Player();",
                        "int fe_c = FE_HullCost();",
                        "if(fe_c > 0)",
                        "{",
                        "    int fe_m = ShipMoney(fe_me);",
                        "    if(fe_m <= 0) MessageBox(Format(CT('FormHangar.HullStatus.NotMoney'), '<Money>', '<color=255,240,100>' + fe_c + '</color>', ''));",
                        "    if(fe_m > 0)",
                        "    {",
                        "        dword fe_h = ShipEqInSlot(fe_me, 42);",
                        "        int fe_w = ItemSize(fe_h);",
                        "        int fe_hp = HullHP(fe_me);",
                        "        if(fe_c > fe_m)",
                        "        {",
                        "            HullHP(fe_me, fe_hp + round(1.0 * fe_m / fe_c * (fe_w - fe_hp)));",
                        "            ShipMoney(fe_me, 0);",
                        "        }",
                        "        if(fe_c <= fe_m)",
                        "        {",
                        "            ShipMoney(fe_me, fe_m - fe_c);",
                        "            HullHP(fe_me, fe_w);",
                        "        }",
                        "        Sound('Sound.Repair');",
                        "        FE_Board();",
                        "    }",
                        "}",
                        "FE_Hangar();",
                        "}",
                        "",
                        "function g_Refuel(int fe_x)",
                        "{",
                        "dword fe_me = Player();",
                        "int fe_c = FE_FuelCost();",
                        "if(fe_c > 0)",
                        "{",
                        "    if(fe_c > ShipMoney(fe_me)) MessageBox(Format(CT('FormHangar.FuelTankStatus.NotMoney'), '<Money>', '<color=255,240,100>' + fe_c + '</color>', ''));",
                        "    if(fe_c <= ShipMoney(fe_me))",
                        "    {",
                        "        ShipMoney(fe_me, ShipMoney(fe_me) - fe_c);",
                        "        ShipRefuel(fe_me);",
                        "        ShipCalcParam(fe_me);",
                        "        Sound('Sound.Sell');",
                        "        FE_Board();",
                        "    }",
                        "}",
                        "FE_Hangar();",
                        "}",
                        "",
                        "function FE_Evict()",
                        "{",
                        "result = 0;",
                        "dword fe_me = Player();",
                        "if(ShipSlots(fe_me, 8) == 0 && FE_Count() > 0)",
                        "{",
                        "    for(int fe_i = 0; fe_i < 3; fe_i = fe_i + 1)",
                        "    {",
                        "        dword fe_e = GetItemFromVault(FE_Key(fe_i));",
                        "        if(fe_e) AddItemToShip(fe_me, fe_e);",
                        "    }",
                        "    RunFunctionFromScript('Mod_Glovebox', 'Sync', 0);",
                        "    MsgAdd(CT('Script.Mod_ForsageBay.Evicted'), 0);",
                        "    result = 1;",
                        "}",
                        "}",
                        "",
                        "function g_Repair(int fe_x)",
                        "{",
                        "dword fe_me = Player();",
                        "int fe_cost = FE_RepCost();",
                        "if(fe_cost > 0)",
                        "{",
                        "    if(ShipMoney(fe_me) < fe_cost) MessageBox(Format(CT('Script.Mod_ForsageBay.NoMoney'), '<0'+'>', '' + fe_cost, ''));",
                        "    if(ShipMoney(fe_me) >= fe_cost)",
                        "    {",
                        "        if(MessageBoxYesNo(Format(CT('Script.Mod_ForsageBay.RepAsk'), '<0'+'>', '' + fe_cost, '')) == 1)",
                        "        {",
                        "            ShipMoney(fe_me, ShipMoney(fe_me) - fe_cost);",
                        "            for(int fe_i = 0; fe_i < 3; fe_i = fe_i + 1)",
                        "            {",
                        "                dword fe_e = FE_Peek(fe_i);",
                        "                if(fe_e)",
                        "                {",
                        "                    if(ShipCanRepairEq(fe_me, fe_e) == 1) ItemDurability(fe_e, 100);",
                        "                }",
                        "            }",
                        "            Sound('Sound.Repair');",
                        "        }",
                        "    }",
                        "}",
                        "FE_Hangar();",
                        "}",
                        "",
                        "function FE_StopAt()",
                        "{",
                        "result = 35;",
                        "str fe_s = '' + GetGameOptions('ForsageDeactivatePercent');",
                        "if(fe_s != '') result = 0 + fe_s;",
                        "}",
                        "",
                        "function FE_KeepOn()",
                        "{",
                        "result = 0;",
                        "dword fe_me = Player();",
                        "dword fe_b = FE_Best();",
                        "if(ShipCustomShipInfoData(fe_me, 'FE_Keep', 1) == 1 && OrderForsage(fe_me) == 0 && fe_b)",
                        "{",
                        "    int fe_ok = 0;",
                        "    if(ItemDurability(fe_b) > FE_StopAt() || ShipCustomShipInfoData(fe_me, 'FE_Hook', 3) == 2) fe_ok = 1;",
                        "    if(ShipInNormalSpace(fe_me) && ShipSlots(fe_me, 8) > 0 && fe_ok)",
                        "    {",
                        "        OrderForsage(fe_me, 1);",
                        "        result = 1;",
                        "    }",
                        "}",
                        "if(OrderForsage(fe_me) == 1) ShipCustomShipInfoData(fe_me, 'FE_Keep', 1, 0);",
                        "}",
                        "",
                        "function g_Keep(int fe_phase)",
                        "{",
                        "result = 0;",
                        "dword fe_me = Player();",
                        "dword fe_b = FE_Best();",
                        "int fe_lim = FE_StopAt();",
                        "if(fe_phase == 11 && OrderForsage(fe_me) == 1)",
                        "{",
                        "    int fe_low = 0;",
                        "    if(fe_b)",
                        "    {",
                        "        if(ItemDurability(fe_b) <= fe_lim) fe_low = 1;",
                        "    }",
                        "    if(fe_low && ShipCustomShipInfoData(fe_me, 'FE_Hook', 3) == 2) fe_low = 2;",
                        "    if(fe_low == 1)",
                        "    {",
                        "        OrderForsage(fe_me, 0);",
                        "        ShipCustomShipInfoData(fe_me, 'FE_Keep', 1, 0);",
                        "        Ether(8, '', Format(CT('Script.Mod_ForsageBay.Worn'), '<0'+'>', '' + ItemDurability(fe_b), '<1'+'>', '' + fe_lim, ''), fe_me);",
                        "        ShipCustomShipInfoData(fe_me, 'FE_Hook', 3, 2);",
                        "    }",
                        "    if(fe_low != 1 && fe_b)",
                        "    {",
                        "        int fe_main = 100;",
                        "        if(ShipEqInSlot(fe_me, 44)) fe_main = ItemDurability(ShipEqInSlot(fe_me, 44));",
                        "        if(fe_main <= fe_lim)",
                        "        {",
                        "            ShipCustomShipInfoData(fe_me, 'FE_Keep', 1, 1);",
                        "            OrderForsage(fe_me, 0);",
                        "        }",
                        "    }",
                        "}",
                        "if(fe_phase == 11) FE_FanDay();",
                        "if(fe_phase == 11) FE_SndFlush();",
                        "if(fe_phase == 0 || fe_phase == 100) result = FE_KeepOn();",
                        "if(fe_phase == 0 || fe_phase == 11 || fe_phase == 100) FE_Speed();",
                        "}",
                        "",
                        "function g_Form(int fe_x)",
                        "{",
                        "dword fe_me = Player();",
                        "FE_Evict();",
                        "str fe_f = CurrentForm();",
                        "if(fe_f == 'Ship')",
                        "{",
                        "    g_Paint(0);",
                        "    FE_Guard();",
                        "}",
                        "if(fe_f == 'Hangar') FE_Hangar();",
                        "}",
                        "",
                        "function FE_PShip(dword fq_sh, str fq_nm)",
                        "{",
                        "result = 0;",
                        "if(fq_sh)",
                        "{",
                        "    for(int fq_a = ShipArts(fq_sh) - 1; fq_a >= 0; fq_a = fq_a - 1)",
                        "    {",
                        "        dword fq_ar = ShipArts(fq_sh, fq_a);",
                        "        if(fq_ar)",
                        "        {",
                        "            if(EquipmentImageName(fq_ar) == fq_nm)",
                        "            {",
                        "                if(ItemIsInUse(fq_ar)) ItemIsInUse(fq_ar, fq_sh, 0);",
                        "                dword fq_ag = GetArtFromShip(fq_sh, fq_ar);",
                        "                if(fq_ag) FreeItem(fq_ag);",
                        "                result = result + 1;",
                        "            }",
                        "        }",
                        "    }",
                        "    for(int fq_k = ShipItems(fq_sh) - 1; fq_k >= 0; fq_k = fq_k - 1)",
                        "    {",
                        "        dword fq_it = ShipItems(fq_sh, fq_k);",
                        "        if(fq_it)",
                        "        {",
                        "            if(EquipmentImageName(fq_it) == fq_nm)",
                        "            {",
                        "                if(ItemIsInUse(fq_it)) ItemIsInUse(fq_it, fq_sh, 0);",
                        "                dword fq_g = GetItemFromShip(fq_sh, fq_it);",
                        "                if(fq_g) FreeItem(fq_g);",
                        "                result = result + 1;",
                        "            }",
                        "        }",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function FE_PShop(dword fq_o, str fq_nm)",
                        "{",
                        "result = 0;",
                        "for(int fq_k = ShopItems(fq_o) - 1; fq_k >= 0; fq_k = fq_k - 1)",
                        "{",
                        "    dword fq_it = ShopItems(fq_o, fq_k);",
                        "    if(fq_it)",
                        "    {",
                        "        if(EquipmentImageName(fq_it) == fq_nm)",
                        "        {",
                        "            dword fq_g = GetItemFromShop(fq_o, fq_it);",
                        "            if(fq_g) FreeItem(fq_g);",
                        "            result = result + 1;",
                        "        }",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function FE_Purge(str fq_nm)",
                        "{",
                        "result = 0;",
                        "for(int fq_i = 0; fq_i < GalaxyStars(); fq_i = fq_i + 1)",
                        "{",
                        "    dword fq_st = GalaxyStar(fq_i);",
                        "    for(int fq_j = StarShips(fq_st) - 1; fq_j >= 0; fq_j = fq_j - 1)",
                        "    {",
                        "        dword fq_s = StarShips(fq_st, fq_j);",
                        "        result = result + FE_PShip(fq_s, fq_nm);",
                        "        if(ObjectType(fq_s) == 4) result = result + FE_PShop(fq_s, fq_nm);",
                        "    }",
                        "    for(int fq_k = StarItems(fq_st) - 1; fq_k >= 0; fq_k = fq_k - 1)",
                        "    {",
                        "        dword fq_it = StarItems(fq_st, fq_k);",
                        "        if(fq_it)",
                        "        {",
                        "            if(EquipmentImageName(fq_it) == fq_nm)",
                        "            {",
                        "                dword fq_g = GetItemFromStar(fq_st, fq_it);",
                        "                if(fq_g) FreeItem(fq_g);",
                        "                result = result + 1;",
                        "            }",
                        "        }",
                        "    }",
                        "    for(int fq_q = 0; fq_q < StarPlanets(fq_st); fq_q = fq_q + 1)",
                        "    {",
                        "        dword fq_pl = StarPlanets(fq_st, fq_q);",
                        "        for(int fq_t = PlanetItems(fq_pl) - 1; fq_t >= 0; fq_t = fq_t - 1)",
                        "        {",
                        "            dword fq_ti = PlanetItems(fq_pl, fq_t);",
                        "            if(fq_ti)",
                        "            {",
                        "                if(EquipmentImageName(fq_ti) == fq_nm)",
                        "                {",
                        "                    dword fq_tg = GetItemFromPlanet(fq_pl, fq_t);",
                        "                    if(fq_tg) FreeItem(fq_tg);",
                        "                    result = result + 1;",
                        "                }",
                        "            }",
                        "        }",
                        "        result = result + FE_PShop(fq_pl, fq_nm);",
                        "    }",
                        "}",
                        "for(int fq_r = 0; fq_r < GalaxyRangers(); fq_r = fq_r + 1) result = result + FE_PShip(GalaxyRangers(fq_r), fq_nm);",
                        "result = result + FE_PShip(Player(), fq_nm);",
                        "for(int fq_v = StorageItems() - 1; fq_v >= 0; fq_v = fq_v - 1)",
                        "{",
                        "    dword fq_vi = StorageItems(fq_v);",
                        "    if(fq_vi)",
                        "    {",
                        "        if(EquipmentImageName(fq_vi) == fq_nm)",
                        "        {",
                        "            dword fq_vg = GetItemFromStorage(fq_v);",
                        "            if(fq_vg) FreeItem(fq_vg);",
                        "            result = result + 1;",
                        "        }",
                        "    }",
                        "}",
                        "for(int fq_w = 0; fq_w < 21; fq_w = fq_w + 1)",
                        "{",
                        "    str fq_n = 'GB_GB_' + fq_w;",
                        "    if(fq_w >= 18) fq_n = 'GB_FE_' + (fq_w - 18);",
                        "    dword fq_wi = GetItemFromVault(fq_n, 0);",
                        "    if(fq_wi)",
                        "    {",
                        "        if(EquipmentImageName(fq_wi) == fq_nm)",
                        "        {",
                        "            dword fq_wg = GetItemFromVault(fq_n);",
                        "            if(fq_wg) FreeItem(fq_wg);",
                        "            result = result + 1;",
                        "        }",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function g_Off(int fe_x)",
                        "{",
                        "result = FE_Purge('FE_Fan');",
                        "dword fe_me = Player();",
                        "if(OrderForsage(fe_me) == 1) OrderForsage(fe_me, 0);",
                        "for(int fe_i = 0; fe_i < 3; fe_i = fe_i + 1)",
                        "{",
                        "    dword fe_e = GetItemFromVault('GB_FE_' + fe_i);",
                        "    if(fe_e)",
                        "    {",
                        "        AddItemToShip(fe_me, fe_e);",
                        "        result = result + 1;",
                        "    }",
                        "}",
                        "ShipCalcParam(fe_me);",
                        "if(IsScriptActive('Mod_Glovebox')) RunFunctionFromScript('Mod_Glovebox', 'Sync', 0);",
                        "if(ShipFindCustomShipInfoByType(fe_me, 'FE_Hook') >= 0) ShipDeleteCustomShipInfo(fe_me, 'FE_Hook');",
                        "if(ShipFindCustomShipInfoByType(fe_me, 'FE_Wear') >= 0) ShipDeleteCustomShipInfo(fe_me, 'FE_Wear');",
                        "if(ShipFindCustomShipInfoByType(fe_me, 'FE_Spd') >= 0)",
                        "{",
                        "    int fe_sd = ShipCustomShipInfoData(fe_me, 'FE_Spd', 1);",
                        "    ShipSpecialBonuses(fe_me, 2, ShipSpecialBonuses(fe_me, 2) - fe_sd);",
                        "    ShipDeleteCustomShipInfo(fe_me, 'FE_Spd');",
                        "    ShipCalcParam(fe_me);",
                        "}",
                        "if(ShipFindCustomShipInfoByType(fe_me, 'FE_Keep') >= 0) ShipDeleteCustomShipInfo(fe_me, 'FE_Keep');",
                        "if(ShipFindCustomShipInfoByType(fe_me, 'FE_Nano') >= 0) ShipDeleteCustomShipInfo(fe_me, 'FE_Nano');",
                        "if(ShipFindCustomShipInfoByType(fe_me, 'FE_Off') < 0) ShipAddCustomShipInfo(fe_me, 'FE_Off');",
                        "AllShipOut();",
                        "}",
                        "",
                        "function FE_NotMe()",
                        "{",
                        "if(FE_Me == 0) FE_Me = Rnd(1, 1000000000);",
                        "result = 0;",
                        "if(GetValueFromScript('Mod_ForsageBay', 'FE_Me') != FE_Me) result = 1;",
                        "}",
                        "",
                        "function FE_Dedup()",
                        "{",
                        "result = FE_NotMe();",
                        "if(result) AllShipOut();",
                        "}"
                    ]
                },
