            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 6,
                    "Code.Type": "Global",
                    "Code": [
                        "if(!Player()) GRun(); else { if(ShipFindCustomShipInfoByType(Player(), 'TF_Off') < 0) GRun(); }"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 7,
                    "Code.Type": "Init",
                    "Code": [
                        "",
                        "// a system held by the true dominators (the user, 2026-10-08: other mods bring enemies that",
                        "// use the dominator mechanics): its series Blazer, Keller or Terron (StarSeries 0..2), at least",
                        "// one plain dominator ship (ShipType Kling, owner 5, not bound to a script) and no ship of the",
                        "// dominator owner of any other type (DomRuins, the dominator stations of the Domiks mods, allowed)",
                        "function TF_DomOk(dword tf_s)",
                        "{",
                        "result = 0;",
                        "int tf_sr = StarSeries(tf_s);",
                        "if(tf_sr >= 0 && tf_sr <= 2)",
                        "{",
                        "    int tf_vk = 0;",
                        "    int tf_bad = 0;",
                        "    for(int tf_i = 0; tf_i < StarShips(tf_s); tf_i = tf_i + 1)",
                        "    {",
                        "        dword tf_sh = StarShips(tf_s, tf_i);",
                        "        if(ShipOwner(tf_sh) == 5)",
                        "        {",
                        "            str tf_ty = ShipType(tf_sh);",
                        "            if(tf_ty == 'Kling')",
                        "            {",
                        "                if(ShipInScript(tf_sh) == 0) tf_vk = 1;",
                        "            }",
                        "            if(tf_ty != 'Kling' && tf_ty != 'DomRuins') tf_bad = 1;",
                        "        }",
                        "    }",
                        "    if(tf_vk && !tf_bad) result = 1;",
                        "}",
                        "}",
                        "",
                        "// for the tests: the system judged",
                        "function g_DomOk(dword tf_s)",
                        "{",
                        "result = TF_DomOk(tf_s);",
                        "}",
                        "",
                        "function g_Deal(dword tf_pb)",
                        "{",
                        "dword tf_me = Player();",
                        "",
                        "dword tf_home = ShipStar(tf_pb);",
                        "int tf_ns = GalaxyStars();",
                        "dword tf_pl = 0;",
                        "for(int tf_k = 0; tf_k < tf_ns; tf_k = tf_k + 1)",
                        "{",
                        "    if(!tf_pl)",
                        "    {",
                        "        dword tf_st = StarNearbyStars(tf_home, tf_k);",
                        "        if(tf_st)",
                        "        {",
                        "            if(StarOwner(tf_st) == 1 && TF_DomOk(tf_st))",
                        "            {",
                        "                for(int tf_p = 0; tf_p < StarPlanets(tf_st); tf_p = tf_p + 1)",
                        "                {",
                        "                    dword tf_c = StarPlanets(tf_st, tf_p);",
                        "                    if(!tf_pl && PlanetOwner(tf_c) == 6) tf_pl = tf_c;",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "}",
                        "",
                        "int tf_price = round(GalaxyMoney(3) / 10) * 10;",
                        "if(tf_price < 2000) tf_price = 2000;",
                        "",
                        "if(tf_pl && ShipMoney(tf_me) >= tf_price && ShipFindCustomShipInfoByType(tf_me, 'TF_MapGiven') == -1)",
                        "{",
                        "    ShipMoney(tf_me, ShipMoney(tf_me) - tf_price);",
                        "    dword tf_art = CreateCustomArt('TretonFocus', 15, 4000, 7);",
                        "    AddItemToPlanet(tf_pl, tf_art);",
                        "    dword tf_map = CreateQuestItem('TF_Map', 7);",
                        "    UselessItemData(tf_map, 1, Id(tf_pl));",
                        "    UselessItemData(tf_map, 2, Id(tf_art));",
                        "    UselessItemText(tf_map, Format(CT('Script.Mod_TretonFocus.MapText'), '<0'+'>', PlanetName(tf_pl), '<1'+'>', StarName(PlanetToStar(tf_pl)), ''));",
                        "    AddItemToShip(tf_me, tf_map);",
                        "    ShipAddCustomShipInfo(tf_me, 'TF_MapGiven', '', CurTurn(), Id(tf_pb), 0);",
                        "}",
                        "}",
                        "",
                        "function TF_PShip(dword tq_sh, str tq_nm)",
                        "{",
                        "result = 0;",
                        "if(tq_sh)",
                        "{",
                        "    for(int tq_a = ShipArts(tq_sh) - 1; tq_a >= 0; tq_a = tq_a - 1)",
                        "    {",
                        "        dword tq_ar = ShipArts(tq_sh, tq_a);",
                        "        if(tq_ar)",
                        "        {",
                        "            if(EquipmentImageName(tq_ar) == tq_nm)",
                        "            {",
                        "                if(ItemIsInUse(tq_ar)) ItemIsInUse(tq_ar, tq_sh, 0);",
                        "                dword tq_ag = GetArtFromShip(tq_sh, tq_ar);",
                        "                if(tq_ag) FreeItem(tq_ag);",
                        "                result = result + 1;",
                        "            }",
                        "        }",
                        "    }",
                        "    for(int tq_k = ShipItems(tq_sh) - 1; tq_k >= 0; tq_k = tq_k - 1)",
                        "    {",
                        "        dword tq_it = ShipItems(tq_sh, tq_k);",
                        "        if(tq_it)",
                        "        {",
                        "            if(EquipmentImageName(tq_it) == tq_nm)",
                        "            {",
                        "                if(ItemIsInUse(tq_it)) ItemIsInUse(tq_it, tq_sh, 0);",
                        "                dword tq_g = GetItemFromShip(tq_sh, tq_it);",
                        "                if(tq_g) FreeItem(tq_g);",
                        "                result = result + 1;",
                        "            }",
                        "        }",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function TF_PShop(dword tq_o, str tq_nm)",
                        "{",
                        "result = 0;",
                        "for(int tq_k = ShopItems(tq_o) - 1; tq_k >= 0; tq_k = tq_k - 1)",
                        "{",
                        "    dword tq_it = ShopItems(tq_o, tq_k);",
                        "    if(tq_it)",
                        "    {",
                        "        if(EquipmentImageName(tq_it) == tq_nm)",
                        "        {",
                        "            dword tq_g = GetItemFromShop(tq_o, tq_it);",
                        "            if(tq_g) FreeItem(tq_g);",
                        "            result = result + 1;",
                        "        }",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function TF_Purge(str tq_nm)",
                        "{",
                        "result = 0;",
                        "for(int tq_i = 0; tq_i < GalaxyStars(); tq_i = tq_i + 1)",
                        "{",
                        "    dword tq_st = GalaxyStar(tq_i);",
                        "    for(int tq_j = StarShips(tq_st) - 1; tq_j >= 0; tq_j = tq_j - 1)",
                        "    {",
                        "        dword tq_s = StarShips(tq_st, tq_j);",
                        "        result = result + TF_PShip(tq_s, tq_nm);",
                        "        if(ObjectType(tq_s) == 4) result = result + TF_PShop(tq_s, tq_nm);",
                        "    }",
                        "    for(int tq_k = StarItems(tq_st) - 1; tq_k >= 0; tq_k = tq_k - 1)",
                        "    {",
                        "        dword tq_it = StarItems(tq_st, tq_k);",
                        "        if(tq_it)",
                        "        {",
                        "            if(EquipmentImageName(tq_it) == tq_nm)",
                        "            {",
                        "                dword tq_g = GetItemFromStar(tq_st, tq_it);",
                        "                if(tq_g) FreeItem(tq_g);",
                        "                result = result + 1;",
                        "            }",
                        "        }",
                        "    }",
                        "    for(int tq_q = 0; tq_q < StarPlanets(tq_st); tq_q = tq_q + 1)",
                        "    {",
                        "        dword tq_pl = StarPlanets(tq_st, tq_q);",
                        "        for(int tq_t = PlanetItems(tq_pl) - 1; tq_t >= 0; tq_t = tq_t - 1)",
                        "        {",
                        "            dword tq_ti = PlanetItems(tq_pl, tq_t);",
                        "            if(tq_ti)",
                        "            {",
                        "                if(EquipmentImageName(tq_ti) == tq_nm)",
                        "                {",
                        "                    dword tq_tg = GetItemFromPlanet(tq_pl, tq_t);",
                        "                    if(tq_tg) FreeItem(tq_tg);",
                        "                    result = result + 1;",
                        "                }",
                        "            }",
                        "        }",
                        "        result = result + TF_PShop(tq_pl, tq_nm);",
                        "    }",
                        "}",
                        "for(int tq_r = 0; tq_r < GalaxyRangers(); tq_r = tq_r + 1) result = result + TF_PShip(GalaxyRangers(tq_r), tq_nm);",
                        "result = result + TF_PShip(Player(), tq_nm);",
                        "for(int tq_v = StorageItems() - 1; tq_v >= 0; tq_v = tq_v - 1)",
                        "{",
                        "    dword tq_vi = StorageItems(tq_v);",
                        "    if(tq_vi)",
                        "    {",
                        "        if(EquipmentImageName(tq_vi) == tq_nm)",
                        "        {",
                        "            dword tq_vg = GetItemFromStorage(tq_v);",
                        "            if(tq_vg) FreeItem(tq_vg);",
                        "            result = result + 1;",
                        "        }",
                        "    }",
                        "}",
                        "for(int tq_w = 0; tq_w < 21; tq_w = tq_w + 1)",
                        "{",
                        "    str tq_n = 'GB_GB_' + tq_w;",
                        "    if(tq_w >= 18) tq_n = 'GB_FE_' + (tq_w - 18);",
                        "    dword tq_wi = GetItemFromVault(tq_n, 0);",
                        "    if(tq_wi)",
                        "    {",
                        "        if(EquipmentImageName(tq_wi) == tq_nm)",
                        "        {",
                        "            dword tq_wg = GetItemFromVault(tq_n);",
                        "            if(tq_wg) FreeItem(tq_wg);",
                        "            result = result + 1;",
                        "        }",
                        "    }",
                        "}",
                        "}",
                        "",
                        "function TF_UndoShip(dword tf_s)",
                        "{",
                        "result = 0;",
                        "for(int tf_k = 0; tf_k < 10; tf_k = tf_k + 1)",
                        "{",
                        "    str tf_n = 'TF_B' + tf_k;",
                        "    if(ShipFindCustomShipInfoByType(tf_s, tf_n) >= 0)",
                        "    {",
                        "        int tf_id = ShipCustomShipInfoData(tf_s, tf_n, 1);",
                        "        int tf_base = ShipCustomShipInfoData(tf_s, tf_n, 2);",
                        "        int tf_dmg = ShipCustomShipInfoData(tf_s, tf_n, 3);",
                        "        int tf_max = int(tf_dmg / 65536);",
                        "        int tf_min = tf_dmg - tf_max * 65536;",
                        "        for(int tf_i = 0; tf_i < ShipItems(tf_s); tf_i = tf_i + 1)",
                        "        {",
                        "            dword tf_w = ShipItems(tf_s, tf_i);",
                        "            if(Id(tf_w) == tf_id)",
                        "            {",
                        "                SetEquipmentStats(tf_w, tf_base, 2);",
                        "                if(tf_max > 0)",
                        "                {",
                        "                    SetEquipmentStats(tf_w, tf_max, 0);",
                        "                    SetEquipmentStats(tf_w, tf_min, 1);",
                        "                }",
                        "            }",
                        "        }",
                        "        ShipDeleteCustomShipInfo(tf_s, tf_n);",
                        "        result = result + 1;",
                        "    }",
                        "}",
                        "if(ShipFindCustomShipInfoByType(tf_s, 'TF_Guard') >= 0) ShipDeleteCustomShipInfo(tf_s, 'TF_Guard');",
                        "if(ShipFindCustomShipInfoByType(tf_s, 'TF_Shot') >= 0) ShipDeleteCustomShipInfo(tf_s, 'TF_Shot');",
                        "}",
                        "",
                        "function g_Off(int tf_x)",
                        "{",
                        "result = TF_Purge('TretonFocus') + TF_Purge('TF_Map');",
                        "dword tf_me = Player();",
                        "for(int tf_i = 0; tf_i < GalaxyStars(); tf_i = tf_i + 1)",
                        "{",
                        "    dword tf_st = GalaxyStar(tf_i);",
                        "    for(int tf_j = 0; tf_j < StarShips(tf_st); tf_j = tf_j + 1) TF_UndoShip(StarShips(tf_st, tf_j));",
                        "}",
                        "for(int tf_r = 0; tf_r < GalaxyRangers(); tf_r = tf_r + 1) TF_UndoShip(GalaxyRangers(tf_r));",
                        "TF_UndoShip(tf_me);",
                        "ShipCalcParam(tf_me);",
                        "if(ShipFindCustomShipInfoByType(tf_me, 'TF_MapGiven') >= 0) ShipDeleteCustomShipInfo(tf_me, 'TF_MapGiven');",
                        "if(ShipFindCustomShipInfoByType(tf_me, 'TF_PirMap') >= 0) ShipDeleteCustomShipInfo(tf_me, 'TF_PirMap');",
                        "if(ShipFindCustomShipInfoByType(tf_me, 'TF_Off') < 0) ShipAddCustomShipInfo(tf_me, 'TF_Off');",
                        "AllShipOut();",
                        "}",
                        "",
                        "// THE NOTE IN A PIRATE TREASURE MAP (the user, 2026-10-08): besides the offer at a pirate base,",
                        "// a treasure map of the game (item type 74, dropped by pirates the player shoots down: 15 in 100",
                        "// of the plain ones, TShip.TryDropTreasureMap) carries with a 25 in 100 chance the note of",
                        "// Корсар Одессит: our map TF_Map to the cache of the focuser, in the nearest system of true",
                        "// dominators from the player.  Scripts can neither read the target of a treasure map nor see it",
                        "// used, so each one is judged once, the day it is first seen in the hold of the player (its Id",
                        "// kept in TF_PirMap TextData 1 as |id|; the chance a function of the Id, not a draw).  The",
                        "// artefact is buried by g_Claim.  Once per game, as the offer at the base.",
                        "",
                        "function TF_PlanCache(dword tf_pb)",
                        "{",
                        "",
                        "dword tf_home = ShipStar(tf_pb);",
                        "int tf_ns = GalaxyStars();",
                        "dword tf_pl = 0;",
                        "for(int tf_k = 0; tf_k < tf_ns; tf_k = tf_k + 1)",
                        "{",
                        "    if(!tf_pl)",
                        "    {",
                        "        dword tf_st = StarNearbyStars(tf_home, tf_k);",
                        "        if(tf_st)",
                        "        {",
                        "            if(StarOwner(tf_st) == 1 && TF_DomOk(tf_st))",
                        "            {",
                        "                for(int tf_p = 0; tf_p < StarPlanets(tf_st); tf_p = tf_p + 1)",
                        "                {",
                        "                    dword tf_c = StarPlanets(tf_st, tf_p);",
                        "                    if(!tf_pl && PlanetOwner(tf_c) == 6) tf_pl = tf_c;",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "}",
                        "",
                        "result = tf_pl;",
                        "}",
                        "",
                        "function TF_Day()",
                        "{",
                        "result = 0;",
                        "dword tf_me = Player();",
                        "int tf_go = 0;",
                        "if(tf_me)",
                        "{",
                        "    // a map of ours not claimed yet (the map own code runs only on entering a screen, and",
                        "    // the star map has no such event)",
                        "    for(int tf_h = 0; tf_h < ShipItems(tf_me); tf_h = tf_h + 1)",
                        "    {",
                        "        dword tf_hm = ShipItems(tf_me, tf_h);",
                        "        if(EquipmentImageName(tf_hm) == 'TF_Map')",
                        "        {",
                        "            if(UselessItemData(tf_hm, 2) == 0) g_Claim(tf_hm);",
                        "        }",
                        "    }",
                        "    if(ShipFindCustomShipInfoByType(tf_me, 'TF_MapGiven') == -1 && ShipFindCustomShipInfoByType(tf_me, 'TF_Off') == -1) tf_go = 1;",
                        "}",
                        "if(tf_go)",
                        "{",
                        "    if(ShipFindCustomShipInfoByType(tf_me, 'TF_PirMap') < 0) ShipAddCustomShipInfo(tf_me, 'TF_PirMap');",
                        "    str tf_seen = ShipCustomShipInfoTextData(tf_me, 'TF_PirMap', 1);",
                        "    for(int tf_k = 0; tf_k < ShipItems(tf_me); tf_k = tf_k + 1)",
                        "    {",
                        "        dword tf_tm = ShipItems(tf_me, tf_k);",
                        "        if(ItemType(tf_tm) == 74 && result == 0)",
                        "        {",
                        "            str tf_key = '|' + Id(tf_tm) + '|';",
                        "            if(findsubstr(tf_seen, tf_key) < 0)",
                        "            {",
                        "                tf_seen = tf_seen + tf_key;",
                        "                int tf_v = Id(tf_tm) * 7919 + 13;",
                        "                if(tf_v < 0) tf_v = 0 - tf_v;",
                        "                if(tf_v - int(tf_v / 100) * 100 < 25) result = TF_Note(tf_tm);",
                        "            }",
                        "        }",
                        "    }",
                        "    if(findsubstr(tf_seen, '|', 400) >= 0) tf_seen = substr(tf_seen, findsubstr(tf_seen, '||') + 1);",
                        "    ShipCustomShipInfoTextData(tf_me, 'TF_PirMap', 1, tf_seen);",
                        "}",
                        "}",
                        "",
                        "function TF_AnyCache(dword tf_pb)",
                        "{",
                        "result = 0;",
                        "dword tf_home = ShipStar(tf_pb);",
                        "if(tf_home)",
                        "{",
                        "    for(int tf_k = 0; tf_k < GalaxyStars(); tf_k = tf_k + 1)",
                        "    {",
                        "        if(!result)",
                        "        {",
                        "            dword tf_st = StarNearbyStars(tf_home, tf_k);",
                        "            if(tf_st)",
                        "            {",
                        "                for(int tf_p = 0; tf_p < StarPlanets(tf_st); tf_p = tf_p + 1)",
                        "                {",
                        "                    dword tf_c = StarPlanets(tf_st, tf_p);",
                        "                    if(!result && PlanetOwner(tf_c) == 6) result = tf_c;",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "}",
                        "}",
                        "",
                        "// the note found: our map in the hold, the cache buried at once",
                        "function TF_Note(dword tf_tm)",
                        "{",
                        "result = 0;",
                        "dword tf_me = Player();",
                        "dword tf_pl = TF_PlanCache(tf_me);",
                        "// where does not matter here (the user): with no system of true dominators left, the",
                        "// nearest uninhabited world anywhere",
                        "if(!tf_pl) tf_pl = TF_AnyCache(tf_me);",
                        "if(tf_pl)",
                        "{",
                        "    dword tf_map = CreateQuestItem('TF_Map', 7);",
                        "    UselessItemData(tf_map, 1, Id(tf_pl));",
                        "    UselessItemData(tf_map, 2, 0);",
                        "    UselessItemText(tf_map, Format(CT('Script.Mod_TretonFocus.MapTextPirate'), '<0' + '>', PlanetName(tf_pl), '<1' + '>', StarName(PlanetToStar(tf_pl)), ''));",
                        "    AddItemToShip(tf_me, tf_map);",
                        "    result = g_Claim(tf_map);",
                        "}",
                        "}",
                        "",
                        "// the player has a pirate map (from the map own code on entering a screen): the artefact",
                        "// buried now; if a map has changed hands already, this one is an empty one",
                        "function g_Claim(dword tf_map)",
                        "{",
                        "result = 0;",
                        "dword tf_me = Player();",
                        "if(tf_map && UselessItemData(tf_map, 2) == 0)",
                        "{",
                        "    if(ShipFindCustomShipInfoByType(tf_me, 'TF_MapGiven') >= 0)",
                        "    {",
                        "        UselessItemData(tf_map, 2, -1);",
                        "        UselessItemData(tf_map, 3, 1);",
                        "        UselessItemText(tf_map, CT('Script.Mod_TretonFocus.MapEmpty'));",
                        "    }",
                        "    else",
                        "    {",
                        "        dword tf_pl = IdToPlanet(UselessItemData(tf_map, 1));",
                        "        if(tf_pl)",
                        "        {",
                        "            dword tf_art = CreateCustomArt('TretonFocus', 15, 4000, 7);",
                        "            AddItemToPlanet(tf_pl, tf_art);",
                        "            UselessItemData(tf_map, 2, Id(tf_art));",
                        "            ShipAddCustomShipInfo(tf_me, 'TF_MapGiven', '', CurTurn(), 0, 0);",
                        "            if(ShipFindCustomShipInfoByType(tf_me, 'TF_PirMap') >= 0) ShipCustomShipInfoData(tf_me, 'TF_PirMap', 1, 0);",
                        "            Ether(2, '', Format(CT('Script.Mod_TretonFocus.MapFound'), '<0' + '>', PlanetName(tf_pl), '<1' + '>', StarName(PlanetToStar(tf_pl)), ''), tf_me);",
                        "            result = 1;",
                        "        }",
                        "    }",
                        "}",
                        "}",
                        "",
                        "// for the tests: judge this treasure map as if just found",
                        "function g_Note(dword tf_tm)",
                        "{",
                        "result = TF_Note(tf_tm);",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 8,
                    "Code.Type": "Turn",
                    "Code": [
                        "",
                        "TF_Day();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 9,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "",
                        "dword tf_me = Player();",
                        "dword tf_pb = GetShipRuins(tf_me);",
                        "if(tf_pb)",
                        "{",
                        "    if(ShipType(tf_pb) == 'PB')",
                        "    {",
                        "        if(ShipFindCustomShipInfoByType(tf_me, 'TF_MapGiven') == -1)",
                        "        {",
                        "            int tf_v = Id(tf_pb) * 31 + CurTurn() * 17;",
                        "            if(ShipStatus(tf_me, 1) >= 80 && tf_v - int(tf_v / 100) * 100 < 30)",
                        "            {",
                        "",
                        "dword tf_home = ShipStar(tf_pb);",
                        "int tf_ns = GalaxyStars();",
                        "dword tf_pl = 0;",
                        "for(int tf_k = 0; tf_k < tf_ns; tf_k = tf_k + 1)",
                        "{",
                        "    if(!tf_pl)",
                        "    {",
                        "        dword tf_st = StarNearbyStars(tf_home, tf_k);",
                        "        if(tf_st)",
                        "        {",
                        "            if(StarOwner(tf_st) == 1 && TF_DomOk(tf_st))",
                        "            {",
                        "                for(int tf_p = 0; tf_p < StarPlanets(tf_st); tf_p = tf_p + 1)",
                        "                {",
                        "                    dword tf_c = StarPlanets(tf_st, tf_p);",
                        "                    if(!tf_pl && PlanetOwner(tf_c) == 6) tf_pl = tf_c;",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "}",
                        "",
                        "                if(tf_pl)",
                        "                {",
                        "                    AddDialogInject('TF_Offer', CT('Script.Mod_TretonFocus.Teaser'), CT('Script.Mod_TretonFocus.Approach'), 100);",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 365,
                    "Parent": -1,
                    "#": 18,
                    "Code.Type": "Turn",
