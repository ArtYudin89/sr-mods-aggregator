                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 20,
                    "Code.Type": "Turn",
                    "Code": [
                        "dword tf_me = Player();",
                        "",
                        "int tf_price = round(GalaxyMoney(3) / 10) * 10;",
                        "if(tf_price < 2000) tf_price = 2000;",
                        "",
                        "str tf_t = Format(CT('Script.Mod_TretonFocus.Offer'), '<1'+'>', '' + tf_price, '');",
                        "if(ShipMoney(tf_me) < tf_price) tf_t = tf_t + '<br><br>' + CT('Script.Mod_TretonFocus.NoMoney');",
                        "if(ShipMoney(tf_me) >= tf_price) DAdd(0);",
                        "DAdd(1);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 130,
                    "Pos.y": 435,
                    "Parent": -1,
