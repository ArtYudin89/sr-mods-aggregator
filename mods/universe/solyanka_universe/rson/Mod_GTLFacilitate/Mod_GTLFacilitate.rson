            "Items": [],
            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 9,
                    "Code.Type": "Global",
                    "Code": [
                        "GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 10,
                    "Code.Type": "Init",
                    "Code": [
                        "if(findsubstr(GameDateTxtByTurn(CurTurn()),'1 января')==0)",
                        " \t{",
                        " \tcount1=0;",
                        " \t}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 11,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(GetShipRuins(Player())>0) {",
                        "  if(ShipType(GetShipRuins(Player()))=='SB') {",
                        "    science_rank = PlayerScienceRank['CurrentRank'];",
                        "    if (science_rank>1) AddDialogInject('Facilitate',CT(\"Script.Mod_GTLFacilitate.43\"),'Купить Облегчители',1);",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 365,
                    "Parent": -1,
                    "#": 21,
                    "Code.Type": "Turn",
                    "Code": [
                        "if (science_rank == 0)total1=0;",
                        "else if (science_rank == 1) total1=0;",
                        "else if (science_rank == 2) total1=1;",
                        "else if (science_rank == 3) total1=1;",
                        "else if (science_rank == 4) total1=2;",
                        "else if (science_rank == 5) total1=2;",
                        "else if (science_rank == 6) total1=3;",
                        "else if (science_rank == 7) total1=4;",
                        "else if (science_rank == 8) total1=5;",
                        "cost1=GalaxyTechLevel()*25000;",
                        "cur_count1=total1-count1;",
                        "DChange(0);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 22,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(cur_count1==0)AddDialogBlock('Купить Облегчитель',1);",
                        "DAdd(3);",
                        "DAdd(0);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 130,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 23,
                    "Code.Type": "Turn",
                    "Code": [
                        "DAdd(2);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 280,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 24,
                    "Code.Type": "Turn",
                    "Code": [
                        "DAdd(1);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 100,
                    "Pos.y": 505,
                    "Parent": -1,
                    "#": 25,
                    "Code.Type": "Turn",
                    "Code": [
                        "cost1=GalaxyTechLevel()*25000;",
                        "cur_count1=total1-count1;",
                        "DChange(0);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 340,
                    "Pos.y": 505,
                    "Parent": -1,
                    "#": 26,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(cost1>ShipMoney(Player())) {",
                        "  DChange(1);",
                        "  exit;",
                        "}",
                        "if(cost1<ShipMoney(Player())) {",
                        "  AddItemToShip(Player(),CreateQuestItem('Facilitate'));",
                        "  ShipMoney(Player(),ShipMoney(Player())-cost1);",
                        "  Sound('Sound.Buy');",
                        "  count1=count1+1;",
                        "  DChange(2);",
                        "  exit;",
                        "}"
                    ]
                }
            ],
