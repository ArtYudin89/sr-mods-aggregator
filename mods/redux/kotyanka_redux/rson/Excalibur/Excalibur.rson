                    "Code": [
                        "GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 8,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "if(state==1) {",
                        "  if(PirateWin()==1 || PirateWin()==2 || PirateWin()==5) {",
                        "    curPlanet=GetShipPlanet(Player());",
                        "    if(curPlanet) {",
                        "        if(curPlanet==PlanetPirateClan()) {",
                        "            if(PlanetOwner(PlanetPirateClan())==PirateClan) {",
                        "                if(ShipOwner(Player())==PirateClan && GetShipPirateRank(Player())>=7) {",
                        "                    AddDialogOverride('GetHull',23);",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 365,
                    "Parent": -1,
                    "#": 13,
                    "Code.Type": "Turn",
                    "Code": [
                        "DChange(0);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 14,
                    "Code.Type": "Turn",
                    "Code": [
                        "DAdd(0);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 505,
                    "Parent": -1,
                    "#": 15,
                    "Code.Type": "Turn",
                    "Code": [
                        "hull = CreateHull(",
                        "    2,",
                        "    500,",
                        "    GalaxyTechLevel(),",
                        "    People,",
                        "    -1,",
                        "    1",
                        ");",
                        "int bonus_num = FindBonusByName('Экскалибур');",
                        "SpecialToEquipment(bonus_num, hull);",
                        "ItemSize(hull, 500);",
                        "ItemCost(hull, 1000000);",
                        "HullHP(hull, 500);",
                        "AddItemToStorage(GetShipPlanet(Player()), hull);",
                        "CanSellItem(hull, 0);",
                        "state=2;",
                        "//Заканчиваем скрипт, чтобы не висело",
                        "AllShipOut();"
                    ]
                }
            ],
