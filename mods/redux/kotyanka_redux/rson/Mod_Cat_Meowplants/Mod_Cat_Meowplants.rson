            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 310,
                    "Parent": -1,
                    "#": 11,
                    "Code.Type": "Global",
                    "Code": [
                        "GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 310,
                    "Parent": -1,
                    "#": 12,
                    "Code.Type": "Turn",
                    "Code": [
                        "// Доп. инфошки биомодулей Cat_Meowplants (AddPlayerInfo): ExpImplants ставит их только NPC, игроку - по своему",
                        "// списку Uni_code (35..45 в нём нет). Ставим/снимаем по факту установки биомодуля (инфошка с TextData2 = путь).",
                        "for(mp_n=10;mp_n<=20;mp_n=mp_n+1) {",
                        "    mp_path = 'Biomodules.8_gtu.' + mp_n;",
                        "    mp_name = CT(mp_path + '.AddPlayerInfo');",
                        "    mp_found = 0;",
                        "    for(mp_i=0;mp_i<ShipCustomShipInfosCount(Player());mp_i=mp_i+1) {",
                        "        if(ShipCustomShipInfoTextData(Player(),mp_i,2) == mp_path) { mp_found = 1; break; }",
                        "    }",
                        "    if(mp_found) {",
                        "        if(ShipFindCustomShipInfoByType(Player(),mp_name) == -1) {",
                        "            if(mp_name == 'bioMM_Exponenta') ShipAddCustomShipInfo(Player(),mp_name,'NoShow',0,GetShipExpByType(Player(),0),int(CT(mp_path + '.AddExpPercent')));",
                        "            else ShipAddCustomShipInfo(Player(),mp_name,'NoShow');",
                        "        }",
                        "    }",
                        "    else if(~ShipFindCustomShipInfoByType(Player(),mp_name)) {",
                        "        if(mp_name == 'bioMM_Ganzales') ShipSpecialBonuses(Player(),bonSpeed,ShipSpecialBonuses(Player(),bonSpeed) - ShipCustomShipInfoData(Player(),mp_name,1));",
                        "        ShipDeleteCustomShipInfo(Player(),mp_name);",
                        "    }",
                        "}",
                        "if(~ShipFindCustomShipInfoByType(Player(),'bioMM_Miko')) GQuestVarExt_MikoBiomodule = 1;",
                        "else GQuestVarExt_MikoBiomodule = 0;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 310,
                    "Parent": -1,
                    "#": 13,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "if(TalkByAI()) {",
                        "    if(GetTalkType() == 3) {",
                        "        if(~ShipFindCustomShipInfoByType(Player(),'bioMM_Akabos')) {",
                        "            for(i=0;i<=int(CT('RefuseDialogs.Count'));i=i+1) {",
                        "                AddDialogBlock(CT('RefuseDialogs.Refuse'+i),1);",
                        "            }",
                        "        }",
                        "    }",
                        "    else if(GetTalkType() < 2) {",
                        "        if(~ShipFindCustomShipInfoByType(Player(),'bioMM_UltraTrus')) {",
                        "            for(i=1;i<=int(CT('TributeDialogs.Count'));i=i+1) {",
                        "                AddDialogBlock(CT('TributeDialogs.Tribute'+i),1);",
                        "            }",
                        "        }",
                        "    }",
                        "}"
                    ]
                }
            ],
