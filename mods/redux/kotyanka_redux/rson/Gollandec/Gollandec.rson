            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 645,
                    "Parent": -1,
                    "#": 18,
                    "Code.Type": "Global",
                    "Code": [
                        "if(GetShipPirateRank(Player()) >= 5) {",
                        "  SFT('условие Атаман получен');",
                        "  if(GalaxyTechLevel() >= 3) {",
                        "    SFT('условие гту 3 или больше');",
                        "    GRun();",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 645,
                    "Parent": -1,
                    "#": 19,
                    "Code.Type": "Init",
                    "Code": [
                        "good_special_name = CT('Script.Gollandec.Settings.good_special_name');",
                        "",
                        "hull_cost_1 = CT('Script.Gollandec.Settings.hull_cost_1');",
                        "",
                        "hull_size_good = CT('Script.Gollandec.Settings.hull_size_good');",
                        "",
                        "research_time_fast = CT('Script.Gollandec.Settings.research_time_fast');"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 645,
                    "Parent": -1,
                    "#": 20,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(state == 1) {",
                        "  if(CurTurn() >= research_start_date + research_time) {",
                        "    if(IdToShip(base_id)) {",
                        "      Ether(0, '', Format(CT(\"Script.Gollandec.205\"),\"<0>\",base_name));",
                        "      state = 2;",
                        "    }",
                        "  }",
                        "  if(!IdToShip(base_id)) {",
                        "    Ether(0, '', Format(CT(\"Script.Gollandec.187\"),\"<0>\",base_name));",
                        "    state = -1;",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 645,
                    "Parent": -1,
                    "#": 21,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "if(!PlayerBridge()) {",
                        "  if(GetShipRuins(Player())) {",
                        "    if(state == 0) {",
                        "      if(ShipType(GetShipRuins(Player())) == 'CB') {",
                        "        AddDialogInject('DialogCB1', '', CT(\"Script.Gollandec.217\"), 1);",
                        "      }",
                        "    }",
                        "    if(state == 1) {",
                        "      if(Id(GetShipRuins(Player())) == base_id) {",
                        "        AddDialogInject('DialogCB1.5', '', CT(\"Script.Gollandec.206\"), 1);",
                        "      }",
                        "      if(Id(GetShipRuins(Player())) != base_id) {",
                        "        if(ShipType(GetShipRuins(Player())) == 'CB') {",
                        "          AddDialogInject('WrongBase1.5', '', CT(\"Script.Gollandec.206\"), 1);",
                        "        }",
                        "      }",
                        "    }",
                        "    if(state == 2) {",
                        "      if(Id(GetShipRuins(Player())) == base_id) {",
                        "        AddDialogInject('DialogCB2', '', CT(\"Script.Gollandec.206\"), 1);",
                        "      }",
                        "      if(Id(GetShipRuins(Player())) != base_id) {",
                        "        if(ShipType(GetShipRuins(Player())) == 'CB') {",
                        "          AddDialogInject('WrongBase2', '', CT(\"Script.Gollandec.206\"), 1);",
                        "        }",
                        "      }",
                        "    }",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 43,
                    "Code.Type": "Turn",
                    "Code": [
                        "DChange(0);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 130,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 44,
