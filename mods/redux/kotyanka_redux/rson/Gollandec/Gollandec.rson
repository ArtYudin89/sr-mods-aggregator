                    "Parent": -1,
                    "#": 45,
                    "Code.Type": "Turn",
                    "Code": [
                        "DChange(2);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 430,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 46,
                    "Code.Type": "Turn",
                    "Code": [
                        "DChange(3);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 610,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 47,
                    "Code.Type": "Turn",
                    "Code": [
                        "DChange(4);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 505,
                    "Parent": -1,
                    "#": 48,
                    "Code.Type": "Turn",
                    "Code": [
                        "DAdd(5);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 130,
                    "Pos.y": 505,
                    "Parent": -1,
                    "#": 49,
                    "Code.Type": "Turn",
                    "Code": [
                        "ShipMoney(Player(), ShipMoney(Player()) - cost);",
                        "state = 4;",
                        "",
                        "hull = CreateHull(",
                        "    2,",
                        "    hull_size_good,",
                        "    8,",
                        "    PirateClan,",
                        "    -1,",
                        "    0",
                        ");",
                        "int bonus_num = FindBonusByName(good_special_name);",
                        "if (bonus_num > -1) {",
                        "    SpecialToEquipment(bonus_num, hull);",
                        "} else {",
                        "    SFT('[Cat_Gollandec] Акрин '+good_special_name+' не найден. Возможны дальнейшие проблемы');",
                        "}",
                        "",
                        "ItemSize(hull, hull_size_good);",
                        "ItemCost(hull, hull_cost_1);",
                        "HullHP(hull, ItemSize(hull));",
                        "AddItemToStorage(GetShipRuins(Player()), hull);",
                        "LinkItemToScript(hull, hull_good);",
                        "CanSellItem(hull_good, 1);",
                        "DAdd(0);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 280,
                    "Pos.y": 505,
                    "Parent": -1,
                    "#": 50,
                    "Code.Type": "Turn",
                    "Code": [
                        "DAdd(1);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 430,
                    "Pos.y": 505,
                    "Parent": -1,
                    "#": 51,
                    "Code.Type": "Turn",
                    "Code": [
                        "DAdd(3);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 580,
                    "Pos.y": 505,
                    "Parent": -1,
                    "#": 52,
                    "Code.Type": "Turn",
                    "Code": [
                        "DAdd(4);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 730,
                    "Pos.y": 505,
                    "Parent": -1,
                    "#": 53,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(ShipMoney(Player()) >= cost_sponsor && (GetNodesFromStorage(GetShipRuins(Player())) >= cost_sponsor_node || GetNodesFromShip(Player()) >= cost_sponsor_node)) {",
                        "  DAdd(6);",
                        "}",
                        "DAdd(7);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 880,
                    "Pos.y": 505,
                    "Parent": -1,
                    "#": 54,
                    "Code.Type": "Turn",
                    "Code": [
                        "DAdd(2);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 580,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 55,
                    "Code.Type": "Turn",
                    "Code": [
                        "DChange(5);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 700,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 56,
                    "Code.Type": "Turn",
                    "Code": [
                        "ShipMoney(Player(), ShipMoney(Player()) - cost_sponsor);",
                        "if(GetNodesFromShip(Player())>=cost_sponsor_node) GetNodesFromShip(Player(), cost_sponsor_node);",
                        "else GetNodesFromStorage(GetShipRuins(Player()), cost_sponsor_node);",
                        "Sound('Sound.Buy');",
                        "research_time = Rnd(0.8 * research_time_fast, 1.2 * research_time_fast);",
                        "base_id = Id(GetShipRuins(Player()));",
                        "base_name = ShipName(GetShipRuins(Player()));",
                        "research_start_date = CurTurn();",
                        "",
                        "state = 1;",
                        "DChange(6);",
                        "exit;"
                    ]
                }
            ],
