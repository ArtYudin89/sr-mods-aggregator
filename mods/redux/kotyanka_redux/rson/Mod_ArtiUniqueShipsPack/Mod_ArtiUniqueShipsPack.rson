                    "Code": [
                        "cur_item = CreateHull(6, CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.HullSize'), 8, GetValueFromScript('', CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.HullRace')), -1, CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.PirateClanAssembly'));",
                        "//Выставляем корпусу значение брони из Lang",
                        "SetEquipmentStats(cur_item, CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.HullArmor'), 0);",
                        "SpecialToEquipment(FindBonusByNameInCfg('ArtiUniqueShipsPack_BulwarkHull'), cur_item);",
                        "//Если в Lang стоимость не задана \"по умолчанию\", то подгружаем её напрямую оттуда",
                        "cost = CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.HullCost');",
                        "if(~cost) ItemCost(cur_item, cost);",
                        "//Заносим корпус в скрипт",
                        "LinkItemToScript(cur_item, BulwarkHull);",
                        "CanSellItem(cur_item, 1);",
                        "",
                        "AddItemToStorage(cur_ruin, cur_item);",
                        "",
                        "//Ставим маркер, что данный корпус купить повторно уже не выйдет",
                        "BulwarkWasBought = 1;",
                        "DChange(36);",
                        "exit;"
                    ]
                },
                {
