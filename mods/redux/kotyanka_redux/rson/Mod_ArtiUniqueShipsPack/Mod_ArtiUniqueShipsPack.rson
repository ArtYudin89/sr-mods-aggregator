            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 920,
                    "Parent": -1,
                    "#": 59,
                    "Code.Type": "Global",
                    "Code": [
                        "if(",
                        "    !IsScriptActive('Mod_ExpPilotBridge') ||",
                        "    !IsScriptActive('Mod_ExpArts') ||",
                        "    !IsScriptActive('Mod_ExpAcryn') ||",
                        "    !IsScriptActive('Mod_ExpTC') ||",
                        "    !IsScriptActive('Mod_ExpScienceRanks') ||",
                        "    !IsScriptActive('Mod_EvoSB')",
                        ") exit;",
                        "if(CurrentMods('KotyankaPlus\\\\ArtiUniqueShipsPack') && (!IsScriptActive('Mod_EvoArmada') || !IsScriptActive('Mod_EvoDreadnought'))) exit;",
                        "",
                        "GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 920,
                    "Parent": -1,
                    "#": 60,
                    "Code.Type": "Init",
                    "Code": [
                        "//Стартовый перебор с запоминанием числа доминионов в Галактике",
                        "for(i = 0; i < GalaxyStars(); i = i + 1)",
                        "{",
                        "    cur_star = GalaxyStar(i);",
                        "    if(StarRuins(cur_star, 'PB')) TotalPBCount = TotalPBCount + 1;",
                        "    if(StarRuins(cur_star, 'CB')) TotalCBCount = TotalCBCount + 1;",
                        "}",
                        "",
                        "function g_SpawnFriendPirate (int summ) {",
                        "    int j;",
                        "",
                        "    dword pirate = BuyWarrior(PlanetPirateClan(), 200 + 50 * summ);",
                        "    if(Rnd(0,2)) ShipSubType(pirate,1);",
                        "    else ShipSubType(pirate,2);",
                        "    for(j = 1; j <= (summ / 2); j = j + 1) ShipRefit(pirate);",
                        "    ShipImproveItems(pirate, max(summ - 4,0));",
                        "",
                        "    result = pirate;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 920,
                    "Parent": -1,
                    "#": 61,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!ShipIsTakeoff(Player())) {",
                        "  //Значения переменной ArtimisEventStatus:",
                        "  //-3 - событие завершилось уничтожением сферы, получением корпуса, либо уничтожением ТЦ, на котором изучали сферу;",
                        "  //-2 - стартовое значение переменной, скрипт запущен, но условия для закапывания сферы ещё не выполнены;",
                        "  //-1 - игрок засел на какой-то планете, ждём пока взлетит;",
                        "  //(5 или выше ГТУ, научное звание не ниже кандидата наук и 30 полностью исследованных незаселёнок, также необходимо находиться на расстоянии не ближе 50 парсек от родной системы)",
                        "  // 0 - сфера была закопана и ждёт игрока на планете, либо уже раскопана игроком и должна быть доставлена в ТЦ;",
                        "  // 1+ - сфера сдана на ЦР и начата постройка корпуса, значение переменной превращается в таймер (CurTurn() + N) вплоть до завершения постройки;",
                        "  if(ArtimisEventStatus == -2 || ArtimisEventStatus == -1)",
                        "  {",
                        "      if(ArtimisEventStatus == -2)",
                        "      {",
                        "          if(GalaxyTechLevel() >= 5)",
                        "          {",
                        "              if(holes > 99) {",
                        "                  cur_planet = GetShipPlanet(Player());",
                        "                  if(cur_planet)",
                        "                  {",
                        "                      //Ставим маркер о посещении планеты игроком, чтобы не перепроверять её по 100500 раз, пока игрок сидит и скипает ходы",
                        "                      ArtimisEventStatus = -1;",
                        "      ",
                        "                      //Если игрок сел именно на незаселёнку",
                        "                      if(PlanetOwner(cur_planet) == 6)",
                        "                      {",
                        "                          //Научное звание не ниже кандидата наук",
                        "                          if(PlayerScienceRank['CurrentRank'] >= 5)",
                        "                          {",
                        "                              //Полностью исследовано не менее 30 незаселёнок",
                        "                              if(GetValueFromScript('Mod_EvoSB', 'UninhabitedPlanetsExplored') >= 20)",
                        "                              {",
                        "                                  //Если расстояние до родной системы составляет не менее 50 парсек",
                        "                                  if(sqrt(Dist2Star(PlanetToStar(cur_planet), PlanetToStar(GetShipHomePlanet(Player())))) >= 50)",
                        "                                  {",
                        "                                      //Проверяем, полностью ли исследована незаселённая планета (должна быть не полностью)",
                        "                                      if(PlanetTerrain(cur_planet, 0) != PlanetTerrainExplored(cur_planet, 0) || PlanetTerrain(cur_planet, 1) != PlanetTerrainExplored(cur_planet, 1) || PlanetTerrain(cur_planet, 2) != PlanetTerrainExplored(cur_planet, 2))",
                        "                                      {",
                        "                                          //С некоторым шансом прячем сферу на планете",
                        "                                          if(Rnd(1, 100) <= 75)",
                        "                                          {",
                        "                                              cur_item = CreateQuestItem('ArtiUniqueShipsPack_UnknownSphere', 6);",
                        "                                              CanSellItem(cur_item, 1);",
                        "                                              AddItemToPlanet(cur_planet, cur_item);",
                        "                                              //Заносим сферу в скрипт",
                        "                                              LinkItemToScript(cur_item, UnknownSphere);",
                        "                                              //И вешаем на неё акткод, который завершит квест в случае уничтожения (в том числе и продажи) сферы",
                        "                                              ItemOnActCode(cur_item, 'if(ScriptItemActionType(t_OnItemDestroy)) ArtimisEventStatus = -3;');",
                        "      ",
                        "                                              //Обновляем статус квеста по поиску корпуса",
                        "                                              ArtimisEventStatus = 0;",
                        "                                          }",
                        "                                      }",
                        "                                  }",
                        "                              }",
                        "                          }",
                        "                      }",
                        "                  }",
                        "              }",
                        "          }",
                        "      }",
                        "      else if(ShipInNormalSpace(Player())) ArtimisEventStatus = -2;",
                        "  }",
                        "  //Завершаем квест если ТЦ, на который игрок стал сферу, был уничтожен",
                        "  else if(ArtimisEventStatus > 0)",
                        "  {",
                        "      cur_ruin = IdToShip(ArtimisStationId);",
                        "      if(!cur_ruin) ArtimisEventStatus = -2;",
                        "      else if(ArtimisEventStatus == CurTurn()) NewsAdd(Format(CT('Script.Mod_ArtiUniqueShipsPack.ArtimisHullReadyEther'), '<Base' + '>', ShipName(cur_ruin), '<Star' + '>', Name(ShipStar(cur_ruin))));",
                        "  }",
                        "  ",
                        "  //Перебираем все последние галактические эвенты, ловим события уничтожения дредноутов игроком",
                        "  for(i = GalaxyEvents() - 1; i >= 0; i = i - 1)",
                        "  {",
                        "      if(GalaxyEventDate(i) < CurTurn()) break;",
                        "  ",
                        "      tstr1 = GalaxyEventType(i);",
                        "      if(tstr1 == 'RuinsCreated')",
                        "      {",
                        "          tint1 = GalaxyEventData(i, 0);",
                        "          if(tint1 == t_PB)",
                        "          {",
                        "              if(GalaxyEventsTextData(i, 1) == '') TotalPBCount = TotalPBCount + 1;",
                        "          }",
                        "          else if(tint1 == t_CB)",
                        "          {",
                        "              if(GalaxyEventsTextData(i, 1) == '') TotalCBCount = TotalCBCount + 1;",
                        "          }",
                        "      }",
                        "      else if(tstr1 == 'RuinsDestroyed')",
                        "      {",
                        "          tint1 = GalaxyEventData(i, 0);",
                        "          if(tint1 == t_PB)",
                        "          {",
                        "              if(GalaxyEventsTextData(i, 1) == '') TotalPBCount = max(TotalPBCount - 1, 0);",
                        "          }",
                        "          else if(tint1 == t_CB)",
                        "          {",
                        "              if(GalaxyEventsTextData(i, 1) == '') TotalCBCount = max(TotalCBCount - 1, 0);",
                        "          }",
                        "      }",
                        "  }",
                        "  ",
                        "  //Отметка, что игрок первый раз попал в список рейнджеров как \"Отличившийся воин\"",
                        "  if(!EminentWarrior)",
                        "  {",
                        "      if(RangerStatus(Player(), 'EminentWarrior')) EminentWarrior = 1;",
                        "  }",
                        "  ",
                        "  //Считаем число дней подряд, когда торговый рейтинг игрока выше или равен 90",
                        "  if(!AscalonWasBought)",
                        "  {",
                        "      if(ShipStatus(Player(), 0) >= CT('Script.Mod_ArtiUniqueShipsPack.AscalonParamsList.TradeRatingToHold'))",
                        "      {",
                        "          AscalonDaysOfHighTrade = AscalonDaysOfHighTrade + 1;",
                        "      }",
                        "      else AscalonDaysOfHighTrade = 0;",
                        "  }",
                        "  ",
                        "  //Считаем дырки",
                        "          if(ShipInHole(Player()))",
                        "          {",
                        "              //Скипаем ЧД, которые проходятся без боя, но только не клисанские",
                        "              cur_hole = ShipOrderObj(Player());",
                        "              tstr1 = HoleMap(ShipOrderObj(Player()));",
                        "              if(tstr1 != 'SkipAB' || HoleStar1(cur_hole) == PlanetToStar(PlanetPirateClan()) || HoleStar2(cur_hole) == PlanetToStar(PlanetPirateClan()))",
                        "              {",
                        "                  //Если игрок ещё не получил очко за посещение данной ЧД",
                        "                  if(!add_complete)",
                        "                  {",
                        "                      add_complete = 1;",
                        "                  }",
                        "              }",
                        "              //Костыль, т.к. маркер 'SkipAB' после первого хода в ЧД сбрасывается на 'NoEntry'",
                        "              else add_complete = 1;",
                        "          }",
                        "  ",
                        "  //Игрок вылетел из ЧД, сбрасывается маркер добавления очка за посещение",
                        "  if(add_complete)",
                        "  {",
                        "      if(ShipInNormalSpace(Player())) {",
                        "          add_complete = 0;",
                        "          holes = holes + 1;",
                        "      }",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 920,
                    "Parent": -1,
                    "#": 62,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "cur_ruin = GetShipRuins(Player());",
                        "if(cur_ruin)",
                        "{",
                        "    tstr1 = Format(ShipType(cur_ruin), '_licensed', '', '');",
                        "    //Если игрок находится в технологическом центре",
                        "    if(tstr1 == 'WB')",
                        "    {",
                        "        if(!PlayerBridge())",
                        "        {",
                        "            //Если игрок ещё не покупал этот корпус",
                        "            if(!FistOfBroggWasBought)",
                        "            {",
                        "                if(ShipPilotRace(cur_ruin) == Maloc && ShipPilotRace(Player()) == Maloc && !ShipOnSidePirateClan(Player()))",
                        "                {",
                        "                    //Военное звание не ниже капитана",
                        "                    if(ShipRank(Player()) >= 3)",
                        "                    {",
                        "                        //Игрок уничтожил не менее 100 доминаторов",
                        "                        if(ShipStatistic(Player(), 2) >= 100)",
                        "                        {",
                        "                            //Если у игрока есть хоть один \"Калкитовый наконечник\", \"Убойный удар\" или \"Табель воина\"",
                        "                            if(CountRewardByNom(Player(), 1) || CountRewardByNom(Player(), 2) || CountRewardByNom(Player(), 3))",
                        "                            {",
                        "                                tstr1 = CT('Script.Mod_ArtiUniqueShipsPack.FistOfBrogg.BuyOffer');",
                        "                                tstr2 = CT('Script.Mod_ArtiUniqueShipsPack.FistOfBrogg.BuyStart');",
                        "                                AddDialogInject('FistOfBroggBuyDialog', tstr1, tstr2, 2);",
                        "                            }",
                        "                        }",
                        "                    }",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "    else if(tstr1 == 'TC')",
                        "    {",
                        "        if(ArtimisEventStatus >= 0)",
                        "        {",
                        "            //Если событие на поиск сферы и получение корпуса \"Артимида\" ещё не было завершено ни одним из способов",
                        "            if(!ArtimisEventStatus)",
                        "            {",
                        "                tstr1 = CT('Script.Mod_ArtiUniqueShipsPack.SphereFoundStart');",
                        "                if(ItemIn(UnknownSphere, Player())) AddDialogInject('UnknownSphereFoundDialog', '', tstr1, 1);",
                        "            }",
                        "            else if(ArtimisEventStatus <= CurTurn() && Id(cur_ruin) == ArtimisStationId)",
                        "            {",
                        "                tstr1 = CT('Script.Mod_ArtiUniqueShipsPack.ArtimisBuyStart');",
                        "                AddDialogInject('ArtimisBuyDialog', '', tstr1, 2);",
                        "            }",
                        "        }",
                        "",
                        "        //Если игрок ещё не изучил корпус \"Зион\" (надо сдавать на ТЦ пушки)",
                        "        if(!ZionWasBought)",
                        "        {",
                        "            if(GalaxyTechLevel() >= 6)",
                        "            {",
                        "                //Только для пеленгов",
                        "                if(ShipPilotRace(Player()) == Peleng && !ShipOnSidePirateClan(Player()))",
                        "                {",
                        "                    //Звание не ниже истребителя",
                        "                    if(ShipRank(Player()) >= 4)",
                        "                    {",
                        "                        //Игрок уничтожил не менее 150 доминаторов и 50 пиратов",
                        "                        if(ShipStatistic(Player(), 2) >= 150 && ShipStatistic(Player(), 1) >= 50)",
                        "                        {",
                        "                            tstr1 = CT('Script.Mod_ArtiUniqueShipsPack.Zion.UnlockOffer');",
                        "                            tstr2 = CT('Script.Mod_ArtiUniqueShipsPack.Zion.PlayerAskUnlock');",
                        "                            AddDialogInject('ZionUnlockDialog', tstr1, tstr2, 2);",
                        "                        }",
                        "                    }",
                        "                }",
                        "            }",
                        "        }",
                        "        //Если игрок ещё не приобрёл \"Зион\"",
                        "        else if(ZionWasBought == 1)",
                        "        {",
                        "            if(GalaxyTechLevel() >= 6)",
                        "            {",
                        "                if(ShipPilotRace(Player()) == Peleng && !ShipOnSidePirateClan(Player()))",
                        "                {",
                        "                    tstr1 = CT('Script.Mod_ArtiUniqueShipsPack.Zion.BuyOffer');",
                        "                    tstr2 = CT('Script.Mod_ArtiUniqueShipsPack.Zion.BuyStart');",
                        "                    AddDialogInject('ZionBuyDialog', tstr1, tstr2, 2);",
                        "                }",
                        "            }",
                        "        }",
                        "        //Если игрок уже купил \"Зион\", но ещё не выбрал к нему модификацию",
                        "        else if(ZionWasBought > 0)",
                        "        {",
                        "            if(ShipPilotRace(Player()) == Peleng && !ShipOnSidePirateClan(Player()))",
                        "            {",
                        "                if(ItemIn(ZionHull, Player()))",
                        "                {",
                        "                    tstr1 = CT('Script.Mod_ArtiUniqueShipsPack.Zion.ModsOffer');",
                        "                    tstr2 = CT('Script.Mod_ArtiUniqueShipsPack.Zion.ModsStart');",
                        "                    AddDialogInject('ZionModsBuyDialog', tstr1, tstr2, 2);",
                        "                }",
                        "            }",
                        "        }",
                        "",
                        "        if(CurrentMods('KotyankaPlus\\\\ArtiUniqueShipsPack'))",
                        "        {",
                        "            //Если игрок ещё не изучил корпус \"Аскалон\"",
                        "            if(!AscalonWasBought)",
                        "            {",
                        "                if(GalaxyTechLevel() >= 5)",
                        "                {",
                        "                    //Только для пеленгов",
                        "                    if(ShipPilotRace(Player()) == Fei && !ShipOnSidePirateClan(Player()))",
                        "                    {",
                        "                        //Не менее 20 выполненных правительственных заданий",
                        "                        if(PlayerQuestsCompleted() >= 20)",
                        "                        {",
                        "                            //\"Торговец года\"",
                        "                            if(AscalonDaysOfHighTrade >= CT('Script.Mod_ArtiUniqueShipsPack.AscalonParamsList.HowMuchToHoldTradeRating'))",
                        "                            {",
                        "                                tint1 = 0;",
                        "                                for(i = 0; i < StorageItems(); i = i + 1)",
                        "                                {",
                        "                                    if(StorageItemLocation(i) != cur_ruin) continue;",
                        "                                    cur_item = StorageItems(i);",
                        "                                    if(ItemType(cur_item) != t_Minerals) continue;",
                        "                                    tint1 = tint1 + ItemSize(cur_item);",
                        "                                }",
                        "",
                        "                                //Не менее 10.000 минералов на складе ТЦ",
                        "                                if(tint1 >= CT('Script.Mod_ArtiUniqueShipsPack.AscalonParamsList.MineralsOnStock'))",
                        "                                {",
                        "                                    tstr1 = CT('Script.Mod_ArtiUniqueShipsPack.Ascalon.BuyOffer');",
                        "                                    tstr2 = CT('Script.Mod_ArtiUniqueShipsPack.Ascalon.BuyStart');",
                        "                                    AddDialogInject('AscalonBuyDialog', tstr1, tstr2, 2);",
                        "                                }",
                        "                            }",
                        "                        }",
                        "                    }",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "    //Если игрок находится на научке",
                        "    else if(tstr1 == 'SB')",
                        "    {",
                        "        if(FindPlanet(ShipStar(Player()),'NotMaloc,NotFei,NotGaal,NotPeleng,NotKling,NotPirateClan,NotNone'))",
                        "        {",
                        "            //Если игрок ещё не покупал корпус \"Торнадо\"",
                        "            if(!TornadoWasBought)",
                        "            {",
                        "                //Игрок не должен состоять в пиратском клане, иметь звание командора, а также должен уничтожить не менее 5 дредноутов из EvoArmada",
                        "                if(!ShipOnSidePirateClan(Player()))",
                        "                {",
                        "                    if(ShipRank(Player()) > 5)",
                        "                    {",
                        "                        //Игрок уничтожил 3 бертора и 3 линкора, либо 3 фрегата",
                        "                        if(GDomBerStat >= 3 && GPirFrigStat >= 3)",
                        "                        {",
                        "                            tstr1 = '</color>' + CT('Script.Mod_ArtiUniqueShipsPack.TornadoBuyOffer');",
                        "                            tstr2 = '</color>' + CT('Script.Mod_ArtiUniqueShipsPack.TornadoBuyStart');",
                        "                            AddDialogInject('TornadoBuyDialog', tstr1, tstr2, 2);",
                        "                        }",
                        "                    }",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "    //Если игрок находится на доминионе",
                        "    else if(tstr1 == 'CB')",
                        "    {",
                        "        //Если игрок ещё не покупал корпус \"Друг\"",
                        "        if(!FriendWasBought)",
                        "        {",
                        "            if(GalaxyTechLevel() >= 7)",
                        "            {",
                        "                if(ShipOnSidePirateClan(Player()))",
                        "                {",
                        "                    //Звание не ниже барона",
                        "                    if(GetShipPirateRank(Player()) >= 7)",
                        "                    {",
                        "                        //Игрок освободил не менее 5 систем",
                        "                        if(ShipStatistic(Player(), 3) >= 5)",
                        "                        {",
                        "                            //Игрок уничтожил не менее 100 доминаторов и 20 военных",
                        "                            if(ShipStatistic(Player(), 2) >= 100 && ShipStatistic(Player(), 5) >= 20)",
                        "                            {",
                        "                                tstr1 = CT('Script.Mod_ArtiUniqueShipsPack.FriendBuyOffer');",
                        "                                tstr2 = CT('Script.Mod_ArtiUniqueShipsPack.FriendBuyStart');",
                        "                                AddDialogInject('FriendBuyDialog', tstr1, tstr2, 2);",
                        "                            }",
                        "                        }",
                        "                    }",
                        "                }",
                        "            }",
                        "        }",
                        "            //Значения сета в переменной BulwarkWasBought:",
                        "            //BulwarkWasBought == 0 - \"Оплот\" не куплен;",
                        "            //1 - \"Оплот\" куплен;",
                        "            //2 - куплен \"Оплот\" и дополнительный акрин к нему;",
                        "            //4 - куплен \"Оплот\" и первый апгрейд дополнительных выстрелов к нему;",
                        "            //5 - куплен \"Оплот\" и второй апгрейд дополнительных выстрелов к нему (суммируется к сету первого);",
                        "            //Максимальное значение переменной - 15;",
                        "            //Если игрок ещё не покупал корпус \"Оплот\"",
                        "            if(!BulwarkWasBought)",
                        "            {",
                        "                if(ShipOnSidePirateClan(Player()))",
                        "                {",
                        "                    //Звание не ниже хана",
                        "                    if(GetShipPirateRank(Player()) >= 6)",
                        "                    {",
                        "                        //Игрок уничтожил не менее 200 доминаторов и освободил не менее 10 систем",
                        "                        if(ShipStatistic(Player(), 2) >= 200 && ShipStatistic(Player(), 3) >= 10)",
                        "                        {",
                        "                            tstr1 = CT('Script.Mod_ArtiUniqueShipsPack.BulwarkBuyOffer');",
                        "                            tstr2 = CT('Script.Mod_ArtiUniqueShipsPack.BulwarkBuyStart');",
                        "                            AddDialogInject('BulwarkBuyDialog', tstr1, tstr2, 2);",
                        "                        }",
                        "                    }",
                        "                }",
                        "            }",
                        "            //Если игрок уже купил \"Оплот\", но ещё не скупил все модификации к нему",
                        "            else if(BulwarkWasBought < 15)",
                        "            {",
                        "                if(ShipOnSidePirateClan(Player()))",
                        "                {",
                        "                    //\"Оплот\" должен быть \"одет\" на игрока",
                        "                    if(ItemIn(BulwarkHull, Player()))",
                        "                    {",
                        "                        tstr1 = CT('Script.Mod_ArtiUniqueShipsPack.BulwarkModsOffer');",
                        "                        tstr2 = CT('Script.Mod_ArtiUniqueShipsPack.BulwarkModsStart');",
                        "                        AddDialogInject('BulwarkModsDialog', tstr1, tstr2, 2);",
                        "                    }",
                        "                }",
                        "            }",
                        "    }",
                        "    //Выдача корпусов в штабе в моде ShuMercsHQ",
                        "    else if(tstr1 == 'PlayerMercHQ' || tstr1 == 'PlayerMercHQ_licensed')",
                        "    {",
                        "        //Коалиционные корпуса",
                        "        if((PlayerMBHullsGiveAwaySet & 1))",
                        "        {",
                        "            PlayerMBHullsGiveAwaySet = PlayerMBHullsGiveAwaySet - 1;",
                        "            AddDialogOverride('AscalonGetDialog', 50000000);",
                        "        }",
                        "        if((PlayerMBHullsGiveAwaySet & 2))",
                        "        {",
                        "            PlayerMBHullsGiveAwaySet = PlayerMBHullsGiveAwaySet - 2;",
                        "            AddDialogOverride('ZionGetDialog', 50000000);",
                        "        }",
                        "        if((PlayerMBHullsGiveAwaySet & 4))",
                        "        {",
                        "            PlayerMBHullsGiveAwaySet = PlayerMBHullsGiveAwaySet - 4;",
                        "            AddDialogOverride('FistOfBroggGetDialog', 50000000);",
                        "        }",
                        "        if((PlayerMBHullsGiveAwaySet & 8))",
                        "        {",
                        "            PlayerMBHullsGiveAwaySet = PlayerMBHullsGiveAwaySet - 8;",
                        "            AddDialogOverride('TornadoGetDialog', 50000000);",
                        "        }",
                        "",
                        "        //Пиратские корпуса",
                        "        if((PlayerMBHullsGiveAwaySet & 16))",
                        "        {",
                        "            PlayerMBHullsGiveAwaySet = PlayerMBHullsGiveAwaySet - 16;",
                        "            AddDialogOverride('FriendGetDialog', 50000000);",
                        "        }",
                        "        if((PlayerMBHullsGiveAwaySet & 32))",
                        "        {",
                        "            PlayerMBHullsGiveAwaySet = PlayerMBHullsGiveAwaySet - 32;",
                        "            AddDialogOverride('BulwarkGetDialog', 50000000);",
                        "        }",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 160,
                    "Pos.y": 375,
                    "Parent": -1,
                    "#": 168,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(GetData() <= CurTurn())",
                        "{",
                        "    ShipSpecialBonuses(CurShip, bonFuel, ShipSpecialBonuses(CurShip, bonFuel) + 10000);",
                        "    ShipOut(CurShip);",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 535,
                    "Parent": -1,
                    "#": 169,
                    "Code.Type": "Turn",
                    "Code": [
                        "//Определяем цену корпуса \"Артимида\"",
                        "//Размер корпуса берём из Lang",
                        "tint1 = CT('Script.Mod_ArtiUniqueShipsPack.ArtimisParamsList.HullSize');",
                        "tint2 = GetValueFromScript('', CT('Script.Mod_ArtiUniqueShipsPack.ArtimisParamsList.HullRace'));",
                        "cur_item = CreateHull(6, tint1, 8, tint2, -1, CT('Script.Mod_ArtiUniqueShipsPack.ArtimisParamsList.PirateClanAssembly'));",
                        "//Выставляем корпусу значение брони из Lang",
                        "SetEquipmentStats(cur_item, CT('Script.Mod_ArtiUniqueShipsPack.ArtimisParamsList.HullArmor'), 0);",
                        "bonus_num = FindBonusByNameInCfg('ArtiUniqueShipsPack_ArtimisHull');",
                        "SpecialToEquipment(bonus_num, cur_item);",
                        "cost = ItemCost(cur_item);",
                        "//Если в Lang стоимость не задана \"по умолчанию\", то подгружаем её напрямую оттуда",
                        "if(CT('Script.Mod_ArtiUniqueShipsPack.ArtimisParamsList.HullCost') != '-1') cost = abs(0 + CT('Script.Mod_ArtiUniqueShipsPack.ArtimisParamsList.HullCost'));",
                        "",
                        "//Удаляем \"расчётный\" корпус во избежание утечки памяти",
                        "FreeItem(cur_item);",
                        "",
                        "tstr1 = '</color>' + Format(CT('Script.Mod_ArtiUniqueShipsPack.Artimis.ArtimisBuy'), '<Cost' + '>', cost);",
                        "tstr2 = '</color>' + CT('Script.Mod_ArtiUniqueShipsPack.Artimis.ArtimisBuyPlayerYes');",
                        "tstr3 = '</color>' + CT('Script.Mod_ArtiUniqueShipsPack.Artimis.ArtimisBuyPlayerNo');",
                        "DChange(0);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 220,
                    "Pos.y": 535,
                    "Parent": -1,
                    "#": 170,
                    "Code.Type": "Turn",
                    "Code": [
                        "tstr1 = '</color>' + CT('Script.Mod_ArtiUniqueShipsPack.Artimis.SphereFound');",
                        "tstr2 = '</color>' + CT('Script.Mod_ArtiUniqueShipsPack.Artimis.SphereFoundPlayerYes');",
                        "tstr3 = '</color>' + CT('Script.Mod_ArtiUniqueShipsPack.Artimis.SphereFoundPlayerNo');",
                        "DChange(3);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 580,
                    "Pos.y": 535,
                    "Parent": -1,
                    "#": 171,
                    "Code.Type": "Turn",
                    "Code": [
                        "cur_item = CreateHull(6, CT('Script.Mod_ArtiUniqueShipsPack.TornadoParamsList.HullSize'), 8, GetValueFromScript('', CT('Script.Mod_ArtiUniqueShipsPack.TornadoParamsList.HullRace')), -1, CT('Script.Mod_ArtiUniqueShipsPack.TornadoParamsList.PirateClanAssembly'));",
                        "//Выставляем корпусу значение брони из Lang",
                        "SetEquipmentStats(cur_item, CT('Script.Mod_ArtiUniqueShipsPack.TornadoParamsList.HullArmor'), 0);",
                        "bonus_num = FindBonusByNameInCfg('ArtiUniqueShipsPack_TornadoHullNormal');",
                        "SpecialToEquipment(bonus_num, cur_item);",
                        "//Запоминаем полученную цену",
                        "cost = ItemCost(cur_item);",
                        "//Если в Lang стоимость не задана \"по умолчанию\", то подгружаем её напрямую оттуда",
                        "if(CT('Script.Mod_ArtiUniqueShipsPack.TornadoParamsList.HullCost') != '-1') cost = abs(0 + CT('Script.Mod_ArtiUniqueShipsPack.TornadoParamsList.HullCost'));",
                        "",
                        "//Удаляем \"расчётный\" корпус во избежание утечки памяти",
                        "FreeItem(cur_item);",
                        "",
                        "tstr1 = '</color>' + Format(CT('Script.Mod_ArtiUniqueShipsPack.Tornado.TornadoBuy'), '<Cost' + '>', cost);",
                        "tstr2 = '</color>' + CT('Script.Mod_ArtiUniqueShipsPack.Tornado.TornadoBuyPlayerYes');",
                        "tstr3 = '</color>' + CT('Script.Mod_ArtiUniqueShipsPack.Tornado.TornadoBuyPlayerNo');",
                        "DChange(6);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 820,
                    "Pos.y": 535,
                    "Parent": -1,
                    "#": 172,
                    "Code.Type": "Turn",
                    "Code": [
                        "cur_item = CreateHull(6, CT('Script.Mod_ArtiUniqueShipsPack.FriendParamsList.HullSize'), 8, GetValueFromScript('', CT('Script.Mod_ArtiUniqueShipsPack.FriendParamsList.HullRace')), -1, CT('Script.Mod_ArtiUniqueShipsPack.FriendParamsList.PirateClanAssembly'));",
                        "//Выставляем корпусу значение брони из Lang",
                        "SetEquipmentStats(cur_item, CT('Script.Mod_ArtiUniqueShipsPack.FriendParamsList.HullArmor'), 0);",
                        "bonus_num = FindBonusByNameInCfg('ArtiUniqueShipsPack_FriendHull');",
                        "SpecialToEquipment(bonus_num, cur_item);",
                        "//Маркер на запрет автоспавна пиратов из корпуса",
                        "ItemExtraSpecialsAddByType(cur_item, FindBonusByNameInCfg('ArtiUniqueShipsPack_FriendHullPirateSpawnIsOff'));",
                        "//Запоминаем полученную цену",
                        "cost = ItemCost(cur_item);",
                        "//Если в Lang стоимость не задана \"по умолчанию\", то подгружаем её напрямую оттуда",
                        "if(CT('Script.Mod_ArtiUniqueShipsPack.FriendParamsList.HullCost') != '-1') cost = abs(0 + CT('Script.Mod_ArtiUniqueShipsPack.FriendParamsList.HullCost'));",
                        "",
                        "//Удаляем \"расчётный\" корпус во избежание утечки памяти",
                        "FreeItem(cur_item);",
                        "",
                        "tstr1 = '</color>' + Format(CT('Script.Mod_ArtiUniqueShipsPack.Friend.FriendBuy'), '<Cost' + '>', cost);",
                        "tstr2 = '</color>' + CT('Script.Mod_ArtiUniqueShipsPack.Friend.FriendBuyPlayerYes');",
                        "tstr3 = '</color>' + CT('Script.Mod_ArtiUniqueShipsPack.Friend.FriendBuyPlayerNo');",
                        "DChange(9);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 1030,
                    "Pos.y": 535,
                    "Parent": -1,
                    "#": 173,
                    "Code.Type": "Turn",
                    "Code": [
                        "cur_item = CreateHull(6, CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.HullSize'), 8, GetValueFromScript('', CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.HullRace')), -1, CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.PirateClanAssembly'));",
                        "//Выставляем корпусу значение брони из Lang",
                        "SetEquipmentStats(cur_item, CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.HullArmor'), 0);",
                        "bonus_num = FindBonusByNameInCfg('ArtiUniqueShipsPack_BulwarkHull');",
                        "SpecialToEquipment(bonus_num, cur_item);",
                        "//Запоминаем полученную цену",
                        "cost = ItemCost(cur_item);",
                        "//Если в Lang стоимость не задана \"по умолчанию\", то подгружаем её напрямую оттуда",
                        "if(CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.HullCost') != '-1') cost = abs(0 + CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.HullCost'));",
                        "",
                        "//Удаляем \"расчётный\" корпус во избежание утечки памяти",
                        "FreeItem(cur_item);",
                        "",
                        "tstr1 = '</color>' + Format(CT('Script.Mod_ArtiUniqueShipsPack.Bulwark.BulwarkBuy'), '<Cost' + '>', cost);",
                        "tstr2 = '</color>' + CT('Script.Mod_ArtiUniqueShipsPack.Bulwark.BulwarkBuyPlayerYes');",
                        "tstr3 = '</color>' + CT('Script.Mod_ArtiUniqueShipsPack.Bulwark.BulwarkBuyPlayerNo');",
                        "DChange(12);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 1270,
                    "Pos.y": 535,
                    "Parent": -1,
                    "#": 174,
                    "Code.Type": "Turn",
                    "Code": [
                        "tstr1 = '</color>' + CT('Script.Mod_ArtiUniqueShipsPack.Bulwark.BulwarkModsBuy');",
                        "//Добавляем дополнительную информацию о модулях, если игрок ещё не выбрал себе один",
                        "if(!(BulwarkWasBought & 2))",
                        "{",
                        "    tstr1 = tstr1 + CT(\"Script.Mod_ArtiUniqueShipsPack.2\") + CT('Script.Mod_ArtiUniqueShipsPack.Bulwark.BulwarkModsBuyAcryn');",
                        "    tstr1 = tstr1 + CT(\"Script.Mod_ArtiUniqueShipsPack.2\") + CT(\"Script.Mod_ArtiUniqueShipsPack.2\") + BonusText(FindBonusByNameInCfg('ArtiUniqueShipsPack_BulwarkHullFearlessMod'));",
                        "    tstr1 = tstr1 + CT(\"Script.Mod_ArtiUniqueShipsPack.2\") + CT(\"Script.Mod_ArtiUniqueShipsPack.2\") + BonusText(FindBonusByNameInCfg('ArtiUniqueShipsPack_BulwarkHullProtectiveMod'));",
                        "    tstr1 = tstr1 + CT(\"Script.Mod_ArtiUniqueShipsPack.2\") + CT(\"Script.Mod_ArtiUniqueShipsPack.2\") + BonusText(FindBonusByNameInCfg('ArtiUniqueShipsPack_BulwarkHullAMLMod'));",
                        "}",
                        "DChange(15);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 1510,
                    "Pos.y": 535,
                    "Parent": -1,
                    "#": 175,
                    "Code.Type": "Turn",
                    "Code": [
                        "tint1 = GAnswerData;",
                        "cur_item = ShipItems(Player(), 0);",
                        "",
                        "//Устанавливаем модуль \"Бесстрашный\"",
                        "if(tint1 == 1)",
                        "{",
                        "    ItemExtraSpecialsAddByType(cur_item, FindBonusByNameInCfg('ArtiUniqueShipsPack_BulwarkHullFearlessMod'));",
                        "",
                        "    BulwarkWasBought = BulwarkWasBought + 2;",
                        "    cost = abs(0 + CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.ModAcrynsCost'));",
                        "}",
                        "//Устанавливаем модуль \"Защитный\"",
                        "else if(tint1 == 2)",
                        "{",
                        "    ItemExtraSpecialsAddByType(cur_item, FindBonusByNameInCfg('ArtiUniqueShipsPack_BulwarkHullProtectiveMod'));",
                        "",
                        "    BulwarkWasBought = BulwarkWasBought + 2;",
                        "    cost = abs(0 + CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.ModAcrynsCost'));",
                        "}",
                        "//Устанавливаем модуль \"ПРК\"",
                        "else if(tint1 == 3)",
                        "{",
                        "    ItemExtraSpecialsAddByType(cur_item, FindBonusByNameInCfg('ArtiUniqueShipsPack_BulwarkHullAMLMod'));",
                        "    ItemOnActCode(cur_item, GenerateCodeStringFromBlock('ActCodeBlocksList.ArtiUniqueShipsPack_BulwarkHullAMLModActCode'));",
                        "    //Вешаем на игрока инфошку, имитирующую аЭгис",
                        "    ShipAddCustomShipInfo(Player(), 'ArtiUniqueShipsPack_kPDTurretInfos', 'NoShow', 5, CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.ModPDTurretRange'));",
                        "",
                        "    BulwarkWasBought = BulwarkWasBought + 2;",
                        "    cost = abs(0 + CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.ModAcrynsCost'));",
                        "}",
                        "//Устанавливаем первый апгрейд с дополнительными выстрелами",
                        "else if(tint1 == 4)",
                        "{",
                        "    tint2 = CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.ModAddShotsFirstUpgrade');",
                        "    ShipSpecialBonuses(Player(), bonAttacks, tint2 - 1);",
                        "    if(ShipFindCustomShipInfoByType(Player(), 'EvoArmada_CapitalShipInfos') == -1) ShipAddCustomShipInfo(Player(), 'EvoArmada_CapitalShipInfos', 'NoShow', tint2 - 1);",
                        "    else ShipCustomShipInfoData(Player(), 'EvoArmada_CapitalShipInfos', 1, tint2 - 1);",
                        "    if(ItemOnActCode(cur_item) == '') ItemOnActCode(cur_item, GenerateCodeStringFromBlock('ActCodeBlocksList.ArtiUniqueShipsPack_BulwarkHullExtraShotsActCode'));",
                        "",
                        "    BulwarkWasBought = BulwarkWasBought + 4;",
                        "    cost = abs(0 + CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.ModAddShotsFirstUpgradeCost'));",
                        "}",
                        "//Устанавливаем второй апгрейд с дополнительными выстрелами",
                        "else",
                        "{",
                        "    tint2 = CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.ModAddShotsSecondUpgrade');",
                        "    ShipSpecialBonuses(Player(), bonAttacks, tint2 - 1);",
                        "    if(ShipFindCustomShipInfoByType(Player(), 'EvoArmada_CapitalShipInfos') == -1) ShipAddCustomShipInfo(Player(), 'EvoArmada_CapitalShipInfos', 'NoShow', tint2 - 1);",
                        "    else ShipCustomShipInfoData(Player(), 'EvoArmada_CapitalShipInfos', 1, tint2 - 1);",
                        "    if(ItemOnActCode(cur_item) == '') ItemOnActCode(cur_item, GenerateCodeStringFromBlock('ActCodeBlocksList.ArtiUniqueShipsPack_BulwarkHullExtraShotsActCode'));",
                        "",
                        "    BulwarkWasBought = BulwarkWasBought + 8;",
                        "    cost = abs(0 + CT('Script.Mod_ArtiUniqueShipsPack.BulwarkParamsList.ModAddShotsSecondUpgradeCost'));",
                        "}",
                        "",
                        "ItemCost(cur_item, ItemCost(cur_item) + cost);",
                        "ShipMoney(Player(), ShipMoney(Player()) - cost);",
                        "Sound('Sound.Buy');",
                        "",
                        "tstr1 = '</color>' + CT('Script.Mod_ArtiUniqueShipsPack.Bulwark.BulwarkModsBuyYes');",
                        "DChange(16);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 560,
                    "Parent": -1,
