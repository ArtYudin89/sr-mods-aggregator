                    "Parent": -1,
                    "#": 67,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!HaveProgramm(progIntercom)) {",
                        "  //Тексты сообщения и ответов (ванильные ключи Lang Script.MS_Terron.N)",
                        "  tstr1 = '</color>' + CT('Script.MS_Terron.20');",
                        "  tstr2 = '</color>' + CT('Script.MS_Terron.43');",
                        "  DChange(20);",
                        "  exit;",
                        "}",
                        "if(HaveProgramm(progIntercom) && MS_Terron_Crack) {",
                        "  //Тексты сообщения и ответов (ванильные ключи Lang Script.MS_Terron.N)",
                        "  tstr1 = '</color>' + CT('Script.MS_Terron.45');",
                        "  tstr2 = '</color>' + CT('Script.MS_Terron.37');",
                        "  DChange(21);",
                        "  exit;",
                        "}",
                        "if(HaveProgramm(progIntercom) && MS_Terron_ToStar) {",
                        "  //Тексты сообщения и ответов (ванильные ключи Lang Script.MS_Terron.N)",
                        "  tstr1 = '</color>' + CT('Script.MS_Terron.15');",
                        "  tstr2 = '</color>' + CT('Script.MS_Terron.42');",
                        "  DChange(15);",
                        "  exit;",
                        "}",
                        "if(HaveProgramm(progIntercom) && !MS_Terron_DialogOk && !MS_Terron_ToStar && !MS_Terron_Crack) {",
                        "  MS_Terron_DialogOk=1;",
                        "  //Тексты сообщения и ответов (ванильные ключи Lang Script.MS_Terron.N)",
                        "  tstr1 = '</color>' + CT('Script.MS_Terron.0');",
                        "  tstr2 = '</color>' + CT('Script.MS_Terron.21');",
                        "  DChange(0);",
                        "  exit;",
                        "}",
                        "if(HaveProgramm(progIntercom) && MS_Terron_DialogOk && !MS_Terron_ToStar && !MS_Terron_Crack) {",
