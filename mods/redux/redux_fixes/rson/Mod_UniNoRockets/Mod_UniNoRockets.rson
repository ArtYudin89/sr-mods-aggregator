            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 285,
                    "Parent": -1,
                    "#": 4,
                    "Code.Type": "Global",
                    "Code": [
                        "if(!GCntRun(GScriptName)) GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 285,
                    "Parent": -1,
                    "#": 5,
                    "Code.Type": "Init",
                    "Code": [
                        "for(int i = 0; GalaxyStars() > i; i = i + 1) {",
                        "    dword cur_star = GalaxyStar(i);",
                        "    dword tdwd;",
                        "    dword cur_item;",
                        "    int y;",
                        "    ",
                        "    for(int j = 0; StarShips(cur_star) > j; j = j + 1) {",
                        "        tdwd = StarShips(cur_star,j);",
                        "        for(y = ShipItems(tdwd); -1 < y; y = y - 1) {",
                        "            cur_item = ShipItems(tdwd,y);",
                        "            if(ItemType(cur_item) < t_Weapon1) continue;",
                        "            if(ItemType(cur_item) > t_CustomWeapon) continue;",
                        "",
                        "            if(GetEquipmentStats(cur_item,3) == 2) FreeItem(GetItemFromShip(tdwd,cur_item));",
                        "        }",
                        "    }",
                        "    for(j = 0; StarPlanets(cur_star) > j; j = j + 1) {",
                        "        tdwd = StarPlanets(cur_star,j);",
                        "        for(y = ShopItems(tdwd); -1 < y; y = y - 1) {",
                        "            cur_item = ShopItems(tdwd,y);",
                        "            if(ItemType(cur_item) < t_Weapon1) continue;",
                        "            if(ItemType(cur_item) > t_CustomWeapon) continue;",
                        "",
                        "            if(GetEquipmentStats(cur_item,3) == 2) FreeItem(GetItemFromShop(tdwd,cur_item));",
                        "        }",
                        "    }",
                        "    for(y = StarItems(cur_star) - 1; -1 < y; y = y - 1) {",
                        "        cur_item = StarItems(cur_star,y);",
                        "        if(ItemType(cur_item) < t_Weapon1) continue;",
                        "        if(ItemType(cur_item) > t_CustomWeapon) continue;",
                        "",
                        "        if(GetEquipmentStats(cur_item,3) == 2) FreeItem(GetItemFromStar(cur_star,cur_item));",
                        "    }",
                        "    for(j = 0; StarPlanets(cur_star) > j; j = j + 1) {",
                        "        tdwd = StarPlanets(cur_star,j);",
                        "        for(y = PlanetItems(tdwd) - 1; -1 < y; y = y - 1) {",
                        "            cur_item = PlanetItems(tdwd,y);",
                        "            if(ItemType(cur_item) < t_Weapon1) continue;",
                        "            if(ItemType(cur_item) > t_CustomWeapon) continue;",
                        "",
                        "            if(GetEquipmentStats(cur_item,3) == 2) FreeItem(GetItemFromPlanet(tdwd,y));",
                        "        }",
                        "        for(int k = 0; PlanetWarriors(tdwd) > k; k = k + 1) {",
                        "            dword warrior = PlanetWarriors(tdwd,k);",
                        "            for(y = ShipItems(warrior) - 1; -1 < y; y = y - 1) {",
                        "                cur_item = ShipItems(warrior,y);",
                        "                if(ItemType(cur_item) < t_Weapon1) continue;",
                        "                if(ItemType(cur_item) > t_CustomWeapon) continue;",
                        "",
                        "                if(GetEquipmentStats(cur_item,3) == 2) FreeItem(GetItemFromShip(warrior,cur_item));",
                        "            }",
                        "        }",
                        "    }",
                        "    for(j = 0; StarRuins(cur_star) > j; j = j + 1) {",
                        "        tdwd = StarRuins(cur_star,j);",
                        "        for(y = ShopItems(tdwd); -1 < y; y = y - 1) {",
                        "            cur_item = ShopItems(tdwd,y);",
                        "            if(ItemType(cur_item) < t_Weapon1) continue;",
                        "            if(ItemType(cur_item) > t_CustomWeapon) continue;",
                        "",
                        "            if(GetEquipmentStats(cur_item,3) == 2) FreeItem(GetItemFromShop(tdwd,cur_item));",
                        "        }",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 285,
                    "Parent": -1,
                    "#": 6,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(CurTurn() % 5 == 0) {",
                        "    for(int i = 0; GalaxyStars() > i; i = i + 1) {",
                        "        dword cur_star = GalaxyStar(i);",
                        "        dword tdwd;",
                        "        dword cur_item;",
                        "        int y;",
                        "    ",
                        "        for(int j = 0; StarShips(cur_star) > j; j = j + 1) {",
                        "            tdwd = StarShips(cur_star,j);",
                        "            for(y = ShipItems(tdwd); -1 < y; y = y - 1) {",
                        "                cur_item = ShipItems(tdwd,y);",
                        "                if(ItemType(cur_item) < t_Weapon1) continue;",
                        "                if(ItemType(cur_item) > t_CustomWeapon) continue;",
                        "    ",
                        "                if(GetEquipmentStats(cur_item,3) == 2) FreeItem(GetItemFromShip(tdwd,cur_item));",
                        "            }",
                        "        }",
                        "        for(j = 0; StarPlanets(cur_star) > j; j = j + 1) {",
                        "            tdwd = StarPlanets(cur_star,j);",
                        "            for(y = ShopItems(tdwd); -1 < y; y = y - 1) {",
                        "                cur_item = ShopItems(tdwd,y);",
                        "                if(ItemType(cur_item) < t_Weapon1) continue;",
                        "                if(ItemType(cur_item) > t_CustomWeapon) continue;",
                        "    ",
                        "                if(GetEquipmentStats(cur_item,3) == 2) FreeItem(GetItemFromShop(tdwd,cur_item));",
                        "            }",
                        "        }",
                        "        for(y = StarItems(cur_star) - 1; -1 < y; y = y - 1) {",
                        "            cur_item = StarItems(cur_star,y);",
                        "            if(ItemType(cur_item) < t_Weapon1) continue;",
                        "            if(ItemType(cur_item) > t_CustomWeapon) continue;",
                        "",
                        "            if(GetEquipmentStats(cur_item,3) == 2) FreeItem(GetItemFromStar(cur_star,cur_item));",
                        "        }",
                        "        for(j = 0; StarPlanets(cur_star) > j; j = j + 1) {",
                        "            tdwd = StarPlanets(cur_star,j);",
                        "            for(y = PlanetItems(tdwd) - 1; -1 < y; y = y - 1) {",
                        "                cur_item = PlanetItems(tdwd,y);",
                        "                if(ItemType(cur_item) < t_Weapon1) continue;",
                        "                if(ItemType(cur_item) > t_CustomWeapon) continue;",
                        "",
                        "                if(GetEquipmentStats(cur_item,3) == 2) FreeItem(GetItemFromPlanet(tdwd,y));",
                        "            }",
                        "            for(int k = 0; PlanetWarriors(tdwd) > k; k = k + 1) {",
                        "                dword warrior = PlanetWarriors(tdwd,k);",
                        "                for(y = ShipItems(warrior) - 1; -1 < y; y = y - 1) {",
                        "                    cur_item = ShipItems(warrior,y);",
                        "                    if(ItemType(cur_item) < t_Weapon1) continue;",
                        "                    if(ItemType(cur_item) > t_CustomWeapon) continue;",
                        "",
                        "                    if(GetEquipmentStats(cur_item,3) == 2) FreeItem(GetItemFromShip(warrior,cur_item));",
                        "                }",
                        "            }",
                        "        }",
                        "        for(j = 0; StarRuins(cur_star) > j; j = j + 1) {",
                        "            tdwd = StarRuins(cur_star,j);",
                        "            for(y = ShopItems(tdwd); -1 < y; y = y - 1) {",
                        "                cur_item = ShopItems(tdwd,y);",
                        "                if(ItemType(cur_item) < t_Weapon1) continue;",
                        "                if(ItemType(cur_item) > t_CustomWeapon) continue;",
                        "    ",
                        "                if(GetEquipmentStats(cur_item,3) == 2) FreeItem(GetItemFromShop(tdwd,cur_item));",
                        "            }",
                        "        }",
                        "    }",
                        "}"
                    ]
                }
