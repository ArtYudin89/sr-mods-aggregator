                    "Code": [
                        "if(!dKillQuestPartnerOk && !CountIn(grDron,Star2)) {",
                        "  Dialog(dPartner,grPartner);",
                        "}",
                        "if(dKillQuestPartnerOk) {",
                        "  ChangeState(9);",
                        "  exit;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
