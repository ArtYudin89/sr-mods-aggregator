                    "Pos.y": 490,
                    "Parent": -1,
                    "#": 135,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!dKillQuestTalkOk) {",
                        "  Dialog(dDron,grDron);",
                        "}",
                        "if(dKillQuestTalkOk) {",
                        "  ChangeState(2);",
