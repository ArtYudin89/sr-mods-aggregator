                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 640,
                    "Parent": -1,
                    "#": 143,
                    "Code.Type": "Turn",
                    "Code": [
                        "SkipGreeting();",
                        "if(MS_Begin_FirstOk==0) {",
                        "  //Тексты сообщения и ответов (ванильные ключи Lang Script.MS_Begin.N)",
                        "  tstr1 = '</color>' + Format(CT('Script.MS_Begin.64'),'<0'+'>',ShortName(GroupToShip(grRC)));",
                        "  if(CurrentMods('Tweaks\\\\BlockPirates')) tstr2 = '</color>' + CT('FormGameSet2.Common.HelpOk');",
                        "  else tstr2 = '</color>' + CT('Script.MS_Begin.78');",
                        "  DChange(0);",
                        "  exit;",
                        "}",
                        "if(MS_Begin_FirstOk==1) {",
                        "  //Тексты сообщения и ответов (ванильные ключи Lang Script.MS_Begin.N)",
                        "  tstr1 = '</color>' + CT('Script.MS_Begin.65');",
                        "  tstr2 = '</color>' + CT('Script.MS_Begin.4');",
                        "  tstr3 = '</color>' + CT('Script.MS_Begin.5');",
                        "  DChange(1);",
                        "  exit;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 100,
                    "Pos.y": 640,
                    "Parent": -1,
                    "#": 144,
                    "Code.Type": "Turn",
                    "Code": [
                        "SkipGreeting();",
                        "if(dFlyQuestBegin && !dGoodsQuestEnd && !dGoodsQuestSell) {",
                        "  if(!dGoodsQuestBegin) {",
                        "    if (!GroupCount(grMC)){",
                        "        if (StarRuins(playerStar,'MC')){ShipJoin(grMC,StarRuins(playerStar,'MC'));}",
                        "        if (!StarRuins(playerStar,'MC')){ShipJoin(grMC,BuildRuins(playerStar,t_MC));}",
                        "        }",
                        "    if(!vInitOk) {",
                        "        //DecayGoods(playerPlanet,2);",
                        "        UpsurgeGoods(otherPlanet,2);",
                        "        PlanetSetGoods(otherPlanet,2,30);",
                        "        AddPlanetNews(Format(CT('Script.MS_Begin.38'),'<0'+'>',Name(otherPlanet),'<1'+'>',Name(playerStar)));",
                        "        DecayGoods(otherPlanet,1);",
                        "        GoodsRuinsForBuy(GroupToShip(grMC),1);",
                        "        vInitOk=1;",
                        "    }",
                        "    //Тексты сообщения и ответов (ванильные ключи Lang Script.MS_Begin.N)",
                        "    tstr1 = '</color>' + Format(CT('Script.MS_Begin.56'),'<0'+'>',ShortName(GroupToShip(grMC)),'<1'+'>',Name(otherPlanet));",
                        "    tstr2 = '</color>' + CT('Script.MS_Begin.37');",
                        "    DChange(5);",
                        "    exit;",
                        "  }",
                        "  if(dGoodsQuestBegin) {",
                        "    //Тексты сообщения и ответов (ванильные ключи Lang Script.MS_Begin.N)",
                        "    tstr1 = '</color>' + Format(CT('Script.MS_Begin.17'),'<0'+'>',Name(otherPlanet));",
                        "    tstr2 = '</color>' + CT('Script.MS_Begin.37');",
                        "    DChange(6);",
                        "    exit;",
                        "  }",
                        "}",
                        "if((dGoodsQuestEnd || dGoodsQuestSell) && !dJumpQuestBegin) {",
                        "  dGoodsQuestEnd=1;",
                        "  if(!dAsteroidQuestBegin) {",
                        "    if(EtherState('615434EA-7C47-4E21-A930-064A05E6B102')==3) {",
                        "        Ether(4,'615434EA-7C47-4E21-A930-064A05E6B102',Format(CT('Script.MS_Begin.13'),'<0'+'>',Name(GroupToShip(grMC)),'<1'+'>',Name(otherPlanet),'<2'+'>',Name(playerPlanet)),GroupToShip(grMC));",
                        "    }",
                        "    if(!dFakeAsteroidQuestBegin) {",
                        "      //Тексты сообщения и ответов (ванильные ключи Lang Script.MS_Begin.N)",
                        "      tstr1 = '</color>' + CT('Script.MS_Begin.22');",
                        "      tstr2 = '</color>' + CT('Script.MS_Begin.43');",
                        "      DChange(11);",
                        "      exit;",
                        "    }",
                        "    if(dFakeAsteroidQuestBegin) {",
                        "      if(ast_damaged) {",
                        "        if(EtherState('61B80EE9-9EFF-4863-BFEC-7E14D13E7B1A')==3) {",
                        "                    Ether(4,'61B80EE9-9EFF-4863-BFEC-7E14D13E7B1A',Format(CT('Script.MS_Begin.75'),'<0'+'>',ShipName(Player())));",
                        "                }",
                        "        //Тексты сообщения и ответов (ванильные ключи Lang Script.MS_Begin.N)",
                        "        tstr1 = '</color>' + CT('Script.MS_Begin.70');",
                        "        tstr2 = '</color>' + CT('Script.MS_Begin.74');",
                        "        DChange(27);",
                        "        exit;",
                        "      }",
                        "      if(!ast_damaged) {",
                        "        //Тексты сообщения и ответов (ванильные ключи Lang Script.MS_Begin.N)",
                        "        tstr1 = '</color>' + CT('Script.MS_Begin.23');",
                        "        tstr2 = '</color>' + CT('Script.MS_Begin.43');",
                        "        DChange(12);",
                        "        exit;",
                        "      }",
                        "    }",
                        "  }",
                        "  if(dAsteroidQuestBegin) {",
                        "    if(ItemExist(ItemEA)) {",
                        "      //Тексты сообщения и ответов (ванильные ключи Lang Script.MS_Begin.N)",
                        "      tstr1 = '</color>' + CT('Script.MS_Begin.23');",
                        "      tstr2 = '</color>' + CT('Script.MS_Begin.43');",
                        "      DChange(12);",
                        "      exit;",
                        "    }",
                        "    if(!ItemExist(ItemEA)) {",
                        "      if(EtherState('82CCC81B-B970-451E-ADB5-4500AC20A7EE')==3) {",
                        "          Ether(4,'82CCC81B-B970-451E-ADB5-4500AC20A7EE',Format(CT('Script.MS_Begin.14'),'<0'+'>',Name(playerPlanet)));",
                        "      }",
                        "      //Тексты сообщения и ответов (ванильные ключи Lang Script.MS_Begin.N)",
                        "      tstr1 = '</color>' + Format(CT('Script.MS_Begin.24'),'<0'+'>',Name(Star2),'<1'+'>',Name(Planet2));",
                        "      tstr2 = '</color>' + CT('Script.MS_Begin.40');",
                        "      DChange(13);",
                        "      exit;",
                        "    }",
                        "  }",
                        "}",
                        "if(dJumpQuestBegin && !dKillQuestBegin) {",
                        "  //Тексты сообщения и ответов (ванильные ключи Lang Script.MS_Begin.N)",
                        "  tstr1 = '</color>' + Format(CT('Script.MS_Begin.25'),'<0'+'>',Name(Star2),'<1'+'>',Name(Planet2));",
                        "  tstr2 = '</color>' + CT('Script.MS_Begin.40');",
                        "  DChange(14);",
                        "  exit;",
                        "}",
                        "if(dKillQuestBegin) {",
                        "  if(!CountIn(grDron,Star2)) {",
                        "    if(EtherState('9D133C50-5A88-495A-8EBA-568FC460E6D4')==3) {",
                        "      Ether(4,'9D133C50-5A88-495A-8EBA-568FC460E6D4',Format(CT('Script.MS_Begin.55'),'<0'+'>',Name(playerStar),'<1'+'>',Name(playerPlanet)));",
                        "    }",
                        "    if(MS_Begin_GoSB!=1) {",
                        "      //Тексты сообщения и ответов (ванильные ключи Lang Script.MS_Begin.N)",
                        "      tstr1 = '</color>' + CT('Script.MS_Begin.35');",
                        "      tstr2 = '</color>' + CT('Script.MS_Begin.53');",
                        "      DChange(24);",
                        "      exit;",
                        "    }",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 310,
                    "Pos.y": 640,
                    "Parent": -1,
                    "#": 145,
                    "Code.Type": "Turn",
                    "Code": [
                        "SkipGreeting();",
                        "if(dGoodsQuestBegin && !dGoodsQuestEnd) {",
                        "  if(!GoodsCount(Player(),1)) {",
                        "    Tips(6);",
                        "    //Тексты сообщения и ответов (ванильные ключи Lang Script.MS_Begin.N)",
                        "    tstr1 = '</color>' + Format(CT('Script.MS_Begin.18'),'<0'+'>',Name(otherPlanet));",
                        "    tstr2 = '</color>' + CT('Script.MS_Begin.39');",
                        "    DChange(7);",
                        "    exit;",
                        "  }",
                        "  if(GoodsCount(Player(),1)) {",
