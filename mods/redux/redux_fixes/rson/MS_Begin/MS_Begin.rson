                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 430,
                    "Pos.y": 640,
                    "Parent": -1,
                    "#": 146,
                    "Code.Type": "Turn",
                    "Code": [
                        "SkipGreeting();",
                        "if(dGoodsQuestBegin && !dGoodsQuestEnd) {",
                        "  if (!dGoodsQuestSell){",
                        "    counter=GalaxyEvents()-1;",
                        "    while (counter>=0){",
                        "    if (GalaxyEventDate(counter)>dGoodsQuestBegin){",
                        "    if (GalaxyEventType(counter)=='PlayerSellsGoodsToPlanet'){",
                        "    if (GalaxyEventData(counter,0)==t_Medicine){",
                        "    if (GalaxyEventData(counter,3)==Id(otherPlanet)){",
                        "    dGoodsQuestSell=1;}}}}",
                        "    counter=counter-1;}",
                        "    }",
                        "  if(!dGoodsQuestSell) {",
                        "    //Тексты сообщения и ответов (ванильные ключи Lang Script.MS_Begin.N)",
                        "    tstr1 = '</color>' + CT('Script.MS_Begin.79');",
                        "    tstr2 = '</color>' + CT('Script.MS_Begin.41');",
                        "    DChange(9);",
                        "    exit;",
                        "  }",
                        "  if(dGoodsQuestSell) {",
                        "    //Тексты сообщения и ответов (ванильные ключи Lang Script.MS_Begin.N)",
                        "    tstr1 = '</color>' + Format(CT('Script.MS_Begin.21'),'<0'+'>',Name(playerPlanet));",
                        "    tstr2 = '</color>' + CT('Script.MS_Begin.42');",
                        "    DChange(10);",
                        "    exit;",
                        "  }",
                        "}"
                    ]
                },
