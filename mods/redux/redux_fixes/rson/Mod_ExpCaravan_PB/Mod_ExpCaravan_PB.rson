            "Items": [],
            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 9,
                    "Code.Type": "Global",
                    "Code": [
                        "if(!GCntRun(GScriptName)) GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 10,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "if(GetShipRuins(Player())) {",
                        "  if(ShipType(GetShipRuins(Player()))=='WB') {",
                        "    j=0;",
                        "    money=0;",
                        "    for(i=0;i<ShipItems(Player());i=i+1)",
                        "    {",
                        "        tdwd=ShipItems(Player(),i);",
                        "        if(ItemType(tdwd)!=t_UselessItem)continue;",
                        "        if(EquipmentImageName(tdwd)=='ExpCaravan_CargoBox')",
                        "        {",
                        "            j=j+1;",
                        "            money=money+ItemCost(tdwd);",
                        "        }",
                        "    }",
                        "    if(j)",
                        "    {",
                        "        if(j==1)Ttext='</color>'+CT(\"Script.Mod_ExpCaravan_PB.2\");",
                        "        else Ttext='</color>'+CT(\"Script.Mod_ExpCaravan_PB.1\");",
                        "        money=money+(money*25)/400;",
                        "        AddDialogInject('WB_CargoBox','',CT(\"Script.Mod_ExpCaravan_PB.3\"),1);",
                        "    }",
                        "  }",
                        "  if(ShipType(GetShipRuins(Player()))=='PB') {",
                        "    j=0;",
                        "    money=0;",
                        "    for(i=0;i<ShipItems(Player());i=i+1)",
                        "    {",
                        "        tdwd=ShipItems(Player(),i);",
                        "        if(ItemType(tdwd)!=t_UselessItem)continue;",
                        "        if(EquipmentImageName(tdwd)=='ExpCaravan_CargoBox')",
                        "        {",
                        "            j=j+1;",
                        "            money=money+ItemCost(tdwd);",
                        "        }",
                        "    }",
                        "    if(j)",
                        "    {",
                        "        if(j==1)Ttext='</color>'+CT(\"Script.Mod_ExpCaravan_PB.2\");",
                        "        else Ttext='</color>'+CT(\"Script.Mod_ExpCaravan_PB.1\");",
                        "        money=money+(money*25)/100;",
                        "        AddDialogInject('PB_CargoBox','',CT(\"Script.Mod_ExpCaravan_PB.0\"),1);",
                        "    }",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 365,
                    "Parent": -1,
                    "#": 28,
                    "Code.Type": "Turn",
