            "Items": [],
            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 11,
                    "Code.Type": "Global",
                    "Code": [
                        "if(GRunFrom==3) {",
                        "  if(!RedSkull_Star) {",
                        "    if(ShipStrengthInAverageRanger(Player())>=1.5) {",
                        "      if(RangerStatus(Player())==Pirate) {",
                        "        if(ShipFind(t_PB)) {",
                        "          GRun();",
                        "        }",
                        "      }",
                        "    }",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 12,
                    "Code.Type": "Init",
                    "Code": [
                        "SetName(GroupToShip(Detective),CT(\"Script.Mod_SR1RedSkullPart1.0\"));"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 13,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!CountIn(Detective)) {",
                        "  ShipOut(Player());",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 160,
                    "Pos.y": 205,
                    "Parent": -1,
                    "#": 37,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(vDetTalkState==1) {",
                        "  if(!sTalkOk) {",
                        "    if(ShipInNormalSpace(CurShip)) {",
                        "      if(ShipInNormalSpace(Player())) {",
                        "        if(ShipInStar(Player(),Star1)) {",
                        "          if(Dist(CurShip,Player())<300) {",
                        "            sTalkOk=Dialog(dDetectiveTalk,CurShip);",
                        "          }",
                        "        }",
                        "      }",
                        "    }",
                        "  }",
                        "}",
                        "if(!ShipInStar(Player(),Star1)) {",
                        "  ShipOut(CurShip);",
                        "}",
                        "if(vDetTalkState==2) {",
                        "  ChangeState(2);",
                        "  exit;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 265,
                    "Parent": -1,
                    "#": 38,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(EndState) {",
                        "  ShipOut(CurShip);",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 365,
                    "Parent": -1,
                    "#": 39,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(vDetTalkState==1) {",
                        "  DChange(0);",
                        "  exit;",
                        "}",
                        "if(vDetTalkState==2) {",
                        "  DChange(7);",
                        "  exit;",
                        "}"
                    ]
                },
