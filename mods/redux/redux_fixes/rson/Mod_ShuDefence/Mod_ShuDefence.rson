                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 100,
                    "Pos.y": 505,
                    "Parent": -1,
                    "#": 32,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(GAnswerData) {",
                        "    if(!g_HasAbsorber(GAnswerData) && ShipMoney(Player())>=sum && ShipFreeSpace(GAnswerData)>=10) {",
                        "        if(g_InstallAbsorber(GAnswerData)) {",
                        "            ShipMoney(Player(),ShipMoney(Player())-sum);",
                        "            Sound('Sound.Buy');",
                        "            if(GAnswerData==Player()) playerGotAbsorber=1;",
                        "        }",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
