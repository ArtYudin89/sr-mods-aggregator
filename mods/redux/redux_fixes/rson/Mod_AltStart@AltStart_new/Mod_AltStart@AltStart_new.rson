            "Items": [],
            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 310,
                    "Parent": -1,
                    "#": 7,
                    "Code.Type": "Global",
                    "Code": [
                        "//"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 310,
                    "Parent": -1,
                    "#": 8,
                    "Code.Type": "Init",
                    "Code": [
                        "//Числа стартовых систем берутся из меню мода (ModsCFG.txt): AltStartBlazerSystems/KellerSystems/TerronSystems/ClanSystems",
                        "//Пусто или \"-1(default)\" = сторону не трогаем (сколько систем дала ваниль, столько и остаётся). 0 = сторона побеждена.",
                        "//tgtArr[Id(звезды)]: 0 - система Коалиции, 1/2/3 - остаётся у Блазера/Келлера/Террона, 4 - остаётся у пиратского клана",
                        "//Дальняя часть скрипта (ход 25): убийство побеждённых доминаторов, как в Reflection\\\\RefAltStart*Dead",
                        "int i, j, k, ser, need, got, tgtI, noPirates, deadCnt, techLvl, techPts, nB, nK, nT, nC, altDone, dB, dK, dT, dC, blzPl, blzV, blzW;",
                        "dword con, star, diffBonus, planet, ruins, hB, hK, hT, hR, hR2, home, blzStar;",
                        "str sB, sK, sT, sC;",
                        "sB = GetParFromTxt('SpaceRangersHD\\\\ModsCFG.txt', 'AltStartBlazerSystems');",
                        "sK = GetParFromTxt('SpaceRangersHD\\\\ModsCFG.txt', 'AltStartKellerSystems');",
                        "sT = GetParFromTxt('SpaceRangersHD\\\\ModsCFG.txt', 'AltStartTerronSystems');",
                        "sC = GetParFromTxt('SpaceRangersHD\\\\ModsCFG.txt', 'AltStartClanSystems');",
                        "nB = 1;",
                        "nK = 1;",
                        "nT = 1;",
                        "nC = 1;",
                        "dB = 1;",
                        "dK = 1;",
                        "dT = 1;",
                        "dC = 1;",
                        "if(sB != '') { if(sB != '-1(default)') { if(int(sB) >= 0) {",
                        "    nB = int(sB);",
                        "    dB = 0;",
                        "} } }",
                        "if(sK != '') { if(sK != '-1(default)') { if(int(sK) >= 0) {",
                        "    nK = int(sK);",
                        "    dK = 0;",
                        "} } }",
                        "if(sT != '') { if(sT != '-1(default)') { if(int(sT) >= 0) {",
                        "    nT = int(sT);",
                        "    dT = 0;",
                        "} } }",
                        "if(sC != '') { if(sC != '-1(default)') { if(int(sC) >= 0) {",
                        "    nC = int(sC);",
                        "    dC = 0;",
                        "} } }",
                        "if(CurrentMods('Tweaks\\\\BlockPirates')) {",
                        "    nC = 0;",
                        "    dC = 0;",
                        "}    //\"Отключаем\" пиратский клан, если активен мод BlockPirates",
                        "if(nB + nK + nT == 0) {    //без врагов начать нельзя: хотя бы один доминатор остаётся",
                        "    nB = 1;",
                        "    nK = 1;",
                        "    nT = 1;",
                        "    dB = 1;",
                        "    dK = 1;",
                        "    dT = 1;",
                        "}",
                        "if(nC == 0) noPirates = 1;",
                        "if(nB == 0) deadCnt = deadCnt + 1;",
                        "if(nK == 0) deadCnt = deadCnt + 1;",
                        "if(nT == 0) deadCnt = deadCnt + 1;",
                        "techLvl = 1;",
                        "techPts = 1;",
                        "if(deadCnt == 1) {",
                        "    techLvl = 4;",
                        "    techPts = 75;",
                        "    if(nK == 0) techPts = 65;",
                        "}",
                        "if(deadCnt == 2) {",
                        "    techLvl = 6;",
                        "    techPts = 155;",
                        "}",
                        "hB = ShipStar(Blazer());",
                        "hK = ShipStar(Keller());",
                        "hT = ShipStar(Terron());",
                        "hR = PlanetToStar(PlanetPirateClan());",
                        "con = StarToCon(hR);    //сектор Дицея всегда последний в списке",
                        "hR2 = hR;",
                        "for(i = 0; i < ConStars(con); i = i + 1) {",
                        "    star = ConStar(con, i);",
                        "    if(star != hR) {",
                        "        hR2 = star;",
                        "        break;",
                        "    }",
                        "}",
                        "for(i = 0; i < GalaxyStars(); i = i + 1) {",
                        "    ArrayAdd(tgtArr, 0);",
                        "}",
                        "if(nB > 0) tgtArr[Id(hB)] = 1;",
                        "if(nK > 0) tgtArr[Id(hK)] = 2;",
                        "if(nT > 0) tgtArr[Id(hT)] = 3;",
                        "if(nC > 0) tgtArr[Id(hR)] = 4;",
                        "if(nC > 1) tgtArr[Id(hR2)] = 4;",
                        "//Стороны со значением default остаются как есть: им достаются все их ванильные системы",
                        "for(i = 0; i < GalaxyStars(); i = i + 1) {",
                        "    star = GalaxyStar(i);",
                        "    if(StarOwner(star) == 1) {",
                        "        if(StarSeries(star) == 0 && dB) tgtArr[i + 1] = 1;",
                        "        if(StarSeries(star) == 1 && dK) tgtArr[i + 1] = 2;",
                        "        if(StarSeries(star) == 2 && dT) tgtArr[i + 1] = 3;",
                        "    }",
                        "    if(StarOwner(star) == 2 && dC) tgtArr[i + 1] = 4;",
                        "}",
                        "//Сперва добираем недостающие системы доминаторов из их собственных (ближайших к столице), затем из систем Коалиции",
                        "for(k = 0; k < 2; k = k + 1) {",
                        "    for(ser = 1; ser <= 3; ser = ser + 1) {",
                        "        home = hB;",
                        "        need = nB;",
                        "        if(dB) need = 0;",
                        "        if(ser == 2) {",
                        "            home = hK;",
                        "            need = nK;",
                        "            if(dK) need = 0;",
                        "        }",
                        "        if(ser == 3) {",
                        "            home = hT;",
                        "            need = nT;",
                        "            if(dT) need = 0;",
                        "        }",
                        "        got = 0;",
                        "        for(i = 0; i < GalaxyStars(); i = i + 1) {",
                        "            if(tgtArr[i + 1] == ser) got = got + 1;",
                        "        }",
                        "        for(j = 1; j < GalaxyStars(); j = j + 1) {",
                        "            if(got >= need) break;",
                        "            star = StarNearbyStars(home, j);",
                        "            if(tgtArr[Id(star)] != 0) continue;",
                        "            if(star == ShipStar(Player())) continue;",
                        "            if(StarToCon(star) == con) continue;",
                        "            if(k == 0) {",
                        "                if(StarOwner(star) != 1) continue;",
                        "                if(StarSeries(star) != ser - 1) continue;",
                        "            }",
                        "            else {",
                        "                if(StarOwner(star) != 0) continue;",
                        "            }",
                        "            tgtArr[Id(star)] = ser;",
                        "            got = got + 1;",
                        "        }",
                        "    }",
                        "}",
                        "//Системы пиратского клана сверх двух классических: ближайшие к Роджерии, но не доминаторские",
                        "got = 0;",
                        "for(i = 0; i < GalaxyStars(); i = i + 1) {",
                        "    if(tgtArr[i + 1] == 4) got = got + 1;",
                        "}",
                        "for(j = 1; j < GalaxyStars(); j = j + 1) {",
                        "    if(dC) break;",
                        "    if(got >= nC) break;",
                        "    star = StarNearbyStars(hR, j);",
                        "    if(tgtArr[Id(star)] != 0) continue;",
                        "    if(star == ShipStar(Player())) continue;",
                        "    if(StarOwner(star) == 1) continue;",
                        "    tgtArr[Id(star)] = 4;",
                        "    got = got + 1;",
                        "}",
                        "if(nB > 0) ArrayAdd(domIdArr, Id(hB) - 1);",
                        "if(nK > 0) ArrayAdd(domIdArr, Id(hK) - 1);",
                        "if(nT > 0) ArrayAdd(domIdArr, Id(hT) - 1);",
                        "if(nC > 0) ArrayAdd(pirIdArr, Id(hR) - 1);",
                        "if(nC > 1) ArrayAdd(pirIdArr, Id(hR2) - 1);",
                        "//Твик перебирает все системы, передаёт ненужные под контроль Коалиции, оставляет нужным сторонам их системы,",
                        "//выставляет технологии и запрет на атаку до 300-го дня.",
                        "for(i = 0; i < GalaxyStars(); i = i + 1) {",
                        "    star = GalaxyStar(i);",
                        "    tgtI = tgtArr[i + 1];",
                        "    if(tgtI >= 1) {",
                        "        if(tgtI <= 3) {",
                        "            if(StarOwner(star) != 1) ToDominator(star, tgtI);",
                        "            else if(StarSeries(star) != tgtI - 1) ToDominator(star, tgtI);",
                        "            if(deadCnt > 0) {",
                        "                for(j = 0; j < StarPlanets(star); j = j + 1) {",
                        "                    planet = StarPlanets(star, j);",
                        "                    if(PlanetOwner(planet) == None) continue;",
                        "                    SetTech(planet, techLvl, techPts);",
                        "                }",
                        "            }",
                        "        }",
                        "        else {",
                        "            if(StarOwner(star) != 2) ToPirates(star);",
                        "            for(j = 0; j < StarPlanets(star); j = j + 1) {",
                        "                planet = StarPlanets(star, j);",
                        "                if(PlanetOwner(planet) == None) continue;",
                        "                SetTech(planet, techLvl, techPts);",
                        "            }",
                        "        }",
                        "        continue;",
                        "    }",
                        "    //Не нужная никому система: сперва уничтожаем всё доминаторское и пиратское",
                        "    if(StarOwner(star)) {",
                        "        if(StarRuins(star)) {",
                        "            for(j = StarRuins(star) - 1; j >= 0; j = j - 1) {",
                        "                ruins = StarRuins(star, j);",
                        "                if(ShipTypeN(ruins) == t_CB) ShipDestroy(ruins, 1);",
                        "                else ClearShop(ruins);",
                        "            }",
                        "        }",
                        "        for(j = 0; j < StarPlanets(star); j = j + 1) {",
                        "            planet = StarPlanets(star, j);",
                        "            if(PlanetOwner(planet) == None) continue;",
                        "            PlanetOwner(planet, PlanetRace(planet));",
                        "            SetTech(planet, techLvl, techPts);",
                        "            ClearShop(planet);",
                        "            BuyWarrior(planet);",
                        "        }",
                        "        for(j = 0; j < StarShips(star); j = j + 1) {",
                        "            planet = StarShips(star, j);",
                        "            if(ShipOwner(planet) < Kling) continue;",
                        "            OrderNone(planet);",
                        "            OrderLock(planet, 1);",
                        "            ShipDestroy(planet, 1);",
                        "        }",
                        "        StarOwner(star, 0);",
                        "    }",
                        "    else",
                        "        for(j = 0; j < StarPlanets(star); j = j + 1) {",
                        "            planet = StarPlanets(star, j);",
                        "            if(PlanetOwner(planet) == None) continue;",
                        "            SetTech(planet, techLvl, techPts);",
                        "            ClearShop(planet);",
                        "        }",
                        "    NoComeKlingToStar(star, 1);",
                        "}",
                        "ArrayClear(tgtArr);",
                        "function SetTech (dword planet, int lvl, int pts) {",
                        "    for(int i = 0; i < 20; i = i + 1) PlanetInventionLevel(planet, i, lvl);",
                        "    PlanetCurInventionPoints(planet, PlanetCurInvention(planet), pts);",
                        "}",
                        "function ClearShop (dword object) {",
                        "    for(int i = ShopItems(object) - 1; i >= 0; i = i - 1) FreeItem(GetItemFromShop(object, i));",
                        "}",
                        "function ToDominator (dword s, int ser) {",
                        "    StarOwner(s, 1);",
                        "    StarSeries(s, ser - 1);",
                        "    for(int i = 0; i < StarPlanets(s); i = i + 1) {",
                        "        if(PlanetOwner(StarPlanets(s, i)) == None) continue;",
                        "        PlanetOwner(StarPlanets(s, i), Kling);",
                        "        ClearShop(StarPlanets(s, i));",
                        "    }",
                        "}",
                        "function ToPirates (dword s) {",
                        "    StarOwner(s, 2);",
                        "    for(int i = 0; i < StarPlanets(s); i = i + 1) {",
                        "        if(PlanetOwner(StarPlanets(s, i)) == None) continue;",
                        "        PlanetOwner(StarPlanets(s, i), PirateClan);",
                        "        ClearShop(StarPlanets(s, i));",
                        "    }",
                        "}",
                        "//выставляем сценарий пиратской концовки \"Коалиция спасена от пиратов\", если пираты отключены",
                        "if(noPirates) PirateWin(3);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 310,
                    "Parent": -1,
                    "#": 9,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(CurTurn() == 25) {",
                        "    //побеждённые доминаторы, как в Reflection\\\\RefAltStart*Dead",
                        "    if(nT == 0) {",
                        "        TerronToStar();",
                        "        MS_Terron_ToStar = 1;",
                        "    }",
                        "    if(nK == 0) {",
                        "        KellerLeave();",
                        "        ShipDestroy(Keller());",
                        "    }",
                        "    if(nB == 0) {",
                        "        ShipDestroyType(1);",
                        "        //Планета для посадки Блазера: заселённая планета его системы, иначе - любая планета рас Коалиции",
                        "        blzPl = 0;",
                        "        blzStar = ShipStar(Blazer());",
                        "        for(k = 0; k < StarPlanets(blzStar); k = k + 1) {",
                        "            if(PlanetOwner(StarPlanets(blzStar, k)) == 6) continue;",
                        "            blzPl = Id(StarPlanets(blzStar, k));",
                        "            break;",
                        "        }",
                        "        if(blzPl == 0) {",
                        "            for(blzV = 0; blzV < GalaxyStars(); blzV = blzV + 1) {",
                        "                for(blzW = 0; blzW < StarPlanets(GalaxyStar(blzV)); blzW = blzW + 1) {",
                        "                    if(PlanetOwner(StarPlanets(GalaxyStar(blzV), blzW)) > 4) continue;",
                        "                    blzPl = Id(StarPlanets(GalaxyStar(blzV), blzW));",
                        "                    break;",
                        "                }",
                        "                if(blzPl != 0) break;",
                        "            }",
                        "        }",
                        "        BlazerLanding(blzPl);",
                        "    }",
                        "    //дочистка кораблей побеждённых серий",
                        "    for(i = 0; i < GalaxyStars(); i = i + 1) {",
                        "        star = GalaxyStar(i);",
                        "        for(j = StarShips(star) - 1; j >= 0; j = j - 1) {",
                        "            planet = StarShips(star, j);",
                        "            if(ShipOwner(planet) != Kling) continue;",
                        "            if(planet == Blazer()) continue;",
                        "            if(planet == Keller()) continue;",
                        "            if(planet == Terron()) continue;",
                        "            if(!ShipEqInSlot(planet, t_Hull)) continue;",
                        "            ser = ItemSubrace(ShipEqInSlot(planet, t_Hull));",
                        "            if(ser == 0 && nB != 0) continue;",
                        "            if(ser == 1 && nK != 0) continue;",
                        "            if(ser == 2 && nT != 0) continue;",
                        "            if(ser > 2) continue;",
                        "            OrderNone(planet);",
                        "            OrderLock(planet, 1);",
                        "            ShipDestroy(planet, 1);",
                        "        }",
                        "    }",
                        "}",
                        "if(CurTurn() == 290) {",
                        "    if(nB == 0) EtherDelete('BlazerWin');",
                        "    if(nK == 0) EtherDelete('KellerWin');",
                        "    if(nT == 0) EtherDelete('TerronWin');",
                        "}",
                        "if(CurTurn()>=300 && !altDone) {",
                        "    altDone = 1;",
                        "    for(i = 0; i < GalaxyStars(); i = i + 1) {",
                        "    \tstar = GalaxyStar(i);",
                        "        if(NoComeKlingToStar(star)) NoComeKlingToStar(star, 0);",
                        "    }",
                        "    diffBonus = GalaxyDiffLevels() / 5;",
                        "    for(i = 1; i < ArrayDim(domIdArr); i = i + 1) {",
                        "        planet = FindPlanet(GalaxyStar(domIdArr[i]),'NotMaloc,NotPeleng,NotPeople,NotFei,NotGaal,NotNone,NotPirateClan',0,0);",
                        "        for(j = 0; j < diffBonus ; j = j + 1) BuyDomikExtremal(planet, Rnd(1, 5));",
                        "    }",
                        "    if(!noPirates) {",
                        "        diffBonus = GalaxyDiffLevels(0) / 5;",
                        "        for(i = 1; i < ArrayDim(pirIdArr); i = i + 1) {",
                        "            planet = FindPlanet(GalaxyStar(pirIdArr[i]),'NotMaloc,NotPeleng,NotPeople,NotFei,NotGaal,NotKling,NotNone',0,0);",
                        "            for(j = 0; j < diffBonus ; j = j + 1) BuyWarrior(planet);",
                        "        }",
                        "    }",
                        "    ArrayClear(domIdArr);",
                        "    ArrayClear(pirIdArr);",
                        "    AllShipOut();",
                        "}"
                    ]
                }
            ],
            "Places": [],
            "Planets": [
