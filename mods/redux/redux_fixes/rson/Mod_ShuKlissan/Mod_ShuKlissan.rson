                        "ShipRepairEq(CurShip);",
                        "//if(~ShipFindCustomShipInfoByType(CurShip, 'ShipImmortalInfo')) ShipDeleteCustomShipInfo(CurShip, 'ShipImmortalInfo');"
                    ]
