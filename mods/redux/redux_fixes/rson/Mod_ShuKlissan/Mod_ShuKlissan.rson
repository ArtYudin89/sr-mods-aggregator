                        "                    AddDialogInject('KlissanControl', '', CT(\"Script.Mod_ShuKlissan.363\"), 1);",
                        "                }",
                        "                else KlissanInvasion['KlissanControl.WasReceived'] = 0;",
                        "            }",
                        "        }",
