                        "//На случай, если наёмник временно остался без приказа",
                        "if(!ShipOrder(CurShip)) {",
                        "    ShipFreeFlight(CurShip);",
                        "}",
                        "",
                        "//А они любят сами себя избивать))",
                        "if(ShipOrder(CurShip) == 6) {",
                        "    if(ShipOrderObj(CurShip) == CurShip) {",
                        "        ShipFreeFlight(CurShip);",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 190,
                    "Pos.y": 1530,
                    "Parent": -1,
                    "#": 439,
                    "Code.Type": "Turn",
                    "Code": [
                        "//Не трогаем корабль, пока он находится в гипере",
                        "if(ShipInHyperSpace(CurShip)) exit;",
                        "",
                        "//Лидер либо сядет к себе в штаб, либо на ЦН, либо на ближайшую планету (и оттуда тайно вернётся на Меркурий)",
                        "dword base = OrgHQ(OrgOfShip(CurShip));",
                        "if(base) {",
                        "    if(HullDamage(base) > 50) base = 0;",
                        "}",
                        "if(!base) base = GroupToShip(MercCenter);",
                        "if(base) {",
                        "    if(HullDamage(base) > 50) base = 0;",
                        "}",
                        "",
                        "if(ShipInNormalSpace(CurShip))",
                        "{",
                        "    if(base)",
                        "    {",
                        "        if(ShipStar(CurShip) == ShipStar(base)) OrderLanding(CurShip, base);",
                        "        else OrderJump(CurShip, ShipStar(base));",
                        "    }",
                        "    else if(NearCivilPlanet(CurShip)) OrderLanding(CurShip, NearCivilPlanet(CurShip));",
                        "    else OrderJump(CurShip, StarNearbyStars(ShipStar(CurShip), 65));",
                        "    exit;",
                        "}",
                        "",
                        "//Лидер сел - переносим его в штаб/ЦН (или на Меркурий) и выводим из боя",
                        "if(base)",
                        "{",
                        "    if(GetShipRuins(CurShip) != base)",
                        "    {",
                        "        TransferShip(CurShip, base); //В свой штаб или в ЦН",
                        "        ShipRepairEq(CurShip);",
                        "        HullHP(CurShip, 'To100');",
                        "    }",
                        "}",
                        "else",
                        "{",
                        "    TransferShip(CurShip, StarPlanets(GalaxyStar(People), 0)); //На Меркурий",
                        "    ShipRepairEq(CurShip);",
                        "    HullHP(CurShip, 'To100');",
                        "}",
                        "",
                        "OrderLock(CurShip, 1);",
                        "ChangeState('LeaderInactive');",
                        "//Снимаем бонус к скорости, который мы накинули, чтобы этот блёб сбежал",
                        "if(ShipSpecialBonuses(CurShip,bonNull)) {",
                        "    ShipSpecialBonuses(CurShip,bonNull,0);",
                        "    ShipSpecialBonuses(CurShip,bonSpeed,ShipSpecialBonuses(CurShip,bonSpeed)-600);",
                        "}",
                        "int cur_org = ShipGroup(CurShip);",
                        "//Номер организации и роль группы (0 - наёмники, 1 - лидер)",
                        "int org_sq = OrgByGroup(cur_org);",
                        "int org_role = OrgRoleByGroup(cur_org);",
                        "",
                        "//Наёмник организации",
                        "if(org_sq >= 1 && org_role == 0)",
                        "{",
                        "    //Организация без лидера распадается: наёмники уходят во фрилансеры",
                        "    if(!GroupCount(OrgGrp(org_sq, 1)))",
                        "    {",
                        "        //Флагман не уходит во фрилансеры, а становится военным (OrgFlagToWarrior)",
                        "        if(OrgIsFlagship(CurShip)) OrgFlagToWarrior(CurShip);",
                        "        else MakeFreelancerFromMerc(CurShip);",
                        "        exit;",
                        "    }",
                        "    else",
                        "    {",
                        "        RelationToRanger(CurShip, OrgLeader(org_sq), 100);",
                        "        if(ShipIsPartner(CurShip) != Player()) RelationToRanger(CurShip, Player(), OrgRel(org_sq));",
                        "        else RelationToRanger(CurShip, Player(),100);",
                        "    }",
                        "",
                        "    //Вручную корректируем характер наёмника (Status/Status.<раса> из таблицы)",
                        "    OrgSetStatus(CurShip, org_sq, ShipPilotRace(CurShip));",
                        "}",
                        "//Фрилансер (характер лидеров не трогаем)",
                        "else if(org_role != 1)",
                        "{",
                        "    OrgSetStatus(CurShip, 0, ShipPilotRace(CurShip));",
                        "}",
                        "",
                        "if(ShipType(CurShip) != 'Freelancer')",
                        "{",
                        "    //Если игрок (или его миньён) атаковал наёмника или босса организации, то это сразу влечёт за собой конфликт и пересчёт отношения организаций",
                        "    if(Hit(CurShip, 0))",
                        "    {",
                        "        if(org_sq >= 1) OrgHitShift(org_sq, CurShip);",
                        "",
                        "        //И сразу сбрасываем маркер, чтобы не мешал",
                        "        Hit(CurShip, 0, 0);",
                        "    }",
                        "}",
                        "",
                        "//На случай, если наёмник временно остался без приказа",
                        "if(!ShipOrder(CurShip)) {",
                        "    ShipFreeFlight(CurShip);",
                        "}",
                        "",
                        "//А они любят сами себя избивать))",
                        "if(ShipOrder(CurShip) == 6) {",
                        "    if(ShipOrderObj(CurShip) == CurShip) {",
                        "        ShipFreeFlight(CurShip);",
                        "    }",
                        "}"
                    ]
                },
                {
