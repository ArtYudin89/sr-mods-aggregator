                    "Parent": -1,
                    "#": 425,
                    "Code.Type": "Turn",
                    "Code": [
                        "int meet_sq = OrgOfShip(CurShip);",
                        "//Игрок (транк, напарник) атаковал лидера: переговоры сорваны - отношение прежнее минус HitSelf, конкурентам Hit<Id>",
                        "if(Hit(CurShip, 0))",
                        "{",
                        "    Hit(CurShip, 0, 0);",
                        "    OrgNegAbort(meet_sq);",
                        "    OrgHitShift(meet_sq, CurShip);",
                        "    ChangeState('LeaderReturning');",
                        "    exit;",
                        "}",
                        "//Игрок не встретился с лидером за TalkWait дней (по умолчанию 60) от вызова: переговоры не состоялись",
                        "if(CurTurn() > OrgCallTurn(meet_sq) - 1000 + OrgI(meet_sq, 'Talk.Wait', 60))",
                        "{",
                        "    OrgNegAbort(meet_sq);",
                        "    ChangeState('LeaderReturning');",
                        "    exit;",
                        "}",
                        "",
                        "if(ShipInHyperSpace(CurShip)) exit;",
                        "",
                        "//Лидер летит на встречу с игроком",
                        "if(!ShipInNormalSpace(CurShip)) OrderTakeOff(CurShip);",
                        "else if(ShipStar(CurShip) == ShipStar(Player()))",
                        "{",
                        "    OrderFollowShip(CurShip, Player(), 0);",
                        "    ShipFreeFlight(CurShip, 1); //Автонаведение орудий на всякую хрень",
                        "",
                        "    if(ShipInNormalSpace(Player()))",
                        "    {",
                        "        if(Dist(CurShip, Player()) <= ShipRadarRange(Player()))",
                        "        {",
                        "            //Диалог переговоров: у трёх старых организаций свой, у остальных - общий TalkOrg",
                        "            if(ShipGroup(CurShip) == RedAxesLeader) Dialog(TalkRed, RedAxesLeader);",
                        "            else if(ShipGroup(CurShip) == AtlantLeader) Dialog(TalkAtlant, AtlantLeader);",
                        "            else if(ShipGroup(CurShip) == FaeyangelionLeader) Dialog(TalkFei, FaeyangelionLeader);",
                        "            else //Остальные организации - общий диалог TalkOrg, тексты OrgTable.<Id>.Talk*",
                        "            {",
                        "                org_talk = OrgOfShip(CurShip);",
                        "                //Свой диалог организации (TalkDialog), иначе общий",
                        "                if(OrgS(org_talk, 'Talk.Dialog') == 'TalkWhalers') Dialog(TalkWhalers, ShipGroup(CurShip));",
                        "                else if(OrgS(org_talk, 'Talk.Dialog') == 'TalkSecondLine') Dialog(TalkSecondLine, ShipGroup(CurShip));",
                        "                else if(OrgS(org_talk, 'Talk.Dialog') == 'TalkWardens') Dialog(TalkWardens, ShipGroup(CurShip));",
                        "                else Dialog(TalkOrg, ShipGroup(CurShip));",
                        "            }",
                        "        }",
                        "    }",
                        "}",
                        "else OrderJump(CurShip, ShipStar(Player()));",
                        "",
                        "//Запахло жареным, лидер драпает",
                        "if(HullDamage(CurShip) > 66)",
                        "{",
                        "    OrgNegAbort(meet_sq);",
                        "    ChangeState('LeaderReturning');",
                        "    exit;",
                        "}",
                        "int cur_org = ShipGroup(CurShip);",
                        "//Номер организации и роль группы (0 - наёмники, 1 - лидер)",
                        "int org_sq = OrgByGroup(cur_org);",
                        "int org_role = OrgRoleByGroup(cur_org);",
                        "",
                        "//Наёмник организации",
                        "if(org_sq >= 1 && org_role == 0)",
                        "{",
                        "    //Организация без лидера распадается: наёмники уходят во фрилансеры",
                        "    if(!GroupCount(OrgGrp(org_sq, 1)))",
                        "    {",
                        "        //Флагман не уходит во фрилансеры, а становится военным (OrgFlagToWarrior)",
                        "        if(OrgIsFlagship(CurShip)) OrgFlagToWarrior(CurShip);",
                        "        else MakeFreelancerFromMerc(CurShip);",
                        "        exit;",
                        "    }",
                        "    else",
                        "    {",
                        "        RelationToRanger(CurShip, OrgLeader(org_sq), 100);",
                        "        if(ShipIsPartner(CurShip) != Player()) RelationToRanger(CurShip, Player(), OrgRel(org_sq));",
                        "        else RelationToRanger(CurShip, Player(),100);",
                        "    }",
