                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 580,
                    "Pos.y": 2220,
                    "Parent": -1,
                    "#": 585,
                    "Code.Type": "Turn",
                    "Code": [
                        "coef2 = 105;",
                        "attack_type = 1;",
                        "if(attack_type == 1)",
                        "{",
                        "    tint2 = ShipSkill(Player(), 'LeadershipCur');",
                        "    //Добавляем ответы с выбором числа наёмников, которых игрок может нанять для атаки",
                        "    /*for(i = 3; i <= 10; i = i + 1)",
                        "    {",
                        "        if(i == 3) tstr1 = \"Три\";",
                        "        else if(i == 4) tstr1 = \"Четыре\";",
                        "        else if(i == 5) tstr1 = \"Пять\";",
                        "        else if(i == 6) tstr1 = \"Шесть\";",
                        "        else if(i == 7) tstr1 = \"Семь\";",
                        "        else if(i == 8) tstr1 = \"Восемь\";",
                        "        else if(i == 9) tstr1 = \"Девять\";",
                        "        else if(i == 10) tstr1 = \"Десять\";",
                        "",
                        "        //Запоминаем требование к навыку лидерства игрока",
                        "        if(i < 9) tint3 = 5;",
                        "        else tint3 = 6;",
                        "",
                        "        if((tint2 * 2) >= i && Soldats >= i) InjectAnswer('AttackMBChoose', tstr1, i);",
                        "        else",
                        "        {",
                        "            AddDialogBlock(tstr1, 1);",
                        "            InjectAnswer('AttackMBChoose', tstr1, i);",
                        "        }",
                        "    }*/",
                        "",
                        "    tint2 = min(GalaxyTechLevel(),5);",
                        "    tint3 = GalaxyTechLevel() * 2 + 7;",
                        "    cnt = CountBox('Bm.Items.2Hull_People_W_s',CT('Script.Mod_ShuMercs.MercCenterDialogs.ChooseCount'),tint2,tint3);",
                        "}",
                        "if(cnt < 1) {",
                        "  DChange(2);",
                        "  exit;",
                        "}",
                        "if(cnt > 0) {",
                        "  dmsg = '</color>' + CT('Script.Mod_ShuMercs.DialogTexts.AttackMBChoose.AskStar');",
                        "  DChange(5);",
                        "  exit;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 700,
                    "Pos.y": 2220,
                    "Parent": -1,
                    "#": 586,
                    "Code.Type": "Turn",
                    "Code": [
                        "coef2 = 95;",
                        "//\"Я мистер Шу, и мне вообще похуЮ на качество диалогов и иммерсивность игры\"",
                        "//\"Поэтому я прямо в реплики персонала ЦН добавлю указание на навык лидерства игрока, см. ниже\"",
                        "//-----",
                        "//Я Клаксон, и я буду в комментах писать всякую херню",
                        "//Ну и не подумаю даже исправить что-то, это для васянов всяких",
                        "",
                        "tstr1 = '</color>' + CT('Script.Mod_ShuMercs.MercCenterDialogs.EscortAsk');",
                        "DChange(1);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 820,
                    "Pos.y": 2220,
                    "Parent": -1,
                    "#": 587,
                    "Code.Type": "Turn",
                    "Code": [
                        "for(int i = 0; i < cnt; i = i + 1)",
                        "{",
                        "    cur_planet = FindPlanetByAdvancement(100, -1);",
                        "",
                        "    cur_ship = OrgSpawnHired(Squad, cur_planet);",
                        "",
                        "    ShipOwner(cur_ship, ShipOwner(Player())); //Чтобы не разрывали с игроком контракт сразу после найма",
                        "    ShipSetPartner(cur_ship, Player(), tint4);",
                        "    ChangeState('MercEscort', cur_ship);",
                        "}",
                        "",
                        "ShipMoney(Player(), ShipMoney(Player()) - cost);",
                        "Sound('Sound.Buy');"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 940,
                    "Pos.y": 2220,
                    "Parent": -1,
                    "#": 588,
                    "Code.Type": "Turn",
                    "Code": [
                        "coef2 = 60;",
                        "attack_type = 2;",
                        "",
                        "if(GalaxyTechLevel() < 5) cnt = 3;",
                        "else if(GalaxyTechLevel() < 6) cnt = 4;",
                        "else if(GalaxyTechLevel() < 7) cnt = 5;",
                        "else cnt = 6;",
                        "dmsg = '</color>' + CT('Script.Mod_ShuMercs.DialogTexts.AttackMBChoose.AskStar');",
                        "DChange(5);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 1060,
                    "Pos.y": 2220,
                    "Parent": -1,
                    "#": 589,
                    "Code.Type": "Turn",
                    "Code": [
                        "timer_attack = CurTurn() + 90;",
                        "enemy_for_all = 0;",
                        "",
                        "for(int i = 0; i < cnt; i = i + 1)",
                        "{",
                        "    cur_planet = FindPlanetByAdvancement(100, -1);",
                        "",
                        "    cur_ship = OrgSpawnHired(Squad, cur_planet);",
                        "",
                        "    ChangeState('AttackTakeoff', cur_ship);",
                        "}",
                        "",
                        "ShipMoney(Player(), ShipMoney(Player()) - cost);",
                        "Sound('Sound.Buy');"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 1180,
                    "Pos.y": 2220,
                    "Parent": -1,
                    "#": 590,
                    "Code.Type": "Turn",
                    "Code": [
                        "rospusk_raida = CurTurn() + 1;",
                        "timer_raid = CurTurn() + 90;",
                        "",
                        "for(int i = 0; i < cnt; i = i + 1)",
                        "{",
                        "    cur_planet = FindPlanetByAdvancement(100, -1);",
                        "",
                        "    cur_ship = OrgSpawnHired(Squad, cur_planet);",
                        "",
                        "    ChangeState('RaidTakeoff', cur_ship);",
                        "}",
                        "",
                        "ShipMoney(Player(), ShipMoney(Player()) - cost);",
                        "Sound('Sound.Buy');"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 1420,
                    "Pos.y": 2220,
                    "Parent": -1,
                    "#": 591,
                    "Code.Type": "Turn",
                    "Code": [
                        "int is_valid = 0;",
                        "tstr6 = TextBox(CT('Script.Mod_ShuMercs.CodeTexts.KillTarget.Ask'));",
                        "check = 0;",
                        "for(int i = 0; i < GalaxyStars(); i = i + 1)",
                        "{",
                        "    dword star = GalaxyStar(i);",
                        "    for(int j = StarShips(star) - 1; j >= 0; j = j - 1)",
                        "    {",
                        "        target_ship = StarShips(star, j);",
                        "",
                        "        if(lowercase(DeleteTags(ShortName(target_ship))) != lowercase(tstr6))",
                        "        {",
                        "            if(lowercase(DeleteTags(Name(target_ship))) != lowercase(tstr6))",
                        "            {",
                        "                check = 6; //Цель невозможно найти в поиске, наёмник откажется",
                        "                continue;",
                        "            }",
                        "        }",
                        "",
                        "        if(ShipStrengthInAverageRanger(target_ship) >= ShipStrengthInAverageRanger(cur_ship) * 1.50)",
                        "        {",
                        "            check = 1; //Цель слишком сильна, наёмник откажется",
                        "        }",
                        "        else if(ShipStrengthInAverageRanger(target_ship) >= ShipStrengthInAverageRanger(cur_ship) * 1.35)",
                        "        {",
                        "            check = 2;",
                        "            coef = 200;",
                        "        }",
                        "        else if(ShipStrengthInAverageRanger(target_ship) >= ShipStrengthInAverageRanger(cur_ship) * 1.20)",
                        "        {",
                        "            check = 3;",
                        "            coef = 150;",
                        "        }",
                        "        else if(ShipStrengthInAverageRanger(target_ship) >= ShipStrengthInAverageRanger(cur_ship) * 0.85)",
                        "        {",
                        "            check = 4;",
                        "            coef = 110;",
                        "        }",
                        "        else",
                        "        {",
                        "            check = 5;",
                        "            coef = 75;",
                        "        }",
                        "",
                        "        if(ShipStar(target_ship) == GalaxyStar(TortugatzId) || ShipStar(target_ship) == GalaxyStar(NifigatzId))",
                        "        {",
                        "            check = 6; //Цель невозможно найти в поиске, наёмник откажется",
                        "        }",
                        "",
                        "        if(target_ship == cur_ship ||",
                        "           target_ship == Terron() ||",
                        "           target_ship == Keller() ||",
                        "           target_ship == Blazer() ||",
                        "           target_ship == Player() ||",
                        "           ShipOwner(target_ship) == Kling ||",
                        "",
                        "           ShipType(target_ship) == 'Machpella' ||",
                        "           ShipType(target_ship) == 'Neurolink' ||",
                        "           ShipType(target_ship) == 'Unknown' ||",
                        "",
                        "           ShipTypeN(target_ship) == t_Tranclucator ||",
                        "           ObjectType(target_ship) == 4)",
                        "        {",
                        "            check = 7; //Цель выходит за рамки здравого смысла, наёмник откажется",
                        "        }",
                        "",
                        "        if(ShipType(target_ship) == 'MercLeader')",
                        "        {",
                        "            check = 7; //Цель выходит за рамки здравого смысла, наёмник откажется",
                        "        }",
                        "",
                        "        //Организация берёт заказы только на пиратов (KillOnlyPirates)",
                        "        if(merc_type == 1)",
                        "        {",
                        "            if(OrgI(OrgOfShip(cur_ship), 'Contract.KillOnlyPirates', 0))",
                        "            {",
                        "                if(ShipTypeN(target_ship) != t_Pirate && ShipOwner(target_ship) != PirateClan) check = 7;",
                        "            }",
                        "        }",
                        "",
                        "        //Если корабль невозможно выбрать целью для атаки рейнджера",
                        "        if(NoTargetToShip(target_ship) == 1 || NoTargetToShip(target_ship) == 2 || NoTargetToShip(target_ship) == 4)",
                        "        {",
                        "            check = 7; //Цель выходит за рамки здравого смысла, наёмник откажется",
                        "        }",
                        "",
                        "        if(ShipType(target_ship) == 'Merc' || ShipType(target_ship) == 'Freelancer')",
                        "        {",
                        "            if(GroupToShip(MercCenter))",
                        "            {",
                        "                if(ShipStar(target_ship) == ShipStar(GroupToShip(MercCenter))) check = 8; //Цель является другим наёмником и находится в системе с центром наёмников, наёмник откажется",
                        "            }",
                        "        }",
                        "",
                        "        if(ShipIsPartner(target_ship) == cur_ship || ShipIsPartner(cur_ship) == target_ship)",
                        "        {",
                        "            check = 9; //Цель является коллегой наёмника, наёмник откажется",
                        "        }",
                        "",
                        "        if(ShipType(cur_ship) == 'Merc' && ShipType(target_ship) == 'Merc')",
                        "        {",
                        "            if(ShipGroup(cur_ship) == ShipGroup(target_ship)) check = 9; //Цель является коллегой наёмника, наёмник откажется",
                        "        }",
                        "",
                        "        cost = GalaxyMoney(3) * coef / 100;",
                        "",
                        "        rel = 0;",
                        "        if(merc_type == 1)",
                        "        {",
                        "            cost = cost * coef2 / 100;",
                        "            int cur_org = OrgOfShip(cur_ship);",
                        "            rel = OrgRel(cur_org) / 2;",
                        "        }",
                        "",
                        "        coef = 100 - rel;",
                        "        cost = cost * coef / 100;",
                        "        is_valid = 1;",
                        "",
                        "        break;",
                        "    }",
                        "",
                        "    if(is_valid) break;",
                        "}",
                        "if(check == 1) {",
                        "  dmsg = '</color>' + Format(CT('Script.Mod_ShuMercs.DialogTexts.MercHire.RefuseRisk'), '<ShipNameTargetShip'+'>', ShipName(target_ship));",
                        "  DChange(12);",
                        "  exit;",
                        "}",
                        "if(check == 8) {",
                        "  dmsg = '</color>' + Format(CT('Script.Mod_ShuMercs.DialogTexts.MercHire.RefuseInCenter'), '<ShipNameTargetShip'+'>', ShipName(target_ship));",
                        "  DChange(55);",
                        "  exit;",
                        "}",
                        "if(check == 9) {",
                        "  dmsg = '</color>' + Format(CT('Script.Mod_ShuMercs.DialogTexts.MercHire.RefuseColleague'), '<ShipNameTargetShip'+'>', ShipName(target_ship));",
                        "  DChange(56);",
                        "  exit;",
                        "}",
                        "if(check == 2 && merc_type == 1) {",
                        "  dmsg = '</color>' + Format(CT('Script.Mod_ShuMercs.DialogTexts.MercHire.PriceHugeDiscount'), '<ShipNameTargetShip'+'>', ShipName(target_ship), '<Tstr5'+'>', tstr5, '<Rel'+'>', rel, '<Cost'+'>', cost);",
                        "  DChange(13);",
                        "  exit;",
                        "}",
                        "if(check == 3 && merc_type == 1) {",
                        "  dmsg = '</color>' + Format(CT('Script.Mod_ShuMercs.DialogTexts.MercHire.PriceHighDiscount'), '<NameTargetShip'+'>', Name(target_ship), '<Tstr5'+'>', tstr5, '<Rel'+'>', rel, '<Cost'+'>', cost);",
                        "  DChange(14);",
                        "  exit;",
                        "}",
                        "if(check == 4 && merc_type == 1) {",
                        "  dmsg = '</color>' + Format(CT('Script.Mod_ShuMercs.DialogTexts.MercHire.PriceMidDiscount'), '<NameTargetShip'+'>', Name(target_ship), '<Tstr5'+'>', tstr5, '<Rel'+'>', rel, '<Cost'+'>', cost);",
                        "  DChange(15);",
                        "  exit;",
                        "}",
                        "if(check == 5 && merc_type == 1) {",
                        "  dmsg = '</color>' + Format(CT('Script.Mod_ShuMercs.DialogTexts.MercHire.PriceLowDiscount'), '<ShipNameTargetShip'+'>', ShipName(target_ship), '<Cost'+'>', cost, '<Rel'+'>', rel);",
                        "  DChange(16);",
                        "  exit;",
                        "}",
                        "if(check == 2 && merc_type == 2) {",
                        "  dmsg = '</color>' + Format(CT('Script.Mod_ShuMercs.DialogTexts.MercHire.PriceHuge'), '<NameTargetShip'+'>', Name(target_ship), '<Cost'+'>', cost);",
                        "  DChange(19);",
                        "  exit;",
                        "}",
                        "if(check == 3 && merc_type == 2) {",
                        "  dmsg = '</color>' + Format(CT('Script.Mod_ShuMercs.DialogTexts.MercHire.PriceHigh'), '<NameTargetShip'+'>', Name(target_ship), '<Cost'+'>', cost);",
                        "  DChange(20);",
                        "  exit;",
                        "}",
                        "if(check == 4 && merc_type == 2) {",
                        "  dmsg = '</color>' + Format(CT('Script.Mod_ShuMercs.DialogTexts.MercHire.PriceMid'), '<ShipNameTargetShip'+'>', ShipName(target_ship), '<ShortNameTargetShip'+'>', ShortName(target_ship), '<Cost'+'>', cost);",
                        "  DChange(21);",
                        "  exit;",
                        "}",
                        "if(check == 5 && merc_type == 2) {",
                        "  dmsg = '</color>' + Format(CT('Script.Mod_ShuMercs.DialogTexts.MercHire.PriceLow'), '<ShipNameTargetShip'+'>', ShipName(target_ship), '<Cost'+'>', cost);",
                        "  DChange(22);",
                        "  exit;",
                        "}",
                        "if(check == 6) {",
                        "  dmsg = '</color>' + Format(CT('Script.Mod_ShuMercs.DialogTexts.MercHire.NotFound'), '<Tstr6'+'>', tstr6);",
                        "  DChange(17);",
                        "  exit;",
                        "}",
                        "if(check == 7) {",
                        "  dmsg = '</color>' + Format(CT('Script.Mod_ShuMercs.DialogTexts.MercHire.RefuseJoke'), '<NameTargetShip'+'>', Name(target_ship));",
                        "  DChange(18);",
                        "  exit;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 1540,
                    "Pos.y": 2220,
                    "Parent": -1,
                    "#": 592,
                    "Code.Type": "Turn",
                    "Code": [
                        "free_timer = CurTurn() + 120;",
                        "free_name = Name(cur_ship);",
                        "target_name = Name(target_ship);",
                        "target_id = Id(target_ship);",
                        "free_id = Id(cur_ship);",
                        "",
                        "//Фрилансер: все организации недовольны, наёмник организации - как при найме",
                        "if(merc_type == 2)",
                        "{",
                        "    OrgRelAddAll(-2);",
                        "}",
                        "else if(merc_type == 1)",
                        "{",
                        "    OrgHireShift(OrgOfShip(cur_ship), cur_ship);",
                        "}",
                        "",
                        "if(ShipIsPartner(cur_ship)) ShipSetPartner(cur_ship, ShipIsPartner(cur_ship), 0);",
                        "ChangeState('MercFreeHireState', cur_ship);",
