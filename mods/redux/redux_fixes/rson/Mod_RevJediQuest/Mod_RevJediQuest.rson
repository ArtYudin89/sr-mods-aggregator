                    "Code": [
                        "if(vState==4) {",
                        "  ChangeState(5);",
                        "  exit;",
                        "}",
                        "if(GroupToShip(Ranger)) {",
                        "  if(vDaysJedi>20 && GetShipPlanet(GroupToShip(Ranger))==PlanetNone) {",
                        "    Dialog(dPirat,Pirate);",
                        "  }",
                        "}",
                        "if(vState==0 && !GroupToShip(Ranger)) {",
                        "  ChangeState(5);",
                        "  exit;",
                        "}",
                        "if(vState==6) {",
                        "  ShipOut(CurShip);",
                        "  ShipOut(Player());",
                        "  if(vState==0)ShipDestroy(GroupToShip(Target));",
                        "  AllShipOut();",
                        "}",
                        "if(vState==3) {",
                        "  ChangeState(4);",
                        "  exit;",
                        "}",
                        "if(vState==5) {",
                        "  ShipDestroy(CurShip);",
                        "  ShipOut(CurShip);",
                        "  ShipOut(Player());",
                        "  if(vState==0)ShipDestroy(GroupToShip(Target));",
                        "  AllShipOut();",
                        "}",
                        "if(vDaysJedi>5000) {",
                        "  ShipOut(CurShip);",
                        "  ShipOut(Player());",
                        "  if(vState==0)ShipDestroy(GroupToShip(Target));",
