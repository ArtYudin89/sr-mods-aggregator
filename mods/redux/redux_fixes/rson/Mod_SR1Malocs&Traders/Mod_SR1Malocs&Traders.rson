            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 600,
                    "Parent": -1,
                    "#": 7,
                    "Code.Type": "Global",
                    "Code": [
                        "if(GRunFrom==3) {",
                        "  if(GCntRun(GScriptName)<3) {",
                        "    if((CurTurn()-GLastTurnRun(GScriptName,0))>620) {",
                        "      if(ShipStrengthInAverageRanger(Player())>=1.5) {",
                        "        if(RangerStatus(Player())==Trader) {",
                        "          GRun();",
                        "        }",
                        "      }",
                        "    }",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 600,
                    "Parent": -1,
                    "#": 8,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!CountIn(MalocGroup)) {",
                        "  ShipOut(Player());",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 205,
                    "Parent": -1,
                    "#": 41,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(vMalocTalkState==2) {",
                        "  ChangeState(3);",
                        "  exit;",
                        "}",
                        "if(vMalocTalkState==3) {",
                        "  ChangeState(2);",
                        "  exit;",
                        "}",
                        "if(ShipInNormalSpace(CurShip)) {",
                        "  if(ShipInNormalSpace(Player())) {",
                        "    if(ShipInStar(Player(),Star1)) {",
                        "      if(Dist(CurShip,Player())<200) {",
                        "        Dialog(dMalocTalk,CurShip);",
                        "      }",
                        "    }",
                        "  }",
                        "}",
                        "if(ShipInNormalSpace(Player()) && !ShipInStar(Player(),Star1)) {",
                        "  ShipOut(CurShip);",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 265,
                    "Parent": -1,
                    "#": 42,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!ShipInStar(Player(),Star1)) {",
                        "  ShipOut(CurShip);",
                        "}"
                    ]
                },
