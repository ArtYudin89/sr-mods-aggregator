                    "Name": "",
                    "Pos.x": 160,
                    "Pos.y": 265,
                    "Parent": -1,
                    "#": 43,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(EndState) {",
                        "  ShipOut(CurShip);",
                        "}"
                    ]
                },
