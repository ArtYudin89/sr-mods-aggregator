                        "    if(EqCustomFaction(dwd1) == 'Klissan') { n1 = n1 + int((100 - ItemDurability(dwd1)) / 10) + 1; n2 = int(n2 * 1.3); }",
                        "    nraw = nraw + n2;",
                        "}",
                        "n3 = int(1.0 * RangerStatus(Player()) / 1.3 + 0.5) + 1;",
                        "n0 = nraw - int(0.01 * nraw * n3); if(n0 < 1 && n1 == 0) n0 = 0;",
                        "if(n0 > 0 || n1 > 0) InjectAnswer('PB_Repair_Do', '</color>' + CT('FormRuins.PB.Repair.PlayerOk'), 1);",
                        "if(n0 > 0 || n1 > 0) InjectAnswer('PB_Repair_No', '</color>' + CT('FormRuins.PB.Repair.PlayerNo'), 0);",
                        "DAdd(10);"
                    ]
                },
                {
                    "Type": "Top",
