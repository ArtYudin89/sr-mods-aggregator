                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 725,
                    "Parent": -1,
                    "#": 25,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "cur_ruin = GetShipRuins(Player());",
                        "if(cur_ruin) SFT('ExpPB DialogBegin: base type=' + ShipType(cur_ruin));",
                        "if(cur_ruin)",
                        "{",
                        "    if(ShipType(cur_ruin) == 'PB')",
                        "    {",
                        "        t0 = '';",
                        "        //--- ChangeSide (only after vanilla intro script PC_part0 has finished) ---",
                        "        AddDialogBlock(CT('FormRuins.PB.ChangeSide.ChangeSideToPirate'), 2);",
                        "        AddDialogBlock(CT('FormRuins.PB.ChangeSide.ChangeSideToNormal'), 2);",
                        "        if(IsScriptActive('PC_part0') == 0 && ShipOnSidePirateClan(Player())) AddDialogInject('PB_ChangeSide', '', DeleteTags(Format(t0 + CT('FormRuins.PB.ChangeSide.ChangeSideToNormal'), 'а','a','е','e','о','o','с','c','р','p','х','x','у','y','А','A','Е','E','О','O','С','C','Р','P','Х','X','К','K','М','M','Н','H','В','B','Т','T')), 1);",
                        "        if(IsScriptActive('PC_part0') == 0 && ShipOnSidePirateClan(Player()) == 0) AddDialogInject('PB_ChangeSide', '', DeleteTags(Format(t0 + CT('FormRuins.PB.ChangeSide.ChangeSideToPirate'), 'а','a','е','e','о','o','с','c','р','p','х','x','у','y','А','A','Е','E','О','O','С','C','Р','P','Х','X','К','K','М','M','Н','H','В','B','Т','T')), 1);",
                        "        //--- ChangeNationality: сверху только без ExpImplants; иначе уезжает в подменю PB_BodyMods ---",
                        "        AddDialogBlock(CT('FormRuins.PB.ChangeNationality.ChangeNationality'), 2);",
                        "        if(!CurrentMods('Expansion\\\\ExpImplants')) AddDialogInject('PB_ChangeNationality', '', DeleteTags(Format(t0 + CT('FormRuins.PB.ChangeNationality.ChangeNationality'), 'а','a','е','e','о','o','с','c','р','p','х','x','у','y','А','A','Е','E','О','O','С','C','Р','P','Х','X','К','K','М','M','Н','H','В','B','Т','T')), 1);",
                        "        //--- Program: блокируем ванильный ответ, инжект уезжает в подменю PB_Shop ---",
                        "        AddDialogBlock(CT('FormRuins.PB.Program.PlayerAsk'), 2);",
                        "        //--- Nod: блокируем ванильный ответ, инжект уезжает в подменю PB_Shop ---",
                        "        AddDialogBlock(CT('FormRuins.PB.Nod.PlayerAsk'), 2);",
                        "        //--- Repair ---",
                        "        AddDialogBlock(CT('FormRuins.PB.Repair.PlayerSend'), 2);",
                        "        AddDialogInject('PB_Repair', '', DeleteTags(Format(t0 + CT('FormRuins.PB.Repair.PlayerSend'), 'а','a','е','e','о','o','с','c','р','p','х','x','у','y','А','A','Е','E','О','O','С','C','Р','P','Х','X','К','K','М','M','Н','H','В','B','Т','T')), 1);",
                        "        //--- Chameleon: блокируем ванильный ответ, инжект уезжает в подменю PB_Shop ---",
                        "        AddDialogBlock(CT('FormRuins.PB.Chameleon.PlayerAsk'), 2);",
                        "        //--- Группирующие подменю (сообщение НЕ трогаем -> остаётся приветствие ПБ) ---",
                        "        AddDialogInject('PB_Shop', '', '</color>' + CT('FormRuins.PB.Grouping.Shop'), 1);",
                        "        if(CurrentMods('Expansion\\\\ExpImplants')) AddDialogInject('PB_BodyMods', '', '</color>' + CT('FormRuins.PB.Grouping.BodyMods'), 1);",
                        "        //--- SabCrack (ванильный гейт PB_IsSabCrackAvailable@0x794A3C, verified в IDA):",
                        "        //    терроноиды исследованы && Day>2000 && (периодика || Day>4000) && программа#4 не куплена.",
                        "        //    Day = CurTurn() (= *(Galaxy+76), verified). Без Day>2000 виден с начала игры.",
                        "        AddDialogBlock(CT('FormRuins.PB.SabCrack.PlayerInfo'), 2);",
                        "        t9 = CurTurn();",
                        "        if(GalaxyDominatorResearchPercent(2) >= 100 && t9 > 2000 && ((t9 % ((t9 % 11) + 20)) == 0 || t9 > 4000) && GetProgramm(4) == 0)",
                        "            AddDialogInject('PB_SabCrack', '', DeleteTags(Format(t0 + CT('FormRuins.PB.SabCrack.PlayerInfo'), 'а','a','е','e','о','o','с','c','р','p','х','x','у','y','А','A','Е','E','О','O','С','C','Р','P','Х','X','К','K','М','M','Н','H','В','B','Т','T')), 1);",
                        "        //--- SpecialShip (pirate ace only) ---",
                        "        AddDialogBlock(CT('FormRuins.PB.SpecialShip.Ask'), 2);",
                        "        if(ShipInPirateClan(Player()) && GetShipPirateRank(Player()) >= 5) AddDialogInject('PB_SpecialShip', '', DeleteTags(Format(t0 + CT('FormRuins.PB.SpecialShip.Ask'), 'а','a','е','e','о','o','с','c','р','p','х','x','у','y','А','A','Е','E','О','O','С','C','Р','P','Х','X','К','K','М','M','Н','H','В','B','Т','T')), 1);",
                        "        //--- WarStatus + AskQuestion (pirates only) ---",
                        "        if(ShipInPirateClan(Player()))",
                        "        {",
                        "            AddDialogBlock(CT('FormRuins.PB.WarWithKlingAndCoalition.PlayerSend'), 2);",
                        "            AddDialogInject('PB_WarStatus', '', DeleteTags(Format(t0 + CT('FormRuins.PB.WarWithKlingAndCoalition.PlayerSend'), 'а','a','е','e','о','o','с','c','р','p','х','x','у','y','А','A','Е','E','О','O','С','C','Р','P','Х','X','К','K','М','M','Н','H','В','B','Т','T')), 1);",
                        "            AddDialogBlock(CT('FormRuins.PB.AskQuestion.PlayerAsk'), 2);",
                        "            AddDialogInject('PB_AskQuestion', '', DeleteTags(Format(t0 + CT('FormRuins.PB.AskQuestion.PlayerAsk'), 'а','a','е','e','о','o','с','c','р','p','х','x','у','y','А','A','Е','E','О','O','С','C','Р','P','Х','X','К','K','М','M','Н','H','В','B','Т','T')), 1);",
                        "        }",
                        "    }",
                        "}"
                    ]
                },
