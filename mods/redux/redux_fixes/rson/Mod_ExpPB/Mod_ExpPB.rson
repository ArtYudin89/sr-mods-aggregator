                    "Code": [
                        "sel = GAnswerData;",
                        "n1 = int(1.0 * RangerStatus(Player()) / 1.3 + 0.5) + 1;",
                        "n0 = 0;",
                        "n2 = 0;",
                        "if(sel == 5) { n0 = 500; n0 = n0 - int(1.0 * 500 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; n2 = 5; }",
                        "if(sel == 6) { n0 = 1000; n0 = n0 - int(1.0 * 1000 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; n2 = 3; }",
                        "if(sel == 7) { n0 = 800; n0 = n0 - int(1.0 * 800 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; n2 = 3; }",
                        "if(sel == 8) { n0 = 300; n0 = n0 - int(1.0 * 300 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; n2 = 3; }",
                        "if(sel == 9) { n0 = 200; n0 = n0 - int(1.0 * 200 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; n2 = 3; }",
                        "if(sel == 10) { n0 = 1200; n0 = n0 - int(1.0 * 1200 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; n2 = 1; }",
                        "if(sel == 11) { n0 = 900; n0 = n0 - int(1.0 * 900 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; n2 = 1; }",
                        "if(GetNodesFromShip(Player()) + RangerBaseNodes(Player()) >= n0)",
                        "{",
                        "    dwd1 = GetNodesFromShip(Player()); if(dwd1 > n0) dwd1 = n0;",
                        "    if(dwd1 > 0) GetNodesFromShip(Player(), dwd1);",
                        "    if(n0 - dwd1 > 0) RangerBaseNodes(Player(), RangerBaseNodes(Player()) - (n0 - dwd1));",
                        "    SetProgramm(sel, GetProgramm(sel) + n2);",
                        "    Sound('Sound.Sell');",
                        "    t0 = '';",
                        "    if(sel == 5) t0 = CT('Programms.Intercom.Name');",
                        "    if(sel == 6) t0 = CT('Programms.Shipwreck.Name');",
                        "    if(sel == 7) t0 = CT('Programms.WeaponBlocking.Name');",
                        "    if(sel == 8) t0 = CT('Programms.Insanity.Name');",
                        "    if(sel == 9) t0 = CT('Programms.Shock.Name');",
                        "    if(sel == 10) t0 = CT('Programms.SelfDestruction.Name');",
                        "    if(sel == 11) t0 = CT('Programms.Disconnection.Name');",
                        "    dtext = '</color>' + Format(CT('FormRuins.PB.Program.PBAfterOk'), '<Text'+'>', t0);",
                        "}",
                        "else dtext = '</color>' + Format(CT('FormRuins.PB.Program.PBAfterNo'), '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player()));",
                        "dtext = Format(dtext);",
                        "DChange(7);",
                        "exit;"
