            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 1325,
                    "Parent": -1,
                    "#": 65,
                    "Code.Type": "Global",
                    "Code": [
                        "//vPeleng == 1 - пеленг ждёт наркоты",
                        "//vPeleng == 2 - пеленг обиделся, наркоту не дали :(",
                        "//vPeleng == 3 - пеленг получил наркоту, игрок попросил энергопакет",
                        "//vPeleng == 4 - пеленг получил наркоту, игрок попросил не то или ничего",
                        "//vPeleng == 5 - пеленга нашутили;",
                        "//Гаалец",
                        "//vGaal==1 - состояние со старта",
                        "//vGaal==2 - гаалец ждёт Энергопакет от игрока",
                        "//vGaal==3 - гаалеца обидели",
                        "//vGaal==4 - гаалец летит за Энергопакетом",
                        "//vGaal==5 - гаалецу помогли, он улетает, довольный;",
                        "if(vRunScrElection==0) {",
                        "    if((CurTurn()+1)>1890) {",
                        "        if(GlobalRelationsPlanets(Player(),0,56)>60) {",
                        "            GRun();",
                        "        }",
                        "    }",
                        "}",
                        "//Фэянин",
                        "//vFei соответствует настроению фэянина. Если ему льстить, то он будет вежливее говорить",
                        "//vFei==7 - отдали технику",
                        "//vFei==20 - фэянин благодарен и улетает",
                        "//vFei==21 - дополнительная стадия, добавленная мной, чтобы возникала галактическая новость о достижениях далани;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 1325,
                    "Parent": -1,
                    "#": 66,
                    "Code.Type": "Init",
                    "Code": [
                        "vSearchD=Rnd(55,99);",
                        "vBegin=CurTurn();",
                        "vPass=Rnd(1,6);",
                        "vFeiV=Rnd(1,3);",
                        "vSerachStr=vSearchD;",
                        "",
                        "//Назначаем имена избираемым",
                        "if(vPass==1) {",
                        "    vName4=CT(\"Script.Mod_RevElection.466\");",
                        "    vName1=CT(\"Script.Mod_RevElection.465\");",
