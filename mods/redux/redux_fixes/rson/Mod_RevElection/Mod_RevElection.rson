                        "        if(!ItemIsInUse(ShipItems(GroupToShip(Maloc),i))) {",
                        "            if(ItemInScript(ShipItems(GroupToShip(Maloc),i))) ReleaseItemFromScript(ShipItems(GroupToShip(Maloc),i));",
                        "            GetItemFromShip(ShipItems(GroupToShip(Maloc),i));",
                        "            FreeItem(ShipItems(GroupToShip(Maloc),i));",
                        "        }",
                        "    }",
                        "}*/",
                        "//Если помогли 3+ из 5 - переходим к следующему этапу",
                        "//Только после расчёта агитатора за голос (vTalkAgit>=4), иначе он застревает в StateF",
                        "if(vTalkAgit>=4 && vTalkAgit<8) {",
                        "    if(vShips>=3) {",
                        "        vTalkAgit=10;",
                        "    }",
                        "}",
                        "//Последствие помощи фэю",
                        "if(vFei==20) {",
                        "    if(vInvestigs) vInvestigs = vInvestigs - 1;",
                        "    if(!vInvestigs) {",
                        "        AddPlanetNews(Format(CT(\"Script.Mod_RevElection.455\"),\"<0>\",FeiName));",
                        "        vFei = 21;",
                        "    }",
                        "}",
                        "NoTargetToShip(GroupToShip(People),2);",
                        "NoTargetToShip(GroupToShip(Gaal),2);",
                        "NoTargetToShip(GroupToShip(Maloc),2);",
                        "NoTargetToShip(GroupToShip(Peleng),2);",
                        "NoTargetToShip(GroupToShip(Fei),2);",
                        "NoTargetToShip(GroupToShip(Agit),1);",
                        "if(vState==20 && vTalkAgit==20) {",
                        "  if(CountIn(People)) {",
                        "    ShipOut(GroupToShip(People));",
                        "  }",
                        "  if(CountIn(Gaal)) {",
                        "    ShipOut(GroupToShip(Gaal));",
                        "  }",
                        "  if(CountIn(Fei)) {",
