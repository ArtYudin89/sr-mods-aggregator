                        "    vName=CT(\"Script.Mod_RevElection.463\");",
                        "    vName1=CT(\"Script.Mod_RevElection.462\");",
                        "}",
                        "if(vPass==4 || vPass==5) {",
                        "    vName=CT(\"Script.Mod_RevElection.464\");",
                        "    vName1=CT(\"Script.Mod_RevElection.466\");",
