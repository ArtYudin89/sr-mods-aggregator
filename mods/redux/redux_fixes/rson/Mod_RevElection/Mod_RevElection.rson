                        "if(vShips<4) {",
                        "    if(CountIn(Agit)) {",
                        "        if(vTalkAgit==7 && vMoney>0) {",
                        "            if(Dist(Player(),PlacePLS)<250) {",
                        "                ShipMoney(Player(),ShipMoney(Player())+vMoney);",
                        "                Sound('Sound.Buy');",
                        "            }",
                        "            //Ну партнёры-то тоже висят!)))",
                        "            if(ShipPartners(Player())) {",
                        "                for(i=0;ShipPartners(Player())>i;i=i+1) {",
                        "                    if(Dist(ShipPartners(Player(),i),PlacePLS)<350) {",
                        "                        ShipMoney(Player(),ShipMoney(Player())+vMoney);",
                        "                        Sound('Sound.Buy');",
                        "                    }",
                        "                }",
                        "                for(i=0;PlayerTranclucators()>i;i=i+1) {",
                        "                    if(Dist(PlayerTranclucators(i),PlacePLS)<350) {",
                        "                        ShipMoney(Player(),ShipMoney(Player())+vMoney);",
                        "                        Sound('Sound.Buy');",
                        "                    }",
                        "                }",
                        "                for(i=0;PlayerPirates()>i;i=i+1) {",
                        "                    if(Dist(PlayerPirates(i),PlacePLS)<350) {",
                        "                        ShipMoney(Player(),ShipMoney(Player())+vMoney);",
                        "                        Sound('Sound.Buy');",
                        "                    }",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "}",
                        "//Для отладки",
                        "//Ether(0,'027B1887-D0DC-4A76-8141-F0B0F2109CC4','vRunScrElection <vRunScrElection> vTalkAgit <vTalkAgit> vState <vState> vSearchD <vSearchD> vTerm <vTerm> vPassP <vPassP> vMoney <vMoney> vPeleng <vPeleng> vDron <vDron> vBegin <vBegin> vGaal <vGaal> vFeiV <vFeiV> vFei <vFei> vPeople <vPeople>  vMaloc <vMaloc> vShips <vShips> vWar <vWar> vSerachStr <vSerachStr>',Player());",
                        "vSearchD=vSearchD-1;",
