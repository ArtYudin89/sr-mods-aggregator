                        "}",
                        "if(vPass==6) {",
                        "    vName=CT(\"Script.Mod_RevElection.466\");",
                        "    vName1=CT(\"Script.Mod_RevElection.465\");",
                        "    vName2=CT(\"Script.Mod_RevElection.464\");",
                        "    vName3=CT(\"Script.Mod_RevElection.463\");",
                        "    vName4=CT(\"Script.Mod_RevElection.462\");",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 1325,
                    "Parent": -1,
                    "#": 67,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(vState==5) {",
                        "  ShipOut(GroupToShip(GroupWar));",
                        "  AllShipOut();",
                        "}",
                        "if(vState>0) {",
                        "  if(!CountIn(GroupToShip(Agit))) {",
                        "    if(vTalkAgit<4) {",
                        "      Ether(3,'D0AD413D-F7EB-4A95-B7BE-AC13208343F1',Format(CT(\"Script.Mod_RevElection.450\"),\"<0>\",vName,\"<1>\",Name(PlanetS),\"<2>\",GameDateTxtByTurn(vBegin+vSerachStr)));",
                        "    }",
                        "  }",
                        "}",
                        "if(ItemIn(iCapsule,Player())) {",
                        "  if(CurTurn() % 7 == 1) {",
                        "    Ether(10,'',CT(\"Script.Mod_RevElection.470\")+' '+vName+' '+CT(\"Script.Mod_RevElection.469\")+' '+(GalaxyMoney(3)*20)+' cr. '+CT(\"Script.Mod_RevElection.468\"));",
                        "    Sound('Sound.NewMsg');",
                        "  }",
                        "}",
                        "if(vState==4) {",
                        "  AddPlanetNews(Format(CT(\"Script.Mod_RevElection.457\"),\"<0>\",Name(PlanetS),\"<1>\",vName));",
                        "  ShipOut(GroupToShip(GrPlayer));",
                        "  vRunScrElection=1;",
                        "  AllShipOut();",
                        "  if(CountIn(People)) {",
                        "    ShipOut(GroupToShip(People));",
                        "  }",
                        "  if(CountIn(Gaal)) {",
                        "    ShipOut(GroupToShip(Gaal));",
                        "  }",
                        "  if(CountIn(Fei)) {",
                        "    ShipOut(GroupToShip(Fei));",
                        "  }",
                        "  if(CountIn(Maloc)) {",
                        "    ShipOut(GroupToShip(Maloc));",
                        "  }",
                        "  if(CountIn(Peleng)) {",
                        "    ShipOut(GroupToShip(Peleng));",
                        "  }",
                        "}",
                        "if(vBegin+vSerachStr==CurTurn()) {",
                        "  ShipOut(GroupToShip(GrPlayer));",
                        "  vRunScrElection=1;",
                        "  AllShipOut();",
                        "  if(!ItemIn(iCapsule,Player()) && !vCapsule) {",
                        "      AddPlanetNews(Format(CT(\"Script.Mod_RevElection.456\"),\"<0>\",Name(PlanetS),\"<1>\",vName));",
                        "      PlanetGov(PlanetS,1);",
                        "      PlanetEco(PlanetS,max(PlanetEco(PlanetS)-1,0));",
                        "  }",
                        "  else {",
                        "      AddPlanetNews(Format(CT(\"Script.Mod_RevElection.467\"),\"<0>\",Name(PlanetS),\"<1>\",vName));",
                        "  }",
                        "  if(CountIn(People)) {",
                        "    ShipOut(GroupToShip(People));",
                        "  }",
                        "  if(vState==1) {",
                        "    vTalkAgit=6;",
                        "    Ether(5,'D0AD413D-F7EB-4A95-B7BE-AC13208343F1',Format(CT(\"Script.Mod_RevElection.450\"),\"<0>\",vName,\"<1>\",Name(PlanetS),\"<2>\",GameDateTxtByTurn(vBegin+vSerachStr)));",
                        "  }",
                        "  if(vState==3) {",
                        "    vTalkAgit=6;",
                        "    Ether(5,'0EE37BC2-C139-4294-94A0-0069854A3C66',Format(CT(\"Script.Mod_RevElection.354\"),\"<0>\",vName,\"<1>\",GameDateTxtByTurn(vBegin+vSerachStr)));",
                        "  }",
                        "  if(CountIn(Gaal)) {",
                        "    ShipOut(GroupToShip(Gaal));",
                        "  }",
                        "  if(CountIn(Fei)) {",
                        "    ShipOut(GroupToShip(Fei));",
                        "  }",
                        "  if(CountIn(Maloc)) {",
                        "    ShipOut(GroupToShip(Maloc));",
                        "  }",
                        "  if(CountIn(Peleng)) {",
                        "    ShipOut(GroupToShip(Peleng));",
                        "  }",
                        "}",
                        "//Если неправильно прошли каждого из участников - обижаем их на игрока",
                        "if(vMaloc==2) {",
                        "    ShipSetBad(GroupToShip(Maloc),Player());",
                        "}",
                        "if(vGaal==3) {",
                        "    ShipSetBad(GroupToShip(Gaal),Player());",
                        "}",
                        "if(vPeleng==2) {",
                        "    ShipSetBad(GroupToShip(Peleng),Player());",
                        "}",
                        "//Счётчик доступа к транку гаальца",
                        "if(vPassP>0) {",
                        "    vPassP=vPassP-1;",
