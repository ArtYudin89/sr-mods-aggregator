            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 645,
                    "Parent": -1,
                    "#": 8,
                    "Code.Type": "Global",
                    "Code": [
                        "if(GRunFrom==3) {",
                        "  if(RedSkull_Star==Id(GRunStar)) {",
                        "    if(RedSkull_PlayerIs==1) {",
                        "      if(!GCntRun(GScriptName)) {",
                        "        GRun();",
                        "      }",
                        "    }",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 645,
                    "Parent": -1,
                    "#": 9,
                    "Code.Type": "Init",
                    "Code": [
                        "SetName(GroupToShip(MadJack),CT(\"Script.Mod_SR1RedSkullPart2.0\"));"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 645,
                    "Parent": -1,
                    "#": 10,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!CountIn(MadJack)) {",
                        "  ShipOut(Player());",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 250,
                    "Parent": -1,
                    "#": 38,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(HullDamage(CurShip)>50) {",
                        "  UseTranclucator(GroupToShip(MadJack));",
                        "}",
                        "if(vJackAttacking==1) {",
                        "  ChangeGlobalRelationsShips(Player(),CurShip,0,0,ffffh,ffffh);",
                        "  ChangeState(1);",
                        "  exit;",
                        "}",
                        "if(ShipInNormalSpace(CurShip)) {",
                        "  if(ShipInNormalSpace(Player())) {",
                        "    if(ShipInStar(Player(),Star1)) {",
                        "      if(Dist(CurShip,Player())<300) {",
                        "        Dialog(dAgressorTalk,CurShip);",
                        "        vJackAttacking=1;",
                        "      }",
                        "    }",
                        "  }",
                        "}",
                        "if(!(ShipInStar(Player(),Star1))) {",
                        "  ShipOut();",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 310,
                    "Parent": -1,
                    "#": 39,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(HullDamage(CurShip)>50) {",
                        "  UseTranclucator(GroupToShip(MadJack));",
                        "}",
                        "if(!(ShipInStar(Player(),Star1))) {",
                        "  ShipOut();",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 410,
                    "Parent": -1,
                    "#": 40,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(vTalkNum==1) {",
                        "  DChange(0);",
                        "  exit;",
                        "}",
                        "if(vTalkNum==2) {",
                        "  DChange(5);",
                        "  exit;",
                        "}",
