                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 310,
                    "Parent": -1,
                    "#": 16,
                    "Code.Type": "Init",
                    "Code": [
                        "function g_SpawnSmuggler(dword spawnPlanet) {",
                        "        //Создаем транспорт",
                        "        dword tmp = BuyTransport(spawnPlanet, 0, RndObject(125, 200, PlanetPirateClan()));",
                        "",
                        "        //Прокачиваем торговлю и обаяние",
                        "        ShipSkill(tmp, 3, RndObject(3, 6, tmp));",
                        "        ShipSkill(tmp, 4, RndObject(3, 6, tmp));",
                        "",
                        "        //Слегка обновляем оборудование на корабле",
                        "        ShipRefit(tmp);",
                        "        ShipRefit(tmp);",
                        "        ShipRefit(tmp);",
                        "",
                        "        //Применяем к корпусу особый акрин и выставляем соответствующий внешний вид",
                        "        dword cur_item = ShipEqInSlot(tmp, t_Hull);",
                        "        if(PlanetRace(spawnPlanet) == Maloc) dword tmp2 = FindBonusByNameInCfg('ShuSmugglers_SmugglerMaloc');",
                        "        else if(PlanetRace(spawnPlanet) == Peleng) tmp2 = FindBonusByNameInCfg('ShuSmugglers_SmugglerPeleng');",
                        "        else if(PlanetRace(spawnPlanet) == People) tmp2 = FindBonusByNameInCfg('ShuSmugglers_SmugglerPeople');",
                        "        else if(PlanetRace(spawnPlanet) == Fei) tmp2 = FindBonusByNameInCfg('ShuSmugglers_SmugglerFei');",
                        "        else /*if(PlanetRace(spawnPlanet) == Gaal)*/ tmp2 = FindBonusByNameInCfg('ShuSmugglers_SmugglerGaal');",
                        "        SpecialToEquipment(tmp2, cur_item);",
                        "        if(~FindBonusByNameInCfg('ExpArts_SmugglersCompartment')) ItemExtraSpecialsAddByType(cur_item, FindBonusByNameInCfg('ExpArts_SmugglersCompartment'), 1);",
                        "        HullHP(tmp, 'To100');",
                        "        Chameleon(tmp);",
                        "",
                        "        //Если в корпусе открыт слот дроида, но самого дроида нет - выдаём",
                        "        if(GetEquipmentStats(cur_item, 5))",
                        "        {",
                        "            if(!ShipEqInSlot(tmp, t_RepairRobot))",
                        "            {",
                        "                cur_item = CreateEquipment(t_RepairRobot, RndObject(30, 60, tmp), GalaxyTechLevel(), PirateClan);",
                        "                AddItemToShip(tmp, cur_item);",
                        "                ItemIsInUse(cur_item, tmp, 1);",
                        "            }",
                        "        }",
                        "        //Аналогично для ГЗП",
                        "        if(GetEquipmentStats(ShipEqInSlot(tmp, t_Hull), 7))",
                        "        {",
                        "            if(!ShipEqInSlot(tmp, t_DefGenerator))",
                        "            {",
                        "                cur_item = CreateEquipment(t_DefGenerator, RndObject(30, 60, tmp), GalaxyTechLevel(), PirateClan);",
                        "                AddItemToShip(tmp, cur_item);",
                        "                ItemIsInUse(cur_item, tmp, 1);",
                        "            }",
                        "        }",
                        "",
                        "        //Рандомно улучшаем оборудование",
                        "        ShipImproveItems(tmp, RndObject(3, 6, tmp));",
                        "",
                        "        //Прописываем уникальный тип",
                        "        ShipType(tmp, 'Smuggler');",
                        "        //Выдаем маску анонимуса, если подключен мод на ЧР",
                        "        if(IsScriptActive('Mod_ExpBlackMarket_2')) GiveRewardByNom(tmp, 48);",
                        "        //Присоединяем корабль к клану",
                        "        ShipJoinsClan(tmp);",
                        "        RaisePirateRank(tmp, 4); //Звание повыше, чтобы имел больше авторитета среди пиратов",
                        "        NoTargetToShip(tmp, 5); //Запрещаем пиратам нападать на контрабандиста с целью ограбления",
                        "        //Выставляем начальное отношение к игроку, равное общему отношению клана к игроку",
                        "        RelationToRanger(tmp, Player(), RelationToRanger(PlanetPirateClan(), Player()));",
                        "",
                        "        //Набиваем груз хламом",
                        "        if(ShipFreeSpace(tmp) > 1) {",
                        "            if(CurrentMods('Expansion\\\\ExpCaravan')) {",
                        "                if(ShipFreeSpace(tmp) > 25) {",
                        "                    cur_item = CreateQuestItem('ExpCaravan_CargoBox',None);",
                        "                    ItemCost(cur_item,GalaxyMoney(4,4));",
                        "                    ItemSize(cur_item,25);",
                        "                    AddItemToShip(tmp,cur_item);",
                        "                    ShipCalcParam(tmp);",
                        "                }",
                        "                if(ShipFreeSpace(tmp) > 25) {",
                        "                    cur_item = CreateQuestItem('ExpCaravan_CargoBox',None);",
                        "                    ItemCost(cur_item,GalaxyMoney(4,4));",
                        "                    ItemSize(cur_item,25);",
                        "                    AddItemToShip(tmp,cur_item);",
                        "                    ShipCalcParam(tmp);",
                        "                }",
                        "                if(ShipFreeSpace(tmp) > 25) {",
                        "                    cur_item = CreateQuestItem('ExpCaravan_CargoBox',None);",
                        "                    ItemCost(cur_item,GalaxyMoney(4,4));",
                        "                    ItemSize(cur_item,25);",
                        "                    AddItemToShip(tmp,cur_item);",
                        "                    ShipCalcParam(tmp);",
                        "                }",
                        "            }",
                        "",
                        "            if(ShipFreeSpace(tmp) > 1) {",
                        "                if(!Rnd(0,4)) {",
                        "                    cur_item = CreateQuestItem('OperatedProbe',Peleng);",
                        "                    AddItemToShip(tmp,cur_item);",
                        "                    ShipCalcParam(tmp);",
                        "                }",
                        "            }",
                        "",
                        "            if(ShipFreeSpace(tmp) > 15) {",
                        "                if(!Rnd(0,2)) {",
                        "                    int rem_series = Rnd(0,2);",
                        "                    //Remains_0-8 общие для всех серий, 9-13 блазерские, 14-18 келлерские, 19-23 терронские",
                        "                    int rem_num = Rnd(0,13);",
                        "                    if(rem_num > 8 && rem_series == 1) rem_num = rem_num + 5;",
                        "                    else if(rem_num > 8 && rem_series == 2) rem_num = rem_num + 10;",
                        "                    cur_item = CreateQuestItem('Remains_' + rem_num, Kling);",
                        "                    ItemSubrace(cur_item, rem_series);",
                        "                    if(ItemSize(cur_item) > 15) ItemSize(cur_item,15);",
                        "                    AddItemToShip(tmp,cur_item);",
                        "                    ShipCalcParam(tmp);",
                        "                }",
                        "            }",
                        "",
                        "            if(ShipFreeSpace(tmp) > 1) {",
                        "                if(!Rnd(0,1)) {",
                        "                    cur_item = CreateQuestItem('Usl_10');",
                        "                    AddItemToShip(tmp,cur_item);",
                        "                    ShipCalcParam(tmp);",
                        "                }",
                        "            }",
                        "",
                        "            if(ShipFreeSpace(tmp) > 5) {",
                        "                if(!Rnd(0,3)) {",
                        "                    cur_item = CreateQuestItem('Usl_11');",
                        "                    AddItemToShip(tmp,cur_item);",
                        "                    ShipCalcParam(tmp);",
                        "                }",
                        "            }",
                        "",
                        "            if(ShipFreeSpace(tmp) > 10) {",
                        "                if(!Rnd(0,3)) {",
                        "                    cur_item = CreateQuestItem('Usl_25');",
                        "                    AddItemToShip(tmp,cur_item);",
                        "                    ShipCalcParam(tmp);",
                        "                }",
                        "            }",
                        "",
                        "            if(ShipFreeSpace(tmp) > 6) {",
                        "                if(!Rnd(0,3)) {",
                        "                    cur_item = CreateQuestItem('Usl_35');",
                        "                    AddItemToShip(tmp,cur_item);",
                        "                    ShipCalcParam(tmp);",
                        "                }",
                        "            }",
                        "",
                        "            if(ShipFreeSpace(tmp) > 2) {",
                        "                if(!Rnd(0,2)) {",
                        "                    cur_item = CreateQuestItem('Usl_39');",
                        "                    AddItemToShip(tmp,cur_item);",
                        "                    ShipCalcParam(tmp);",
                        "                }",
                        "            }",
                        "",
                        "            if(ShipFreeSpace(tmp) > 6) {",
                        "                if(!Rnd(0,2)) {",
                        "                    cur_item = CreateQuestItem('Usl_47');",
                        "                    AddItemToShip(tmp,cur_item);",
                        "                    ShipCalcParam(tmp);",
                        "                }",
                        "            }",
                        "",
                        "            if(ShipFreeSpace(tmp) > 10) {",
                        "                if(!Rnd(0,2)) {",
                        "                    cur_item = CreateQuestItem('Usl_49');",
                        "                    AddItemToShip(tmp,cur_item);",
                        "                    ShipCalcParam(tmp);",
                        "                }",
                        "            }",
                        "        }",
                        "",
                        "        ShipCalcParam(tmp);",
                        "        if(ShipFreeSpace(tmp) < 0) ShipImproveItems(tmp, 0); //Устраняем перевес (расширяет корпус)",
                        "",
                        "        ShipJoin(Smugglers, tmp);",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 310,
                    "Parent": -1,
                    "#": 17,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(timer <= CurTurn())",
                        "{",
                        "    //Определяем максимальное число контрабандистов",
                        "    maxSmugglers = 3 + ControlledSystems(2) * 1.2;",
                        "    if(ControlledSystems(2) <= 3) maxSmugglers = 3;",
                        "    else if(ControlledSystems(2) <= 4) maxSmugglers = 5;",
                        "",
                        "    if(PirateWin() == 1) maxSmugglers = maxSmugglers * 1.25;",
                        "    else if(PirateWin() == 5) maxSmugglers = maxSmugglers * 1.5;",
                        "    else if(PirateWin() == 3) maxSmugglers = maxSmugglers * 0.7;",
                        "",
                        "    if(GroupCount(Smugglers) < maxSmugglers)",
                        "    {",
                        "        ArrayClear(piratePlanets);",
                        "",
                        "        //Перебираем системы в галактике",
                        "        tmp = GalaxyStars();",
                        "        for(i = 0; i < tmp; i = i + 1)",
                        "        {",
                        "            tmp2 = GalaxyStar(i);",
                        "            //Пропускаем пиратский сектор",
                        "            if(StarToCon(tmp2) == StarToCon(PlanetToStar(PlanetPirateClan()))) continue;",
                        "            //Ищем пиратские планеты и заносим в массив",
                        "            if(StarOwner(tmp2) == 2)",
                        "            {",
                        "                //Пропускаем оспариваемые системы",
                        "                if(!StarBattle(tmp2))",
                        "                {",
                        "                    tmp3 = StarPlanets(tmp2);",
                        "                    for(j = 0; j < tmp3; j = j + 1)",
                        "                    {",
                        "                        spawnPlanet = StarPlanets(tmp2, j);",
                        "                        if(PlanetOwner(spawnPlanet) == PirateClan) ArrayAdd(piratePlanets, spawnPlanet);",
                        "                    }",
                        "                }",
                        "            }",
                        "        }",
                        "",
                        "        //Если подходящих планет слишком мало, то никого не спавним",
                        "        if(ArrayDim(piratePlanets) <= 1) exit;",
                        "",
                        "        spawnPlanet = piratePlanets[RndObject(1, ArrayDim(piratePlanets) - 1, PlanetPirateClan())];",
                        "",
                        "        g_SpawnSmuggler(spawnPlanet);",
                        "    }",
                        "",
                        "    //Обновляем таймер появления",
                        "    timer = CurTurn() + round(1.0 * GroupCount(Smugglers) / maxSmugglers * RndObject(30, 90, PlanetPirateClan()));",
                        "}",
                        "",
                        "//Если контрабандисты существуют, перебираем все галактические события",
                        "if(GroupCount(Smugglers))",
                        "{",
                        "    for(i = GalaxyEvents() - 1; i >= 0; i = i - 1)",
                        "    {",
                        "        //Перебираем все сегодняшние ивенты, в которых игрок или его напарник уничтожает или помогает в уничтожении корабля",
                        "        if(GalaxyEventDate(i) < CurTurn()) break;",
                        "",
                        "        tstr1 = GalaxyEventType(i);",
                        "        if(tstr1 == 'PlayerKillsShip' || tstr1 == 'PlayerAssistKillsShip' || tstr1 == 'PlayerCompanionKillsShip' || tstr1 == 'PlayerCompanionAssistKillsShip')",
                        "        {",
                        "            //Пропускаем все, что не относится к контрабандистам",
                        "            if(GalaxyEventsTextData(i, 2) != 'Smuggler') continue;",
                        "            //Если игрок уничтожал контрабандистов, ухудшаем отношения с кланом",
                        "            tmp = RelationToRanger(PlanetPirateClan(), Player());",
                        "            //Если игрок сам состоит в клане - штраф к отношениям будет гораздо меньше",
                        "            if(ShipOnSidePirateClan(Player())) RelationToRanger(PlanetPirateClan(), Player(), tmp - 3);",
                        "            else RelationToRanger(PlanetPirateClan(), Player(), tmp - 10);",
                        "            break;",
                        "        }",
                        "        //Аналогично для транклюкаторов игрока, отличается только номер параметра",
                        "        else if(tstr1 == 'PlayerTranclucatorKillsShip' || tstr1 == 'PlayerTranclucatorAssistKillsShip')",
                        "        {",
                        "            if(GalaxyEventsTextData(i, 3) != 'Smuggler') continue;",
                        "            tmp = RelationToRanger(PlanetPirateClan(), Player());",
                        "            if(ShipOnSidePirateClan(Player())) RelationToRanger(PlanetPirateClan(), Player(), tmp - 3);",
                        "            else RelationToRanger(PlanetPirateClan(), Player(), tmp - 10);",
                        "            break;",
                        "        }",
                        "        //Если игрок выбил из контрабандиста деньги или груз, отношения также ухудшатся",
                        "        else if(tstr1 == 'PlayerExtortsMoney' || tstr1 == 'PlayerExtortsGoods')",
                        "        {",
                        "            //Тип корабля текстом в это событие не завезли, поэтому выясняем его отдельно",
                        "            tmp2 = IdToShip(GalaxyEventData(i, 3));",
                        "            //Обязательная проверка на существование корабля, без нее может возникнуть краш",
                        "            if(tmp2)",
                        "            {",
                        "                if(ShipType(tmp2) != 'Smuggler') continue;",
                        "                //Если игрок грабил контрабандистов, незначительно ухудшаем отношения с кланом",
                        "                tmp = RelationToRanger(PlanetPirateClan(), Player());",
                        "                //Если игрок сам состоит в клане - ухудшение отношений будет минимальным",
                        "                if(ShipOnSidePirateClan(Player())) RelationToRanger(PlanetPirateClan(), Player(), tmp - 1);",
                        "                else RelationToRanger(PlanetPirateClan(), Player(), tmp - 3);",
                        "                break;",
                        "            }",
                        "        }",
                        "    }",
                        "}"
                    ]
                },
                {
