                        "//Универсальный PC_destroyer (UtilityFunctionsPack). Ветки для модов, которым он нужен:",
                        "//  Tweaks\\\\BlockSOTE - скрипт отключается (AllShipOut), Тень империи недоступна",
                        "//  Reflection\\\\RefBlackSalamander - кристалл можно отдать на пиратскую базу (корпус Черная Саламандра),",
                        "//    управление Саламандрой с мостика ExpPilotBridge; тексты - Lang мода, ключи Script.PC_destroyer.Sal*",
                        "//Без этих модов логика ванильная.",
                        "if(CurrentMods('Tweaks\\\\BlockSOTE')) AllShipOut();",
                        "list_visited=newarray(1);",
                        "list_visited[0]=0;",
                        "hull_variants=newarray(4);",
                        "hull_variants[1]=1;",
                        "hull_variants[2]=2;",
                        "hull_variants[3]=3;",
                        "hull_sizes=newarray(4);",
                        "hull_costs=newarray(4);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 770,
                    "Parent": -1,
                    "#": 34,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(GetShipPlanet(Player())) {",
                        "  if(!crystal_created) {",
                        "    if(PlanetOwner(GetShipPlanet(Player()))==6) {",
                        "      if(ArrayFind(list_visited,Id(GetShipPlanet(Player())))<0) {",
                        "        ArrayAdd(list_visited,Id(GetShipPlanet(Player())));",
                        "        if(ArrayDim(list_visited)>num_planets_needed) {",
                        "          if((Rnd(1,1000)+(1000/num_planets_needed)*ArrayDim(list_visited))>2000) {",
                        "            quest_item=CreateQuestItem('Usl_AncientCrystal');",
                        "            AddItemToPlanet(GetShipPlanet(Player()),quest_item);",
                        "            LinkItemToScript(quest_item,AncientCrystal);",
                        "            crystal_created=1;",
                        "          }",
                        "        }",
                        "      }",
                        "    }",
                        "  }",
                        "}",
                        "if(research_start_date) {",
                        "  if(CurTurn()>(research_start_date+20)) {",
                        "    if(!message_research_complete) {",
                        "      message_research_complete=1;",
                        "      if(salamander) Ether(0,'',Format(CT('Script.PC_destroyer.SalEtherDone'),'<0'+'>',ShipName(Player()),'<1'+'>',base_name));",
                        "      else Ether(0,'FBB50D18-D027-42BB-985B-8D7F1B97E294',Format(CT('Script.PC_destroyer.23'),'<0'+'>',base_name,'<1'+'>',base_name));",
                        "    }",
                        "  }",
                        "  if(IdToShip(base_id)==0) {",
                        "    research_start_date=0;",
                        "    if(salamander) Ether(0,'',Format(CT('Script.PC_destroyer.SalEtherLost'),'<0'+'>',ShipName(Player()),'<1'+'>',base_name));",
                        "    else if(!(CurrentMods('Reflection\\\\RefBlackSalamander') && CoalitionDefeated())) {",
                        "      RangerBaseNodes(Player(),RangerBaseNodes(Player())+nodes_needed/2);",
                        "      Ether(0,'31A425D1-C896-441E-943E-FE0228799D17',Format(CT('Script.PC_destroyer.24'),'<0'+'>',base_name,'<1'+'>',nodes_needed/2));",
                        "    }",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 770,
                    "Parent": -1,
                    "#": 35,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "if(GetShipRuins(Player())>0) {",
                        "  if(ShipType(GetShipRuins(Player()))=='SB') {",
                        "    if(ItemIn(AncientCrystal,Player())) {",
                        "      AddDialogInject('DialogSB1','',CT('Script.PC_destroyer.20'),1);",
                        "    }",
                        "    if(message_research_complete && (Id(GetShipRuins(Player()))==base_id)) {",
                        "      AddDialogInject('DialogSB2','',CT('Script.PC_destroyer.19'),1);",
                        "    }",
                        "    if(hull_available) {",
                        "      AddDialogInject('DialogSB2','',CT('Script.PC_destroyer.18'),1);",
                        "    }",
                        "  }",
                        "}",
                        "if(CurrentMods('Reflection\\\\RefBlackSalamander')) {",
                        "  if(~HullSpecial(Player())) {",
                        "    if(HullSpecial(Player())==FindBonusByNameInCfg('RefBlackSalamander')) {",
                        "      if(PlayerBridge()==3) AddDialogInject('Salamander','',CT('Script.PC_destroyer.SalBridge'),20);",
                        "    }",
                        "  }",
                        "  if(GetShipRuins(Player())>0) {",
                        "    if(ShipType(GetShipRuins(Player()))=='CB') {",
                        "      if(ItemIn(AncientCrystal,Player())) AddDialogInject('DialogCB1','',CT('Script.PC_destroyer.20'),10);",
                        "      else if(message_research_complete && (Id(GetShipRuins(Player()))==base_id) && salamander==1) AddDialogInject('DialogCB2','',CT('Script.PC_destroyer.19'),10);",
                        "    }",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 460,
                    "Parent": -1,
                    "#": 99,
                    "Code.Type": "Turn",
                    "Code": [
                        "//Тексты сообщения и ответов (ванильные ключи Lang Script.PC_destroyer.N)",
                        "tstr1 = '</color>' + CT('Script.PC_destroyer.0');",
                        "tstr2 = '</color>' + CT('Script.PC_destroyer.8');",
                        "DChange(0);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 130,
                    "Pos.y": 460,
                    "Parent": -1,
                    "#": 100,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(Id(GetShipRuins(Player()))!=base_id) {",
                        "  if(!IdToShip(base_id)) {",
                        "    hull_available=0;",
                        "    //Тексты сообщения и ответов (ванильные ключи Lang Script.PC_destroyer.N)",
                        "    tstr1 = '</color>' + Format(CT('Script.PC_destroyer.47'),'<0'+'>',ShipName(Player()),'<1'+'>',base_name);",
                        "    tstr2 = '</color>' + CT('Script.PC_destroyer.49');",
                        "    DChange(12);",
                        "    exit;",
                        "  }",
                        "  if(IdToShip(base_id)) {",
                        "    //Тексты сообщения и ответов (ванильные ключи Lang Script.PC_destroyer.N)",
                        "    tstr1 = '</color>' + Format(CT('Script.PC_destroyer.46'),'<0'+'>',ShipName(Player()),'<1'+'>',base_name,'<2'+'>',Name(ShipStar(IdToShip(base_id))));",
                        "    tstr2 = '</color>' + CT('Script.PC_destroyer.48');",
                        "    DChange(11);",
                        "    exit;",
                        "  }",
                        "}",
                        "if(Id(GetShipRuins(Player()))==base_id) {",
                        "  hull_sizes[1]=700;",
                        "  hull_sizes[2]=1100;",
                        "  hull_sizes[3]=1500;",
                        "  hull_costs[1]=150;",
                        "  hull_costs[2]=200;",
                        "  hull_costs[3]=250;",
                        "  base_cost=(1000000/8)*GalaxyTechLevel()/100;",
                        "  if(hull_available==3) {",
                        "    //Тексты сообщения и ответов (ванильные ключи Lang Script.PC_destroyer.N)",
                        "    tstr1 = '</color>' + Format(CT('Script.PC_destroyer.53'),'<0'+'>',hull_sizes[hull_variants[1]],'<1'+'>',base_cost*hull_costs[hull_variants[1]],'<2'+'>',hull_sizes[hull_variants[2]],'<3'+'>',base_cost*hull_costs[hull_variants[2]],'<4'+'>',hull_sizes[hull_variants[3]],'<5'+'>',base_cost*hull_costs[hull_variants[3]]);",
                        "    tstr2 = '</color>' + Format(CT('Script.PC_destroyer.27'),'<0'+'>',hull_sizes[hull_variants[1]],'<1'+'>',base_cost*hull_costs[hull_variants[1]]);",
                        "    tstr3 = '</color>' + Format(CT('Script.PC_destroyer.27'),'<0'+'>',hull_sizes[hull_variants[2]],'<1'+'>',base_cost*hull_costs[hull_variants[2]]);",
                        "    tstr4 = '</color>' + Format(CT('Script.PC_destroyer.27'),'<0'+'>',hull_sizes[hull_variants[3]],'<1'+'>',base_cost*hull_costs[hull_variants[3]]);",
                        "    tstr5 = '</color>' + CT('Script.PC_destroyer.16');",
                        "    DChange(7);",
                        "    exit;",
                        "  }",
                        "  if(hull_available==2) {",
                        "    //Тексты сообщения и ответов (ванильные ключи Lang Script.PC_destroyer.N)",
                        "    tstr1 = '</color>' + Format(CT('Script.PC_destroyer.54'),'<0'+'>',hull_sizes[hull_variants[1]],'<1'+'>',base_cost*hull_costs[hull_variants[1]],'<2'+'>',hull_sizes[hull_variants[2]],'<3'+'>',base_cost*hull_costs[hull_variants[2]]);",
                        "    tstr2 = '</color>' + Format(CT('Script.PC_destroyer.27'),'<0'+'>',hull_sizes[hull_variants[1]],'<1'+'>',base_cost*hull_costs[hull_variants[1]]);",
                        "    tstr3 = '</color>' + Format(CT('Script.PC_destroyer.27'),'<0'+'>',hull_sizes[hull_variants[2]],'<1'+'>',base_cost*hull_costs[hull_variants[2]]);",
                        "    tstr4 = '</color>' + Format(CT('Script.PC_destroyer.27'),'<0'+'>',hull_sizes[hull_variants[3]],'<1'+'>',base_cost*hull_costs[hull_variants[3]]);",
                        "    tstr5 = '</color>' + CT('Script.PC_destroyer.16');",
                        "    DChange(8);",
                        "    exit;",
                        "  }",
                        "  if(hull_available==1) {",
                        "    //Тексты сообщения и ответов (ванильные ключи Lang Script.PC_destroyer.N)",
                        "    tstr1 = '</color>' + Format(CT('Script.PC_destroyer.55'),'<0'+'>',hull_sizes[hull_variants[1]],'<1'+'>',base_cost*hull_costs[hull_variants[1]]);",
                        "    tstr2 = '</color>' + Format(CT('Script.PC_destroyer.27'),'<0'+'>',hull_sizes[hull_variants[1]],'<1'+'>',base_cost*hull_costs[hull_variants[1]]);",
                        "    tstr3 = '</color>' + Format(CT('Script.PC_destroyer.27'),'<0'+'>',hull_sizes[hull_variants[2]],'<1'+'>',base_cost*hull_costs[hull_variants[2]]);",
                        "    tstr4 = '</color>' + Format(CT('Script.PC_destroyer.27'),'<0'+'>',hull_sizes[hull_variants[3]],'<1'+'>',base_cost*hull_costs[hull_variants[3]]);",
                        "    tstr5 = '</color>' + CT('Script.PC_destroyer.16');",
                        "    DChange(9);",
                        "    exit;",
                        "  }",
                        "  if(message_research_complete) {",
                        "    //Тексты сообщения и ответов (ванильные ключи Lang Script.PC_destroyer.N)",
                        "    tstr1 = '</color>' + Format(CT('Script.PC_destroyer.5'),'<0'+'>',ShipName(Player()));",
                        "    tstr2 = '</color>' + CT('Script.PC_destroyer.13');",
                        "    tstr3 = '</color>' + CT('Script.PC_destroyer.14');",
                        "    DChange(4);",
                        "    exit;",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 280,
                    "Pos.y": 460,
                    "Parent": -1,
                    "#": 101,
                    "Code.Type": "Turn",
                    "Code": [
                        "//RefBlackSalamander: тексты из Lang мода",
                        "tstr1 = '</color>' + CT('Script.PC_destroyer.SalCB1Msg1');",
                        "tstr2 = '</color>' + CT('Script.PC_destroyer.SalCB1Ans1');",
                        "DChange(14);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 430,
                    "Pos.y": 460,
                    "Parent": -1,
