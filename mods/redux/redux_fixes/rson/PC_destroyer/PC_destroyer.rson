                    "Code": [
                        "if(Id(GetShipRuins(Player()))!=base_id) {",
                        "  if(IdToShip(base_id)) {",
                        "    tstr1 = '</color>' + Format(CT('Script.PC_destroyer.SalCB2Elsewhere'),'<0'+'>',base_name,'<1'+'>',Name(ShipStar(IdToShip(base_id))));",
                        "    tstr2 = '</color>' + CT('Script.PC_destroyer.SalCB2Thanks');",
                        "    DChange(18);",
                        "    exit;",
                        "  }",
                        "  if(!IdToShip(base_id)) {",
                        "    tstr1 = '</color>' + CT('Script.PC_destroyer.SalCB2BaseLost');",
                        "    tstr2 = '</color>' + CT('Script.PC_destroyer.49');",
                        "    DChange(19);",
                        "    exit;",
                        "  }",
                        "}",
                        "if(Id(GetShipRuins(Player()))==base_id) {",
                        "  if(message_research_complete) {",
                        "    tstr1 = '</color>' + CT('Script.PC_destroyer.SalCB2Msg1');",
                        "    tstr2 = '</color>' + CT('Script.PC_destroyer.SalCB2Ans1');",
                        "    DChange(20);",
                        "    exit;",
                        "  }",
                        "}"
                    ]
