                        "InterfacePos('Info', 'M05Peleng', 4, 0, 1);",
                        "InterfacePos('Info', 'M05People', 8, 0, 1);",
                        "InterfacePos('Info', 'M05Fei', 14, 0, 1);",
                        "InterfacePos('Info', 'M05Gaal', 20, 0, 1);",
