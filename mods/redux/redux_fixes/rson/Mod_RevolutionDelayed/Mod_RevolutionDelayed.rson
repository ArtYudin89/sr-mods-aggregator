                        "InterfacePos('Info', 'M06Peleng', 4, 0, 1);",
                        "InterfacePos('Info', 'M06People', 8, 0, 1);",
                        "InterfacePos('Info', 'M06Fei', 14, 0, 1);",
                        "InterfacePos('Info', 'M06Gaal', 20, 0, 1);",
                        "InterfaceState('Info', 'M06Pirate', 0);",
                        "",
                        "InterfacePos('Info', 'M07Maloc', 0, 0, 1);",
                        "InterfacePos('Info', 'M07Peleng', 4, 0, 1);",
                        "InterfacePos('Info', 'M07People', 8, 0, 1);",
                        "InterfacePos('Info', 'M07Fei', 14, 0, 1);",
                        "InterfacePos('Info', 'M07Gaal', 20, 0, 1);",
                        "InterfaceState('Info', 'M07Pirate', 0);",
                        "",
                        "InterfacePos('Info', 'M09Maloc', 0, 0, 1);",
                        "InterfacePos('Info', 'M09Peleng', 4, 0, 1);",
                        "InterfacePos('Info', 'M09People', 8, 0, 1);",
                        "InterfacePos('Info', 'M09Fei', 14, 0, 1);",
                        "InterfacePos('Info', 'M09Gaal', 20, 0, 1);",
                        "InterfaceState('Info', 'M09Pirate', 0);",
                        "",
                        "InterfacePos('Info', 'M12Maloc', 0, 0, 1);",
                        "InterfacePos('Info', 'M12Peleng', 4, 0, 1);",
                        "InterfacePos('Info', 'M12People', 8, 0, 1);",
                        "InterfacePos('Info', 'M12Fei', 14, 0, 1);",
                        "InterfacePos('Info', 'M12Gaal', 20, 0, 1);",
                        "InterfaceState('Info', 'M12Pirate', 0);",
