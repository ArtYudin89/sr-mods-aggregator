                        "InterfacePos('Info', 'M04Peleng', 4, 0, 1);",
                        "InterfacePos('Info', 'M04People', 8, 0, 1);",
                        "InterfacePos('Info', 'M04Fei', 14, 0, 1);",
                        "InterfacePos('Info', 'M04Gaal', 20, 0, 1);",
                        "InterfaceState('Info', 'M04Pirate', 0);",
                        "",
