                        "InterfacePos('Info', 'M15Maloc', 0, 0, 1);",
                        "InterfacePos('Info', 'M15Peleng', 4, 0, 1);",
                        "InterfacePos('Info', 'M15People', 8, 0, 1);",
                        "InterfacePos('Info', 'M15Fei', 14, 0, 1);",
                        "InterfacePos('Info', 'M15Gaal', 20, 0, 1);",
                        "InterfaceState('Info', 'M15Pirate', 0);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 310,
                    "Parent": -1,
                    "#": 13,
                    "Code.Type": "Turn",
                    "Code": [
                        "//FIX: учёт станций и чистка их магазинов от пиратского оборудования теперь работают с начала игры до захвата",
                        "//пиратами первой системы (раньше - только после выступления пиратов); массив обходится с конца (ArrayDelete при",
                        "//обходе вперёд выводил индекс за границу - Error array), одна станция в списке больше не пропускается",
                        "if(!pirates_captured_first_star)",
                        "{",
                        "    for(i = GalaxyEvents() - 1; i >= 0; i = i - 1)",
                        "    {",
                        "        if(GalaxyEventDate(i) < CurTurn()) break;",
                        "        if(GalaxyEventType(i) != 'RuinsCreated') continue;",
                        "",
                        "        str_type = Format(GalaxyEventsTextData(i, 1), '_licensed', '', '');",
                        "        if(str_type == '')",
                        "        {",
                        "            if(GalaxyEventData(i, 0) == t_PB) ArrayAdd(control_ruins_arr, GalaxyEventData(i, 1));",
                        "        }",
                        "        else if(str_type == 'MB' || str_type == 'Manaan' || str_type == 'MercHQ' || str_type == 'PlayerMercHQ') ArrayAdd(control_ruins_arr, GalaxyEventData(i, 1));",
                        "    }",
                        "",
                        "    for(i = ArrayDim(control_ruins_arr) - 1; i >= 0; i = i - 1)",
                        "    {",
                        "        dword cur_ruin = IdToShip(control_ruins_arr[i]);",
                        "        if(!cur_ruin)",
                        "        {",
                        "            ArrayDelete(control_ruins_arr, i);",
                        "            continue;",
                        "        }",
                        "",
                        "        for(j = ShopItems(cur_ruin) - 1; j >= 0; j = j - 1)",
                        "        {",
                        "            dword cur_item = ShopItems(cur_ruin, j);",
                        "            if(!cur_item) continue;",
                        "            if(ItemOwner(cur_item) != PirateClan) continue;",
                        "",
                        "            if(ItemType(cur_item) == t_Hull)",
                        "            {",
                        "                FreeItem(GetItemFromShop(cur_ruin, cur_item)); //FIX: было GetItemFromShop(cur_ruin, i) - удалялся не тот предмет",
                        "                continue;",
                        "            }",
                        "",
                        "            //FIX: EqSpecial/EqModule у не-оборудования (квестовый предмет, ноды) = 0, ~0 истинно -> SpecialToEquipment падал 'not eq'",
                        "            if((ItemType(cur_item) >= t_Artefact && ItemType(cur_item) <= t_CustomWeapon) || ItemType(cur_item) == t_MicroModule || ItemType(cur_item) == t_Cistern)",
                        "            {",
                        "                if(~EqSpecial(cur_item)) SpecialToEquipment(-1, cur_item);",
                        "                if(~EqModule(cur_item)) ModuleToEquipment(-1, cur_item);",
                        "            }",
                        "",
                        "            //Цена малокской оборудки ближе всего к пиратской",
                        "            if(RndObject(0, 2, cur_ruin)) ItemOwner(cur_item, Maloc);",
                        "            else ItemOwner(cur_item, People);",
                        "        }",
                        "    }",
                        "}",
                        "",
                        "if(pirates_begin_turn > CurTurn())",
                        "{",
                        "    for(i = 0; i < GalaxyStars(); i = i + 1)",
                        "    {",
                        "        cur_star = GalaxyStar(i);",
                        "        if(StarOwner(cur_star) == 2) continue;",
                        "",
                        "        //Уничтожаем все вылетевшие за пределы скрытого сектора пиратские корабли в не пиратских системах",
                        "        for(j = StarShips(cur_star) - 1; j >= 0; j = j - 1) //FIX: обход с конца - TransferShip убирает корабль из системы",
                        "        {",
                        "            cur_ship = StarShips(cur_star, j);",
                        "            if(ShipOwner(cur_ship) != PirateClan) continue;",
                        "",
                        "            TransferShip(cur_ship, StarPlanets(GalaxyStar(People), 0)); //На Меркурий",
                        "            OrderNone(cur_ship);",
                        "            ShipDestroy(cur_ship, 1);",
                        "        }",
                        "    }",
                        "}",
                        "else",
                        "{",
                        "    if(!pirates_captured_first_star)",
                        "    {",
                        "        if(!pirates_advance_started)",
                        "        {",
                        "            //Капец ты умный, а что, если в галактике больше звёзд?",
                        "            //dword tortugatz = GalaxyStar(70);",
                        "            dword tortugatz = PlanetToStar(PlanetPirateClan());",
                        "            dword dicea = StarToCon(tortugatz);",
                        "            int stars_to_attack = PortionInDiapason(GalaxyDiffLevels(0), 50, 500, 4, 12) + Rnd(0, 2);",
                        "            unknown stars_to_attack_arr = newarray(1);",
                        "            ArrayDelete(stars_to_attack_arr, 0);",
                        "            j = 0; //FIX: счётчик целей не обнулялся (оставалось значение от прошлых циклов) - цели могли не ограничиваться",
                        "            for(i = 0; i < GalaxyStars(); i = i + 1)",
                        "            {",
                        "                cur_star = StarNearbyStars(tortugatz, i);",
                        "                if(dicea == StarToCon(cur_star)) continue; //FIX: пропускаем весь закрытый сектор (StarNearbyStars(tortugatz, 0) - сама Тортугац, она попадала в цели)",
                        "                ArrayAdd(stars_to_attack_arr, cur_star);",
                        "                j = j + 1;",
                        "                if(j == stars_to_attack) break;",
                        "            }",
                        "",
                        "            int dominions_limit = PortionInDiapason(GalaxyDiffLevels(0), 50, 500, 0, 5);",
                        "            for(i = 0; i < ArrayDim(stars_to_attack_arr); i = i + 1)",
                        "            {",
                        "                cur_star = stars_to_attack_arr[i];",
                        "",
                        "                int attackers = PortionInDiapason(GalaxyDiffLevels(0), 50, 500, 12, 45) + Rnd(0, 5);",
                        "                //Создаём нападающих пиратов",
                        "                for(j = 1; j <= attackers; j = j + 1)",
                        "                {",
                        "                    cur_ship = BuyWarrior(PlanetPirateClan(), 500);",
                        "                    ShipRefit(cur_ship);",
                        "                    ShipRefit(cur_ship);",
                        "                    ShipRefit(cur_ship);",
                        "                    ShipImproveItems(cur_ship, RndObject(5, 10, cur_ship));",
                        "                    RaisePirateRank(cur_ship, min(GetShipPirateRank(cur_ship), 3));",
                        "                    ShipJoin(AttackersGroup, cur_ship, '', Id(cur_star));",
                        "                }",
                        "",
                        "                if(dominions_limit)",
                        "                {",
                        "                    if(RndObject(1, 100, cur_star) <= 60)",
                        "                    {",
                        "                        cur_ruin = BuildRuins(cur_star, t_CB);",
                        "",
                        "                        //Создаём гарнизон доминиона",
                        "                        attackers = RndObject(3, 5, cur_ruin);",
                        "                        for(j = 1; j <= attackers; j = j + 1)",
                        "                        {",
                        "                            cur_ship = BuyWarrior(PlanetPirateClan(), 500);",
                        "                            ShipRefit(cur_ship);",
                        "                            ShipRefit(cur_ship);",
                        "                            ShipRefit(cur_ship);",
                        "                            ShipImproveItems(cur_ship, RndObject(5, 10, cur_ship));",
                        "                            RaisePirateRank(cur_ship, min(GetShipPirateRank(cur_ship), 3));",
                        "                            TransferShip(cur_ship, cur_ruin);",
                        "                        }",
                        "",
                        "                        MakeShipEnterStar(cur_ruin, cur_star, tortugatz, 7);",
                        "                        OrderTeleport(cur_ruin, cur_star, CoordX(cur_ruin), CoordY(cur_ruin), 1, 7);",
                        "                        dominions_limit = dominions_limit - 1;",
                        "                    }",
                        "                }",
                        "            }",
                        "",
                        "            //Разрешаем Роджерии спавнить пиратов на ПБ в Коалиционных системах",
                        "            if(!CurrentMods('ShusRangers\\\\ShuPirates')) PlanetExtraFlags(PlanetPirateClan(), PlanetExtraFlags(PlanetPirateClan()) & ~2); //FIX: снимаем только свой флаг 2, остальные не трогаем",
                        "",
                        "            pirates_advance_started = 1;",
                        "        }",
                        "",
                        "        for(i = 0; i < GalaxyStars(); i = i + 1)",
                        "        {",
                        "            cur_star = GalaxyStar(i);",
                        "            if(StarOwner(cur_star) != 2) continue;",
                        "            //Кроме скрытого сектора",
                        "            if(StarToCon(cur_star) == StarToCon(PlanetToStar(PlanetPirateClan()))) continue;",
                        "",
                        "            pirates_captured_first_star = CurTurn();",
                        "        }",
                        "    }",
                        "    //Возвращаем пиратские кнопки в инфоцентры",
                        "    else",
                        "    {",
                        "        InterfacePos('Info', 'M01Maloc', 0, 0, 1);",
                        "        InterfacePos('Info', 'M01Peleng', 0, 0, 1);",
                        "        InterfacePos('Info', 'M01People', 0, 0, 1);",
                        "        InterfacePos('Info', 'M01Fei', 0, 0, 1);",
                        "        InterfacePos('Info', 'M01Gaal', 0, 0, 1);",
                        "        InterfaceState('Info', 'M01Pirate', 1);",
                        "",
                        "        InterfacePos('Info', 'M02Maloc', 0, 0, 1);",
                        "        InterfacePos('Info', 'M02Peleng', 0, 0, 1);",
                        "        InterfacePos('Info', 'M02People', 0, 0, 1);",
                        "        InterfacePos('Info', 'M02Fei', 0, 0, 1);",
                        "        InterfacePos('Info', 'M02Gaal', 0, 0, 1);",
                        "        InterfaceState('Info', 'M02Pirate', 1);",
                        "",
                        "        InterfacePos('Info', 'M03Maloc', 0, 0, 1);",
                        "        InterfacePos('Info', 'M03Peleng', 0, 0, 1);",
                        "        InterfacePos('Info', 'M03People', 0, 0, 1);",
                        "        InterfacePos('Info', 'M03Fei', 0, 0, 1);",
                        "        InterfacePos('Info', 'M03Gaal', 0, 0, 1);",
                        "        InterfaceState('Info', 'M03Pirate', 1);",
                        "",
                        "        InterfacePos('Info', 'M04Maloc', 0, 0, 1);",
                        "        InterfacePos('Info', 'M04Peleng', 0, 0, 1);",
                        "        InterfacePos('Info', 'M04People', 0, 0, 1);",
                        "        InterfacePos('Info', 'M04Fei', 0, 0, 1);",
                        "        InterfacePos('Info', 'M04Gaal', 0, 0, 1);",
                        "        InterfaceState('Info', 'M04Pirate', 1);",
                        "",
                        "        InterfacePos('Info', 'M05Maloc', 0, 0, 1);",
                        "        InterfacePos('Info', 'M05Peleng', 0, 0, 1);",
                        "        InterfacePos('Info', 'M05People', 0, 0, 1);",
                        "        InterfacePos('Info', 'M05Fei', 0, 0, 1);",
                        "        InterfacePos('Info', 'M05Gaal', 0, 0, 1);",
                        "        InterfaceState('Info', 'M05Pirate', 1);",
                        "",
                        "        InterfacePos('Info', 'M06Maloc', 0, 0, 1);",
                        "        InterfacePos('Info', 'M06Peleng', 0, 0, 1);",
                        "        InterfacePos('Info', 'M06People', 0, 0, 1);",
                        "        InterfacePos('Info', 'M06Fei', 0, 0, 1);",
                        "        InterfacePos('Info', 'M06Gaal', 0, 0, 1);",
                        "        InterfaceState('Info', 'M06Pirate', 1);",
                        "",
                        "        InterfacePos('Info', 'M07Maloc', 0, 0, 1);",
                        "        InterfacePos('Info', 'M07Peleng', 0, 0, 1);",
                        "        InterfacePos('Info', 'M07People', 0, 0, 1);",
                        "        InterfacePos('Info', 'M07Fei', 0, 0, 1);",
                        "        InterfacePos('Info', 'M07Gaal', 0, 0, 1);",
                        "        InterfaceState('Info', 'M07Pirate', 1);",
                        "",
                        "        InterfacePos('Info', 'M09Maloc', 0, 0, 1);",
                        "        InterfacePos('Info', 'M09Peleng', 0, 0, 1);",
                        "        InterfacePos('Info', 'M09People', 0, 0, 1);",
                        "        InterfacePos('Info', 'M09Fei', 0, 0, 1);",
                        "        InterfacePos('Info', 'M09Gaal', 0, 0, 1);",
                        "        InterfaceState('Info', 'M09Pirate', 1);",
                        "",
                        "        InterfacePos('Info', 'M12Maloc', 0, 0, 1);",
                        "        InterfacePos('Info', 'M12Peleng', 0, 0, 1);",
                        "        InterfacePos('Info', 'M12People', 0, 0, 1);",
                        "        InterfacePos('Info', 'M12Fei', 0, 0, 1);",
                        "        InterfacePos('Info', 'M12Gaal', 0, 0, 1);",
                        "        InterfaceState('Info', 'M12Pirate', 1);",
                        "",
                        "        InterfacePos('Info', 'M15Maloc', 0, 0, 1);",
                        "        InterfacePos('Info', 'M15Peleng', 0, 0, 1);",
                        "        InterfacePos('Info', 'M15People', 0, 0, 1);",
                        "        InterfacePos('Info', 'M15Fei', 0, 0, 1);",
                        "        InterfacePos('Info', 'M15Gaal', 0, 0, 1);",
                        "        InterfaceState('Info', 'M15Pirate', 1);",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 310,
                    "Parent": -1,
                    "#": 14,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "dword cur_ruin = GetShipRuins(Player());",
                        "if(cur_ruin)",
                        "{",
                        "    if(pirates_begin_turn > CurTurn())",
                        "    {",
                        "        if(ShipType(cur_ruin) == 'RC')",
                        "        {",
                        "            //Блочим вопрос игрока \"Как я могу помочь Коалиции в борьбе с пиратами?\"",
                        "            AddDialogBlock(CT('FormRuins.RC.PirateClan.PlayerSend'), 2);",
                        "        }",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 160,
                    "Pos.y": 205,
                    "Parent": -1,
                    "#": 17,
                    "Code.Type": "Turn",
                    "Code": [
                        "dword cur_star = ShipStar(CurShip);",
                        "OrderLock(CurShip, 1);",
                        "",
                        "if(!ShipInNormalSpace(CurShip))",
                        "{",
                        "    if(!ShipInHyperSpace(CurShip)) OrderTakeOff(CurShip);",
                        "    else",
                        "    {",
                        "        //Если прилетел в целевую систему",
                        "        if(Id(cur_star) == GetData(0))",
                        "        {",
                        "            OrderLock(CurShip, 0);",
                        "            ShipOut(CurShip);",
                        "        }",
                        "    }",
                        "}",
                        "else if(Id(cur_star) != GetData(0)) OrderJump(CurShip, GalaxyStar(GetData(0) - 1));",
                        "else //FIX: уже в целевой системе в обычном космосе - раньше корабль оставался с OrderLock навсегда",
                        "{",
                        "    OrderLock(CurShip, 0);",
                        "    ShipOut(CurShip);",
                        "}"
                    ]
                }
            ],
