                        "      dcnt = 0;",
                        "      for(i=1;GalaxyStars()>i;i=i+1) {",
                        "          to_star = StarNearbyStars(cur_star,i);",
                        "          if(round(sqrt(Dist2Star(cur_star, to_star))) > 150) break;",
                        "          if(round(sqrt(Dist2Star(cur_star, to_star))) < 30) continue;",
                        "          if(StarOwner(to_star) != 0) continue;",
                        "          if(!SectorVisible(StarToCon(to_star))) continue;",
                        "  ",
                        "          for(j=0;StarPlanets(to_star)>j;j=j+1) {",
                        "              if(PlanetOwner(StarPlanets(to_star,j)) > 4) continue;",
                        "              dcnt = dcnt + 1;",
                        "              if(Rnd(1,dcnt) == 1) t3 = Id(StarPlanets(to_star,j));",
                        "          }",
                        "      }",
                        "      if(!t3) {",
                        "          dcnt = 0;",
                        "          for(i=1;GalaxyStars()>i;i=i+1) {",
                        "              to_star = StarNearbyStars(cur_star,i);",
                        "              if(round(sqrt(Dist2Star(cur_star, to_star))) > 150) break;",
                        "              if(round(sqrt(Dist2Star(cur_star, to_star))) < 20) continue;",
                        "              if(StarOwner(to_star) != 0) continue;",
                        "              if(!SectorVisible(StarToCon(to_star))) continue;",
                        "  ",
                        "              for(j=0;StarPlanets(to_star)>j;j=j+1) {",
                        "                  if(PlanetOwner(StarPlanets(to_star,j)) > 4) continue;",
                        "                  dcnt = dcnt + 1;",
                        "                  if(Rnd(1,dcnt) == 1) t3 = Id(StarPlanets(to_star,j));",
                        "              }",
                        "          }",
                        "      }",
                        "  ",
                        "      if(t3 && f3) {",
                        "          d3 = 35 + round(sqrt(Dist2Star(PlanetToStar(IdToPlanet(f3)), PlanetToStar(IdToPlanet(t3)))) * 2);",
                        "          m3 = GalaxyMoney(2,ShipOwner(GetShipRuins(Player()))) * 3 * PortionInDiapason(round(sqrt(Dist2Star(PlanetToStar(IdToPlanet(f3)), PlanetToStar(IdToPlanet(t3))))),20,150,85,170) / 100;",
                        "  ",
                        "         tstr = tstr + Format('<br>') + '</color>' + Format(CT(path + '.AskFor2'),'<PlanetFrom'+'>',Name(IdToPlanet(f3)),'<PlanetTo'+'>',Name(IdToPlanet(t3)),'<Days'+'>',d3,'<Type'+'>',CT(path + '.Quests.'+c3+'.TypeName'),'<Weight'+'>',CT(path + '.Quests.'+c3+'.Count'),'<Money'+'>',m3);",
                        "      }",
                        "      else c3 = -1;",
                        "  }",
                        "  else if(~c3) tstr = tstr + Format('<br>') + '</color>' + Format(CT(path + '.AskFor2'),'<PlanetFrom'+'>',Name(IdToPlanet(f3)),'<PlanetTo'+'>',Name(IdToPlanet(t3)),'<Days'+'>',d3,'<Type'+'>',CT(path + '.Quests.'+c3+'.TypeName'),'<Weight'+'>',CT(path + '.Quests.'+c3+'.Count'),'<Money'+'>',m3);",
                        "  ",
                        "  if(c1 == -1 && c2 == -1 && c3 == -1) tstr = tstr + Format('<br>') + '</color>' + CT(path + '.AskForNo');",
                        "  ",
                        "  tstr = tstr + Format('<br>') + '</color>' + CT(path + '.AskFor3');",
                        "  DChange(2);",
                        "  exit;",
                        "}",
                        "if(contract) {",
                        "  tdwd = IdToPlanet(PlanetFromId);",
                        "  tdwd2 = IdToPlanet(PlanetToId);",
                        "  tstr = '</color>' + Format(CT(path + '.ActualContracts'),'<PlanetFrom'+'>',Name(tdwd),'<PlanetTo'+'>',Name(tdwd2),'<Days'+'>',DaysLeft,'<Type'+'>',CT(path + '.Quests.'+contract+'.TypeName'),'<Weight'+'>',CT(path + '.Quests.'+contract+'.Count'),'<Money'+'>',Reward);",
                        "  DChange(3);",
                        "  exit;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 340,
                    "Pos.y": 390,
                    "Parent": -1,
                    "#": 62,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(DaysLeft * 2 > days) {",
                        "    i = Reward / 100 * 115;",
                        "    tstr = '</color>' + Format(CT(path+'.RecievedEarlier'),'<Player'+'>',Name(Player()),'<Money'+'>',i);",
                        "}",
                        "else if(DaysLeft >= 0) {",
                        "    i = Reward;",
                        "    tstr = '</color>' + Format(CT(path+'.RecievedInTime'),'<Player'+'>',Name(Player()),'<Money'+'>',i);",
                        "}",
                        "else {",
                        "    i = Reward / 2;",
                        "    tstr = '</color>' + Format(CT(path+'.RecievedLater'),'<Player'+'>',Name(Player()),'<Money'+'>',i);",
                        "}",
                        "ShipMoney(Player(),ShipMoney(Player()) + i);",
                        "",
                        "j = 0;",
                        "if(CT(path+'.Quests.'+contract+'.Contraband') == '1') j = 1;",
                        "else if(int(CT(path+'.Quests.'+contract+'.ItemType')) != t_UselessItem) {",
                        "    if(ShipGoodsIllegalOnPlanet(Player(),int(CT(path+'.Quests.'+contract+'.ItemType')),GetShipPlanet(Player()))) j = 1;",
                        "}",
                        "if(j) {",
                        "    j = RelationToRanger(GetShipPlanet(Player()),Player()) - Rnd(30,50);",
                        "    if(j < 0) j = 0;",
                        "    RelationToRanger(GetShipPlanet(Player()),Player(),j);",
                        "}",
                        "",
                        "dword item;",
                        "if(int(CT(path+'.Quests.'+contract+'.ItemType')) != t_UselessItem) {",
                        "    if(GoodsCount(Player(),int(CT(path+'.Quests.'+contract+'.ItemType'))) >= CT(path+'.Quests.'+contract+'.Count')) {",
                        "        ShipGoods(Player(),int(CT(path+'.Quests.'+contract+'.ItemType')),-CT(path+'.Quests.'+contract+'.Count'));",
                        "    }",
                        "}",
                        "else {",
                        "    j = 0;",
                        "    for(i=ShipItems(Player())-1;i>=0;i=i-1) {",
                        "        if(j >= CT(path+'.Quests.'+contract+'.Count')) break;",
                        "        item = ShipItems(Player(),i);",
                        "        if(ItemType(item) != t_UselessItem) continue;",
                        "        if(EquipmentImageName(item) != CT(path+'.Quests.'+contract+'.UselessType')) continue;",
                        "        FreeItem(GetItemFromShip(Player(),item));",
                        "        j = j + 1;",
                        "    }",
                        "}",
                        "",
                        "Sound('Sound.QuestOk');",
                        "Ether(4,'RevMerchantsEther','');",
                        "days = 0;",
                        "contract = 0;",
                        "DChange(4);",
                        "exit;"
                    ]
                },
