            "Items": [],
            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 600,
                    "Parent": -1,
                    "#": 36,
                    "Code.Type": "Global",
                    "Code": [
                        "GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 600,
                    "Parent": -1,
                    "#": 37,
                    "Code.Type": "Init",
                    "Code": [
                        "//Просто по приколу будем тут хранить путь до всех текстов и цифр мода",
                        "path = 'Script.Mod_RevMerchants';",
                        "",
                        "UpdateCD = Rnd(50,90);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 600,
                    "Parent": -1,
                    "#": 38,
                    "Code.Type": "Turn",
                    "Code": [
                        "//Обновляем доступные контракты",
                        "if(UpdateCD) UpdateCD = UpdateCD - 1;",
                        "else {",
                        "    c1 = 0;",
                        "    c2 = 0;",
                        "    c3 = 0;",
                        "    f1 = 0;",
                        "    f2 = 0;",
                        "    f3 = 0;",
                        "    t1 = 0;",
                        "    t2 = 0;",
                        "    t3 = 0;",
                        "",
                        "    UpdateCD = PortionInDiapason(GalaxyDiffLevels(5),50,500,20,700) + Rnd(1,20);",
                        "}",
                        "",
                        "//Считаем кулдаун",
                        "if(days && joined_work) {",
                        "    DaysLeft = DaysLeft - 1;",
                        "    tdwd = IdToPlanet(PlanetFromId);",
                        "    tdwd2 = IdToPlanet(PlanetToId);",
                        "    Ether(3,'RevMerchantsEther',Format(CT(path+'.EtherText'),'<Days'+'>',DaysLeft,'<FromPlanet'+'>',Name(tdwd),'<FromStar'+'>',Name(PlanetToStar(tdwd)),'<FromSector'+'>',Name(StarToCon(PlanetToStar(tdwd))),'<ToPlanet'+'>',Name(tdwd2),'<ToStar'+'>',Name(PlanetToStar(tdwd2)),'<ToSector'+'>',Name(StarToCon(PlanetToStar(tdwd2)))));",
                        "}",
                        "//Даём проверку на сильное истечение срока",
                        "if(days && (DaysLeft < (0 - days / 2)) && joined_work) {",
                        "    joined_work = 0;",
                        "    NewsAdd(Format(CT(path+'.QuestFailed'),'<Player'+'>',Name(Player())));",
                        "    Sound('Sound.QuestCancel');",
                        "    Ether(5,'RevMerchantsEther','');",
                        "    PlayerDebt(PlayerDebt()+Reward);",
                        "    if(!PlayerDebtDate()) PlayerDebtDate(CurTurn());",
                        "    days = 0;",
                        "    contract = 0;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 600,
                    "Parent": -1,
                    "#": 39,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "cur_ship = GetShipRuins(Player());",
                        "",
                        "if(cur_ship) {",
                        "    if(ShipType(cur_ship) == 'BK') {",
                        "        if(!PlayerDebtCnt()) {",
                        "            if(!joined_work) {",
                        "                AddDialogInject('AskForWork',CT('Script.Mod_RevMerchants.Vacancia'),CT('Script.Mod_RevMerchants.AskForVacancia'),2);",
                        "            }",
                        "            else if(!contract) {",
                        "                AddDialogInject('AskForContract','',CT(\"Script.Mod_RevMerchants.16\"),2);",
                        "            }",
                        "            else {",
                        "                AddDialogInject('AskForContract','',CT(\"Script.Mod_RevMerchants.15\"),2);",
                        "            }",
                        "        }",
                        "    }",
                        "}",
                        "",
                        "cur_ship = GetShipPlanet(Player());",
                        "dword item;",
                        "",
                        "if(cur_ship) {",
                        "    if(contract) {",
                        "        if(cur_ship == IdToPlanet(PlanetToId)) {",
                        "            if(int(CT(path+'.Quests.'+contract+'.ItemType')) != t_UselessItem) {",
                        "                if(GoodsCount(Player(),int(CT(path+'.Quests.'+contract+'.ItemType'))) >= CT(path+'.Quests.'+contract+'.Count')) {",
                        "                    AddDialogInject('RecieveCargo','',CT(\"Script.Mod_RevMerchants.0\"),1);",
                        "                }",
                        "            }",
                        "            else {",
                        "                j = 0;",
                        "                for(i=0;i<ShipItems(Player());i=i+1) {",
                        "                    item = ShipItems(Player(),i);",
                        "                    if(ItemType(item) != t_UselessItem) continue;",
                        "                    if(EquipmentImageName(item) != CT(path+'.Quests.'+contract+'.UselessType')) continue;",
                        "                    j = j + 1;",
                        "                }",
                        "                if(j >= CT(path+'.Quests.'+contract+'.Count')) {",
                        "                    AddDialogInject('RecieveCargo','',CT(\"Script.Mod_RevMerchants.0\"),1);",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 390,
                    "Parent": -1,
                    "#": 60,
                    "Code.Type": "Turn",
                    "Code": [
                        "DChange(0);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 130,
                    "Pos.y": 390,
                    "Parent": -1,
                    "#": 61,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!contract) {",
                        "  dword cur_star = ShipStar(Player());",
                        "  dword to_star;",
                        "  tstr = '</color>' + CT(path + '.AskFor1');",
                        "  ",
                        "  if(ContractStar != cur_star) {",
                        "      c1 = 0; c2 = 0; c3 = 0;",
                        "      f1 = 0; f2 = 0; f3 = 0;",
                        "      t1 = 0; t2 = 0; t3 = 0;",
                        "      ContractStar = cur_star;",
                        "  }",
                        "  ",
                        "  if(!c1 && ~c1) {",
                        "      c1 = Rnd(1,CT(path+'.Quests.Count'));",
                        "      for(i=0;StarPlanets(cur_star)>i;i=i+1) {",
                        "          if(PlanetOwner(StarPlanets(cur_star,i)) == None) continue;",
                        "          else {",
                        "              f1 = Id(StarPlanets(cur_star,i));",
                        "          }",
                        "      }",
                        "  ",
                        "      t1 = 0;",
                        "      dcnt = 0;",
                        "      for(i=1;GalaxyStars()>i;i=i+1) {",
                        "          to_star = StarNearbyStars(cur_star,i);",
                        "          if(round(sqrt(Dist2Star(cur_star, to_star))) > 150) break;",
                        "          if(round(sqrt(Dist2Star(cur_star, to_star))) < 30) continue;",
                        "          if(StarOwner(to_star) != 0) continue;",
                        "          if(!SectorVisible(StarToCon(to_star))) continue;",
                        "  ",
                        "          for(j=0;StarPlanets(to_star)>j;j=j+1) {",
                        "              if(PlanetOwner(StarPlanets(to_star,j)) > 4) continue;",
                        "              dcnt = dcnt + 1;",
                        "              if(Rnd(1,dcnt) == 1) t1 = Id(StarPlanets(to_star,j));",
                        "          }",
                        "      }",
                        "      if(!t1) {",
                        "          dcnt = 0;",
                        "          for(i=1;GalaxyStars()>i;i=i+1) {",
                        "              to_star = StarNearbyStars(cur_star,i);",
                        "              if(round(sqrt(Dist2Star(cur_star, to_star))) > 150) break;",
                        "              if(round(sqrt(Dist2Star(cur_star, to_star))) < 20) continue;",
                        "              if(StarOwner(to_star) != 0) continue;",
                        "              if(!SectorVisible(StarToCon(to_star))) continue;",
                        "  ",
                        "              for(j=0;StarPlanets(to_star)>j;j=j+1) {",
                        "                  if(PlanetOwner(StarPlanets(to_star,j)) > 4) continue;",
                        "                  dcnt = dcnt + 1;",
                        "                  if(Rnd(1,dcnt) == 1) t1 = Id(StarPlanets(to_star,j));",
                        "              }",
                        "          }",
                        "      }",
                        "  ",
                        "      if(t1 && f1) {",
                        "          d1 = 35 + round(sqrt(Dist2Star(PlanetToStar(IdToPlanet(f1)), PlanetToStar(IdToPlanet(t1)))) * 2);",
                        "          m1 = GalaxyMoney(2,ShipOwner(GetShipRuins(Player()))) * 3 * PortionInDiapason(round(sqrt(Dist2Star(PlanetToStar(IdToPlanet(f1)), PlanetToStar(IdToPlanet(t1))))),20,150,85,170) / 100;",
                        "      ",
                        "          tstr = tstr + Format('<br>') + '</color>' + Format(CT(path + '.AskFor2'),'<PlanetFrom'+'>',Name(IdToPlanet(f1)),'<PlanetTo'+'>',Name(IdToPlanet(t1)),'<Days'+'>',d1,'<Type'+'>',CT(path + '.Quests.'+c1+'.TypeName'),'<Weight'+'>',CT(path + '.Quests.'+c1+'.Count'),'<Money'+'>',m1);",
                        "      }",
                        "      else c1 = -1;",
                        "  }",
                        "  else if(~c1) tstr = tstr + Format('<br>') + '</color>' + Format(CT(path + '.AskFor2'),'<PlanetFrom'+'>',Name(IdToPlanet(f1)),'<PlanetTo'+'>',Name(IdToPlanet(t1)),'<Days'+'>',d1,'<Type'+'>',CT(path + '.Quests.'+c1+'.TypeName'),'<Weight'+'>',CT(path + '.Quests.'+c1+'.Count'),'<Money'+'>',m1);",
                        "  if(!c2 && ~c2) {",
                        "      c2 = Rnd(1,CT(path+'.Quests.Count'));",
                        "      for(i=0;StarPlanets(cur_star)>i;i=i+1) {",
                        "          if(PlanetOwner(StarPlanets(cur_star,i)) == None) continue;",
                        "          else {",
                        "              f2 = Id(StarPlanets(cur_star,i));",
                        "          }",
                        "      }",
                        "  ",
                        "      t2 = 0;",
                        "      dcnt = 0;",
                        "      for(i=1;GalaxyStars()>i;i=i+1) {",
                        "          to_star = StarNearbyStars(cur_star,i);",
                        "          if(round(sqrt(Dist2Star(cur_star, to_star))) > 150) break;",
                        "          if(round(sqrt(Dist2Star(cur_star, to_star))) < 30) continue;",
                        "          if(StarOwner(to_star) != 0) continue;",
                        "          if(!SectorVisible(StarToCon(to_star))) continue;",
                        "  ",
                        "          for(j=0;StarPlanets(to_star)>j;j=j+1) {",
                        "              if(PlanetOwner(StarPlanets(to_star,j)) > 4) continue;",
                        "              dcnt = dcnt + 1;",
                        "              if(Rnd(1,dcnt) == 1) t2 = Id(StarPlanets(to_star,j));",
                        "          }",
                        "      }",
                        "      if(!t2) {",
                        "          dcnt = 0;",
                        "          for(i=1;GalaxyStars()>i;i=i+1) {",
                        "              to_star = StarNearbyStars(cur_star,i);",
                        "              if(round(sqrt(Dist2Star(cur_star, to_star))) > 150) break;",
                        "              if(round(sqrt(Dist2Star(cur_star, to_star))) < 20) continue;",
                        "              if(StarOwner(to_star) != 0) continue;",
                        "              if(!SectorVisible(StarToCon(to_star))) continue;",
                        "  ",
                        "              for(j=0;StarPlanets(to_star)>j;j=j+1) {",
                        "                  if(PlanetOwner(StarPlanets(to_star,j)) > 4) continue;",
                        "                  dcnt = dcnt + 1;",
                        "                  if(Rnd(1,dcnt) == 1) t2 = Id(StarPlanets(to_star,j));",
                        "              }",
                        "          }",
                        "      }",
                        "  ",
                        "      if(t2 && f2) {",
                        "          d2 = 35 + round(sqrt(Dist2Star(PlanetToStar(IdToPlanet(f2)), PlanetToStar(IdToPlanet(t2)))) * 2);",
                        "          m2 = GalaxyMoney(2,ShipOwner(GetShipRuins(Player()))) * 3 * PortionInDiapason(round(sqrt(Dist2Star(PlanetToStar(IdToPlanet(f2)), PlanetToStar(IdToPlanet(t2))))),20,150,85,170) / 100;",
                        "  ",
                        "          tstr = tstr + Format('<br>') + '</color>' + Format(CT(path + '.AskFor2'),'<PlanetFrom'+'>',Name(IdToPlanet(f2)),'<PlanetTo'+'>',Name(IdToPlanet(t2)),'<Days'+'>',d2,'<Type'+'>',CT(path + '.Quests.'+c2+'.TypeName'),'<Weight'+'>',CT(path + '.Quests.'+c2+'.Count'),'<Money'+'>',m2);",
                        "      }",
                        "      else c2 = -1;",
                        "  }",
                        "  else if(~c2) tstr = tstr + Format('<br>') + '</color>' + Format(CT(path + '.AskFor2'),'<PlanetFrom'+'>',Name(IdToPlanet(f2)),'<PlanetTo'+'>',Name(IdToPlanet(t2)),'<Days'+'>',d2,'<Type'+'>',CT(path + '.Quests.'+c2+'.TypeName'),'<Weight'+'>',CT(path + '.Quests.'+c2+'.Count'),'<Money'+'>',m2);",
                        "  if(!c3 && ~c3) {",
                        "      c3 = Rnd(1,CT(path+'.Quests.Count'));",
                        "      for(i=0;StarPlanets(cur_star)>i;i=i+1) {",
                        "          if(PlanetOwner(StarPlanets(cur_star,i)) == None) continue;",
                        "          else {",
