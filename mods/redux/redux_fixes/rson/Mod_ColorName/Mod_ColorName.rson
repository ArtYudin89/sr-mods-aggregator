                    "Code.Type": "Turn",
                    "Code": [
                        "tcolor = '255,0,0';",
                        "if(tmode == 0)",
                        "{",
                        "    SetName(Player(),DeleteTags(ShipName(Player())));",
                        "    SetName(Player(),'<color='+tcolor+'>'+ShipName(Player())+'</color>');",
                        "    ShipMoney(Player(),ShipMoney(Player())-5000);",
                        "}",
                        "else",
                        "{",
                        "    SetName(ShipPartners(Player(),tint1),DeleteTags(ShipName(ShipPartners(Player(),tint1))));",
                        "    SetName(ShipPartners(Player(),tint1),'<color='+tcolor+'>'+ShipName(ShipPartners(Player(),tint1))+'</color>');",
                        "    ShipMoney(Player(),ShipMoney(Player())-5250);",
                        "    ShipMoney(ShipPartners(Player(),tint1),ShipMoney(ShipPartners(Player(),tint1))+5250);",
                        "}",
                        "Sound('Sound.Buy');",
