                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 750,
                    "Parent": -1,
                    "#": 26,
                    "Code.Type": "Init",
                    "Code": [
                        "//Отладочный вывод отключён",
                        "",
                        "//--- Смена стороны и национальности на ПБ по формулам движка (TfRuinsTalk, пиратская база) ---",
                        "//Движок не пишет галасобытия PlayerChangesSide/PlayerChangesNationality для смен через ExpPB,",
                        "//поэтому ходы таких смен хранятся в ExpPB_SideChangeTurns/ExpPB_NatChangeTurns (элемент [0] - заглушка)",
                        "function g_CountRecentChanges(str etype)",
                        "{",
                        "    int cnt = 0;",
                        "    int k = 0;",
                        "    for(k = GalaxyEvents() - 1; k >= 0; k = k - 1)",
                        "    {",
                        "        if(GalaxyEventDate(k) + 365 < CurTurn()) break;",
                        "        if(GalaxyEventType(k) == etype) cnt = cnt + 1;",
                        "    }",
                        "    if(etype == 'PlayerChangesSide')",
                        "    {",
                        "        if(ArrayDim(ExpPB_SideChangeTurns) < 1) { free(ExpPB_SideChangeTurns); ExpPB_SideChangeTurns = newarray(1); ExpPB_SideChangeTurns[0] = 0; }",
                        "        for(k = ArrayDim(ExpPB_SideChangeTurns) - 1; k >= 1; k = k - 1)",
                        "        {",
                        "            if(ExpPB_SideChangeTurns[k] + 365 < CurTurn()) ArrayDelete(ExpPB_SideChangeTurns, k);",
                        "            else cnt = cnt + 1;",
                        "        }",
                        "    }",
                        "    else",
                        "    {",
                        "        if(ArrayDim(ExpPB_NatChangeTurns) < 1) { free(ExpPB_NatChangeTurns); ExpPB_NatChangeTurns = newarray(1); ExpPB_NatChangeTurns[0] = 0; }",
                        "        for(k = ArrayDim(ExpPB_NatChangeTurns) - 1; k >= 1; k = k - 1)",
                        "        {",
                        "            if(ExpPB_NatChangeTurns[k] + 365 < CurTurn()) ArrayDelete(ExpPB_NatChangeTurns, k);",
                        "            else cnt = cnt + 1;",
                        "        }",
                        "    }",
                        "    result = cnt;",
                        "}",
                        "",
                        "//Запоминаем ход смены (аналог AddGalaxyEvent в движке)",
                        "function g_RememberChange(str etype)",
                        "{",
                        "    g_CountRecentChanges(etype); //инициализация массива и чистка старых записей",
                        "    if(etype == 'PlayerChangesSide') ArrayAdd(ExpPB_SideChangeTurns, CurTurn());",
                        "    else ArrayAdd(ExpPB_NatChangeTurns, CurTurn());",
                        "}",
                        "",
                        "//Цена смены стороны: огромная сумма, x1.5 за каждую смену за последние 365 дней, не больше 100000000",
                        "function g_SideChangeCost()",
                        "{",
                        "    int cost = GalaxyMoney(4);",
                        "    int cnt = g_CountRecentChanges('PlayerChangesSide');",
                        "    for(int k = 0; k < cnt; k = k + 1) cost = min(100000000, round(cost * 1.5));",
                        "    result = cost;",
                        "}",
                        "",
                        "//Отношения после смены стороны (вызывать ПОСЛЕ смены овнера)",
                        "function g_ApplySideChangeRelations()",
                        "{",
                        "    dword pc = PlanetPirateClan();",
                        "    if(ShipOnSidePirateClan(Player()))",
                        "    {",
                        "        if(pc) { if(RelationToRanger(pc, Player()) < 45) RelationToRanger(pc, Player(), 45); }",
                        "        ChangeGlobalRelationsShips(Player(), 0, 1, 45, 61, 128);",
                        "        ChangeGlobalRelationsPlanets(Player(), 0, 0, 20, 31);",
                        "        ChangeGlobalRelationsShips(Player(), 0, 0, 20, 61, 31);",
                        "    }",
                        "    else",
                        "    {",
                        "        ChangeGlobalRelationsPlanets(Player(), 0, 1, 45, 31);",
                        "        ChangeGlobalRelationsShips(Player(), 0, 1, 45, 61, 31);",
                        "        if(pc) { if(RelationToRanger(pc, Player()) > 20) RelationToRanger(pc, Player(), 20); }",
                        "        ChangeGlobalRelationsShips(Player(), 0, 0, 20, 61, 128);",
                        "    }",
                        "}",
                        "",
                        "//Множитель цены смены национальности: x1.5 за каждую смену за последние 365 дней",
                        "function g_NationalityFactor()",
                        "{",
                        "    float f = 1.0;",
                        "    int cnt = g_CountRecentChanges('PlayerChangesNationality');",
                        "    for(int k = 0; k < cnt; k = k + 1) f = f * 1.5;",
                        "    result = f;",
                        "}",
                        "",
                        "function g_NationalityCost(int race)",
                        "{",
                        "    result = round(GalaxyMoney(3, race) * g_NationalityFactor());",
                        "}",
                        "",
                        "//Смена национальности (TfRuinsTalk.AcceptPirateBaseNationality), вызывается из CustomForm_ExpPB_ChangeRace",
                        "function g_ApplyNationality(int race, int face, str nm)",
                        "{",
                        "    int ok = 0;",
                        "    int cost = g_NationalityCost(race);",
                        "    if(race >= 0 && race <= 4 && ShipMoney(Player()) >= cost)",
                        "    {",
                        "        ok = 1;",
                        "        ShipPilotRace(Player(), race);",
                        "        ShipFace(Player(), face);",
                        "        //Пиратский овнер сохраняется, коалиционный меняется на новую расу",
                        "        if(!ShipOnSidePirateClan(Player())) ShipOwner(Player(), race);",
                        "        if(nm != '') SetName(Player(), nm);",
                        "        ShipMoney(Player(), max(ShipMoney(Player()) - cost, 0));",
                        "        //Недоразвившиеся болезни 1..12, которыми новая раса болеть не может, снимаются",
                        "        //(маски рас CaptainHealthDefinitions[].AllowedOwners: бит 1 - малоки ... бит 16 - гаальцы)",
                        "        str masks = '31,30,7,30,31,31,31,30,1,2,8,16';",
                        "        for(int j = 1; j <= 12; j = j + 1)",
                        "        {",
                        "            int m = int(GetParFromString(masks, ',', j - 1, 0));",
                        "            if((m & (1 << race)) == 0)",
                        "            {",
                        "                if(ShipHealthFactorStatus(Player(), j) < 100) ShipHealthFactorStatus(Player(), j, 0);",
                        "            }",
                        "        }",
                        "        ChangeGlobalRelationsPlanets(Player(), 0, 1, 70, 31);",
                        "        ChangeGlobalRelationsShips(Player(), 0, 1, 70, 61, 31);",
                        "        dword pc = PlanetPirateClan();",
                        "        if(pc) { if(RelationToRanger(pc, Player()) < 45) RelationToRanger(pc, Player(), 45); }",
                        "        ChangeGlobalRelationsShips(Player(), 0, 1, 45, 61, 128);",
                        "        Sound('Sound.Sell');",
                        "        g_RememberChange('PlayerChangesNationality');",
                        "        str rt = 'Maloc';",
                        "        if(race == 1) rt = 'Peleng';",
                        "        else if(race == 2) rt = 'People';",
                        "        else if(race == 3) rt = 'Fei';",
                        "        else if(race == 4) rt = 'Gaal';",
                        "        MessageBox(Format(CT('FormRuins.PB.ChangeNationality.AfterOperation' + rt), '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player())), 10);",
                        "    }",
                        "    result = ok;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 750,
                    "Parent": -1,
                    "#": 27,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "cur_ruin = GetShipRuins(Player());",
                        "//if(cur_ruin) SFT(\"ExpPB DialogBegin: base type=\" + ShipType(cur_ruin));",
                        "if(cur_ruin)",
                        "{",
                        "    if(ShipType(cur_ruin) == 'PB')",
                        "    {",
                        "        t0 = '';",
                        "        //--- ChangeSide: в коалицию - пока Коалиция не разгромлена; в клан - пока клан не побеждён (PirateWin 3), впервые (без ShipInPirateClan) - только после вступительного PC_part0 ---",
                        "        AddDialogBlock(CT('FormRuins.PB.ChangeSide.ChangeSideToPirate'), 2);",
                        "        AddDialogBlock(CT('FormRuins.PB.ChangeSide.ChangeSideToNormal'), 2);",
                        "        if(ShipOnSidePirateClan(Player()) && !CoalitionDefeated()) AddDialogInject('PB_ChangeSide', '', DeleteTags(Format(t0 + CT('FormRuins.PB.ChangeSide.ChangeSideToNormal'), 'а','a','е','e','о','o','с','c','р','p','х','x','у','y','А','A','Е','E','О','O','С','C','Р','P','Х','X','К','K','М','M','Н','H','В','B','Т','T')), 1);",
                        "        if(!ShipOnSidePirateClan(Player()) && PirateWin() != 3 && (ShipInPirateClan(Player()) || IsScriptActive('PC_part0') == 0)) AddDialogInject('PB_ChangeSide', '', DeleteTags(Format(t0 + CT('FormRuins.PB.ChangeSide.ChangeSideToPirate'), 'а','a','е','e','о','o','с','c','р','p','х','x','у','y','А','A','Е','E','О','O','С','C','Р','P','Х','X','К','K','М','M','Н','H','В','B','Т','T')), 1);",
                        "        //--- ChangeNationality: сверху только без ExpImplants; иначе уезжает в подменю PB_BodyMods ---",
                        "        AddDialogBlock(CT('FormRuins.PB.ChangeNationality.ChangeNationality'), 2);",
                        "        if(!CurrentMods('Expansion\\\\ExpImplants')) AddDialogInject('PB_ChangeNationality', '', DeleteTags(Format(t0 + CT('FormRuins.PB.ChangeNationality.ChangeNationality'), 'а','a','е','e','о','o','с','c','р','p','х','x','у','y','А','A','Е','E','О','O','С','C','Р','P','Х','X','К','K','М','M','Н','H','В','B','Т','T')), 1);",
                        "        //--- Program: блокируем ванильный ответ, инжект уезжает в подменю PB_Shop ---",
                        "        AddDialogBlock(CT('FormRuins.PB.Program.PlayerAsk'), 2);",
                        "        //--- Nod: блокируем ванильный ответ, инжект уезжает в подменю PB_Shop ---",
                        "        AddDialogBlock(CT('FormRuins.PB.Nod.PlayerAsk'), 2);",
                        "        //--- Repair ---",
                        "        AddDialogBlock(CT('FormRuins.PB.Repair.PlayerSend'), 2);",
                        "        AddDialogInject('PB_Repair', '', DeleteTags(Format(t0 + CT('FormRuins.PB.Repair.PlayerSend'), 'а','a','е','e','о','o','с','c','р','p','х','x','у','y','А','A','Е','E','О','O','С','C','Р','P','Х','X','К','K','М','M','Н','H','В','B','Т','T')), 1);",
                        "        //--- Chameleon: блокируем ванильный ответ, инжект уезжает в подменю PB_Shop ---",
                        "        AddDialogBlock(CT('FormRuins.PB.Chameleon.PlayerAsk'), 2);",
                        "        //--- Группирующие подменю (сообщение НЕ трогаем -> остаётся приветствие ПБ) ---",
                        "        AddDialogInject('PB_Shop', '', '</color>' + CT('FormRuins.PB.Grouping.Shop'), 1);",
                        "        if(CurrentMods('Expansion\\\\ExpImplants')) AddDialogInject('PB_BodyMods', '', '</color>' + CT('FormRuins.PB.Grouping.BodyMods'), 1);",
                        "        //--- SabCrack (сабмодем): ванильный гейт TPlayer.MayTakeSubCrack = билдин PlayerMayTakeSubCrack():",
                        "        //    серия Террона НЕ побеждена && Day>2000 && (Day mod (Day mod 11 + 20) == 0 || Day>4000) && программы нет.",
                        "        AddDialogBlock(CT('FormRuins.PB.SabCrack.PlayerInfo'), 2);",
                        "        if(PlayerMayTakeSubCrack())",
                        "        {",
                        "            t1 = DeleteTags(Format(t0 + CT('FormRuins.PB.SabCrack.PlayerInfo'), 'а','a','е','e','о','o','с','c','р','p','х','x','у','y','А','A','Е','E','О','O','С','C','Р','P','Х','X','К','K','М','M','Н','H','В','B','Т','T'));",
                        "            //как в движке: денег меньше цены -> пункт серый некликабельный",
                        "            if(ShipMoney(Player()) < SubCrackCost()) AddDialogBlock(t1, 1);",
                        "            AddDialogInject('PB_SabCrack', '', t1, 1);",
                        "        }",
                        "        //--- SpecialShip: НЕ трогаем, ванильный пункт движка (флаг базы SpecialServiceActive, условия,",
                        "        //    акриновый корпус SuperHullPB и смена отношений скриптом не воспроизводимы) ---",
                        "        //--- WarStatus + AskQuestion (pirates only) ---",
                        "        if(ShipInPirateClan(Player()))",
                        "        {",
                        "            AddDialogBlock(CT('FormRuins.PB.WarWithKlingAndCoalition.PlayerSend'), 2);",
                        "            AddDialogInject('PB_WarStatus', '', DeleteTags(Format(t0 + CT('FormRuins.PB.WarWithKlingAndCoalition.PlayerSend'), 'а','a','е','e','о','o','с','c','р','p','х','x','у','y','А','A','Е','E','О','O','С','C','Р','P','Х','X','К','K','М','M','Н','H','В','B','Т','T')), 1);",
                        "            AddDialogBlock(CT('FormRuins.PB.AskQuestion.PlayerAsk'), 2);",
                        "            AddDialogInject('PB_AskQuestion', '', DeleteTags(Format(t0 + CT('FormRuins.PB.AskQuestion.PlayerAsk'), 'а','a','е','e','о','o','с','c','р','p','х','x','у','y','А','A','Е','E','О','O','С','C','Р','P','Х','X','К','K','М','M','Н','H','В','B','Т','T')), 1);",
                        "        }",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 390,
                    "Parent": -1,
                    "#": 113,
                    "Code.Type": "Turn",
                    "Code": [
                        "sBack = '</color>' + CT('FormRuins.PB.AskQuestion.PlayerNoQuestions');",
                        "dtext = '</color>' + CT('FormRuins.PB.AskQuestion.PBAsk');",
                        "dtext = Format(dtext);",
                        "DChange(0);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
