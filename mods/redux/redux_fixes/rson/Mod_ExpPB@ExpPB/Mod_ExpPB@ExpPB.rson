                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 460,
                    "Pos.y": 390,
                    "Parent": -1,
                    "#": 115,
                    "Code.Type": "Turn",
                    "Code": [
                        "dtext = '</color>' + Format(CT('FormRuins.PB.RankPoints.RankPoints'), '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player()));",
                        "dtext = Format(dtext);",
                        "DChange(2);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 730,
                    "Pos.y": 390,
                    "Parent": -1,
                    "#": 116,
                    "Code.Type": "Turn",
                    "Code": [
                        "n0 = g_SideChangeCost();",
                        "if(ShipOnSidePirateClan(Player())) dtext = '</color>' + Format(CT('FormRuins.PB.ChangeSide.AnswerChangeSideToNormal'), '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player()), '<Cost'+'>', n0);",
                        "else dtext = '</color>' + Format(CT('FormRuins.PB.ChangeSide.AnswerChangeSideToPirate'), '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player()), '<Cost'+'>', n0);",
                        "dtext = Format(dtext);",
                        "DChange(3);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 940,
                    "Pos.y": 390,
                    "Parent": -1,
                    "#": 117,
                    "Code.Type": "Turn",
                    "Code": [
                        "n0 = g_SideChangeCost();",
                        "if(ShipMoney(Player()) >= n0)",
                        "{",
                        "    ShipMoney(Player(), ShipMoney(Player()) - n0);",
                        "    if(ShipOnSidePirateClan(Player()))",
                        "    {",
                        "        ShipOwner(Player(), ShipPilotRace(Player()));",
                        "        dtext = '</color>' + Format(CT('FormRuins.PB.ChangeSide.AnswerPlayerOkNormal'), '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player()));",
                        "    }",
                        "    else",
                        "    {",
                        "        ShipJoinsClan(Player());",
                        "        dtext = '</color>' + Format(CT('FormRuins.PB.ChangeSide.AnswerPlayerOkPirate'), '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player()));",
                        "    }",
                        "    g_ApplySideChangeRelations();",
                        "    g_RememberChange('PlayerChangesSide');",
                        "    Sound('Sound.Sell');",
                        "}",
                        "else dtext = '</color>' + Format(CT('FormRuins.PB.ChangeSide.AnswerPlayerNoPirate'), '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player()));",
                        "dtext = Format(dtext);",
                        "DChange(4);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 1180,
                    "Pos.y": 390,
                    "Parent": -1,
                    "#": 118,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(ShipOnSidePirateClan(Player())) dtext = '</color>' + Format(CT('FormRuins.PB.ChangeSide.AnswerPlayerNoNormal'), '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player()));",
                        "else dtext = '</color>' + Format(CT('FormRuins.PB.ChangeSide.AnswerPlayerNoPirate'), '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player()));",
                        "dtext = Format(dtext);",
                        "DChange(5);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 1420,
                    "Pos.y": 390,
                    "Parent": -1,
                    "#": 119,
                    "Code.Type": "Turn",
                    "Code": [
                        "dtext = '</color>' + CT('FormRuins.PB.ChangeNationality.AnswerChangeNationality');",
                        "t1 = Format(CT('FormRuins.PB.ChangeNationality.PBNext'), '<MoneyMaloc'+'>', g_NationalityCost(0), '<MoneyPeleng'+'>', g_NationalityCost(1), '<MoneyPeople'+'>', g_NationalityCost(2), '<MoneyFei'+'>', g_NationalityCost(3), '<MoneyGaal'+'>', g_NationalityCost(4), '255,240,100');",
                        "dtext = dtext + Format(t1, '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player()));",
                        "dtext = Format(dtext);",
                        "DChange(28);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 1720,
                    "Pos.y": 390,
                    "Parent": -1,
                    "#": 120,
                    "Code.Type": "Turn",
                    "Code": [
                        "n1 = int(1.0 * ShipStatus(Player(), 1) / 1.3 + 0.5) + 1;",
                        "dtext = '</color>' + Format(CT('FormRuins.PB.Program.PBStart'), '<Percent'+'>', n1, '<NodTrum'+'>', GetNodesFromShip(Player()), '<NodAcc'+'>', RangerBaseNodes(Player()));",
                        "n0 = 500; n0 = n0 - int(1.0 * 500 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; dtext = dtext + '<br>' + '<color=255,240,100>' + CT('Programms.Intercom.Name') + '</color>' + ' - ' + Format(CT('Programms.Intercom.Text'), '<Count'+'>', 5) + '<br>' + Format(CT('FormRuins.PB.Program.NodCost'), '<Cost'+'>', n0) + '<br>';",
                        "n0 = 1000; n0 = n0 - int(1.0 * 1000 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; dtext = dtext + '<br>' + '<color=255,240,100>' + CT('Programms.Shipwreck.Name') + '</color>' + ' - ' + Format(CT('Programms.Shipwreck.Text'), '<Count'+'>', 3) + '<br>' + Format(CT('FormRuins.PB.Program.NodCost'), '<Cost'+'>', n0) + '<br>';",
                        "n0 = 800; n0 = n0 - int(1.0 * 800 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; dtext = dtext + '<br>' + '<color=255,240,100>' + CT('Programms.WeaponBlocking.Name') + '</color>' + ' - ' + Format(CT('Programms.WeaponBlocking.Text'), '<Count'+'>', 3) + '<br>' + Format(CT('FormRuins.PB.Program.NodCost'), '<Cost'+'>', n0) + '<br>';",
                        "n0 = 300; n0 = n0 - int(1.0 * 300 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; dtext = dtext + '<br>' + '<color=255,240,100>' + CT('Programms.Insanity.Name') + '</color>' + ' - ' + Format(CT('Programms.Insanity.Text'), '<Count'+'>', 3) + '<br>' + Format(CT('FormRuins.PB.Program.NodCost'), '<Cost'+'>', n0) + '<br>';",
                        "n0 = 200; n0 = n0 - int(1.0 * 200 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; dtext = dtext + '<br>' + '<color=255,240,100>' + CT('Programms.Shock.Name') + '</color>' + ' - ' + Format(CT('Programms.Shock.Text'), '<Count'+'>', 3) + '<br>' + Format(CT('FormRuins.PB.Program.NodCost'), '<Cost'+'>', n0) + '<br>';",
                        "n0 = 1200; n0 = n0 - int(1.0 * 1200 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; dtext = dtext + '<br>' + '<color=255,240,100>' + CT('Programms.SelfDestruction.Name') + '</color>' + ' - ' + Format(CT('Programms.SelfDestruction.Text'), '<Count'+'>', 1) + '<br>' + Format(CT('FormRuins.PB.Program.NodCost'), '<Cost'+'>', n0) + '<br>';",
                        "n0 = 900; n0 = n0 - int(1.0 * 900 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; dtext = dtext + '<br>' + '<color=255,240,100>' + CT('Programms.Disconnection.Name') + '</color>' + ' - ' + Format(CT('Programms.Disconnection.Text'), '<Count'+'>', 1) + '<br>' + Format(CT('FormRuins.PB.Program.NodCost'), '<Cost'+'>', n0) + '<br>';",
                        "dtext = Format(dtext);",
                        "DChange(6);",
                        "exit;"
                    ]
                },
                {
