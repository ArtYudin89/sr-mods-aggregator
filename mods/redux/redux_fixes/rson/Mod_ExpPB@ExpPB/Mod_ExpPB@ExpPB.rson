                        "n0 = 1000; n0 = n0 - int(1.0 * 1000 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; InjectAnswer('PB_Program_Buy', '</color>' + Format(CT('FormRuins.PB.Program.PlayerOk'), '<Nod'+'>', n0, '<Text'+'>', CT('Programms.Shipwreck.Name')), 6);",
                        "n0 = 800; n0 = n0 - int(1.0 * 800 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; InjectAnswer('PB_Program_Buy', '</color>' + Format(CT('FormRuins.PB.Program.PlayerOk'), '<Nod'+'>', n0, '<Text'+'>', CT('Programms.WeaponBlocking.Name')), 7);",
                        "n0 = 300; n0 = n0 - int(1.0 * 300 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; InjectAnswer('PB_Program_Buy', '</color>' + Format(CT('FormRuins.PB.Program.PlayerOk'), '<Nod'+'>', n0, '<Text'+'>', CT('Programms.Insanity.Name')), 8);",
