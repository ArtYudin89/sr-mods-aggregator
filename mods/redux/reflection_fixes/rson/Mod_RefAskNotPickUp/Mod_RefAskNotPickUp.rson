            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 9,
                    "Code.Type": "Global",
                    "Code": [
                        "GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 10,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "if(ShipInNormalSpace(Player())) {",
                        "    cur_ship = GetTalkShip();",
                        "    if(cur_ship) {",
                        "        star = ShipStar(cur_ship);",
                        "        if(ShipTypeN(cur_ship) != t_Kling && ShipTypeN(cur_ship) != t_Tranclucator) {",
                        "            for(int i = (StarItems(star)-1);i>=0;i=i-1) {",
                        "                dword item = StarItems(star,i);",
                        "                if(!ShipPicksItem(Player(),item)) continue;",
                        "                if(!ShipPicksItem(cur_ship,item)) continue;",
                        "    ",
                        "                AddDialogInject('DialogNew','',CT(\"Script.Mod_RefAskNotPickUp.0\"),10);",
                        "                break;",
                        "            }",
                        "        }",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 365,
                    "Parent": -1,
                    "#": 17,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(RelationToShip(GetTalkShip(),Player()) < 10) {",
                        "  DChange(0);",
                        "  exit;",
                        "}",
                        "if(RelationToShip(GetTalkShip(),Player()) > 9) {",
                        "  if(RelationToShip(GetTalkShip(),Player()) < 71 && ShipStrengthInAverageRanger(Player()) < 3.0) {",
                        "    DChange(0);",
                        "    exit;",
                        "  }",
                        "  if(RelationToShip(GetTalkShip(),Player()) < 71 && ShipStrengthInAverageRanger(Player()) >= 3.0) {",
                        "    cost = 0;",
                        "    for(i = (StarItems(star)-1);i>=0;i=i-1) {",
                        "        item = StarItems(star,i);",
                        "        if(ShipPicksItem(Player(),item) && ShipPicksItem(cur_ship,item)) {",
                        "            cost = ItemCost(item) + cost;",
                        "        }",
                        "    }",
                        "    ",
                        "    if(cost < (GalaxyMoney(4,4) * 5)) cost = 0;",
                        "    if(cost) {",
                        "      DChange(0);",
                        "      exit;",
                        "    }",
                        "    if(!cost) {",
                        "      DChange(1);",
                        "      exit;",
                        "    }",
                        "  }",
                        "  if(RelationToShip(GetTalkShip(),Player()) > 70) {",
                        "    cost = 0;",
                        "    for(i = (StarItems(star)-1);i>=0;i=i-1) {",
                        "        item = StarItems(star,i);",
                        "        if(ShipPicksItem(Player(),item) && ShipPicksItem(cur_ship,item)) {",
                        "            cost = ItemCost(item) + cost;",
                        "        }",
                        "    }",
                        "    ",
                        "    if(cost < (GalaxyMoney(4,4) * 5)) cost = 0;",
                        "    if(cost) {",
                        "      DChange(0);",
                        "      exit;",
                        "    }",
                        "    if(!cost) {",
                        "      DChange(1);",
                        "      exit;",
                        "    }",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 18,
                    "Code.Type": "Turn",
                    "Code": [
                        "DAdd(0);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 130,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 19,
                    "Code.Type": "Turn",
                    "Code": [
                        "cur_ship = GetTalkShip();",
                        "star = ShipStar(cur_ship);",
                        "",
                        "for(i = (StarItems(star)-1);i>=0;i=i-1) {",
                        "    item = StarItems(star,i);",
                        "    if(!ShipPicksItem(Player(),item)) continue;",
                        "    if(!ShipPicksItem(cur_ship,item)) continue;",
                        "",
                        "    ShipPicksItem(cur_ship,item,-1);",
                        "    ShipFreeFlight(cur_ship);",
                        "}",
                        "DAdd(1);"
                    ]
                }
            ],
