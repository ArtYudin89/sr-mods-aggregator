                    "Pos.y": 310,
                    "Parent": -1,
                    "#": 9,
                    "Code.Type": "Global",
                    "Code": [
                        "GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 310,
                    "Parent": -1,
                    "#": 10,
                    "Code.Type": "Turn",
                    "Code": [
                        "tcon = StarToCon(ShipStar(Player()));",
                        "pcon = StarToCon(PlanetToStar(PlanetPirateClan()));",
                        "for(i=0;GalaxySectors()>i;i=i+1) {",
                        "    if(GalaxySectors(i) == pcon) continue; //пиратский сектор - после цикла",
                        "    if(tcon == GalaxySectors(i)) SectorVisible(GalaxySectors(i),1);",
                        "    else if(ConNear(tcon,GalaxySectors(i))) SectorVisible(GalaxySectors(i),1);",
                        "    else SectorVisible(GalaxySectors(i),0);",
                        "}",
                        "//Пиратский сектор. Раньше игрок внутри открытого пиратского сектора сам его закрывал (сектор не \"рядом\" с собой),",
                        "//а сектор со скрытой Дицеей мог тут же закрыться обычной веткой - зависело от порядка секторов",
                        "if(SectorVisible(pcon)) DiceaFlag = 1;",
                        "if(tcon == pcon || ConNear(tcon,pcon)) {",
                        "    if(DiceaFlag) SectorVisible(pcon,1);",
                        "    else {",
                        "        tdw = GetSectorAdjacentToDicea();",
                        "        if(tdw != 0) SectorVisible(tdw,1);",
                        "    }",
                        "}",
                        "else if(DiceaFlag) SectorVisible(pcon,0);"
                    ]
                }
            ],
