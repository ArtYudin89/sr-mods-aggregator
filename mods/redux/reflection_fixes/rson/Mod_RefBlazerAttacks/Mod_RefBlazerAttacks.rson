            "Items": [],
            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 735,
                    "Parent": -1,
                    "#": 15,
                    "Code.Type": "Global",
                    "Code": [
                        "if(!GCntRun(GScriptName)) GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 735,
                    "Parent": -1,
                    "#": 16,
                    "Code.Type": "Init",
                    "Code": [
                        "//Функции для спавна свиты Блазера",
                        "function SpawnBlazer(star) {",
                        "    int cnty,i;",
                        "    dword t_plan;",
                        "    dword ship, tdwd, item;",
                        "",
                        "    //Командир-Блазер - псевдо-Блазер, атакующий другие системы.",
                        "    if(GroupCount(BlazerGroup)) exit; //если остался жив после предыдущей атаки",
                        "",
                        "    //Ищем планету для доминаторских утех с процессом спавна",
                        "    for(i=0;StarPlanets(star)>i;i=i+1) {",
                        "        if(PlanetOwner(StarPlanets(star,i)) == 6) continue;",
                        "        t_plan = StarPlanets(star,i);",
                        "        break;",
                        "    }",
                        "",
                        "    //Начинаем спавнить",
                        "    ship = BuyDomikExtremal(t_plan,1);",
                        "    ShipJoin(BlazerGroup,ship);",
                        "",
                        "    //Зачищаем командиру шмот",
                        "    if(ShipEqInSlot(ship,t_Radar)) {",
                        "        tdwd = ShipEqInSlot(ship,t_Radar);",
                        "        GetItemFromShip(ship,tdwd);",
                        "        FreeItem(tdwd);",
                        "    }",
                        "    if(ShipEqInSlot(ship,t_Engine)) {",
                        "        tdwd = ShipEqInSlot(ship,t_Engine);",
                        "        GetItemFromShip(ship,tdwd);",
                        "        FreeItem(tdwd);",
                        "    }",
                        "    if(ShipEqInSlot(ship,t_FuelTanks)) {",
                        "        tdwd = ShipEqInSlot(ship,t_FuelTanks);",
                        "        GetItemFromShip(ship,tdwd);",
                        "        FreeItem(tdwd);",
                        "    }",
                        "    if(ShipEqInSlot(ship,t_Scaner)) {",
                        "        tdwd = ShipEqInSlot(ship,t_Scaner);",
                        "        GetItemFromShip(ship,tdwd);",
                        "        FreeItem(tdwd);",
                        "    }",
                        "    if(ShipEqInSlot(ship,t_DefGenerator)) {",
                        "        tdwd = ShipEqInSlot(ship,t_DefGenerator);",
                        "        GetItemFromShip(ship,tdwd);",
                        "        FreeItem(tdwd);",
                        "    }",
                        "    if(ShipEqInSlot(ship,t_RepairRobot)) {",
                        "        tdwd = ShipEqInSlot(ship,t_RepairRobot);",
                        "        GetItemFromShip(ship,tdwd);",
                        "        FreeItem(tdwd);",
                        "    }",
                        "    if(ShipEqInSlot(ship,t_CargoHook)) {",
                        "        tdwd = ShipEqInSlot(ship,t_CargoHook);",
                        "        GetItemFromShip(ship,tdwd);",
                        "        FreeItem(tdwd);",
                        "    }",
                        "    for(i=1;ShipSlots(ship,1)>=i;i=i+1) {",
                        "        if(ShipEqInSlot(ship,t_Weapon1,i)) {",
                        "            tdwd = ShipEqInSlot(ship,t_Weapon1,i);",
                        "            GetItemFromShip(ship,tdwd);",
                        "            FreeItem(tdwd);",
                        "        }",
                        "    }",
                        "    //Теперь насовываем ему за щеку обвес",
                        "    if(ShipEqInSlot(Blazer(),t_Radar)) {",
                        "        item = ShipEqInSlot(Blazer(),t_Radar);",
                        "        tdwd = CreateEquipment(t_Radar,ItemSize(item),ItemLevel(item),Kling);",
                        "        ItemSubrace(tdwd,0);",
                        "        AddItemToShip(ship,tdwd);",
                        "        if(EqSpecial(item) >= 0) SpecialToEquipment(EqSpecial(item),tdwd);",
                        "    }",
                        "    if(ShipEqInSlot(Blazer(),t_Engine)) {",
                        "        item = ShipEqInSlot(Blazer(),t_Engine);",
                        "        tdwd = CreateEquipment(t_Engine,ItemSize(item),ItemLevel(item),Kling);",
                        "        ItemSubrace(tdwd,0);",
                        "        AddItemToShip(ship,tdwd);",
                        "        if(EqSpecial(item) >= 0) SpecialToEquipment(EqSpecial(item),tdwd);",
                        "    }",
                        "    if(ShipEqInSlot(Blazer(),t_FuelTanks)) {",
                        "        item = ShipEqInSlot(Blazer(),t_FuelTanks);",
                        "        tdwd = CreateEquipment(t_FuelTanks,ItemSize(item),ItemLevel(item),Kling);",
                        "        ItemSubrace(tdwd,0);",
                        "        AddItemToShip(ship,tdwd);",
                        "        if(EqSpecial(item) >= 0) SpecialToEquipment(EqSpecial(item),tdwd);",
                        "    }",
                        "    if(ShipEqInSlot(Blazer(),t_DefGenerator)) {",
                        "        item = ShipEqInSlot(Blazer(),t_DefGenerator);",
                        "        tdwd = CreateEquipment(t_DefGenerator,ItemSize(item),ItemLevel(item),Kling);",
                        "        ItemSubrace(tdwd,0);",
                        "        AddItemToShip(ship,tdwd);",
                        "        if(EqSpecial(item) >= 0) SpecialToEquipment(EqSpecial(item),tdwd);",
                        "    }",
                        "    if(ShipEqInSlot(Blazer(),t_RepairRobot)) {",
                        "        item = ShipEqInSlot(Blazer(),t_RepairRobot);",
                        "        tdwd = CreateEquipment(t_RepairRobot,ItemSize(item),ItemLevel(item),Kling);",
                        "        ItemSubrace(tdwd,0);",
                        "        AddItemToShip(ship,tdwd);",
                        "    }",
                        "    if(ShipEqInSlot(Blazer(),t_Scaner)) {",
                        "        item = ShipEqInSlot(Blazer(),t_Scaner);",
                        "        tdwd = CreateEquipment(t_Scaner,ItemSize(item),ItemLevel(item),Kling);",
                        "        ItemSubrace(tdwd,0);",
                        "        AddItemToShip(ship,tdwd);",
                        "        if(EqSpecial(item) >= 0) SpecialToEquipment(EqSpecial(item),tdwd);",
                        "    }",
                        "    if(ShipEqInSlot(Blazer(),t_CargoHook)) {",
                        "        item = ShipEqInSlot(Blazer(),t_CargoHook);",
                        "        tdwd = CreateEquipment(t_CargoHook,ItemSize(item),ItemLevel(item),Kling);",
                        "        ItemSubrace(tdwd,0);",
                        "        AddItemToShip(ship,tdwd);",
                        "        if(EqSpecial(item) >= 0) SpecialToEquipment(EqSpecial(item),tdwd);",
                        "    }",
                        "    for(i=0;i<ShipSlots(Blazer(),1);i=i+1) {",
                        "        item = ShipEqInSlot(Blazer(),t_Weapon1,i+1);",
                        "        if(!item) continue;",
                        "        if(ItemType(item) != t_CustomWeapon) tdwd = CreateEquipment(ItemType(item),ItemSize(item),ItemLevel(item),Kling);",
                        "        else tdwd = CreateCustomWeapon(CustomWeaponType(item),ItemSize(item),ItemLevel(item),Kling);",
                        "        ItemSubrace(tdwd,0);",
                        "        AddItemToShip(ship,tdwd);",
                        "        if(EqSpecial(item) >= 0) SpecialToEquipment(EqSpecial(item),tdwd);",
                        "    }",
                        "",
                        "    ArrangeItems(ship);",
                        "    ",
                        "    //Меняем игроку корпус",
                        "    tdwd = ShipEqInSlot(ship,t_Hull);",
                        "    ItemSize(tdwd,ItemSize(ShipEqInSlot(Blazer(),t_Hull))); //Нужно будет зависимость от выбранного типа домика шибануть",
                        "    HullHP(ship,'To100');",
                        "    Chameleon(ship,'Data.SE.Ruins.Blazer');",
                        "    SetName(ship,CT(\"Script.Mod_RefBlazerAttacks.54\"));",
                        "}",
                        "function SpawnHeavyFleet(star) {",
                        "    int cnty,i;",
                        "    dword t_plan;",
                        "",
                        "    //Тяжёлый флот состоит из трёх-четырёх эквенторов и нескольких ургантов",
                        "",
                        "    //Сколько спавним эквенторов?",
                        "    cnty = Rnd(2,4);",
                        "    if(GalaxyDiffLevels() > 200) cnty = cnty + 1;",
                        "    if(GalaxyDiffLevels() > 350) cnty = cnty + 1;",
                        "",
                        "    //Ищем планету для доминаторских утех с процессом спавна",
                        "    for(i=0;StarPlanets(star)>i;i=i+1) {",
                        "        if(PlanetOwner(StarPlanets(star,i)) == 6) continue;",
                        "        t_plan = StarPlanets(star,i);",
                        "        break;",
                        "    }",
                        "",
                        "    //Начинаем спавнить",
                        "    for(i=0;cnty>i;i=i+1){",
                        "        ShipJoin(BlazersGuysGroup,BuyDomikExtremal(t_plan,1));",
                        "    }",
                        "",
                        "    //Сколько спавним ургантов?",
                        "    cnty = Rnd(4,7);",
                        "    if(GalaxyDiffLevels() > 200) cnty = cnty + 1;",
                        "    if(GalaxyDiffLevels() > 350) cnty = cnty + 2;",
                        "",
                        "    //Начинаем спавнить",
                        "    for(i=0;cnty>i;i=i+1){",
                        "        ShipJoin(BlazersGuysGroup,BuyDomikExtremal(t_plan,2));",
                        "    }",
                        "}",
                        "function SpawnFastFleet(star) {",
                        "    int cnty,i;",
                        "    dword t_plan;",
                        "",
                        "    //Маневренный флот состоит из четырёх-девяти менков, 15+ штипов и нескольких клигов",
                        "",
                        "    //Сколько спавним менков?",
                        "    cnty = Rnd(4,9);",
                        "    if(GalaxyDiffLevels() > 200) cnty = cnty + 4;",
                        "    if(GalaxyDiffLevels() > 350) cnty = cnty + 7;",
                        "",
                        "    //Ищем планету для доминаторских утех с процессом спавна",
                        "    for(i=0;StarPlanets(star)>i;i=i+1) {",
                        "        if(PlanetOwner(StarPlanets(star,i)) == 6) continue;",
                        "        t_plan = StarPlanets(star,i);",
                        "        break;",
                        "    }",
                        "",
                        "    //Начинаем спавнить",
                        "    for(i=0;cnty>i;i=i+1){",
                        "        ShipJoin(BlazersGuysGroup,BuyDomikExtremal(t_plan,4));",
                        "    }",
                        "",
                        "    //Сколько спавним штипов?",
                        "    cnty = Rnd(15,22);",
                        "    if(GalaxyDiffLevels() > 200) cnty = cnty + 6;",
                        "    if(GalaxyDiffLevels() > 350) cnty = cnty + 10;",
                        "",
                        "    //Начинаем спавнить",
                        "    for(i=0;cnty>i;i=i+1){",
                        "        ShipJoin(BlazersGuysGroup,BuyDomikExtremal(t_plan,5));",
                        "    }",
                        "",
                        "    //Сколько спавним клигов?",
                        "    cnty = Rnd(3,7);",
                        "    if(GalaxyDiffLevels() > 200) cnty = cnty + 2;",
                        "    if(GalaxyDiffLevels() > 350) cnty = cnty + 4;",
                        "",
                        "    //Начинаем спавнить",
                        "    for(i=0;cnty>i;i=i+1){",
                        "        //Не забываем их сразу закидывать в скриптовую группу",
                        "        ShipJoin(BlazersGuysGroup,BuyDomikExtremal(t_plan,7));",
                        "    }",
                        "}",
                        "function FindStarToAttack() {",
                        "    dword tstar;",
                        "    int i;",
                        "",
                        "    for(i=0;GalaxyStars()>i;i=i+1) {",
                        "        if(StarToCon(StarNearbyStars(ShipStar(Blazer()),i)) == StarToCon(ShipStatistic(Player(),10)) && CurTurn() < 6000) continue;",
                        "        if(StarOwner(StarNearbyStars(ShipStar(Blazer()),i)) == 1 && StarSeries(StarNearbyStars(ShipStar(Blazer()),i)) == 0) continue;",
                        "        if(Rnd(1,2) == 2) tstar = StarNearbyStars(ShipStar(Blazer()),i);",
                        "        else continue;",
                        "        break;",
                        "    }",
                        "",
                        "    result = tstar;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 735,
                    "Parent": -1,
                    "#": 17,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(GroupCount(BlazerGroup)) {",
                        "  //Отправляем Блазера в группу",
                        "  //if(ShipGroup(Blazer()) != BlazerGroup) ShipJoin(BlazerGroup,Blazer());",
                        "  ",
                        "  if(AttackCD == 0 && !DomiksDefeated(1) && AttackStage == 0) {",
                        "      //Блазер живой? Значит, идём искать систему!",
                        "      if(!ShipInStar(Blazer(),ShipStar(Player())) && StarOwner(ShipStar(Blazer())) == 1 && HullDamage(Blazer()) < 30 && StarSeries(ShipStar(Blazer())) == 0 && !StarBattle(ShipStar(Blazer()))) {",
                        "          //Спавнить можно только с заселённой планеты",
                        "          CurStar = 0;",
                        "          for(i=0;StarPlanets(ShipStar(Blazer()))>i;i=i+1) { if(PlanetOwner(StarPlanets(ShipStar(Blazer()),i)) != 6) CurStar = ShipStar(Blazer()); }",
                        "          if(CurStar != 0) {",
                        "              StarForAttackID = Id(FindStarToAttack());",
                        "              AttackStage = 1;",
                        "              SpawnFastFleet(CurStar);",
                        "              SpawnHeavyFleet(CurStar);",
                        "              SpawnBlazer(CurStar);",
                        "          }",
                        "      }",
                        "  }",
                        "  if(AttackCD != 0) AttackCD = AttackCD - 1;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 160,
                    "Pos.y": 205,
                    "Parent": -1,
                    "#": 79,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(AttackStage) {",
                        "    if(ShipStar(CurShip) != GalaxyStar(StarForAttackID-1)) {",
                        "        OrderJump(CurShip,GalaxyStar(StarForAttackID-1));",
                        "    }",
                        "    else {",
                        "        if(StarOwner(ShipStar(CurShip)) != 1 && StarSeries(ShipStar(CurShip)) && !StarBattle(ShipStar(CurShip))) {",
                        "            if(HullDamage(CurShip) > 70) {",
                        "                AttackStage = 0;",
                        "                AttackCD = Rnd(400,600);",
                        "            }",
                        "            else ShipSpecialBonuses(CurShip,bonFuel,-50000);",
                        "        }",
                        "        else {",
                        "            AttackStage = 0;",
                        "            AttackCD = Rnd(180,300);",
                        "        }",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 265,
                    "Parent": -1,
                    "#": 80,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(GetShipPlanet(CurShip)) OrderTakeOff(CurShip);",
                        "else {",
                        "    if(ShipStar(CurShip) != GalaxyStar(StarForAttackID-1)) {",
                        "        OrderJump(CurShip,GalaxyStar(StarForAttackID-1));",
                        "    }",
                        "    else {",
                        "        if(StarOwner(ShipStar(CurShip)) != 1 && StarSeries(ShipStar(CurShip)) && !StarBattle(ShipStar(CurShip))) {",
                        "            ShipSpecialBonuses(CurShip,bonFuel,-1000);",
                        "        }",
                        "        else {",
                        "            ShipSpecialBonuses(CurShip,bonFuel,0);",
                        "            ShipOut(CurShip);",
                        "        }",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 425,
                    "Parent": -1,
                    "#": 81,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!HaveProgramm(progIntercom)) {",
                        "  DChange(2);",
                        "  exit;",
                        "}",
                        "if(HaveProgramm(progIntercom)) {",
                        "  TalkFlag = 0;",
                        "  ",
                        "  if(ShipInNormalSpace(Player())) {",
                        "      if(GetShipRuins(Player()) == 0) {",
                        "          if(Dist(Player(),GroupToShip(BlazerGroup)) > 500) {",
                        "              TalkFlag = 1;",
                        "          }",
                        "          if(StarOwner(ShipStar(GroupToShip(BlazerGroup))) == 1) {",
                        "              TalkFlag = 2;",
                        "          }",
                        "      }",
                        "  }",
                        "  if(!TalkFlag) {",
                        "    if(MS_Blazer_Landing) {",
                        "      DChange(3);",
                        "      exit;",
                        "    }",
                        "    if(MS_Blazer_DialogOk && MS_Blazer_Promise && !HaveProgramm(progLogicalNegation)) {",
                        "      DChange(4);",
                        "      exit;",
                        "    }",
                        "    if(!(MS_Blazer_DialogOk && MS_Blazer_Promise && !HaveProgramm(progLogicalNegation))) {",
                        "      DChange(6);",
                        "      exit;",
                        "    }",
                        "  }",
                        "  if(TalkFlag == 1) {",
                        "    DChange(1);",
                        "    exit;",
                        "  }",
                        "  if(TalkFlag == 2) {",
                        "    DChange(0);",
                        "    exit;",
                        "  }",
                        "}"
                    ]
                },
