                    "Parent": -1,
                    "#": 6,
                    "Code.Type": "Global",
                    "Code": [
                        "if(!GCntRun(GScriptName)) GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 310,
                    "Parent": -1,
                    "#": 7,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(ShipIsTakeoff(Player())) {",
                        "   fuel = ShipFuel(Player());",
                        "",
                        "    if(GetShipRuins(Player())) {",
                        "        if(fuel) {",
                        "            ShipFuel(Player(),fuel - 1);",
                        "        }",
                        "        else {",
                        "            tdwd = ShipEqInSlot(Player(),t_FuelTanks);",
                        "            if(tdwd) ItemDurability(tdwd,ItemDurability(tdwd) - Rnd(8,13));",
                        "        }",
                        "    }",
                        "    else if(GetShipPlanet(Player())) {",
                        "        if(PlanetOwner(GetShipPlanet(Player())) == None) {",
                        "            if(fuel > 2) {",
                        "                ShipFuel(Player(),fuel - 3);",
                        "            }",
                        "            else {",
                        "                tdwd = ShipEqInSlot(Player(),t_FuelTanks);",
                        "                if(tdwd) ItemDurability(tdwd,ItemDurability(tdwd) - (Rnd(7,11) * (3 - fuel)));",
                        "                tdwd = ShipEqInSlot(Player(),t_Engine);",
                        "                if(tdwd) ItemDurability(tdwd,ItemDurability(tdwd) - (Rnd(9,14) * (2 - fuel)));",
                        "            }",
                        "        }",
                        "        else {",
                        "            if(fuel > 1) {",
                        "                ShipFuel(Player(),fuel - 2);",
                        "            }",
                        "            else {",
                        "                tdwd = ShipEqInSlot(Player(),t_FuelTanks);",
                        "                if(tdwd) ItemDurability(tdwd,ItemDurability(tdwd) - (Rnd(7,11) * (2 - fuel)));",
                        "                tdwd = ShipEqInSlot(Player(),t_Engine);",
                        "                if(tdwd) ItemDurability(tdwd,ItemDurability(tdwd) - (Rnd(9,14) * (1 - fuel)));",
                        "            }",
                        "        }",
                        "    }",
                        "}"
                    ]
                }
            ],
