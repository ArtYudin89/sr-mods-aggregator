            "Items": [],
            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 600,
                    "Parent": -1,
                    "#": 20,
                    "Code.Type": "Global",
                    "Code": [
                        "if(!GCntRun(GScriptName)) GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 600,
                    "Parent": -1,
                    "#": 21,
                    "Code.Type": "Turn",
                    "Code": [
                        "//cd1..cd3 - переменные скрипта (раньше int внутри кода хода обнулялись каждый ход -> «идёт сражение» ежедневно)",
                        "if(cd1 > 0) cd1 = cd1 - 1;",
                        "if(cd2 > 0) cd2 = cd2 - 1;",
                        "if(cd3 > 0) cd3 = cd3 - 1;",
                        "//Пустые слоты (Id 0 в старых сейвах после ошибки удаления) убираются: IdToPlanet(0) -> вылет",
                        "if(FlagCount >= 3 && IDThree < 1) {",
                        "    IDThree = 0;",
                        "    temp_str3 = CT(\"Script.Mod_RefCustomSystemAlarm.18\");",
                        "    cd3 = 0;",
                        "    FlagCount = 2;",
                        "}",
                        "if(FlagCount >= 2 && IDTwo < 1) {",
                        "    IDTwo = IDThree;",
                        "    temp_str2 = temp_str3;",
                        "    cd2 = cd3;",
                        "    IDThree = 0;",
                        "    temp_str3 = CT(\"Script.Mod_RefCustomSystemAlarm.18\");",
                        "    cd3 = 0;",
                        "    FlagCount = FlagCount - 1;",
                        "}",
                        "if(FlagCount >= 1 && IDOne < 1) {",
                        "    IDOne = IDTwo;",
                        "    temp_str1 = temp_str2;",
                        "    cd1 = cd2;",
                        "    IDTwo = IDThree;",
                        "    temp_str2 = temp_str3;",
                        "    cd2 = cd3;",
                        "    IDThree = 0;",
                        "    temp_str3 = CT(\"Script.Mod_RefCustomSystemAlarm.18\");",
                        "    cd3 = 0;",
                        "    FlagCount = FlagCount - 1;",
                        "}",
                        "if(FlagCount < 2) temp_str2 = CT(\"Script.Mod_RefCustomSystemAlarm.18\");",
                        "if(FlagCount < 1) temp_str1 = CT(\"Script.Mod_RefCustomSystemAlarm.18\");",
                        "//С конца: удаление слота сдвигает только уже проверенные.",
                        "//Захват (в т.ч. пиратами) - маркер 1, как при выборе системы и проверке боя; раньше сдвиг писал №3 в №1",
                        "if(FlagCount >= 3) {",
                        "    alarm_star = PlanetToStar(IdToPlanet(IDThree));",
                        "    alarm_lev = StarEnemyThreatLevel(alarm_star,1);",
                        "    if(alarm_lev == 3) {",
                        "        CustomEther('Galaxy_Alert',0,'',Format(CT(\"Script.Mod_RefCustomSystemAlarm.2\"),\"<0>\",temp_str3));",
                        "        IDThree = 0;",
                        "        temp_str3 = CT(\"Script.Mod_RefCustomSystemAlarm.18\");",
                        "        cd3 = 0;",
                        "        FlagCount = FlagCount - 1;",
                        "    }",
                        "    else if(alarm_lev == 2 && cd3 == 0) {",
                        "        cd3 = 15;",
                        "        CustomEther('Galaxy_Alert',0,'',Format(CT(\"Script.Mod_RefCustomSystemAlarm.3\"),\"<0>\",temp_str3));",
                        "    }",
                        "}",
                        "if(FlagCount >= 2) {",
                        "    alarm_star = PlanetToStar(IdToPlanet(IDTwo));",
                        "    alarm_lev = StarEnemyThreatLevel(alarm_star,1);",
                        "    if(alarm_lev == 3) {",
                        "        CustomEther('Galaxy_Alert',0,'',Format(CT(\"Script.Mod_RefCustomSystemAlarm.2\"),\"<0>\",temp_str2));",
                        "        IDTwo = IDThree;",
                        "        temp_str2 = temp_str3;",
                        "        cd2 = cd3;",
                        "        IDThree = 0;",
                        "        temp_str3 = CT(\"Script.Mod_RefCustomSystemAlarm.18\");",
                        "        cd3 = 0;",
                        "        FlagCount = FlagCount - 1;",
                        "    }",
                        "    else if(alarm_lev == 2 && cd2 == 0) {",
                        "        cd2 = 15;",
                        "        CustomEther('Galaxy_Alert',0,'',Format(CT(\"Script.Mod_RefCustomSystemAlarm.3\"),\"<0>\",temp_str2));",
                        "    }",
                        "}",
                        "if(FlagCount >= 1) {",
                        "    alarm_star = PlanetToStar(IdToPlanet(IDOne));",
                        "    alarm_lev = StarEnemyThreatLevel(alarm_star,1);",
                        "    if(alarm_lev == 3) {",
                        "        CustomEther('Galaxy_Alert',0,'',Format(CT(\"Script.Mod_RefCustomSystemAlarm.2\"),\"<0>\",temp_str1));",
                        "        IDOne = IDTwo;",
                        "        temp_str1 = temp_str2;",
                        "        cd1 = cd2;",
                        "        IDTwo = IDThree;",
                        "        temp_str2 = temp_str3;",
                        "        cd2 = cd3;",
                        "        IDThree = 0;",
                        "        temp_str3 = CT(\"Script.Mod_RefCustomSystemAlarm.18\");",
                        "        cd3 = 0;",
                        "        FlagCount = FlagCount - 1;",
                        "    }",
                        "    else if(alarm_lev == 2 && cd1 == 0) {",
                        "        cd1 = 15;",
                        "        CustomEther('Galaxy_Alert',0,'',Format(CT(\"Script.Mod_RefCustomSystemAlarm.3\"),\"<0>\",temp_str1));",
                        "    }",
                        "}",
                        "if(FlagCount < 2) temp_str2 = CT(\"Script.Mod_RefCustomSystemAlarm.18\");",
                        "if(FlagCount < 1) temp_str1 = CT(\"Script.Mod_RefCustomSystemAlarm.18\");"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 600,
                    "Parent": -1,
                    "#": 22,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "if(PlayerBridge()==12) {",
                        "  if(FlagCount == 0) {",
                        "      temp_str_main = CT(\"Script.Mod_RefCustomSystemAlarm.24\");",
                        "  }",
                        "  if(FlagCount == 1) {",
                        "      temp_str_main = CT(\"Script.Mod_RefCustomSystemAlarm.23\")+' ' + temp_str1;",
                        "  }",
                        "  if(FlagCount == 2) {",
                        "      temp_str_main = CT(\"Script.Mod_RefCustomSystemAlarm.22\")+' ' + temp_str1 + ' '+CT(\"Script.Mod_RefCustomSystemAlarm.20\")+' ' + temp_str2;",
                        "  }",
                        "  if(FlagCount == 3) temp_str_main = CT(\"Script.Mod_RefCustomSystemAlarm.21\")+' ' + temp_str1 + ', ' + temp_str2 + ' '+CT(\"Script.Mod_RefCustomSystemAlarm.20\")+' ' + temp_str3;",
                        "  AddDialogInject('AlarmDialog',CT(\"Script.Mod_RefCustomSystemAlarm.19\")+' ' + temp_str_main,CT(\"Script.Mod_RefCustomSystemAlarm.4\"),19);",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 390,
                    "Parent": -1,
                    "#": 40,
                    "Code.Type": "Turn",
                    "Code": [
                        "DChange(0);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 160,
                    "Pos.y": 390,
                    "Parent": -1,
                    "#": 41,
                    "Code.Type": "Turn",
                    "Code": [
                        "temp_dword = GAnswerData;",
                        "temp_str_local = Name(temp_dword);",
                        "DChange(2);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 340,
                    "Pos.y": 390,
                    "Parent": -1,
                    "#": 42,
                    "Code.Type": "Turn",
                    "Code": [
                        "temp_dword = GAnswerData;",
                        "temp_str_local = Name(GAnswerData);",
                        "DChange(3);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 460,
                    "Parent": -1,
                    "#": 43,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(FlagCount >= 1) {",
                        "  DAdd(0);",
                        "}",
                        "if(FlagCount == 0) {",
                        "  DAdd(1);",
                        "}",
                        "if(FlagCount >= 2) {",
                        "  DAdd(2);",
                        "}",
                        "if(FlagCount == 1) {",
                        "  DAdd(3);",
                        "}",
                        "if(FlagCount == 3) {",
                        "  DAdd(4);",
                        "}",
                        "if(FlagCount == 2) {",
                        "  DAdd(5);",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 130,
                    "Pos.y": 460,
                    "Parent": -1,
                    "#": 44,
                    "Code.Type": "Turn",
                    "Code": [
                        "DAdd(6);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 280,
                    "Pos.y": 460,
                    "Parent": -1,
                    "#": 45,
                    "Code.Type": "Turn",
                    "Code": [
                        "for(i = 0;ConStars(temp_dword) > i;i = i + 1) {",
                        "    alarm_star = ConStar(temp_dword,i);",
                        "    if(alarm_star == ShipStatistic(Player(),10)) continue;",
                        "    if(StarEnemyThreatLevel(alarm_star,1) > 1) continue;",
                        "    //Система отслеживается по её планете: без планет нельзя (раньше Id(0) -> вылет)",
                        "    if(StarPlanets(alarm_star) < 1) continue;",
                        "    //Уже выбранные не предлагать",
                        "    if(FlagCount >= 1 && IDOne > 0) {",
                        "        if(PlanetToStar(IdToPlanet(IDOne)) == alarm_star) continue;",
                        "    }",
                        "    if(FlagCount >= 2 && IDTwo > 0) {",
                        "        if(PlanetToStar(IdToPlanet(IDTwo)) == alarm_star) continue;",
                        "    }",
                        "    InjectAnswer('DialogSystems',Name(alarm_star),alarm_star);",
                        "}",
                        "InjectAnswer('AlarmDialog',CT(\"Script.Mod_RefCustomSystemAlarm.25\"),0);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 430,
                    "Pos.y": 460,
                    "Parent": -1,
                    "#": 46,
                    "Code.Type": "Turn",
                    "Code": [
                        "InjectAnswer('AlarmDialog',CT(\"Script.Mod_RefCustomSystemAlarm.25\"),0);",
                        "DAdd(7);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 580,
                    "Pos.y": 460,
                    "Parent": -1,
                    "#": 47,
                    "Code.Type": "Turn",
                    "Code": [
                        "for(i = 0;GalaxySectors() > i;i = i + 1) {",
                        "    if(!SectorVisible(GalaxySectors(i))) continue;",
                        "    InjectAnswer('DialogSector',Name(GalaxySectors(i)),GalaxySectors(i));",
                        "}",
                        "InjectAnswer('AlarmDialog',CT(\"Script.Mod_RefCustomSystemAlarm.25\"),0);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 530,
                    "Parent": -1,
                    "#": 48,
                    "Code.Type": "Turn",
                    "Code": [
                        "//Удаление системы №1: остальные сдвигаются вверх",
                        "//(раньше при 2 системах в №1 попадал Id пустой №3 = 0 -> на следующем ходу IdToPlanet(0) -> вылет)",
                        "IDOne = IDTwo;",
                        "temp_str1 = temp_str2;",
                        "cd1 = cd2;",
                        "IDTwo = IDThree;",
                        "temp_str2 = temp_str3;",
                        "cd2 = cd3;",
                        "IDThree = 0;",
                        "temp_str3 = CT(\"Script.Mod_RefCustomSystemAlarm.18\");",
                        "cd3 = 0;",
                        "FlagCount = FlagCount - 1;",
                        "if(FlagCount < 2) temp_str2 = CT(\"Script.Mod_RefCustomSystemAlarm.18\");",
                        "if(FlagCount < 1) temp_str1 = CT(\"Script.Mod_RefCustomSystemAlarm.18\");",
                        "DChange(1);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 100,
                    "Pos.y": 530,
                    "Parent": -1,
                    "#": 49,
                    "Code.Type": "Turn",
                    "Code": [
                        "DChange(4);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 220,
                    "Pos.y": 530,
                    "Parent": -1,
                    "#": 50,
                    "Code.Type": "Turn",
                    "Code": [
                        "//Удаление системы №2: №3 сдвигается вверх",
                        "IDTwo = IDThree;",
                        "temp_str2 = temp_str3;",
                        "cd2 = cd3;",
                        "IDThree = 0;",
                        "temp_str3 = CT(\"Script.Mod_RefCustomSystemAlarm.18\");",
                        "cd3 = 0;",
                        "FlagCount = FlagCount - 1;",
                        "if(FlagCount < 2) temp_str2 = CT(\"Script.Mod_RefCustomSystemAlarm.18\");",
                        "DChange(1);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 340,
                    "Pos.y": 530,
                    "Parent": -1,
                    "#": 51,
                    "Code.Type": "Turn",
                    "Code": [
                        "DChange(4);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 460,
                    "Pos.y": 530,
                    "Parent": -1,
                    "#": 52,
                    "Code.Type": "Turn",
                    "Code": [
                        "IDThree = 0;",
                        "temp_str3 = CT(\"Script.Mod_RefCustomSystemAlarm.18\");",
                        "cd3 = 0;",
                        "FlagCount = FlagCount - 1;",
                        "DChange(1);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 580,
                    "Pos.y": 530,
                    "Parent": -1,
                    "#": 53,
                    "Code.Type": "Turn",
                    "Code": [
                        "DChange(4);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 820,
                    "Pos.y": 530,
                    "Parent": -1,
                    "#": 54,
                    "Code.Type": "Turn",
                    "Code": [
                        "//Планета №0 (раньше №1 - вторая; в системе с одной планетой получался Id 0 -> вылет)",
                        "if(FlagCount == 0) {",
                        "    IDOne = Id(StarPlanets(temp_dword,0));",
                        "}",
                        "if(FlagCount == 1) {",
                        "    IDTwo = Id(StarPlanets(temp_dword,0));",
                        "}",
                        "if(FlagCount == 2) {",
                        "    IDThree = Id(StarPlanets(temp_dword,0));",
                        "}",
                        "if(FlagCount == 0) {",
                        "    temp_str1 = temp_str_local;",
                        "}",
                        "if(FlagCount == 1) {",
                        "    temp_str2 = temp_str_local;",
                        "}",
                        "if(FlagCount == 2) {",
                        "    temp_str3 = temp_str_local;",
                        "}",
                        "FlagCount = FlagCount + 1;"
                    ]
                }
            ],
