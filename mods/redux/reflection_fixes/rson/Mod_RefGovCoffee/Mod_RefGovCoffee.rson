            "Items": [],
            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 13,
                    "Code.Type": "Global",
                    "Code": [
                        "if(!GCntRun(GScriptName)) GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 14,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(~ShipFindCustomShipInfoByType(Player(),'RefCoffeeFlag')) {",
                        "    //Что именно дал кофе, запоминается в инфошке 'Бодрость' (Data1 = раса+1, Data2 = доп. бонус родной планеты):",
                        "    //при окончании снимается ровно это, даже если флаг перезаписан другим источником кофе или сменилась раса",
                        "    if(ShipFindCustomShipInfoByType(Player(),'RefMainCoffeeInfo') == -1) ShipAddCustomShipInfo(Player(),'RefMainCoffeeInfo');",
                        "    if(ShipCustomShipInfoData(Player(),'RefCoffeeFlag',3)) {",
                        "        if(!ShipCustomShipInfoData(Player(),'RefMainCoffeeInfo',1)) {",
                        "            race = ShipPilotRace(Player());",
                        "            ShipCustomShipInfoData(Player(),'RefMainCoffeeInfo',1,race + 1);",
                        "            ShipCustomShipInfoData(Player(),'RefMainCoffeeInfo',2,ShipCustomShipInfoData(Player(),'RefCoffeeFlag',2));",
                        "            if(!race) {",
                        "                //малоки",
                        "                ShipSpecialBonuses(Player(),bonSkill3,ShipSpecialBonuses(Player(),bonSkill3) + 1);",
                        "                ShipSpecialBonuses(Player(),bonScan,ShipSpecialBonuses(Player(),bonScan) + 2);",
                        "                if(ShipCustomShipInfoData(Player(),'RefMainCoffeeInfo',2)) {",
                        "                    ShipSpecialBonuses(Player(),bonScan,ShipSpecialBonuses(Player(),bonScan) + 2);",
                        "                }",
                        "            }",
                        "            if(race == 1) {",
                        "                //пеленги",
                        "                ShipSpecialBonuses(Player(),bonSkill5,ShipSpecialBonuses(Player(),bonSkill5) + 1);",
                        "                ShipSpecialBonuses(Player(),bonDef,ShipSpecialBonuses(Player(),bonDef) + 2);",
                        "                ShipSpecialBonuses(Player(),bonDroid,ShipSpecialBonuses(Player(),bonDroid) + 3);",
                        "                ShipSpecialBonuses(Player(),bonSpeed,ShipSpecialBonuses(Player(),bonSpeed) - 25);",
                        "                if(ShipCustomShipInfoData(Player(),'RefMainCoffeeInfo',2)) {",
                        "                    ShipSpecialBonuses(Player(),bonDef,ShipSpecialBonuses(Player(),bonDef) + 1);",
                        "                    ShipSpecialBonuses(Player(),bonDroid,ShipSpecialBonuses(Player(),bonDroid) + 2);",
                        "                }",
                        "            }",
                        "            if(race == 2) {",
                        "                //люди",
                        "                ShipSpecialBonuses(Player(),bonSkill6,ShipSpecialBonuses(Player(),bonSkill6) + 2);",
                        "                ShipSpecialBonuses(Player(),bonWEnergy,ShipSpecialBonuses(Player(),bonWEnergy) + 5);",
                        "                if(ShipCustomShipInfoData(Player(),'RefMainCoffeeInfo',2)) {",
                        "                    ShipSpecialBonuses(Player(),bonWEnergy,ShipSpecialBonuses(Player(),bonWEnergy) + 3);",
                        "                }",
                        "            }",
                        "            if(race == 3) {",
                        "                //фьяни",
                        "                ShipSpecialBonuses(Player(),bonSkill1,ShipSpecialBonuses(Player(),bonSkill1) + 1);",
                        "                ShipSpecialBonuses(Player(),bonWRadius,ShipSpecialBonuses(Player(),bonWRadius) + 25);",
                        "                if(ShipCustomShipInfoData(Player(),'RefMainCoffeeInfo',2)) {",
                        "                    ShipSpecialBonuses(Player(),bonWRadius,ShipSpecialBonuses(Player(),bonWRadius) + 10);",
                        "                }",
                        "            }",
                        "            if(race == 4) {",
                        "                //гаальцы",
                        "                ShipSpecialBonuses(Player(),bonSkill4,ShipSpecialBonuses(Player(),bonSkill4) + 1);",
                        "                ShipSpecialBonuses(Player(),bonJump,ShipSpecialBonuses(Player(),bonJump) + 3);",
                        "                if(ShipCustomShipInfoData(Player(),'RefMainCoffeeInfo',2)) {",
                        "                    ShipSpecialBonuses(Player(),bonJump,ShipSpecialBonuses(Player(),bonJump) + 2);",
                        "                }",
                        "            }",
                        "        }",
                        "        ShipCustomShipInfoData(Player(),'RefCoffeeFlag',3,0);",
                        "    }",
                        "",
                        "    if(ShipCustomShipInfoData(Player(),'RefCoffeeFlag',1)) ShipCustomShipInfoData(Player(),'RefCoffeeFlag',1,ShipCustomShipInfoData(Player(),'RefCoffeeFlag',1)-1);",
                        "    else {",
                        "        //Кофе выпит до этой правки: что дано, не записано - считаем по текущей расе и флагу",
                        "        if(!ShipCustomShipInfoData(Player(),'RefMainCoffeeInfo',1)) {",
                        "            ShipCustomShipInfoData(Player(),'RefMainCoffeeInfo',1,ShipPilotRace(Player()) + 1);",
                        "            ShipCustomShipInfoData(Player(),'RefMainCoffeeInfo',2,ShipCustomShipInfoData(Player(),'RefCoffeeFlag',2));",
                        "        }",
                        "        race = ShipCustomShipInfoData(Player(),'RefMainCoffeeInfo',1) - 1;",
                        "        if(!race) {",
                        "            //малоки",
                        "            ShipSpecialBonuses(Player(),bonSkill3,ShipSpecialBonuses(Player(),bonSkill3) - 1);",
                        "            ShipSpecialBonuses(Player(),bonScan,ShipSpecialBonuses(Player(),bonScan) - 2);",
                        "            if(ShipCustomShipInfoData(Player(),'RefMainCoffeeInfo',2)) {",
                        "                ShipSpecialBonuses(Player(),bonScan,ShipSpecialBonuses(Player(),bonScan) - 2);",
                        "            }",
                        "        }",
                        "        if(race == 1) {",
                        "            //пеленги",
                        "            ShipSpecialBonuses(Player(),bonSkill5,ShipSpecialBonuses(Player(),bonSkill5) - 1);",
                        "            ShipSpecialBonuses(Player(),bonDef,ShipSpecialBonuses(Player(),bonDef) - 2);",
                        "            ShipSpecialBonuses(Player(),bonDroid,ShipSpecialBonuses(Player(),bonDroid) - 3);",
                        "            ShipSpecialBonuses(Player(),bonSpeed,ShipSpecialBonuses(Player(),bonSpeed) + 25);",
                        "            if(ShipCustomShipInfoData(Player(),'RefMainCoffeeInfo',2)) {",
                        "                ShipSpecialBonuses(Player(),bonDef,ShipSpecialBonuses(Player(),bonDef) - 1);",
                        "                ShipSpecialBonuses(Player(),bonDroid,ShipSpecialBonuses(Player(),bonDroid) - 2);",
                        "            }",
                        "        }",
                        "        if(race == 2) {",
                        "            //люди",
                        "            ShipSpecialBonuses(Player(),bonSkill6,ShipSpecialBonuses(Player(),bonSkill6) - 2);",
                        "            ShipSpecialBonuses(Player(),bonWEnergy,ShipSpecialBonuses(Player(),bonWEnergy) - 5);",
                        "            if(ShipCustomShipInfoData(Player(),'RefMainCoffeeInfo',2)) {",
                        "                ShipSpecialBonuses(Player(),bonWEnergy,ShipSpecialBonuses(Player(),bonWEnergy) - 3);",
                        "            }",
                        "        }",
                        "        if(race == 3) {",
                        "            //фьяни",
                        "            ShipSpecialBonuses(Player(),bonSkill1,ShipSpecialBonuses(Player(),bonSkill1) - 1);",
                        "            ShipSpecialBonuses(Player(),bonWRadius,ShipSpecialBonuses(Player(),bonWRadius) - 25);",
                        "            if(ShipCustomShipInfoData(Player(),'RefMainCoffeeInfo',2)) {",
                        "                ShipSpecialBonuses(Player(),bonWRadius,ShipSpecialBonuses(Player(),bonWRadius) - 10);",
                        "            }",
                        "        }",
                        "        if(race == 4) {",
                        "            //гаальцы",
                        "            ShipSpecialBonuses(Player(),bonSkill4,ShipSpecialBonuses(Player(),bonSkill4) - 1);",
                        "            ShipSpecialBonuses(Player(),bonJump,ShipSpecialBonuses(Player(),bonJump) - 3);",
                        "            if(ShipCustomShipInfoData(Player(),'RefMainCoffeeInfo',2)) {",
                        "                ShipSpecialBonuses(Player(),bonJump,ShipSpecialBonuses(Player(),bonJump) - 2);",
                        "            }",
                        "        }",
                        "        ShipDeleteCustomShipInfo(Player(),'RefCoffeeFlag');",
                        "        ShipDeleteCustomShipInfo(Player(),'RefMainCoffeeInfo');",
                        "        NewsAdd(CT(\"Script.Mod_RefGovCoffee.30\"));",
                        "    }",
                        "}",
                        "//Обнуляем напитые кружки",
                        "if(ShipIsTakeoff(Player())) {",
                        "    CoffeeForMania = 0;",
                        "}",
                        "//Стадия кофезависимости (Data1 инфошки, 1..5; штрафы вешает её OnActCode) растёт с ManiaCount: >400 - 1, далее каждые 100 - +1",
                        "if(ShipFindCustomShipInfoByType(Player(),'RefCoffeeIllness') != -1) {",
                        "    if(ShipCustomShipInfoData(Player(),'RefCoffeeIllness',1) < 1) ShipCustomShipInfoData(Player(),'RefCoffeeIllness',1,1);",
                        "    if(ManiaCount > 500 && ShipCustomShipInfoData(Player(),'RefCoffeeIllness',1) < 2) ShipCustomShipInfoData(Player(),'RefCoffeeIllness',1,2);",
                        "    if(ManiaCount > 600 && ShipCustomShipInfoData(Player(),'RefCoffeeIllness',1) < 3) ShipCustomShipInfoData(Player(),'RefCoffeeIllness',1,3);",
                        "    if(ManiaCount > 700 && ShipCustomShipInfoData(Player(),'RefCoffeeIllness',1) < 4) ShipCustomShipInfoData(Player(),'RefCoffeeIllness',1,4);",
                        "    if(ManiaCount > 800 && ShipCustomShipInfoData(Player(),'RefCoffeeIllness',1) < 5) ShipCustomShipInfoData(Player(),'RefCoffeeIllness',1,5);",
                        "}",
                        "//Кофезависимость момент",
                        "if(ShipFindCustomShipInfoByType(Player(),'RefMainCoffeeInfo') == -1) {",
                        "    if(ManiaCount > 400 && ShipFindCustomShipInfoByType(Player(),'RefCoffeeIllness') == -1) {",
                        "        ShipAddCustomShipInfo(Player(),'RefCoffeeIllness');",
                        "    }",
                        "    if(ShipFindCustomShipInfoByType(Player(),'RefCoffeeIllness') != -1 && ManiaCount == 0) {",
                        "        if(ShipCustomShipInfoData(Player(),'RefCoffeeIllness',2) >= 1) {",
                        "            ShipSpecialBonuses(Player(),bonSkill1,ShipSpecialBonuses(Player(),bonSkill1) + 1);",
                        "            ShipSpecialBonuses(Player(),bonSkill2,ShipSpecialBonuses(Player(),bonSkill2) + 1);",
                        "            ShipSpecialBonuses(Player(),bonSkill6,ShipSpecialBonuses(Player(),bonSkill6) + 1);",
                        "            ShipSpecialBonuses(Player(),bonWRadius,ShipSpecialBonuses(Player(),bonWRadius) + 15);",
                        "            ShipSpecialBonuses(Player(),bonHookRadius,ShipSpecialBonuses(Player(),bonHookRadius) + 30);",
                        "        }",
                        "        if(ShipCustomShipInfoData(Player(),'RefCoffeeIllness',2) >= 2) {",
                        "            ShipSpecialBonuses(Player(),bonSkill1,ShipSpecialBonuses(Player(),bonSkill1) + 1);",
                        "            ShipSpecialBonuses(Player(),bonSkill2,ShipSpecialBonuses(Player(),bonSkill2) + 1);",
                        "            ShipSpecialBonuses(Player(),bonSkill3,ShipSpecialBonuses(Player(),bonSkill3) + 1);",
                        "            ShipSpecialBonuses(Player(),bonSkill5,ShipSpecialBonuses(Player(),bonSkill5) + 1);",
                        "            ShipSpecialBonuses(Player(),bonSkill6,ShipSpecialBonuses(Player(),bonSkill6) + 1);",
                        "            ShipSpecialBonuses(Player(),bonWRadius,ShipSpecialBonuses(Player(),bonWRadius) + 15);",
                        "            ShipSpecialBonuses(Player(),bonHookRadius,ShipSpecialBonuses(Player(),bonHookRadius) + 20);",
                        "            ShipSpecialBonuses(Player(),bonSpeed,ShipSpecialBonuses(Player(),bonSpeed) + 75);",
                        "            ShipSpecialBonuses(Player(),bonZonds,ShipSpecialBonuses(Player(),bonZonds) + 1);",
                        "        }",
                        "        if(ShipCustomShipInfoData(Player(),'RefCoffeeIllness',2) >= 3) {",
                        "            ShipSpecialBonuses(Player(),bonSkill1,ShipSpecialBonuses(Player(),bonSkill1) + 1);",
                        "            ShipSpecialBonuses(Player(),bonSkill3,ShipSpecialBonuses(Player(),bonSkill3) + 1);",
                        "            ShipSpecialBonuses(Player(),bonSkill4,ShipSpecialBonuses(Player(),bonSkill4) + 1);",
                        "            ShipSpecialBonuses(Player(),bonSkill5,ShipSpecialBonuses(Player(),bonSkill5) + 1);",
                        "            ShipSpecialBonuses(Player(),bonSkill6,ShipSpecialBonuses(Player(),bonSkill6) + 1);",
                        "            ShipSpecialBonuses(Player(),bonWRadius,ShipSpecialBonuses(Player(),bonWRadius) + 15);",
                        "            ShipSpecialBonuses(Player(),bonHookRadius,ShipSpecialBonuses(Player(),bonHookRadius) + 20);",
                        "            ShipSpecialBonuses(Player(),bonSpeed,ShipSpecialBonuses(Player(),bonSpeed) + 75);",
                        "            ShipSpecialBonuses(Player(),bonZonds,ShipSpecialBonuses(Player(),bonZonds) + 1);",
                        "            ShipSpecialBonuses(Player(),bonWEnergy,ShipSpecialBonuses(Player(),bonWEnergy) + 5);",
                        "            ShipSpecialBonuses(Player(),bonWSplinter,ShipSpecialBonuses(Player(),bonWSplinter) + 5);",
                        "        }",
                        "        if(ShipCustomShipInfoData(Player(),'RefCoffeeIllness',2) >= 4) {",
                        "            ShipSpecialBonuses(Player(),bonSkill1,ShipSpecialBonuses(Player(),bonSkill1) + 1);",
                        "            ShipSpecialBonuses(Player(),bonSkill3,ShipSpecialBonuses(Player(),bonSkill3) + 1);",
                        "            ShipSpecialBonuses(Player(),bonSkill4,ShipSpecialBonuses(Player(),bonSkill4) + 1);",
                        "            ShipSpecialBonuses(Player(),bonSkill5,ShipSpecialBonuses(Player(),bonSkill5) + 1);",
                        "            ShipSpecialBonuses(Player(),bonSkill6,ShipSpecialBonuses(Player(),bonSkill6) + 1);",
                        "            ShipSpecialBonuses(Player(),bonWRadius,ShipSpecialBonuses(Player(),bonWRadius) + 15);",
                        "            ShipSpecialBonuses(Player(),bonHookRadius,ShipSpecialBonuses(Player(),bonHookRadius) + 20);",
                        "            ShipSpecialBonuses(Player(),bonSpeed,ShipSpecialBonuses(Player(),bonSpeed) + 75);",
                        "            ShipSpecialBonuses(Player(),bonZonds,ShipSpecialBonuses(Player(),bonZonds) + 1);",
                        "            ShipSpecialBonuses(Player(),bonWEnergy,ShipSpecialBonuses(Player(),bonWEnergy) + 5);",
                        "            ShipSpecialBonuses(Player(),bonWSplinter,ShipSpecialBonuses(Player(),bonWSplinter) + 5);",
                        "            ShipSpecialBonuses(Player(),bonHook,ShipSpecialBonuses(Player(),bonHook) + 25);",
                        "            ShipSpecialBonuses(Player(),bonSkill2,ShipSpecialBonuses(Player(),bonSkill2) + 1);",
                        "        }",
                        "        if(ShipCustomShipInfoData(Player(),'RefCoffeeIllness',2) >= 5) {",
                        "            ShipSpecialBonuses(Player(),bonSkill1,ShipSpecialBonuses(Player(),bonSkill1) + 1);",
                        "            ShipSpecialBonuses(Player(),bonSkill3,ShipSpecialBonuses(Player(),bonSkill3) + 1);",
                        "            ShipSpecialBonuses(Player(),bonSkill4,ShipSpecialBonuses(Player(),bonSkill4) + 1);",
                        "            ShipSpecialBonuses(Player(),bonSkill5,ShipSpecialBonuses(Player(),bonSkill5) + 1);",
                        "            ShipSpecialBonuses(Player(),bonSkill6,ShipSpecialBonuses(Player(),bonSkill6) + 1);",
                        "            ShipSpecialBonuses(Player(),bonWRadius,ShipSpecialBonuses(Player(),bonWRadius) + 15);",
                        "            ShipSpecialBonuses(Player(),bonHookRadius,ShipSpecialBonuses(Player(),bonHookRadius) + 20);",
                        "            ShipSpecialBonuses(Player(),bonSpeed,ShipSpecialBonuses(Player(),bonSpeed) + 75);",
                        "            ShipSpecialBonuses(Player(),bonZonds,ShipSpecialBonuses(Player(),bonZonds) + 1);",
                        "            ShipSpecialBonuses(Player(),bonWEnergy,ShipSpecialBonuses(Player(),bonWEnergy) + 5);",
                        "            ShipSpecialBonuses(Player(),bonWSplinter,ShipSpecialBonuses(Player(),bonWSplinter) + 5);",
                        "            ShipSpecialBonuses(Player(),bonHook,ShipSpecialBonuses(Player(),bonHook) + 25);",
                        "            ShipSpecialBonuses(Player(),bonSkill2,ShipSpecialBonuses(Player(),bonSkill2) + 1);",
                        "        }",
                        "        ShipDeleteCustomShipInfo(Player(),'RefCoffeeIllness');",
                        "        CustomEther('BioCured',0,'',CT(\"Script.Mod_RefGovCoffee.29\"));",
                        "    }",
                        "    if(ManiaCount != 0) ManiaCount = ManiaCount - 1;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 15,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "if(GetTalkShip() == 0) {",
                        "    if(GetShipRuins(Player()) == 0) {",
                        "        if(PlanetOwner(GetShipPlanet(Player())) < 5 || PlanetOwner(GetShipPlanet(Player())) == 7) {",
                        "            if(GetRelationPlanet(GetShipPlanet(Player()),Player()) > 50) {",
                        "                if(ShipMoney(Player()) >= 125) {",
