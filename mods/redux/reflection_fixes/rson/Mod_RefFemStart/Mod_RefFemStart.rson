            "Items": [],
            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 7,
                    "Code.Type": "Global",
                    "Code": [
                        "GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 8,
                    "Code.Type": "Init",
                    "Code": [
                        "if(ShipPilotRace(Player()) == People) {",
                        "    ShipAddCustomShipInfo(Player(),'RefFemStart','NoShow');",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 9,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "if(GetShipRuins(Player())) {",
                        "    if(ShipType(GetShipRuins(Player())) == 'TC') {",
                        "        if(ItemExtraSpecialsCountByType(ShipEqInSlot(Player(),t_Hull),FindBonusByNameInCfg('RefFemStart_Crutch')) || ItemExtraSpecialsCountByType(ShipEqInSlot(Player(),t_Hull),0)) { //0 - метка из старых сохранений (строка вместо номера бонуса)",
                        "            AddDialogInject('DialogNew','',CT(\"Script.Mod_RefFemStart.0\"),20);",
                        "        }",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 365,
                    "Parent": -1,
                    "#": 18,
                    "Code.Type": "Turn",
                    "Code": [
                        "//Раньше: 4 висячих if подряд делали ветку 480 недостижимой, tint не сбрасывался",
                        "tint = 0;",
                        "if(BonusNumInCfg(HullSpecial(Player())) == '480' && GalaxyTechLevel() >= 2) tint = 1;",
                        "if(BonusNumInCfg(HullSpecial(Player())) == '481' && GalaxyTechLevel() >= 4) tint = 1;",
                        "if(BonusNumInCfg(HullSpecial(Player())) == '482' && GalaxyTechLevel() >= 6) tint = 1;",
                        "if(BonusNumInCfg(HullSpecial(Player())) == '483' && GalaxyTechLevel() >= 8) tint = 1;",
                        "",
                        "money = GalaxyMoney(3,4);",
                        "",
                        "if(tint == 0) tstr = CT(\"Script.Mod_RefFemStart.2\");",
                        "else tstr = CT(\"Script.Mod_RefFemStart.8\")+' '+money+' cr.';",
                        "DChange(0);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 19,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(tint) {",
                        "  if(money <= ShipMoney(Player())) {",
                        "    DAdd(2);",
                        "  }",
                        "  if(money > ShipMoney(Player())) {",
                        "    DAdd(1);",
                        "  }",
                        "}",
                        "DAdd(0);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 130,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 20,
                    "Code.Type": "Turn",
                    "Code": [
                        "DAdd(3);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 220,
                    "Pos.y": 505,
                    "Parent": -1,
                    "#": 21,
                    "Code.Type": "Turn",
                    "Code": [
                        "ShipMoney(Player(),ShipMoney(Player())-money);",
                        "Sound('Sound.Buy');",
                        "",
                        "if(BonusNumInCfg(HullSpecial(Player())) == '480') { //на один уровень за покупку (раньше каскадом до 489)",
                        "    HullSpecial(Player(),-1);",
                        "    HullSpecial(Player(),FindBonusByNameInCfg('481'));",
                        "}",
                        "else if(BonusNumInCfg(HullSpecial(Player())) == '481') {",
                        "    HullSpecial(Player(),-1);",
                        "    HullSpecial(Player(),FindBonusByNameInCfg('482'));",
                        "}",
                        "else if(BonusNumInCfg(HullSpecial(Player())) == '482') {",
                        "    HullSpecial(Player(),-1);",
                        "    HullSpecial(Player(),FindBonusByNameInCfg('483'));",
                        "}",
                        "else if(BonusNumInCfg(HullSpecial(Player())) == '483') {",
                        "    HullSpecial(Player(),-1);",
                        "    HullSpecial(Player(),FindBonusByNameInCfg('489'));",
                        "}",
                        "Chameleon(Player());",
                        "DChange(1);",
                        "exit;"
                    ]
                }
            ],
