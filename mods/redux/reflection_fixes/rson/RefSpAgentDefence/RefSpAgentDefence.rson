                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 980,
                    "Parent": -1,
                    "#": 57,
                    "Code.Type": "Global",
                    "Code": [
                        "//нужно чтоб скрипт случайно не повторял себя после завершения",
                        "if(!GCntRun(GScriptName)) GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 980,
                    "Parent": -1,
                    "#": 58,
                    "Code.Type": "Init",
                    "Code": [
                        "nextattack = CurTurn()+Rnd(10,30);",
                        "InitVars();",
                        "updater=CT('Update.StatsVersion');",
                        "function InitVars(){",
                        "    ArrayClear(fem_name);",
                        "    for(i = 1;i <= CT('Script.RefSpAgentDefence.NamesSpAgent.Count');i = i + 1){",
                        "        ArrayAdd(fem_name,CT('Script.RefSpAgentDefence.NamesSpAgent.'+i));",
                        "    }",
                        "    for(i = 1;i <= CT('Script.RefSpAgentDefence.SkillsDiv.Count');i = i + 1){",
                        "        UpdateSkillDivp(CT('Script.RefSpAgentDefence.SkillsDiv.'+i));",
                        "    }",
                        "    for(i = 1;i <= CT('Script.RefSpAgentDefence.SkillsWarr.Count');i = i + 1){",
                        "        UpdateSkillWarr(CT('Script.RefSpAgentDefence.SkillsWarr.'+i));",
                        "    }",
                        "}",
                        "function UpdateSkillDivp(str skill){",
                        "    if(ArrayFind(skilldivpc,skill) == -1){",
                        "        ArrayAdd(skilldivp,0,skill);",
                        "        ArrayAdd(skilldivpc,skill);",
                        "    }",
                        "}",
                        "",
                        "function UpdateSkillWarr(str skill){",
                        "    if(ArrayFind(skillwarrc,skill)== -1){",
                        "        ArrayAdd(skillwarr,0,skill);",
                        "        ArrayAdd(skillwarrc,skill);",
                        "    }",
                        "}",
                        "",
                        "function SpawnWarrior(dword planet){",
                        "    dword ship = BuyWarrior(planet,2000);",
                        "    if(skillwarr['BonHull']){",
                        "        ItemSize(ShipItems(ship,0),Rnd(400,800)+max(3,GalaxyTechLevel())*10);",
                        "    }",
                        "    else {",
                        "        ItemSize(ShipItems(ship,0),Rnd(700,1200)+max(3,GalaxyTechLevel())*20);",
                        "    }",
                        "",
                        "    //Назначаем также и хп",
                        "    HullHP(ship,ItemSize(ShipItems(ship,0)));",
                        "    ShipType(ship,'Swat');",
                        "    hullstat=ShipItems(ship,0);",
                        "    //Делаем корпус",
                        "    if(GetEquipmentStats(hullstat,5)<1)ShipSpecialBonuses(ship,bonSlotDroid,1);",
                        "    if(GetEquipmentStats(hullstat,7)<1)ShipSpecialBonuses(ship,bonSlotDef,1);",
                        "    ShipSpecialBonuses(ship,bonSlotWeapon,5);",
                        "    ShipSpecialBonuses(ship,bonSlotArt,4);",
                        "    if(skillwarr['Speed']){",
                        "        ShipSpecialBonuses(ship,bonSpeed,400);",
                        "        ShipSpecialBonuses(ship,bonDef,-2);",
                        "        ShipSpecialBonuses(ship,bonDroid,-3);",
                        "    }",
                        "    else {",
                        "        ShipSpecialBonuses(ship,bonSpeed,100);",
                        "    }",
                        "    if(skillwarr['BonSpHull']){",
                        "        int hullbonus = FindBonusByCustomTag('SpAgentHull');",
                        "        SpecialToEquipment(hullbonus, hullstat);",
                        "    }",
                        "    if(skillwarr['BufAttack']){",
                        "        ShipSpecialBonuses(ship,bonWEnergy,15);",
                        "        ShipSpecialBonuses(ship,bonWSplinter,15);",
                        "        ShipSpecialBonuses(ship,bonWMissile,15);",
                        "        ShipSpecialBonuses(ship,bonWRadius,50);",
                        "        dword equip;",
                        "        int rnd;",
                        "        //Оснащаем артами",
                        "        if(Rnd(1,5)>2){",
                        "            rnd = Rnd(1,4);",
                        "            if(rnd == 1){",
                        "                equip=CreateArt(t_ArtefactHull,ShipOwner(ship));",
                        "            }",
                        "            else if(rnd == 2){",
                        "                equip=CreateArt(t_ArtEnergyPulse,ShipOwner(ship));",
                        "            }",
                        "            else if(rnd == 3){",
                        "                equip=CreateArt(t_ArtefactNano,ShipOwner(ship));",
                        "            }",
                        "            else {",
                        "                equip=CreateArt(t_ArtSplinter,ShipOwner(ship));",
                        "            }",
                        "        }",
                        "        AddItemToShip(ship,equip);",
                        "        ItemIsInUse(equip,ship,1);",
                        "    }",
                        "    Chameleon(ship);",
                        "    //Вешаем навыки",
                        "    ShipSkill(ship,0,5);",
                        "    ShipSkill(ship,1,5);",
                        "    ShipSkill(ship,2,Rnd(3,6));",
                        "    //Заставляем закупится корабль",
                        "    for(i=0;i<4;i = i +1) {",
                        "        ShipRefit(ship);",
                        "    }",
                        "    ShipJoin(WarriorsR,ship);",
                        "}",
                        "function SpawnAgent(dword planet) {",
                        "    planetRace = PlanetRace(planet);",
                        "    PlanetRace(planet,2);",
                        "    dword ship = BuyRanger(planet,2000);",
                        "    PlanetRace(planet,planetRace);",
                        "    hullstat=ShipItems(ship,0);",
                        "    ItemSize(ShipItems(ship,0),Rnd(250,750));",
                        "    HullHP(ship,ItemSize(ShipItems(ship,0)));",
                        "    Chameleon(ship,'Ship.AkrinFemale.J');",
                        "    if(GetEquipmentStats(hullstat,5)<1)ShipSpecialBonuses(ship,bonSlotDroid,1);",
                        "    if(GetEquipmentStats(hullstat,7)<1)ShipSpecialBonuses(ship,bonSlotDef,1);",
                        "    ShipSpecialBonuses(ship,bonSlotWeapon,5);",
                        "    ShipSpecialBonuses(ship,bonSlotArt,4);",
                        "    str name = fem_name[Rnd(1,ArrayDim(fem_name)-1)];",
                        "    SetName(ship,name);",
                        "    ShipType(ship,'FemRanger');",
                        "    NoScanToShip(ship,1);",
                        "    NoTalkToShip(ship,1);",
                        "    ShipFace(ship,Rnd(25,32));",
                        "    ShipSkill(ship,0,4);",
                        "    ShipSkill(ship,1,4);",
                        "    ShipSkill(ship,2,Rnd(3,6));",
                        "    for(i=0;i<5;i = i +1) {",
                        "        ShipRefit(ship);",
                        "    }",
                        "    ShipJoin(Agent,ship);",
                        "}",
                        "function SpawnPirate(dword planet) {",
                        "    planetRace = PlanetRace(planet);",
                        "    PlanetRace(planet,Rnd(0,4));",
                        "    dword ship = BuyPirate(planet,2000);",
                        "    ShipJoinsClan(ship);",
                        "    ShipType(ship,'Diversion');",
                        "    PlanetRace(planet,planetRace);",
                        "    hullstat=ShipItems(ship,0);",
                        "    if(skilldivp['BonHp']){",
                        "        ItemSize(ShipItems(ship,0),Rnd(700,1300)+max(3,GalaxyTechLevel())*10);",
                        "    } else {",
                        "        ItemSize(ShipItems(ship,0),Rnd(400,800)+max(3,GalaxyTechLevel())*5);",
                        "    }",
                        "    if(skilldivp['PremiumHull']){",
                        "        int rndb = Rnd(1,3);",
                        "        int hullbonus = FindBonusByCustomTag('Diversant'+rndb);",
                        "        SpecialToEquipment(hullbonus, hullstat);",
                        "    }",
                        "    Chameleon(ship);",
                        "    HullHP(ship,ItemSize(ShipItems(ship,0)));",
                        "    if(GetEquipmentStats(hullstat,5)<1)ShipSpecialBonuses(ship,bonSlotDroid,1);",
                        "    if(GetEquipmentStats(hullstat,7)<1)ShipSpecialBonuses(ship,bonSlotDef,1);",
                        "    ShipSpecialBonuses(ship,bonSlotWeapon,5);",
                        "    ShipSpecialBonuses(ship,bonSlotArt,4);",
                        "    if(skilldivp['BufAttack']){",
                        "        ShipSpecialBonuses(ship,bonWEnergy,10);",
                        "        ShipSpecialBonuses(ship,bonWSplinter,10);",
                        "        ShipSpecialBonuses(ship,bonWMissile,10);",
                        "        ShipSpecialBonuses(ship,bonWRadius,100);",
                        "        dword equip;",
                        "        int rnd;",
                        "        //Оснащаем артами",
                        "        if(Rnd(1,5)>3){",
                        "            rnd = Rnd(1,3);",
                        "            if(rnd == 1){",
                        "                equip=CreateArt(t_ArtPDTurret,ShipOwner(ship));",
                        "            }",
                        "            else if(rnd == 2){",
                        "                equip=CreateArt(t_ArtEnergyPulse,ShipOwner(ship));",
                        "            }",
                        "            else {",
                        "                equip=CreateArt(t_ArtSplinter,ShipOwner(ship));",
                        "            }",
                        "        }",
                        "        ItemOwner(equip,7);",
                        "        AddItemToShip(ship,equip);",
                        "        ItemIsInUse(equip,ship,1);",
                        "    }",
                        "    if(ShipInPirateClan(Player())){",
                        "        if(GetShipPirateRank(Player())>=3){",
                        "            RelationToRanger(ship,Player(),Rnd(35,90));",
                        "        }",
                        "        else {",
                        "            RelationToRanger(ship,Player(),Rnd(25,70));",
                        "        }",
                        "    }",
                        "    else {",
                        "        RelationToRanger(ship,Player(),Rnd(1,15));",
                        "    }",
                        "    ShipSkill(ship,0,4);",
                        "    ShipSkill(ship,1,4);",
                        "    ShipSkill(ship,2,Rnd(3,6));",
                        "    if(skilldivp['GlobalBuf']){",
                        "        for(i=0;i<6;i = i +1) {",
                        "            ShipRefit(ship);",
                        "        }",
                        "    }",
                        "    else {",
                        "        for(i=0;i<4;i = i +1) {",
                        "            ShipRefit(ship);",
                        "        }",
                        "    }",
                        "    if(skilldivp['Def']){",
                        "        ShipSpecialBonuses(ship,bonDef,5);",
                        "    }",
                        "    if(diversion==0){",
                        "        TransferShip(ship,GroupShip(PB,0));",
                        "    }",
                        "",
                        "",
                        "    ShipJoin(Pirates,ship);",
                        "}",
                        "function ClearTstr() {",
                        "    tstr1='';",
                        "    tstr2='';",
                        "    tstr3='';",
                        "    tstr4='';",
                        "    ArrayClear(skillprl);",
                        "}",
                        "function RandomPBGalaxy() {",
                        "    dword CurSystem;",
                        "    ArrayClear(systems);",
                        "    for(i=0; i<GalaxyStars(); i=i+1) {",
                        "      curSystem=GalaxyStar(i);",
                        "      //Проверяем не пиратская ли система",
                        "        if(StarOwner(curSystem) != 2) {",
                        "            if(!StarBattle(curSystem)){",
                        "                if(StarRuins(curSystem,'PB')) {",
                        "                    //Записываем в массив систему",
                        "                    ArrayAdd(systems, Id(curSystem));",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "    tint = ArrayDim(systems);",
                        "    //Во избежание возможных ошибок после очисток массивов обращаюсь к массиву систем от первого индекса массива",
                        "    if(tint >1){",
                        "        system = systems[Rnd(1,tint-1,CurTurn())];",
                        "    }",
                        "    else {",
                        "        system = 0;",
                        "    }",
                        "    ArrayClear(systems);",
                        "}",
                        "function RandomGalaxy(int domikstat) {",
                        "    dword CurSystem;",
                        "    ArrayClear(systems);",
                        "    for(i=0; i<GalaxyStars(); i=i+1) {",
                        "      curSystem=GalaxyStar(i);",
                        "      //Проверяем не пиратская ли система",
                        "      if(StarOwner(curSystem) != 2) {",
                        "          if(skilldivp['DomDiv'] == 1 && domikstat == 1){",
                        "              if(!StarBattle(curSystem)){",
                        "                  //Записываем в массив систему",
                        "                  ArrayAdd(systems, Id(curSystem));",
                        "              }",
                        "          } else {",
                        "              if(StarOwner(curSystem) == 0) {",
                        "                  ArrayAdd(systems, Id(curSystem));",
                        "              }",
                        "          }",
                        "",
                        "      }",
                        "    }",
                        "    tint = ArrayDim(systems);",
                        "    //Во избежание возможных ошибок после очисток массивов обращаюсь к массиву систем от первого индекса массива",
                        "    if(tint >1){",
                        "        system = systems[Rnd(1,tint-1,CurTurn())];",
                        "    }",
                        "    else {",
                        "        system = 0;",
                        "    }",
                        "",
                        "    ArrayClear(systems);",
                        "}",
                        "function StartDiversionNoPB(){",
                        "    if(statebatt == 0){",
                        "        RandomGalaxy(0);",
                        "        if(system!=0){",
                        "            statebatt = 1;",
                        "            planet = Id(FindPlanet(GalaxyStar(system-1),'NotNone',0,100));",
                        "            if(Rnd(1,10,CurTurn()) > 3 + tint3){",
                        "                diversion = 1;",
                        "                for(j=0;j < 2+GalaxyTechLevel()+Rnd(1,3,CurTurn())+skilldivp['BonMinusSwat']+skilldivp['GlobalBuf'];j = j + 1){",
                        "                    SpawnPirate(IdToPlanet(planet));",
                        "                }",
                        "                for(j=0;j < 1+GalaxyTechLevel();j = j + 1){",
                        "                    SpawnWarrior(IdToPlanet(planet));",
                        "                }",
                        "            }",
                        "            else {",
                        "                statebatt==0;",
                        "            }",
                        "        }",
                        "        else {",
                        "            statebatt = 0;",
                        "        }",
                        "    }",
                        "}",
                        "function StartDiversionPB(){",
                        "    if(statebatt == 0){",
                        "        RandomPBGalaxy();",
                        "        if(system!=0){",
                        "            statebatt = 1;",
                        "            planet = Id(FindPlanet(GalaxyStar(system-1),'NotNone',0,100));",
                        "            //Рандомайзер который определит сможет ли Коалиция заподозрить подготовку диверсии",
                        "",
                        "            if(Rnd(1,10) > 3 + tint3){",
                        "                diversion = 2;",
                        "                for(j=0;j < 2+GalaxyTechLevel()+Rnd(1,3,CurTurn())+skilldivp['BonMinusSwat']+skilldivp['GlobalBuf'];j = j + 1){",
                        "                    SpawnPirate(IdToPlanet(planet));",
                        "                }",
                        "            }",
                        "            else {",
                        "                ShipJoin(PB,StarRuins(GalaxyStar(system-1),'PB'));",
                        "                diversion=0;",
                        "                SpawnAgent(IdToPlanet(planet));",
                        "                turnr= CurTurn()+30;",
                        "            }",
                        "        }",
                        "        else {",
                        "            statebatt = 0;",
                        "        }",
                        "    }",
                        "}",
                        "function StartDisversion (){",
                        "    if(statebatt == 0){",
                        "        RandomGalaxy(1);",
                        "        if(system!=0){",
                        "            statebatt = 1;",
                        "            diversion = 2;",
                        "            planet = Id(FindPlanet(GalaxyStar(system-1),'NotNone',0,100));",
                        "",
                        "            for(j=0;j < 2+GalaxyTechLevel()+Rnd(1,3,CurTurn())+skilldivp['BonMinusSwat']+skilldivp['GlobalBuf'];j = j + 1){",
                        "                SpawnPirate(IdToPlanet(planet));",
                        "            }",
                        "        }",
                        "        else {",
                        "            statebatt = 0;",
                        "        }",
                        "    }",
                        "}",
                        "function StartCustomDisversion (){",
                        "    if(statebatt == 0){",
                        "        if(CurTurn()>=currucn){",
                        "            if(sys){",
                        "                if(StarOwner(GalaxyStar(sys-1))!= 2){",
                        "                    CustomEther('Div', 0, '',Format(CT('Script.RefSpAgentDefence.TextMsg.Diversion'),'<systemname'+'>',Name(GalaxyStar(sys-1))));",
                        "                    planet = Id(FindPlanet(GalaxyStar(sys-1),'NotNone',0,100));",
                        "                    statebatt=1;",
                        "                    if(Rnd(1,10,CurTurn())>5){",
                        "                        diversion = 4;",
                        "                        for(j=0;j < shipcou;j = j + 1){",
                        "                            SpawnPirate(IdToPlanet(planet));",
                        "                        }",
                        "                    }",
                        "                    else {",
                        "                        if(StarOwner(GalaxyStar(sys-1))!= 1){",
                        "                            diversion = 3;",
                        "                            for(j=0;j < shipcou;j = j + 1){",
                        "                                SpawnPirate(IdToPlanet(planet));",
                        "                            }",
                        "                            for(j=0;j < 1+GalaxyTechLevel();j = j + 1){",
                        "                                SpawnWarrior(IdToPlanet(planet));",
                        "                            }",
                        "                        }",
                        "                        else {",
                        "                            diversion = 4;",
                        "                            for(j=0;j < shipcou;j = j + 1){",
                        "                                SpawnPirate(IdToPlanet(planet));",
                        "                            }",
                        "                        }",
                        "                    }",
                        "                }",
                        "                else {",
                        "                    statebatt = 0;",
                        "                }",
                        "            }",
                        "            else {",
                        "                statebatt = 0;",
                        "            }",
                        "        }",
                        "    }",
                        "}",
                        "function SysName(dword sys){",
                        "    if(sys==222){",
                        "        result = CT(\"Script.RefSpAgentDefence.123\");",
                        "    }",
                        "    else {",
                        "        result = Name(GalaxyStar(sys-1));",
                        "    }",
                        "}",
                        "function RestartTimer(){",
                        "    nextattack = CurTurn()+Rnd(120,250,CurTurn());",
                        "    statebatt = 0;",
                        "    statekill=0;",
                        "    newsst=0;",
                        "    pirateleave=0;",
                        "    turnr=0;",
                        "    couleavers=0;",
                        "    coustan=0;",
                        "}",
                        "function RestartTimerCustom(){",
                        "    nextattack = CurTurn()+Rnd(120,250,CurTurn());",
                        "    statebatt = 0;",
                        "    currucn=CurTurn()+180;",
                        "    rucnickd=0;",
                        "    newsst=0;",
                        "    turnr=0;",
                        "    couleavers=0;",
                        "    sys=222;",
                        "    coustan=0;",
                        "}",
                        "function ArrayChekerDiv() {",
                        "    int checker = 0;",
                        "    for(i = 1;i <= CT('Script.RefSpAgentDefence.SkillsDiv.Count');i = i + 1){",
                        "        if(ArrayFind(skilldivpc,CT('Script.RefSpAgentDefence.SkillsDiv.'+i))){",
                        "            if(skilldivp[CT('Script.RefSpAgentDefence.SkillsDiv.'+i)]==0){",
                        "                if(GalaxyTechLevel() >= CT('Script.RefSpAgentDefence.RulesSkillsDiv.'+CT('Script.RefSpAgentDefence.SkillsDiv.'+i)+'.GTL')){",
                        "                    //Проверка на требование другого апа",
                        "                    if(CT('Script.RefSpAgentDefence.RulesSkillsDiv.'+CT('Script.RefSpAgentDefence.SkillsDiv.'+i)+'.WantSkill') == 0){",
                        "                        checker = 1;",
                        "                    }",
                        "                    else {",
                        "                        if(skilldivp[CT('Script.RefSpAgentDefence.RulesSkillsDiv.'+CT('Script.RefSpAgentDefence.SkillsDiv.'+i)+'.WantSkill')] == 1){",
                        "                            checker = 1;",
                        "",
                        "                        }",
                        "                    }",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "    result = checker;",
                        "}",
                        "function ArrayChekerWarr() {",
                        "    int checker = 0;",
                        "    for(i = 1;i <= CT('Script.RefSpAgentDefence.SkillsWarr.Count');i = i + 1){",
                        "        if(ArrayFind(skillwarrc,CT('Script.RefSpAgentDefence.SkillsWarr.'+i))){",
                        "            if(skillwarr[CT('Script.RefSpAgentDefence.SkillsWarr.'+i)]==0){",
                        "                if(GalaxyTechLevel() >= CT('Script.RefSpAgentDefence.RulesSkillsWarr.'+CT('Script.RefSpAgentDefence.SkillsWarr.'+i)+'.GTL')){",
                        "                    //Проверка на требование другого апа",
                        "                    if(CT('Script.RefSpAgentDefence.RulesSkillsWarr.'+CT('Script.RefSpAgentDefence.SkillsWarr.'+i)+'.WantSkill') == 0){",
                        "                        checker = 1;",
                        "                    }",
                        "                    else {",
                        "                        if(skillwarr[CT('Script.RefSpAgentDefence.RulesSkillsWarr.'+CT('Script.RefSpAgentDefence.SkillsWarr.'+i)+'.WantSkill')] == 1){",
                        "                            checker = 1;",
                        "",
                        "                        }",
                        "                    }",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "    result = checker;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 980,
                    "Parent": -1,
                    "#": 59,
                    "Code.Type": "Turn",
                    "Code": [
                        "//Обнуление для постоянных апгрейдов",
                        "if(curfinp <= CurTurn()){",
                        "    divbon = 0;",
                        "}",
                        "if(curfinp > CurTurn()){",
                        "    divbon = 1;",
                        "}",
                        "",
                        "if(statebatt == 1) {",
                        "    if(diversion==0 || diversion==1 || diversion==2){",
                        "        if(GroupCount(Pirates) != 0){",
                        "            for(i=0;i < GroupCount(Pirates);i = i + 1){",
                        "                if(Id(ShipStar(GroupShip(Pirates,i))) != system){",
                        "                    ShipSpecialBonuses(GroupShip(Pirates,i),bonJump,0);",
                        "                    ShipType(GroupShip(Pirates,i),'Pirate');",
                        "                    ShipOut(GroupShip(Pirates,i));",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "    else {",
                        "        if(GroupCount(Pirates) != 0){",
                        "            for(i=0;i < GroupCount(Pirates);i = i + 1){",
                        "                if(Id(ShipStar(GroupShip(Pirates,i))) != sys){",
                        "                    ShipSpecialBonuses(GroupShip(Pirates,i),bonJump,0);",
                        "                    ShipType(GroupShip(Pirates,i),'Pirate');",
                        "                    ShipOut(GroupShip(Pirates,i));",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "}",
                        "//Очистка строк текста",
                        "ClearTstr();",
                        "//Спавнит бегущих с ПБ диверсантов",
                        "if(pirateleave==1 && statebatt == 1 && GroupCount(PB)>0){",
                        "    if(GroupCount(Pirates)<8){",
                        "        if(couleavers < 10){",
                        "            couleavers=couleavers+1;",
                        "            SpawnPirate(IdToPlanet(planet));",
                        "        }",
                        "    }",
                        "}",
                        "//Перемещает случайного диверсанта в стейт для договора с планетой",
                        "if(dipl == 1){",
                        "    dipl = 0;",
                        "    ChangeState('PiratePlanetLand',GroupShip(Pirates,Rnd(1,GroupCount(Pirates)-1)));",
                        "}",
                        "//Перемещает случайного спецназовца в стейт для подрыва ПБ",
                        "if(statekill == 1){",
                        "    pirateleave=0;",
                        "    statekill=2;",
                        "    ChangeState('PBKiller',GroupShip(WarriorsR,Rnd(1,GroupCount(WarriorsR)-1)));",
                        "}",
                        "",
                        "if(updater != CT('Update.StatsVersion')){",
                        "    InitVars();",
                        "    updater=CT('Update.StatsVersion');",
                        "}",
                        "",
                        "",
                        "//Обработчик сброса операции",
                        "if(statebatt == 1){",
                        "",
                        "    if(diversion==0){",
                        "        if(GroupCount(WarriorsR) < 1 && GroupCount(Pirates) < 1 && GroupCount(Agent) < 1 && GroupCount(PB) < 1){",
                        "            RestartTimer();",
                        "        }",
                        "    }",
                        "    if(diversion==1){",
                        "         if(GroupCount(WarriorsR) < 1 && GroupCount(Pirates) < 1){",
                        "            RestartTimer();",
                        "        }",
                        "    }",
                        "    if(diversion==2){",
                        "        if(GroupCount(Pirates) < 1){",
                        "            RestartTimer();",
                        "        }",
                        "    }",
                        "    //Кастомное указание цели для атаки",
                        "    if(diversion==3){",
                        "        if(GroupCount(Pirates) < 1){",
                        "            RestartTimerCustom();",
                        "        }",
                        "    }",
                        "    if(diversion==4){",
                        "        if(GroupCount(WarriorsR) < 1 && GroupCount(Pirates) < 1){",
                        "            RestartTimerCustom();",
                        "        }",
                        "    }",
                        "}",
                        "",
                        "//Обработчик диверсии",
                        "//diversion - тип диверсии",
                        "//statebatt - статус активности диверсии",
                        "//nextattack - таймер обычной атаки",
                        "//rucnickd - ручник для диверсии игрока",
                        "",
                        "if(CurTurn()>nextattack && statebatt == 0 ||  rucnickd == 1) {",
                        "    if(rucnickd==0){",
                        "        tint3=3*skilldivp['BonMinusSwat']-2*skillwarr['BonMinusDiv'];",
                        "        if(Rnd(1,10) > 3+tint3) {",
                        "            if(Rnd(1,10) < 2+tint3){",
                        "                StartDiversionNoPB();//1 тип",
                        "            }",
                        "            else {",
                        "                StartDiversionPB();//0 или 2 тип",
                        "            }",
                        "        }",
                        "        else {",
                        "            StartDisversion();//2 тип",
                        "        }",
                        "    }",
                        "    else {",
                        "        StartCustomDisversion(); //3 или 4 тип",
                        "    }",
                        "}",
                        "",
                        "if(ShipInNormalSpace(Player())) {",
                        "    if(PirateWin()==3 || PirateWin==4) {",
                        "        AllShipOut();",
                        "    }",
                        "}",
                        "//Проверка на то что существует пб в скриптовой группе но боя нет",
                        "if(GroupCount(PB)>0) {",
                        "    ShipOut(GroupToShip(PB));",
                        "}",
                        "//Проверка на \"блуждающих\" диверсантов в скриптовой группе",
                        "if(GroupCount(Pirates)>0) {",
                        "    if(statebatt != 1){",
                        "        for(i = 0;i < GroupCount(Pirates);i = i +1){",
                        "            ShipSpecialBonuses(ShipGroup(Pirates,i),bonJump,0);",
                        "            ShipType(ShipGroup(Pirates,i),'Pirate');",
                        "            ShipOut(ShipGroup(Pirates,i));",
                        "        }",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 980,
                    "Parent": -1,
                    "#": 60,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "if(!PlayerBridge()) {",
                        "  if(GetShipRuins(Player())) {",
                        "    if(ShipType(GetShipRuins(Player())) == 'CB') {",
                        "      if(ShipInPirateClan(Player())) {",
                        "        if(GetShipPirateRank(Player()) > 4) {",
                        "          if(finandivp == 0){",
                        "              AddDialogInject('FinanceDiversions', '', CT('Script.RefSpAgentDefence.TextSkills.FinanceDiversionsFirst'), 1);",
                        "          } else {",
                        "              AddDialogInject('FinanceDiversions', '',CT('Script.RefSpAgentDefence.TextSkills.FinanceDiversions') , 1);",
                        "          }",
                        "        }",
                        "      }",
                        "    }",
                        "    if(ShipType(GetShipRuins(Player())) == 'WB') {",
                        "      if(!ShipInPirateClan(Player())) {",
                        "        if(ShipRank(Player())>3) {",
                        "          if(finanwarr == 0){",
                        "              AddDialogInject('FinanceSwat', '', CT('Script.RefSpAgentDefence.TextSkills.FinanceSpAgentFirst'), 1);",
                        "          } else {",
                        "              AddDialogInject('FinanceSwat', '', CT('Script.RefSpAgentDefence.TextSkills.FinanceSpAgent'), 1);",
                        "          }",
                        "        }",
                        "      }",
                        "    }",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 445,
                    "Parent": -1,
                    "#": 145,
                    "Code.Type": "Turn",
                    "Code": [
                        "//Спецназовцы летят избивать ПБ",
                        "if(GetShipPlanet(CurShip)) OrderTakeOff(CurShip);",
                        "else {",
                        "    if(GroupCount(PB) < 1){",
                        "        ChangeState('DivDestroyed');",
                        "    }",
                        "    else {",
                        "        if(CurTurn()<turnr && GroupCount(PB)>0){",
                        "            pirateleave = 1;",
                        "        }",
                        "        else {",
                        "            pirateleave = 0;",
                        "        }",
                        "        if(CurTurn()>=turnr && GroupCount(PB)>0 && statekill==0 && pirateleave == 0 && GroupCount(WarriorsR) > 2){",
                        "            //Для вызова подрывника из главного турн-кода",
                        "            statekill = 1;",
                        "        }",
                        "    }",
                        "",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 310,
                    "Pos.y": 325,
                    "Parent": -1,
                    "#": 146,
                    "Code.Type": "Turn",
                    "Code": [
                        "//Спец-агента летит на точку где собирает \"инфу\"",
                        "if(GetShipPlanet(CurShip)) {",
                        "    OrderTakeOff(CurShip);",
                        "}",
                        "else if(ShipInNormalSpace(CurShip)) {",
                        "    if(turnr<= CurTurn()) {",
                        "        //Записываем таймер для вояк и меняем стейт агентки",
                        "        turnr = CurTurn() + 20;",
                        "        ChangeState('SPComeback');",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 385,
                    "Parent": -1,
                    "#": 147,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(babahg==1 && CurTurn()==turnr) {",
                        "    babahg=0;",
                        "    ShipDestroy(CurShip, 1);",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 130,
                    "Pos.y": 445,
                    "Parent": -1,
                    "#": 148,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(GroupCount(Pirates) > 0){",
                        "    ChangeState('WarriorsPB');",
                        "}",
                        "else {",
                        "    if(GetShipPlanet(CurShip)) {",
                        "        TransferShip(CurShip,PlanetPirateClan());",
                        "        ShipDestroy(CurShip, 1);",
                        "        if(newsst==0){",
                        "            newsst=1;",
                        "            if(diversion != 3){",
                        "                NewsAdd(Format(CT(\"Script.RefSpAgentDefence.83\"),\"<0>\",Name(GalaxyStar(system-1))));",
                        "                AddPlanetNews(Format(CT(\"Script.RefSpAgentDefence.83\"),\"<0>\",Name(GalaxyStar(system-1))));",
                        "            }",
                        "            else {",
                        "                NewsAdd(Format(CT(\"Script.RefSpAgentDefence.89\"),\"<0>\",Name(GalaxyStar(sys-1))));",
                        "                AddPlanetNews(Format(CT(\"Script.RefSpAgentDefence.89\"),\"<0>\",Name(GalaxyStar(sys-1))));",
                        "            }",
                        "        }",
                        "",
                        "",
                        "    }",
                        "    else {",
                        "        OrderLanding(CurShip,IdToPlanet(planet));",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 470,
                    "Parent": -1,
                    "#": 149,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(GetShipPlanet(CurShip)) {",
                        "    if(!StarBattle(GalaxyStar(system-1))){",
                        "        if(GroupCount(WarriorsR)< 2+GalaxyTechLevel()-skilldivp['BonMinusSwat']*3){",
                        "            for(j=0;j < 5+GalaxyTechLevel()-skilldivp['BonMinusSwat']*3;j = j + 1){",
                        "                SpawnWarrior(IdToPlanet(planet));",
                        "            }",
                        "        }",
                        "    }",
                        "    else {",
                        "        GroupToShip(PB);",
                        "    }",
                        "    TransferShip(CurShip,PlanetPirateClan());",
                        "    ShipDestroy(CurShip, 1);",
                        "}",
                        "else {",
                        "    OrderLanding(CurShip,IdToPlanet(planet));",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 130,
                    "Pos.y": 470,
                    "Parent": -1,
                    "#": 150,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(babahg == 0){",
                        "    if(!GetShipRuins(CurShip)) OrderLanding(CurShip,GroupShip(PB,0));",
                        "    else {",
                        "        babahg = 1;",
                        "        turnr = CurTurn()+4;",
                        "    }",
                        "}",
                        "else {",
                        "    if(GetShipRuins(CurShip)) OrderTakeOff(CurShip);",
                        "    else {",
                        "        ChangeState('InitState3');",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 70,
                    "Pos.y": 385,
                    "Parent": -1,
                    "#": 151,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(diversion==4) {",
                        "  turnr=CurTurn()+Rnd(50,75,CurTurn());",
                        "  ChangeState('PirateDiv');",
                        "}",
                        "if(diversion==3) {",
                        "  ChangeState('PirateAttack');",
                        "}",
                        "if(diversion==2) {",
                        "  turnr=CurTurn()+Rnd(50,75,CurTurn());",
                        "  ChangeState('PirateDiv');",
                        "}",
                        "if(diversion==1) {",
                        "  ChangeState('PirateAttack');",
                        "}",
                        "if(diversion==0) {",
                        "  ChangeState('PirateLeave');",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 250,
                    "Pos.y": 470,
                    "Parent": -1,
                    "#": 152,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(GroupCount(Pirates) == 0){",
                        "    ChangeState('DivDestroyed');",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 495,
                    "Parent": -1,
                    "#": 153,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(GetShipRuins(CurShip) || GetShipPlanet(CurShip)) OrderTakeOff(CurShip);",
                        "else {",
                        "",
                        "    if(GroupCount(WarriorsR) > 5 && GroupCount(Pirates) <3){",
                        "        ChangeState('PirateArest');",
                        "",
                        "    }",
                        "    else {",
                        "        if(GroupCount(WarriorsR) == 0){",
                        "            if(GroupCount(PB)>0) {",
                        "                ShipOut(GroupToShip(PB));",
                        "            }",
                        "            turnr=CurTurn()+Rnd(50,75,CurTurn());",
                        "            ChangeState('PirateDiv');",
                        "",
                        "        }",
                        "        ShipSpecialBonuses(CurShip,bonJump,-50000000);",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 160,
                    "Pos.y": 495,
                    "Parent": -1,
                    "#": 154,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(GetShipRuins(CurShip) || GetShipPlanet(CurShip)) OrderTakeOff(CurShip);",
                        "else {",
                        "    if(diversion != 3 && diversion != 4){",
                        "        if(Id(ShipStar(CurShip))!=system){",
                        "            ShipSpecialBonuses(CurShip,bonJump,0);",
                        "            ShipType(CurShip,'Pirate');",
                        "            ShipOut(CurShip);",
                        "        }",
                        "        for(i = 0;i < StarRuins(GalaxyStar(system-1));i = i + 1){",
                        "            if(ShipType(StarRuins(GalaxyStar(system-1),i)) == 'CB') continue;",
                        "            if(ShipType(StarRuins(GalaxyStar(system-1),i)) == 'PB') continue;",
                        "            if(ShipType(StarRuins(GalaxyStar(system-1),i)) == 'BM') continue;",
                        "            if(ShipType(StarRuins(GalaxyStar(system-1),i)) == 'MC') continue;",
                        "            if(ShipType(StarRuins(GalaxyStar(system-1),i)) == 'TC') continue;",
                        "            if(ShipType(StarRuins(GalaxyStar(system-1),i)) == 'MB') continue;",
                        "            if(ShipType(StarRuins(GalaxyStar(system-1),i)) == 'PlayerMB') continue;",
                        "            if(ShipType(StarRuins(GalaxyStar(system-1),i)) == 'Manaan') continue;",
                        "            coustan=coustan+1;",
                        "        }",
                        "    }",
                        "    else {",
                        "        if(Id(ShipStar(CurShip))!=sys){",
                        "            ShipSpecialBonuses(CurShip,bonJump,0);",
                        "            ShipType(CurShip,'Pirate');",
                        "            ShipOut(CurShip);",
                        "        }",
                        "        for(i = 0;i < StarRuins(GalaxyStar(sys-1));i = i + 1){",
                        "            if(ShipType(StarRuins(GalaxyStar(sys-1),i)) == 'CB') continue;",
                        "            if(ShipType(StarRuins(GalaxyStar(sys-1),i)) == 'PB') continue;",
                        "            if(ShipType(StarRuins(GalaxyStar(sys-1),i)) == 'BM') continue;",
                        "            if(ShipType(StarRuins(GalaxyStar(sys-1),i)) == 'MC') continue;",
                        "            if(ShipType(StarRuins(GalaxyStar(sys-1),i)) == 'TC') continue;",
                        "            if(ShipType(StarRuins(GalaxyStar(sys-1),i)) == 'MB') continue;",
                        "            if(ShipType(StarRuins(GalaxyStar(sys-1),i)) == 'PlayerMB') continue;",
                        "            if(ShipType(StarRuins(GalaxyStar(sys-1),i)) == 'Manaan') continue;",
                        "            coustan=coustan+1;",
                        "        }",
                        "    }",
                        "    if(StarOwner(ShipStar(CurShip)) == 2){",
                        "        ShipSpecialBonuses(CurShip,bonJump,0);",
                        "        ShipType(CurShip,'Pirate');",
                        "        ShipOut(CurShip);",
                        "    }",
                        "    else {",
                        "        if(StarShips(ShipStar(CurShip))-GroupCount(Pirates)<=5 && CurTurn() >= turnr && StarOwner(ShipStar(CurShip)) != 1 && coustan == 0) {",
                        "            if(Id(ShipStar(Player()))!=Id(ShipStar(CurShip))){",
                        "                if(newsst==0){",
                        "                    newsst=1;",
                        "                    if(diversion != 3 && diversion != 4){",
                        "                        StarOwner(GalaxyStar(system-1),2);",
                        "                        for(i = 0;i < StarPlanets(GalaxyStar(system-1));i = i + 1){",
                        "                            if(PlanetOwner(StarPlanets(GalaxyStar(system-1),i)) != None){",
                        "                                PlanetOwner(StarPlanets(GalaxyStar(system-1),i),PirateClan);",
                        "                            }",
                        "                        }",
                        "                        NewsAdd(Format(CT(\"Script.RefSpAgentDefence.119\"),\"<0>\",Name(GalaxyStar(system-1))));",
                        "                        AddPlanetNews(Format(CT(\"Script.RefSpAgentDefence.119\"),\"<0>\",Name(GalaxyStar(system-1))));",
                        "                    }",
                        "                    else {",
                        "                        StarOwner(GalaxyStar(sys-1),2);",
                        "                        for(i = 0;i < StarPlanets(GalaxyStar(sys-1));i = i + 1){",
                        "                            if(PlanetOwner(StarPlanets(GalaxyStar(sys-1),i)) != None){",
                        "                                PlanetOwner(StarPlanets(GalaxyStar(sys-1),i),PirateClan);",
                        "                            }",
                        "                        }",
                        "                        NewsAdd(Format(CT(\"Script.RefSpAgentDefence.119\"),\"<0>\",Name(GalaxyStar(sys-1))));",
                        "                        AddPlanetNews(Format(CT(\"Script.RefSpAgentDefence.119\"),\"<0>\",Name(GalaxyStar(sys-1))));",
                        "                    }",
                        "                }",
                        "            }",
                        "            else {",
                        "                dipl=1;",
                        "            }",
                        "",
                        "        }",
                        "        else {",
                        "            if(turnr <= CurTurn()){",
                        "                ChangeState('PirateCancelDiv');",
                        "            }",
                        "        }",
                        "        ShipSpecialBonuses(CurShip,bonJump,-50000000);",
                        "    }",
                        "    if(ShipOrder(CurShip) == 3){",
                        "        OrderNone(CurShip);",
                        "    }",
                        "}"
                    ]
                },
