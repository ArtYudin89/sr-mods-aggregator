                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 160,
                    "Pos.y": 520,
                    "Parent": -1,
                    "#": 156,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(GetShipPlanet(CurShip)) {",
                        "    if(newsst==0){",
                        "        newsst=1;",
                        "        if(diversion != 3 && diversion != 4){",
                        "            StarOwner(GalaxyStar(system-1),2);",
                        "            for(i = 0;i < StarPlanets(GalaxyStar(system-1));i = i + 1){",
                        "                if(PlanetOwner(StarPlanets(GalaxyStar(system-1),i)) != None){",
                        "                    PlanetOwner(StarPlanets(GalaxyStar(system-1),i),PirateClan);",
                        "                }",
                        "            }",
                        "            NewsAdd(Format(CT(\"Script.RefSpAgentDefence.115\"),\"<0>\",Name(GalaxyStar(system-1))));",
                        "            AddPlanetNews(Format(CT(\"Script.RefSpAgentDefence.115\"),\"<0>\",Name(GalaxyStar(syrems-1))));",
                        "        }",
                        "        else {",
                        "            for(i = 0;i < StarPlanets(GalaxyStar(sys-1));i = i + 1){",
                        "                if(PlanetOwner(StarPlanets(GalaxyStar(sys-1),i)) != None){",
                        "                    PlanetOwner(StarPlanets(GalaxyStar(sys-1),i),PirateClan);",
                        "                }",
                        "            }",
                        "            NewsAdd(Format(CT(\"Script.RefSpAgentDefence.115\"),\"<0>\",Name(GalaxyStar(sys-1))));",
                        "            AddPlanetNews(Format(CT(\"Script.RefSpAgentDefence.115\"),\"<0>\",Name(GalaxyStar(sys-1))));",
                        "        }",
                        "    }",
                        "    ChangeState('PirateDiv');",
                        "}",
                        "else {",
                        "    OrderLanding(CurShip,IdToPlanet(planet));",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 545,
                    "Parent": -1,
                    "#": 157,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(GetShipPlanet(CurShip)) {",
                        "    TransferShip(CurShip,PlanetPirateClan());",
                        "    ShipDestroy(CurShip, 1);",
                        "    if(newsst==0){",
                        "        newsst=1;",
                        "        if(diversion != 3 && diversion != 4){",
                        "            NewsAdd(Format(CT(\"Script.RefSpAgentDefence.116\"),\"<0>\",Name(GalaxyStar(system-1))));",
                        "            AddPlanetNews(Format(CT(\"Script.RefSpAgentDefence.116\"),\"<0>\",Name(GalaxyStar(system-1))));",
                        "        }",
                        "        else {",
                        "            NewsAdd(Format(CT(\"Script.RefSpAgentDefence.116\"),\"<0>\",Name(GalaxyStar(sys-1))));",
                        "            AddPlanetNews(Format(CT(\"Script.RefSpAgentDefence.116\"),\"<0>\",Name(GalaxyStar(sys-1))));",
                        "        }",
                        "    }",
                        "}",
                        "else {",
                        "    OrderLanding(CurShip,IdToPlanet(planet));",
                        "}"
                    ]
                },
                {
