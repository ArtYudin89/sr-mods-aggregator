                        "                              //Добавление в массив для дальнейшего использования цены(нужно в основном чтоб ТН не ломало цену)",
                        "                              ArrayAdd(skillprl,tint4,tstr2);",
                        "                          }",
                        "                          else {",
                        "                              tint4=Rnd(1*GalaxyDiffLevels(1),10*GalaxyDiffLevels(1),int(sqrt(CurTurn()*GalaxyDiffLevels(1)))+Id(ShipStar(Player())))+CT('Script.RefSpAgentDefence.RulesSkillsDiv.'+tstr2+'.Price');",
                        "                              //Добавление в массив для дальнейшего использования цены(нужно в основном чтоб ТН не ломало цену)",
