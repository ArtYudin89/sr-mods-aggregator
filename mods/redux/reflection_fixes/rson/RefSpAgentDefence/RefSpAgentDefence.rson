                    "Name": "",
                    "Pos.x": 190,
                    "Pos.y": 545,
                    "Parent": -1,
                    "#": 158,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!GetShipPlanet(CurShip)){",
                        "    OrderLanding(CurShip,IdToPlanet(planet));",
                        "}",
                        "else {",
                        "    TransferShip(CurShip,PlanetPirateClan());",
                        "    ShipDestroy(CurShip,1);",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 570,
                    "Parent": -1,
                    "#": 159,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!GetShipPlanet(CurShip)){",
                        "    if(GetShipRuins(CurShip)) OrderTakeOff(CurShip);",
                        "    else {",
                        "        if(GroupCount(PB) < 1){",
                        "            ChangeState('PiratePl');",
                        "        }",
                        "        else {",
                        "            if(GroupCount(WarriorsR) < 4 && GroupCount(Pirates) > 5){",
                        "                ChangeState('PiratePl');",
                        "            }",
                        "        }",
                        "    }",
                        "}",
                        "else {",
                        "    TransferShip(CurShip,PlanetPirateClan());",
                        "    ShipDestroy(CurShip,1);",
                        "}"
                    ]
                },
