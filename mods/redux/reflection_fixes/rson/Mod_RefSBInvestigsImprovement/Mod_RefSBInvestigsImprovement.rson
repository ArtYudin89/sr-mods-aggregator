                    "Pos.x": 0,
                    "Pos.y": 230,
                    "Parent": -1,
                    "#": 33,
                    "Move": 0,
                    "MoveObj": -1,
                    "Attack.Count": 0,
                    "TakeItem": -1,
                    "TakeAllItem": false,
                    "OnTalk": "",
                    "OnActCode": "",
