                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 16,
                    "Code.Type": "Init",
                    "Code": [
                        "if(GalaxyDiffLevels() > 49) payment = 3;",
                        "if(GalaxyDiffLevels() > 99) payment = 4;",
                        "if(GalaxyDiffLevels() > 149) payment = 5;",
                        "if(GalaxyDiffLevels() > 199) payment = 7;",
                        "if(GalaxyDiffLevels() > 249) payment = 10;",
                        "if(GalaxyDiffLevels() > 299) payment = 15;",
                        "if(GalaxyDiffLevels() > 349) payment = 20;",
                        "if(GalaxyDiffLevels() > 399) payment = 30;",
                        "if(GalaxyDiffLevels() > 449) payment = 40;",
                        "if(GalaxyDiffLevels() > 479) payment = 50;",
                        "",
                        "function PlayerActCode() {",
                        "    if(ScriptItemActionType(t_OnPlayerTalkedWithShip)) {",
                        "        if(ShipType(ScriptItemActObject1()) == 'FemRanger') {",
                        "            j = 0;",
                        "            for(i=0;ShipPartners(Player())>i;i=i+1) {",
                        "                if(ShipType(ShipPartners(Player(),i)) == 'FemRanger') j = j + 1;",
                        "            }",
                        "            if(j > WivesCnt) {",
                        "                NewsAdd(CT(\"Script.Mod_RefLandingCost.16\")+' '+mcost+' '+CT(\"Script.Mod_RefLandingCost.15\"));",
                        "                Sound('Sound.NewMsg');",
                        "                MarriageCount = MarriageCount + 1;",
                        "            }",
                        "            //Запоминаем число спецагенток-напарниц (раньше WivesCnt всегда 0 -> налог при каждом разговоре со спецагенткой)",
                        "            WivesCnt = j;",
                        "        }",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 17,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(ShipIsTakeoff(Player())) {",
                        "  if(GetShipRuins(Player()) == 0) {",
                        "      if(PlanetOwner(GetShipPlanet(Player())) < 6) counting = counting + 1;",
                        "  }",
                        "}",
                        "if(Flag == 0) {",
                        "    if(counting > 5) {",
                        "        NewsAdd('Уважаемый рейнджер! Вы не оплатили задолженности за посадку на планеты. Зайдите на сайт ГосуУслуги и оплатите счёт, пока не поздно.');",
                        "        Flag = 1;",
                        "    }",
                        "}",
                        "if(Flag == 1) {",
                        "    if(counting > 10) {",
                        "        NewsAdd('Уважаемый рейнджер! Вы не оплатили задолженности за посадку на планеты. Зайдите на сайт ГосуУслуги и оплатите счёт, пока не поздно.');",
                        "        Flag = 2;",
                        "    }",
                        "}",
                        "if(Flag == 2) {",
                        "    if(counting > 15) {",
                        "        NewsAdd('Уважаемый рейнджер! Вы не оплатили задолженности за посадку на планеты. Зайдите на сайт ГосуУслуги и оплатите счёт, пока не поздно.');",
                        "        Flag = 3;",
