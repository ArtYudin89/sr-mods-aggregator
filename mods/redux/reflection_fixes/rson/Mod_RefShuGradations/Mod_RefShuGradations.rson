                    "Code.Type": "Global",
                    "Code": [
                        "if(!GCntRun(GScriptName)) GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 310,
                    "Parent": -1,
                    "#": 11,
                    "Code.Type": "Turn",
                    "Code": [
                        "temp_int=BuildListOfNewShips(tempArr,lastShipId,1+2+4+8+16,0,1);",
                        "if(temp_int)",
                        "{",
                        "    for(i=0;i<ArrayDim(tempArr);i=i+1)",
                        "    {",
                        "        temp_int=0;",
                        "        temp_dword=tempArr[i];",
                        "        if(ShipName(temp_dword) == CT(\"Script.Mod_RefShuGradations.1\")) {",
                        "            ShipSkill(temp_dword,0,4);",
                        "            ShipSkill(temp_dword,1,3);",
                        "            ShipRefit(temp_dword,GalaxyTechLevel()*Rnd(100,160)+Rnd(100,200),1200000);",
                        "            if(ShipEqInSlot(temp_dword,t_Hull)) SpecialToEquipment(FindBonusByName(CT(\"Script.Mod_RefShuGradations.0\")),ShipEqInSlot(temp_dword,t_Hull));",
                        "            ShipHealthFactor(temp_dword,13,9000);",
                        "            if(ShipEqInSlot(temp_dword,t_DefGenerator)) SetEquipmentStats(ShipEqInSlot(temp_dword,t_DefGenerator),GetEquipmentStats(ShipEqInSlot(temp_dword,t_DefGenerator),0)+10,0);",
                        "            if(ShipEqInSlot(temp_dword,t_RepairRobot)) SetEquipmentStats(ShipEqInSlot(temp_dword,t_RepairRobot),GetEquipmentStats(ShipEqInSlot(temp_dword,t_RepairRobot),0)+25,0);",
                        "        }",
                        "    }",
                        "}",
                        "lastShipId=GalaxyShipId();"
                    ]
                }
            ],
