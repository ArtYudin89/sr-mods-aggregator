            "Items": [],
            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 6,
                    "Code.Type": "Global",
                    "Code": [
                        "if(!GCntRun(GScriptName)) GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 575,
                    "Parent": -1,
                    "#": 7,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "if(DomiksDefeated() == 1) {",
                        "  if(PlayerChameleonCharges(0) > 0 || PlayerChameleonCharges(1) > 0 || PlayerChameleonCharges(2) > 0) {",
                        "    if(GetTalkShip() == 0) {",
                        "        if(GetShipRuins(Player())) {",
                        "            if(!PlayerBridge()) {",
                        "                if(ShipType(GetShipRuins(Player())) == 'WB' || ShipType(GetShipRuins(Player())) == 'CB') {",
                        "                    AddDialogInject('CamoSell','',CT('Script.Mod_RefCamoSelling.9'),10);",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 365,
                    "Parent": -1,
                    "#": 17,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(ShipType(GetShipRuins(Player())) == 'WB') tstr = CT('Script.Mod_RefCamoSelling.11');",
                        "else tstr = CT('Script.Mod_RefCamoSelling.10');",
                        "DChange(0);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 18,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(PlayerChameleonCharges(1) > 0) { //ответ 0 - Келлер (серия 1; раньше продавался камуфляж Блазера)",
                        "  DAdd(0);",
                        "}",
                        "if(PlayerChameleonCharges(0) > 0) { //ответ 1 - Блазер (серия 0)",
                        "  DAdd(1);",
                        "}",
                        "if(PlayerChameleonCharges(2) > 0) {",
                        "  DAdd(2);",
                        "}",
                        "DAdd(3);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 130,
                    "Pos.y": 435,
                    "Parent": -1,
                    "#": 19,
                    "Code.Type": "Turn",
                    "Code": [
                        "DAdd(4);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 505,
                    "Parent": -1,
                    "#": 20,
                    "Code.Type": "Turn",
                    "Code": [
                        "//Сумма для реплики «<money> cr. перечислены» (раньше money не задавался - всегда 0)",
                        "money = PlayerChameleonCharges(1) * 30000;",
                        "ShipMoney(Player(),ShipMoney(Player()) + money);",
                        "PlayerChameleonCharges(1,0);",
                        "DChange(1);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 100,
                    "Pos.y": 505,
                    "Parent": -1,
                    "#": 21,
                    "Code.Type": "Turn",
                    "Code": [
                        "//Сумма для реплики «<money> cr. перечислены» (раньше money не задавался - всегда 0)",
                        "money = PlayerChameleonCharges(0) * 30000;",
                        "ShipMoney(Player(),ShipMoney(Player()) + money);",
                        "PlayerChameleonCharges(0,0);",
                        "DChange(1);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 220,
                    "Pos.y": 505,
                    "Parent": -1,
                    "#": 22,
                    "Code.Type": "Turn",
                    "Code": [
                        "//Сумма для реплики «<money> cr. перечислены» (раньше money не задавался - всегда 0)",
                        "money = PlayerChameleonCharges(2) * 30000;",
                        "ShipMoney(Player(),ShipMoney(Player()) + money);",
                        "PlayerChameleonCharges(2,0);",
                        "DChange(1);",
                        "exit;"
                    ]
                }
            ],
