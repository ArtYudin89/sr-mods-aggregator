                        "GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 360,
                    "Parent": -1,
                    "#": 34,
                    "Code.Type": "Init",
                    "Code": [
                        "if(GalaxyDiffLevels() <= 500) { //было без () - всегда 0",
                        "    RangersNeeded = 1;",
                        "}",
                        "if(GalaxyDiffLevels() <= 400) {",
                        "    RangersNeeded = 2;",
                        "}",
                        "if(GalaxyDiffLevels() <= 300) {",
                        "    RangersNeeded = 3;",
                        "}",
                        "if(GalaxyDiffLevels() <= 200) {",
                        "    RangersNeeded = 4;",
                        "}",
                        "if(GalaxyDiffLevels() <= 150) {",
                        "    RangersNeeded = 3;",
                        "}",
                        "if(GalaxyDiffLevels() <= 100) {",
                        "    RangersNeeded = 2;",
                        "}",
                        "//Функция для исправления перевеса корабля (если он есть): расширяет вместимость корпуса, повышает HP до максимума",
                        "function FixOverweight(ship)",
                        "{",
                        "    ShipCalcParam(ship);",
                        "    int space = ShipFreeSpace(ship);",
                        "    if(space < 0)",
                        "    {",
                        "        dword hull = ShipItems(ship, 0);",
                        "        ItemSize(hull, ItemSize(hull) + abs(space) + Rnd(1, 3));",
                        "        HullHP(hull, ItemSize(hull));",
                        "        ShipCalcParam(ship);",
                        "    }",
                        "}",
                        "",
                        "//Заселённая планета Коалиции для появления рейнджера (0 - не найдена)",
                        "//(раньше: GalaxyStar(Rnd(0,j-1)) с незаданным j и счётчик попыток без сброса -> BuyRanger(0))",
                        "function MightyPlanet()",
                        "{",
                        "    int t, n, cnt, o;",
                        "    dword s;",
                        "    result = 0;",
                        "    for(t = 0; t < 200; t = t + 1) {",
                        "        s = GalaxyStar(Rnd(0, GalaxyStars() - 1));",
                        "        if(StarOwner(s) > 0) continue; //только системы Коалиции",
                        "        if(StarCustomFaction(s) != '') continue;",
                        "        if(StarToCon(s) == StarToCon(PlanetToStar(PlanetPirateClan()))) continue; //не пиратский сектор",
                        "        cnt = StarPlanets(s);",
                        "        if(cnt < 1) continue;",
                        "        o = Rnd(0, cnt - 1);",
                        "        for(n = 0; n < cnt; n = n + 1) {",
                        "            if(PlanetOwner(StarPlanets(s, (n + o) % cnt)) < 5) {",
                        "                result = StarPlanets(s, (n + o) % cnt);",
                        "                break;",
                        "            }",
                        "        }",
                        "        if(result) break;",
                        "    }",
                        "}",
                        "",
                        "//«Крутой» рейнджер: improves - число улучшений оборудования. Вернёт 1, если создан",
                        "function SpawnMighty(int improves)",
                        "{",
                        "    result = 0;",
                        "    PlanetForSpawn = MightyPlanet();",
                        "    if(PlanetForSpawn) {",
                        "        Ranger = BuyRanger(PlanetForSpawn,450);",
                        "        if(Ranger) {",
                        "            ShipRefit(Ranger);",
                        "            ShipRefit(Ranger);",
                        "            ShipImproveItems(Ranger,improves);",
                        "            //Звание и прочность по времени (раньше if подряд - всегда срабатывал последний)",
                        "            if(CurTurn() <= 1700) {",
                        "                RankRnd = Rnd(3,5);",
                        "                ShipHP = Rnd(650,850);",
                        "            }",
                        "            else if(CurTurn() <= 3100) {",
                        "                RankRnd = Rnd(4,6);",
                        "                ShipHP = Rnd(850,1050);",
                        "            }",
                        "            else if(CurTurn() <= 6300) {",
                        "                RankRnd = Rnd(5,7);",
                        "                ShipHP = Rnd(950,1250);",
                        "            }",
                        "            else {",
                        "                RankRnd = Rnd(6,7);",
                        "                ShipHP = Rnd(1250,1650);",
                        "            }",
                        "            ShipRaiseRank(Ranger,RankRnd);",
                        "            HullHP(Ranger,ShipHP);",
                        "            ShipSkill(Ranger,0,Rnd(3,6));",
                        "            ShipSkill(Ranger,1,Rnd(3,6));",
                        "            ShipSkill(Ranger,2,Rnd(2,5));",
                        "            ShipSkill(Ranger,5,Rnd(2,4));",
                        "            //Фэянское оборудование ТУ+1 без повторов типа (запрет сбрасывается на каждого рейнджера)",
                        "            AntiEquiping = 0;",
                        "            AntiEquiping1 = 0;",
                        "            AntiEquiping2 = 0;",
                        "            AntiEquiping3 = 0;",
                        "            ForAntiEquiping = 0;",
                        "            CountOfGoodEquips = Rnd(2,5);",
                        "            while(CountOfGoodEquips > 0) {",
                        "                NumberOfEquip = Rnd(43,49);",
                        "                if(NumberOfEquip == AntiEquiping) continue;",
                        "                if(NumberOfEquip == AntiEquiping1) continue;",
                        "                if(NumberOfEquip == AntiEquiping2) continue;",
                        "                if(NumberOfEquip == AntiEquiping3) continue;",
                        "                SizeOfEquip = Rnd(25,45);",
                        "                Equip = CreateEquipment(NumberOfEquip,SizeOfEquip,CurTechs,Fei);",
                        "                ItemIsInUse(Equip,Ranger,1);",
                        "                CountOfGoodEquips = CountOfGoodEquips - 1;",
                        "                ForAntiEquiping = ForAntiEquiping + 1;",
                        "                if(ForAntiEquiping == 1) AntiEquiping = NumberOfEquip;",
                        "                if(ForAntiEquiping == 2) AntiEquiping1 = NumberOfEquip;",
                        "                if(ForAntiEquiping == 3) AntiEquiping2 = NumberOfEquip;",
                        "                if(ForAntiEquiping == 4) AntiEquiping3 = NumberOfEquip;",
                        "            }",
                        "            FixOverweight(Ranger);",
                        "            ShipFreeFlight(Ranger);",
                        "            RangersSpawned = RangersSpawned + 1;",
                        "            result = 1;",
                        "        }",
                        "    }",
                        "    PlanetForSpawn = 0;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 360,
                    "Parent": -1,
                    "#": 35,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(CoalitionDefeated() == 0) {",
                        "  CurTechs = GalaxyTechLevel() + 1;",
                        "  if(CurTechs > 8) CurTechs = 8;",
                        "  if(SpawnNpcs == 0) {",
                        "      //Стартовые рейнджеры (раньше цикл не выполнялся: условие перевёрнуто, CurTurn без () = 0)",
                        "      while(RangersSpawned < RangersNeeded) {",
                        "          if(!SpawnMighty(4)) break;",
                        "      }",
                        "      SpawnNpcs = 1;",
                        "  }",
                        "  else {",
                        "      //Подкрепления по датам (раньше SpawnNpcs не выставлялся и CurTurn без () - не срабатывали)",
                        "      if(CurTurn() == 1900) SpawnMighty(7);",
                        "      if(CurTurn() == 4000) SpawnMighty(11);",
                        "      if(CurTurn() == 7000) SpawnMighty(13);",
                        "      if(CurTurn() == 9000) SpawnMighty(15);",
                        "      if(CurTurn() == 11000) SpawnMighty(17);",
                        "      if(CurTurn() == 22000) {",
                        "          if(SpawnMighty(24)) RangerExcludedFromRating(Ranger,0);",
                        "      }",
                        "  }",
                        "  //Награждаем крупные корабли Коалиции системами ПРО",
                        "  //Пиратскому металлолому вешаем Ракетанг",
                        "  if(GalaxyShipId()>lastShipId) {",
                        "      tdwd=BuildListOfNewShips(tempArr,lastShipId,8+16,1+2+4+8+16+128,1,'');",
                        "      if(tdwd) {    //Если найден хотя бы один корабль",
                        "          for(i=0;i<ArrayDim(tempArr);i=i+1) {",
                        "              tdwd=0;    //Обнуляем флаг",
                        "              tShip=tempArr[i];    //Выбираем корабль",
                        "              if(IsPlayer(tShip)) continue;",
                        "              tStr=ShipType(tShip);",
                        "              if(tStr=='PirateGalleon' || tStr=='PirateFrigate' || tStr=='PirateCorvette') {",
                        "                  if(GetEquipmentStats(ShipEqInSlot(tShip,t_Hull),3) > 1) {",
                        "                      tArt = CreateArt(t_ArtMissileDef,Pirate);",
                        "                      AddItemToShip(tShip,tArt);",
                        "                      ItemIsInUse(tArt,tShip,1,1); //сначала предмет, потом корабль (было наоборот)",
                        "                      NoDropItem(tArt,1);",
                        "                  }",
                        "              }",
                        "              if(tStr=='Dreadnought') {",
                        "                  if(GetEquipmentStats(ShipEqInSlot(tShip,t_Hull),3) > 1) {",
                        "                      tArt = CreateArt(t_ArtPDTurret,Fei);",
                        "                      AddItemToShip(tShip,tArt);",
                        "                      ItemIsInUse(tArt,tShip,1,1); //сначала предмет, потом корабль (было наоборот)",
                        "                      ShipAddCustomShipInfo(tShip,'RefPVOFix','NoShow');",
                        "                      NoDropItem(tArt,1);",
                        "                  }",
                        "              }",
                        "              if(tStr=='Warrior') {",
                        "                  if(ShipSubType(tShip) == 1) {",
                        "                      if(GetEquipmentStats(ShipEqInSlot(tShip,t_Hull),3) > 1) {",
                        "                          tArt = CreateArt(t_ArtPDTurret,Fei);",
                        "                          AddItemToShip(tShip,tArt);",
                        "                          ItemIsInUse(tArt,tShip,1,1); //сначала предмет, потом корабль (было наоборот)",
                        "                          ShipAddCustomShipInfo(tShip,'RefPVOFix','NoShow');",
                        "                          NoDropItem(tArt,1);",
                        "                      }",
                        "                  }",
                        "              }",
                        "          }",
                        "      }",
                        "      lastShipId=GalaxyShipId();    //Обновляем Id последнего рожденного корабля",
                        "  }",
                        "}"
                    ]
                }
            ],
