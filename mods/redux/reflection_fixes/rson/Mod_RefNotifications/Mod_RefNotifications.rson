                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 555,
                    "Parent": -1,
                    "#": 102,
                    "Code.Type": "Turn",
                    "Code": [
                        "//Календарь игры - григорианский, с високосными годами (GameDateTxtByTurn): 1 января 3300 = ход 301.",
                        "//Раньше год = 365 дней ровно: с 3304 года напоминание съезжало на день за каждый високосный год.",
                        "//Текущий год (раньше round(): со второй половины года минимум был уже следующий год)",
                        "tyear = 3300;",
                        "tint = 301;",
                        "for(j=0;j<1000;j=j+1) {",
                        "    nleap = 0;",
                        "    if(int(tyear/4)*4 == tyear) {",
                        "        if(int(tyear/100)*100 != tyear || int(tyear/400)*400 == tyear) nleap = 1;",
                        "    }",
                        "    if(tint + 365 + nleap > CurTurn()) break;",
                        "    tint = tint + 365 + nleap;",
                        "    tyear = tyear + 1;",
                        "}",
                        "tint = tyear;",
                        "tyear = CountBox('Bm.Items.2Minerals',CT(\"Script.Mod_RefNotifications.39\"),tint,4000);",
                        "//Ход «0 января» выбранного года. Напоминание пишется в NotifyTurn только при выборе дня",
                        "//(раньше сразу: отмена года или выход в меню затирали действующее напоминание)",
                        "nturn = 300;",
                        "for(j=3300;j<tyear;j=j+1) {",
                        "    nturn = nturn + 365;",
                        "    nleap = 0;",
                        "    if(int(j/4)*4 == j) {",
                        "        if(int(j/100)*100 != j || int(j/400)*400 == j) nleap = 1;",
                        "    }",
                        "    nturn = nturn + nleap;",
                        "}",
                        "nleap = 0;",
                        "if(int(tyear/4)*4 == tyear) {",
                        "    if(int(tyear/100)*100 != tyear || int(tyear/400)*400 == tyear) nleap = 1;",
                        "}",
                        "if(tyear >= 3000) {",
                        "  DChange(1);",
                        "  exit;",
                        "}",
                        "if(tyear < 3000) {",
                        "  DChange(0);",
                        "  exit;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 100,
                    "Pos.y": 555,
                    "Parent": -1,
                    "#": 103,
                    "Code.Type": "Turn",
                    "Code": [
                        "tstr = TextBox(CT(\"Script.Mod_RefNotifications.41\"));",
                        "tdwd = 0;",
                        "for(i=0;GalaxyStars()>i;i=i+1) {",
                        "    for(j=0;StarShips(GalaxyStar(i)) > j;j=j+1) {",
                        "        if(ShortName(StarShips(GalaxyStar(i),j)) == tstr) tdwd = StarShips(GalaxyStar(i),j);",
                        "        else continue;",
                        "    }",
                        "}",
                        "if(tdwd == 0) MessageBox(CT(\"Script.Mod_RefNotifications.40\"));",
                        "else {",
                        "    tstr = Name(tdwd);",
                        "    ShipIDD = Id(tdwd);",
                        "}",
                        "if(tdwd == 0) {",
                        "  DChange(0);",
                        "  exit;",
                        "}",
                        "if(tdwd != 0) {",
                        "  DChange(9);",
                        "  exit;",
                        "}"
                    ]
                },
