            "Items": [],
            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 650,
                    "Parent": -1,
                    "#": 20,
                    "Code.Type": "Global",
                    "Code": [
                        "GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 650,
                    "Parent": -1,
                    "#": 21,
                    "Code.Type": "Turn",
                    "Code": [
                        "//Дата: >= (выбранный прошедший день сработает на следующий ход, а не никогда); в тексте - текущий день",
                        "//(раньше NotifyTurn обнулялся до вывода -> в новости дата 3299 года)",
                        "if(NotifyTurn > 0 && CurTurn() >= NotifyTurn) {",
                        "    NotifyTurn = 0;",
                        "    if(text_date == 'No') text_date = '';",
                        "    else text_date = '<br' + '/>' + text_date;",
                        "    NewsAdd(Format(CT(\"Script.Mod_RefNotifications.33\"),'date',GameDateTxtByTurn(CurTurn())) + text_date);",
                        "    Sound('Sound.NewMsg');",
                        "}",
                        "if(NotifySysID > 0 && NotifySysID < 10000) {",
                        "    if(Id(ShipStar(Player())) == NotifySysID) {",
                        "        if(text_system == 'No') text_system = '';",
                        "        else text_system = '<br' + '/>' + text_system;",
                        "        NewsAdd(Format(CT(\"Script.Mod_RefNotifications.32\"),'name',Name(GalaxyStar(NotifySysID-1))) + text_system);",
                        "        Sound('Sound.NewMsg');",
                        "        NotifySysID = 0;",
                        "    }",
                        "}",
                        "if(ShipIDD != 0) {",
                        "    tdwd2 = IdToShip(ShipIDD);",
                        "    //Пилот погиб -> уведомление снимается (раньше ShipStar(0) каждый ход)",
                        "    if(!tdwd2) ShipIDD = 0;",
                        "    else if(ShipInStar(Player(),ShipStar(tdwd2))) {",
                        "        //Метка пилота - text_person (раньше выводилась метка уведомления о системе)",
                        "        if(text_person == 'No') text_person = '';",
                        "        else text_person = '<br' + '/>' + text_person;",
                        "        NewsAdd(Format(CT(\"Script.Mod_RefNotifications.31\"),'name',Name(tdwd2)) + text_person);",
                        "        Sound('Sound.NewMsg');",
                        "        ShipIDD = 0;",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 650,
                    "Parent": -1,
                    "#": 22,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "if(PlayerBridge()==12) {",
                        "  AddDialogInject('NotifyDial',CT(\"Script.Mod_RefNotifications.43\"),CT(\"Script.Mod_RefNotifications.2\"),50);",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 390,
                    "Parent": -1,
                    "#": 76,
                    "Code.Type": "Turn",
                    "Code": [
                        "//NotifySysID: 0 или 10000 (старые сейвы) = нет. Раньше после сработавшего уведомления о системе",
                        "//10000 проходило \"> 0\" -> GalaxyStar(9999) -> вылет при открытии меню; а 0 в новой игре давал пустой список",
                        "if(ShipIDD != 0) {",
                        "    if(!IdToShip(ShipIDD)) ShipIDD = 0;",
                        "}",
                        "if(NotifyTurn <= 0 && ShipIDD == 0 && (NotifySysID == 0 || NotifySysID >= 10000)) tstr = CT(\"Script.Mod_RefNotifications.38\");",
                        "else {",
                        "    tstr = '';",
                        "    if(NotifyTurn > 0) tstr = tstr + Format(CT(\"Script.Mod_RefNotifications.37\"),'date',GameDateTxtByTurn(NotifyTurn)) + CT('FormInfo.br');",
                        "    if(ShipIDD > 0) tstr = tstr + Format(CT(\"Script.Mod_RefNotifications.36\"),'ship',Name(IdToShip(ShipIDD))) + CT('FormInfo.br');",
                        "    if(NotifySysID > 0 && NotifySysID < 10000) tstr = tstr + Format(CT(\"Script.Mod_RefNotifications.35\"),'sys',Name(GalaxyStar(NotifySysID-1))) + CT('FormInfo.br');",
                        "}",
                        "DChange(0);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 130,
                    "Pos.y": 390,
                    "Parent": -1,
                    "#": 77,
                    "Code.Type": "Turn",
                    "Code": [
                        "NotifyTurn = nturn + GAnswerData;",
                        "tstr = GameDateTxtByTurn(NotifyTurn);",
                        "DChange(8);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 250,
                    "Pos.y": 390,
                    "Parent": -1,
                    "#": 78,
                    "Code.Type": "Turn",
                    "Code": [
                        "tdwd = GAnswerData;",
                        "DChange(4);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 430,
                    "Pos.y": 390,
                    "Parent": -1,
                    "#": 79,
                    "Code.Type": "Turn",
                    "Code": [
                        "NotifySysID = Id(GAnswerData);",
                        "tstr = Name(GAnswerData);",
                        "DChange(7);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 460,
                    "Parent": -1,
                    "#": 80,
                    "Code.Type": "Turn",
                    "Code": [
                        "DAdd(0);",
                        "DAdd(1);",
                        "DAdd(2);",
                        "DAdd(24);"
                    ]
