            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 335,
                    "Parent": -1,
                    "#": 18,
                    "Code.Type": "Global",
                    "Code": [
                        "GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 335,
                    "Parent": -1,
                    "#": 19,
                    "Code.Type": "Turn",
                    "Code": [
                        "SysUnderCoal = ControlledSystems(0);",
                        "TryAgainPlanets = 0;",
                        "TryAgain = 0;",
                        "if(TimerMinerals == 0) {",
                        "    //Новая планета для каждого события (раньше PlanetForGoods не сбрасывался: выбор не повторялся)",
                        "    PlanetForGoods = 0;",
                        "    j = GalaxyStars();",
                        "    while(PlanetForGoods == 0) {",
                        "        choosed_star = GalaxyStar(Rnd(0,j-1)); //выбираем рандомную звёздов",
                        "        TryAgain = TryAgain + 1;",
                        "        if(TryAgain>=100) break;",
                        "        if(StarOwner(choosed_star)) continue; //Исключаем некоалиционные системы и системы с кастомной расой",
                        "        if(StarCustomFaction(choosed_star)!='') continue;",
                        "        //Исключаем Тортугац и Нифигац (PlanetPirateClan() может не быть)",
                        "        if(PlanetPirateClan()) {",
                        "            if(StarToCon(choosed_star)==StarToCon(PlanetToStar(PlanetPirateClan()))) continue;",
                        "        }",
                        "        i = StarPlanets(choosed_star);",
                        "        if(i < 1) continue;",
                        "        choosed_planet = StarPlanets(choosed_star,Rnd(0,i-1)); //планета звезды (было - \"планеты\" choosed_planet)",
                        "        if(!choosed_planet) continue;",
                        "        TryAgainPlanets = 0; //попытки - на каждую звезду заново",
                        "        while(PlanetOwner(choosed_planet)==6) {",
                        "            choosed_planet = StarPlanets(choosed_star,Rnd(0,i-1));",
                        "            TryAgainPlanets = TryAgainPlanets+1;",
                        "            if(TryAgainPlanets>=30) break; //если перебрали всё, а не нашли заселёнок",
                        "        }",
                        "        if(TryAgainPlanets>=30) continue;",
                        "        PlanetForGoods = choosed_planet;",
                        "    }",
                        "",
                        "    if(PlanetForGoods > 0) {",
                        "        ForRnd1 = Rnd(1,2);",
                        "        if(ForRnd1 == 1) {",
                        "            ForRnd2 = Rnd(1,3);",
                        "            if(ForRnd2 == 1) ForAddingGoods = 5000;",
                        "            if(ForRnd2 == 2) ForAddingGoods = 10000;",
                        "            if(ForRnd2 == 3) ForAddingGoods = 20000;",
                        "            UpsurgeGoods(PlanetForGoods,t_Minerals);",
                        "            PlanetSetGoods(PlanetForGoods,t_Minerals,ForAddingGoods);",
                        "            if(SysUnderCoal < 5) {",
                        "                TimerMinerals = Rnd(300,340);",
                        "            }",
                        "            if(SysUnderCoal >= 5 && SysUnderCoal < 15) {",
                        "                TimerMinerals = Rnd(220,250);",
                        "            }",
                        "            if(SysUnderCoal >= 15 && SysUnderCoal < 25) {",
                        "                TimerMinerals = Rnd(120,240);",
                        "            }",
                        "            if(SysUnderCoal >= 25 && SysUnderCoal < 40) {",
                        "                TimerMinerals = Rnd(80,110);",
                        "            }",
                        "            if(SysUnderCoal >= 40) {",
                        "                TimerMinerals = Rnd(50,90);",
                        "            }",
                        "            AddPlanetNews(Format(CT('GoodsNews.MineralsSale'+ForRnd2),'#pl1#',Name(PlanetForGoods)),71);",
                        "        }",
                        "        if(ForRnd1 == 2) {",
                        "            ForRnd2 = Rnd(1,3);",
                        "            DecayGoods(PlanetForGoods,t_Minerals);",
                        "            PlanetSetGoods(PlanetForGoods,t_Minerals,0);",
                        "            if(SysUnderCoal < 5) {",
                        "                TimerMinerals = Rnd(100,140);",
                        "            }",
                        "            if(SysUnderCoal >= 5 && SysUnderCoal < 15) {",
                        "                TimerMinerals = Rnd(30,50);",
                        "            }",
                        "            if(SysUnderCoal >= 15 && SysUnderCoal < 25) {",
                        "                TimerMinerals = Rnd(12,24);",
                        "            }",
                        "            if(SysUnderCoal >= 25 && SysUnderCoal < 40) {",
                        "                TimerMinerals = Rnd(8,11);",
                        "            }",
                        "            if(SysUnderCoal >= 40) {",
                        "                TimerMinerals = Rnd(4,9);",
                        "            }",
                        "            AddPlanetNews(Format(CT('GoodsNews.MineralsBuy'+ForRnd2),'#pl1#',Name(PlanetForGoods)),7);",
                        "        }",
                        "    }",
                        "}",
                        "TryAgainPlanets = 0;",
                        "TryAgain = 0;",
                        "if(TimerDrugs == 0) {",
                        "    //Новая планета для каждого события (раньше PlanetForGoods не сбрасывался: выбор не повторялся)",
                        "    PlanetForGoods = 0;",
                        "    j = GalaxyStars();",
                        "    while(PlanetForGoods == 0) {",
                        "        choosed_star = GalaxyStar(Rnd(0,j-1)); //выбираем рандомную звёздов",
                        "        TryAgain = TryAgain + 1;",
                        "        if(TryAgain>=100) break;",
                        "        if(StarOwner(choosed_star)) continue; //Исключаем некоалиционные системы и системы с кастомной расой",
                        "        if(StarCustomFaction(choosed_star)!='') continue;",
                        "        //Исключаем Тортугац и Нифигац (PlanetPirateClan() может не быть)",
                        "        if(PlanetPirateClan()) {",
                        "            if(StarToCon(choosed_star)==StarToCon(PlanetToStar(PlanetPirateClan()))) continue;",
                        "        }",
                        "        i = StarPlanets(choosed_star);",
                        "        if(i < 1) continue;",
                        "        choosed_planet = StarPlanets(choosed_star,Rnd(0,i-1)); //планета звезды (было - \"планеты\" choosed_planet)",
                        "        if(!choosed_planet) continue;",
                        "        TryAgainPlanets = 0; //попытки - на каждую звезду заново",
                        "        while(PlanetOwner(choosed_planet)==6) {",
                        "            choosed_planet = StarPlanets(choosed_star,Rnd(0,i-1));",
                        "            TryAgainPlanets = TryAgainPlanets+1;",
                        "            if(TryAgainPlanets>=30) break; //если перебрали всё, а не нашли заселёнок",
                        "        }",
                        "        if(TryAgainPlanets>=30) continue;",
                        "        PlanetForGoods = choosed_planet;",
                        "    }",
                        "",
                        "    if(PlanetForGoods > 0) {",
                        "        ForRnd1 = Rnd(1,2);",
                        "        if(ForRnd1 == 1) {",
                        "            ForRnd2 = Rnd(1,3);",
                        "            if(ForRnd2 == 1) ForAddingGoods = 300;",
                        "            if(ForRnd2 == 2) ForAddingGoods = 500;",
                        "            if(ForRnd2 == 3) ForAddingGoods = 700;",
                        "            UpsurgeGoods(PlanetForGoods,t_Narcotics);",
                        "            PlanetSetGoods(PlanetForGoods,t_Narcotics,ForAddingGoods);",
                        "            if(SysUnderCoal < 5) {",
                        "                TimerDrugs = Rnd(890,1200);",
                        "            }",
                        "            if(SysUnderCoal >= 5 && SysUnderCoal < 15) {",
                        "                TimerDrugs = Rnd(560,780);",
                        "            }",
                        "            if(SysUnderCoal >= 15 && SysUnderCoal < 25) {",
                        "                TimerDrugs = Rnd(340,510);",
                        "            }",
                        "            if(SysUnderCoal >= 25 && SysUnderCoal < 40) {",
                        "                TimerDrugs = Rnd(280,390);",
                        "            }",
                        "            if(SysUnderCoal >= 40) {",
                        "                TimerDrugs = Rnd(110,230);",
                        "            }",
                        "            AddPlanetNews(Format(CT('GoodsNews.DrugsSale'+ForRnd2),'#pl1#',Name(PlanetForGoods)),71);",
                        "        }",
                        "        if(ForRnd1 == 2) {",
                        "            ForRnd2 = Rnd(1,3);",
                        "            DecayGoods(PlanetForGoods,t_Narcotics);",
                        "            PlanetSetGoods(PlanetForGoods,t_Narcotics,0);",
                        "            if(SysUnderCoal < 5) {",
                        "                TimerDrugs = Rnd(890,1200);",
                        "            }",
                        "            if(SysUnderCoal >= 5 && SysUnderCoal < 15) {",
                        "                TimerDrugs = Rnd(560,780);",
                        "            }",
                        "            if(SysUnderCoal >= 15 && SysUnderCoal < 25) {",
                        "                TimerDrugs = Rnd(340,510);",
                        "            }",
                        "            if(SysUnderCoal >= 25 && SysUnderCoal < 40) {",
                        "                TimerDrugs = Rnd(280,390);",
                        "            }",
                        "            if(SysUnderCoal >= 40) {",
                        "                TimerDrugs = Rnd(110,230);",
                        "            }",
                        "            AddPlanetNews(Format(CT('GoodsNews.DrugsBuy'+ForRnd2),'#pl1#',Name(PlanetForGoods)),70);",
                        "        }",
                        "    }",
                        "}",
                        "TryAgainPlanets = 0;",
                        "TryAgain = 0;",
                        "if(TimerZabast == 0) {",
                        "    //Новая планета для каждого события (раньше PlanetForGoods не сбрасывался: выбор не повторялся)",
                        "    PlanetForGoods = 0;",
                        "    j = GalaxyStars();",
                        "    while(PlanetForGoods == 0) {",
                        "        choosed_star = GalaxyStar(Rnd(0,j-1)); //выбираем рандомную звёздов",
                        "        TryAgain = TryAgain + 1;",
                        "        if(TryAgain>=100) break;",
                        "        if(StarOwner(choosed_star)) continue; //Исключаем некоалиционные системы и системы с кастомной расой",
                        "        if(StarCustomFaction(choosed_star)!='') continue;",
                        "        //Исключаем Тортугац и Нифигац (PlanetPirateClan() может не быть)",
                        "        if(PlanetPirateClan()) {",
                        "            if(StarToCon(choosed_star)==StarToCon(PlanetToStar(PlanetPirateClan()))) continue;",
                        "        }",
                        "        i = StarPlanets(choosed_star);",
                        "        if(i < 1) continue;",
                        "        choosed_planet = StarPlanets(choosed_star,Rnd(0,i-1)); //планета звезды (было - \"планеты\" choosed_planet)",
                        "        if(!choosed_planet) continue;",
                        "        TryAgainPlanets = 0; //попытки - на каждую звезду заново",
                        "        while(PlanetOwner(choosed_planet)==6) {",
                        "            choosed_planet = StarPlanets(choosed_star,Rnd(0,i-1));",
                        "            TryAgainPlanets = TryAgainPlanets+1;",
                        "            if(TryAgainPlanets>=30) break; //если перебрали всё, а не нашли заселёнок",
                        "        }",
                        "        if(TryAgainPlanets>=30) continue;",
                        "        PlanetForGoods = choosed_planet;",
                        "    }",
                        "    if(PlanetForGoods > 0) {",
                        "        DecayGoods(PlanetForGoods,t_Food);",
                        "        PlanetSetGoods(PlanetForGoods,t_Food,30);",
                        "        DecayGoods(PlanetForGoods,t_Medicine);",
                        "        PlanetSetGoods(PlanetForGoods,t_Medicine,0);",
                        "        DecayGoods(PlanetForGoods,t_Technics);",
                        "        PlanetSetGoods(PlanetForGoods,t_Technics,0);",
                        "        DecayGoods(PlanetForGoods,t_Luxury);",
                        "        PlanetSetGoods(PlanetForGoods,t_Luxury,0);",
                        "        UpsurgeGoods(PlanetForGoods,t_Minerals);",
                        "        PlanetSetGoods(PlanetForGoods,t_Minerals,1200);",
                        "        DecayGoods(PlanetForGoods,t_Alcohol);",
                        "        PlanetSetGoods(PlanetForGoods,t_Alcohol,0);",
                        "        DecayGoods(PlanetForGoods,t_Arms);",
                        "        PlanetSetGoods(PlanetForGoods,t_Arms,0);",
                        "        DecayGoods(PlanetForGoods,t_Narcotics);",
                        "        PlanetSetGoods(PlanetForGoods,t_Narcotics,0);",
                        "        if(SysUnderCoal < 5) {",
                        "            TimerZabast = Rnd(490,800);",
                        "        }",
                        "        if(SysUnderCoal >= 5 && SysUnderCoal < 15) {",
                        "            TimerZabast = Rnd(360,580);",
                        "        }",
                        "        if(SysUnderCoal >= 15 && SysUnderCoal < 25) {",
                        "            TimerZabast = Rnd(240,310);",
                        "        }",
                        "        if(SysUnderCoal >= 25 && SysUnderCoal < 40) {",
                        "            TimerZabast = Rnd(190,290);",
                        "        }",
                        "        if(SysUnderCoal >= 40) {",
                        "            TimerZabast = Rnd(80,150);",
                        "        }",
                        "        AddPlanetNews(Format(CT('GoodsNews.Zabastcom1'),'#pl1#',Name(PlanetForGoods)),69);",
                        "    }",
                        "}",
                        "if(TimerDrugs) TimerDrugs = TimerDrugs - 1;",
                        "if(TimerMinerals) TimerMinerals = TimerMinerals - 1;",
                        "if(TimerZabast) TimerZabast = TimerZabast - 1;"
                    ]
                }
            ],
