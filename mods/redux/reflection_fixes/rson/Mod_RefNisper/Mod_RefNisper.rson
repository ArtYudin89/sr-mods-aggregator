                        "HullSizeMax[0] = 350;",
                        "HullSizeMax[1] = 450;",
                        "HullSizeMax[2] = 600;",
                        "HullSizeMax[3] = 800;",
                        "HullSizeMax[4] = 1100;",
                        "HullSizeMax[5] = 1400;",
                        "HullSizeMax[6] = 2000;",
                        "/*",
                        "Research = newarray(10);",
                        "Research[0] = 0.0;",
                        "Research[1] = 0.1;",
                        "Research[2] = 0.1;",
                        "Research[3] = 0.1;",
