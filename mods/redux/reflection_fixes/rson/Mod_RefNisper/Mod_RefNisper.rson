                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 940,
                    "Pos.y": 1690,
                    "Parent": -1,
                    "#": 861,
                    "Code.Type": "Turn",
                    "Code": [
                        "missionsStrings=newarray(5);",
                        "for(i=0;i<5;i=i+1){",
                        "    doneMissions[i]=0;",
                        "    missionsStrings[i]=CT(\"Script.Mod_RefNisper.546\");",
                        "}",
                        "idPlanetsMissions=newarray(5);",
                        "for(i=0;i<5;i=i+1){",
                        "    idPlanetsMissions[i]=-1;",
                        "    for(wl21 = 0; idPlanetsMissions[i]==-1 && wl21 < GalaxyStars() - i; wl21 = wl21 + 1) {",
                        "        targetStar=GalaxyStar(i + wl21);",
                        "        wlC = StarPlanets(targetStar);",
                        "        wlR = 0;",
                        "        if(wlC > 0) wlR = Rnd(0, wlC - 1);",
                        "        for(wl22 = 0; idPlanetsMissions[i]==-1 && wl22 < wlC; wl22 = wl22 + 1) {",
                        "            wlP = StarPlanets(targetStar, (wlR + wl22) % wlC);",
                        "            if(PlanetOwner(wlP) != None) idPlanetsMissions[i] = Id(wlP);",
                        "        }",
                        "    }",
                        "}",
                        "completeTask=2;",
                        "daysMission=850-30*difficultOfMissions;",
                        "CustomEther('NisperEther',3,'ZelDomiksQuest',Format(CT(\"Script.Mod_RefNisper.411\"),\"<0>\",daysMission,\"<1>\",missionsStrings[0],\"<2>\",missionsStrings[1],\"<3>\",missionsStrings[2],\"<4>\",missionsStrings[3],\"<5>\",missionsStrings[4]));",
                        "DChange(58);",
                        "exit;"
                    ]
                },
