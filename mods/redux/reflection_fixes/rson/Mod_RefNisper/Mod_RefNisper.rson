                        "      0.10, 0",
                        "    );",
                        "  } else if (level == 10) {",
                        "    power = choice2(",
                        "      0.45, 2,",
                        "      0.55, 1",
                        "    );",
                        "  } else if (level == 11) {",
                        "    power = choice2(",
                        "      0.70, 2,",
                        "      0.30, 1",
                        "    );",
                        "  }",
                        "  result = power;",
                        "}",
                        "",
                        "function GiveTypeDomik(level) {",
                        "  random = Rnd(1, exp(9.3 - 0.5 * (level - GroupCount(bertors)) - 0.05 * ControlledSystems(0)));",
                        "  if (GroupCount(bertors)*2<ControlledSystems(0)&&random == 1)",
                        "    power = 6;",
                        "  else {",
                        "    if (level == 1) {",
                        "      power = choice2(",
                        "            0.10, 2,",
                        "            0.90, 1",
                        "      );",
                        "    } else if (level == 2) {",
                        "      power = choice3(",
                        "            0.03, 3,",
                        "            0.18, 2,",
                        "            0.79, 1",
                        "      );",
                        "    } else if (level == 3) {",
                        "      power = choice3(",
                        "            0.08, 3,",
                        "            0.22, 2,",
                        "            0.70, 1",
                        "      );",
                        "    } else if (level == 4) {",
                        "      power = choice4(",
                        "            0.02, 4,",
                        "            0.12, 3,",
                        "            0.22, 2,",
                        "            0.64, 1",
                        "      );",
                        "    } else if (level == 5) {",
                        "      power = choice4(",
                        "            0.02, 4,",
                        "            0.12, 3,",
                        "            0.22, 2,",
                        "            0.64, 1",
                        "      );",
                        "    } else if (level == 6) {",
                        "      power = choice4(",
                        "            0.05, 4,",
                        "            0.14, 3,",
                        "            0.23, 2,",
                        "            0.58, 1",
                        "      );",
                        "    } else if (level == 7) {",
