                        "            0.07, 4,",
                        "            0.18, 3,",
                        "            0.23, 2,",
                        "            0.52, 1",
                        "      );",
                        "    } else if (level == 8) {",
                        "      power = choice5(",
                        "            0.02, 5,",
                        "            0.10, 4,",
                        "            0.20, 3,",
                        "            0.16, 2,",
                        "            0.52, 1",
                        "      );",
                        "    } else if (level == 9) {",
                        "      power = choice5(",
                        "            0.04, 5,",
                        "            0.10, 4,",
                        "            0.20, 3,",
                        "            0.22, 2,",
                        "            0.44, 1",
                        "      );",
                        "    } else if (level == 10) {",
                        "      power = choice5(",
                        "            0.08, 5,",
                        "            0.10, 4,",
                        "            0.20, 3,",
                        "            0.24, 2,",
                        "            0.38, 1",
                        "      );",
                        "    } else if (level == 11) {",
