                        "function GiveWeaponMenok(level, ship) {",
                        "  level = toDiap(level, 1, 11);",
                        "  str eq;",
                        "  if(level==1){",
                        "    eq=choice4(",
                        "      0.20, t_Weapon2,",
                        "      0.20, t_Weapon4,",
                        "      0.30, t_Weapon6,",
                        "      0.30, t_Weapon7",
                        "    );",
                        "  }",
                        "  else if(level==2){",
                        "    eq=choice5(",
                        "      0.15, t_Weapon2,",
                        "      0.25, t_Weapon4,",
                        "      0.30, t_Weapon6,",
