                        "        tstr = 'RefNisper_Dock'+wl23;",
                        "        if(ShipFindCustomShipInfoByType(CurShip,tstr) != -1) {",
                        "            if(ShipCustomShipInfoData(CurShip,tstr,3) == 0) {",
                        "                wlT = GiveTypeDomik(toDiap(curDomLevel, 1, 11));",
                        "                ShipCustomShipInfoData(CurShip,tstr,1,wlT);",
                        "            }",
                        "            //Синхронизация срока постройки (в т.ч. миграция старых сейвов со старыми сроками)",
                        "            wlT = ConstructionTime(ShipCustomShipInfoData(CurShip,tstr,1));",
                        "            //Предел численности достигнут - пауза: Data3 <= Data2, инфошка дока перестаёт копить прогресс (-1 при нулевом прогрессе, чтобы не сработала переинициализация по Data3 == 0)",
                        "            if(GroupCount(domiks) + GroupCount(bertors) >= NisperDockCap()) {",
                        "                if(ShipCustomShipInfoData(CurShip,tstr,2) > 0) wlT = ShipCustomShipInfoData(CurShip,tstr,2);",
                        "                else wlT = -1;",
                        "            }",
                        "            if(ShipCustomShipInfoData(CurShip,tstr,3) != wlT) ShipCustomShipInfoData(CurShip,tstr,3,wlT);",
                        "        }",
                        "        if(ShipCustomShipInfoData(CurShip,tstr,2) >= ShipCustomShipInfoData(CurShip,tstr,3) && ShipCustomShipInfoData(CurShip,tstr,2) > 0 && GroupCount(domiks) + GroupCount(bertors) < NisperDockCap()) {",
                        "            //SFT('Dock number '+j+', spawning type '+ShipCustomShipInfoData(CurShip,tstr,1)+', because of Data 2 is '+ShipCustomShipInfoData(CurShip,tstr,2)+', and Data 3 is '+ShipCustomShipInfoData(CurShip,tstr,3));",
                        "            SpawnDomOnShipyard(ShipCustomShipInfoData(CurShip,tstr,1), 0, CurShip);",
                        "            i = GiveTypeDomik(toDiap(curDomLevel, 1, 11));",
                        "            //if(ConstructionTime(i) < 1) NewsAdd('Fuck! No time for spawning nisperoid!');",
                        "            ShipCustomShipInfoData(CurShip,tstr,1,i);",
                        "            ShipCustomShipInfoData(CurShip,tstr,2,0);",
                        "            ShipCustomShipInfoData(CurShip,tstr,3,ConstructionTime(i));",
                        "        }",
                        "    }",
                        "}"
                    ]
