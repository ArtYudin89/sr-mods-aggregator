                    "Pos.y": 1015
                },
                {
                    "Name": "",
                    "Code.Type": "Turn",
                    "Code": [
                        "if(Int_for_Keller_Krinator == 1) {",
                        "  ShipSpecialBonuses(Player(),bonAttacks, ShipSpecialBonuses(Player(),bonAttacks)+1);",
                        "  Armada_TI_Activate = 1;",
                        "  AddDialogBlock('Хорошо. Отдаю распоряжение запитать орудия дополнительной <clr>энергией<clrEnd> реактора. Мне нужно больше огневой мощи.', 1);",
                        "  AddDialogBlock('Отдаю распоряжение отключить орудийные системы от дополнительной подпитки <clr>энергией<clrEnd> реактора. Я в этом не нуждаюсь.', 0);",
                        "}",
                        "if(Int_for_Keller_Krinator == 2) {",
                        "  ShipSpecialBonuses(Player(),bonAttacks, ShipSpecialBonuses(Player(),bonAttacks)+3);",
                        "  Armada_TI_Activate = 1;",
                        "  AddDialogBlock('Хорошо. Отдаю распоряжение запитать орудия дополнительной <clr>энергией<clrEnd> реактора. Мне нужно больше огневой мощи.', 1);",
                        "  AddDialogBlock('Отдаю распоряжение отключить орудийные системы от дополнительной подпитки <clr>энергией<clrEnd> реактора. Я в этом не нуждаюсь.', 0);",
                        "}"
                    ],
